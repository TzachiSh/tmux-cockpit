#!/bin/sh
# cargo's runner for this repo (.cargo/config.toml, #973). cargo starts every
# binary of `cargo test`, `cargo run` and `cargo bench` as
#   tui/tests/claude-guard/runner <binary> [args...]
# A test binary runs with the refusing `claude` beside this file first on its
# PATH, and fails, named, when it started that claude. The product sends a
# failed claude's stderr away and reads the failure as no answer, so the
# refusal alone would pass: each start leaves a line in a file this script
# owns, read once the binary has ended. Anything else is exec'd untouched.
# COCKPIT_TEST_CLAUDE_GUARD=0 lifts the guard by hand (docs/testing.md).
me=claude-guard
[ "$#" -gt 0 ] || { echo "$me: usage: runner <binary> [args...]" >&2; exit 2; }
[ "${COCKPIT_TEST_CLAUDE_GUARD-}" != 0 ] || exec "$@"

# What `cargo test` runs, by the folder the binary is in and its name: one in
# deps/, which `cargo bench` runs too, with --bench; an example built as a
# test, examples/<name>-<16 hex>, where `cargo run --example` runs
# examples/<name>; and from cargo 1.89 a doctest.
h='[0-9a-f]'
h=$h$h$h$h
h=$h$h$h$h
dir=${1%/*}
case ${dir##*/}/${1##*/} in
    deps/* | examples/*-$h | rustdoctest*/rust_out) ;;
    *) exec "$@" ;;
esac
for a in "$@"; do
    [ "$a" != --bench ] || exec "$@"
done

# One folder per binary run, so two cargo runs at once share nothing. No
# folder, no run: the binary is never started without the guard.
d=$(mktemp -d "${TMPDIR:-/tmp}/cockpit-claude-guard.XXXXXX") || {
    echo "$me: error: no folder for the guard, the binary was not started binary=$1" >&2
    exit 1
}
trap 'rm -rf "$d"' EXIT
# A signal sent to this script waits for the binary: the log is still read and
# the folder removed, and the script then dies by that signal itself.
got=
trap 'got=HUP' HUP
trap 'got=INT' INT
trap 'got=TERM' TERM
case $d in /*) ;; *) d=$PWD/$d ;; esac
case $d in
    *:*)
        echo "$me: error: a ':' in TMPDIR would split PATH, the binary was not started dir=$d" >&2
        exit 1
        ;;
esac
cp "${0%/*}/claude" "$d/claude" && : > "$d/reached" || {
    echo "$me: error: cannot set the guard up, the binary was not started dir=$d" >&2
    exit 1
}

PATH=$d:${PATH-/bin:/usr/bin} COCKPIT_TEST_CLAUDE_GUARD_DIR=$d "$@"
rc=$?

if [ ! -f "$d/reached" ]; then
    echo "$me: error: the guard's folder was removed under the binary binary=$1 dir=$d" >&2
    [ "$rc" -ne 0 ] || rc=1
elif [ -s "$d/reached" ]; then
    echo "$me: error: a test started claude, not its rig's own stub (docs/tui.md) binary=$1" >&2
    cat "$d/reached" >&2
    [ "$rc" -ne 0 ] || rc=1
fi
rm -rf "$d"
trap - EXIT HUP INT TERM

# cargo names the signal a test binary died by. The shell hands that death on
# as 128 + the signal, which cargo would print as a plain exit status, so this
# script dies by the same signal, without a second core file. An exit status
# above 128 that the binary chose itself reads the same here and is passed on
# as a signal too. Only a signal that ends a process is sent: STOP would leave
# this script, and cargo behind it, waiting for good.
sig=$got
[ "$rc" -le 128 ] || sig=$(kill -l "$rc" 2>/dev/null) || sig=$got
case $sig in
    HUP | INT | QUIT | ILL | TRAP | ABRT | BUS | FPE | KILL | USR1 | SEGV | USR2 | PIPE | ALRM | \
        TERM | XCPU | XFSZ | SYS)
        ulimit -c 0 2>/dev/null
        kill -s "$sig" "$$"
        ;;
esac
exit "$rc"
