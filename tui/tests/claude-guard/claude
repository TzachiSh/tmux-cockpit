#!/bin/sh
# Not claude, and not gh. tui/tests/claude-guard/runner copies this into a
# folder first on a test binary's PATH, once as `claude` (#973) and once as
# `gh` (#1346), so a test that would start the developer's claude or gh starts
# this. It goes by the name it was started as. It adds one line to `reached`
# beside itself, which fails that binary once it has ended, says why, and
# exits 126. It reads no stdin. The file is the runner's: started by hand from
# the checkout, where there is none, this writes nothing.
prog=${0##*/}
args=
for a in "$@"; do args="$args [$a]"; done
line="claude-guard: error: refused to start $prog for a test ppid=$PPID cwd=$PWD argv=$prog$args"
log=${0%/*}/reached
[ ! -f "$log" ] || printf '%s\n' "$line" >> "$log"
printf '%s\n' "$line" >&2
exit 126
