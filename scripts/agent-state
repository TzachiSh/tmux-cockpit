#!/bin/bash
# Record a tmux pane's agent state in per-pane tmux options.
#   usage: agent-state <running|needs-input|error|done|off|notify|wake|recount> [pane-id]
#          agent-state session [pane-id]   save the payload's session_id, transcript_path (#302)
#                                          and cwd as @cockpit_dir (#312)
#          agent-state sweep      every window's and session's summaries (tmux hooks)
#          agent-state poll <running|needs-input|error|done|off> <pane-id> [ask]   (agent-poll)
# The pane defaults to $TMUX_PANE; tmux hooks have no TMUX_PANE, so they pass it.
# Every @panestate write must go through here, or the window/fleet counters go stale.
set -u

state="${1:-off}"
poll="" view=""
if [ "$state" = poll ]; then
    # poll <state> <pane> [ask]: the agent-view poller's write (#174). It owns the state, so
    # the stickiness below does not apply, and it may only write a closed set of values.
    poll=1; state="${2:-}"; pane="${3:-}"
    case "$state" in needs-input|running|error|done|off) ;; *) exit 0 ;; esac
else
    pane="${2:-${TMUX_PANE:-}}"
fi
# Window, session and fleet summaries are precomputed here so status redraws walk no
# panes (tmux#2774/#3352). They refresh only on a transition in that window or session.
agent='#{m:*|#{pane_current_command}|*,#{@cockpit_agents_glob}}'

# Worst state in the window: needs-input > error > running > done > idle ("A" = agent with no state).
fmt_state="#{?#{m:*needs-input*,#{P:#{?$agent,#{@panestate},} }},needs-input,#{?#{m:*error*,#{P:#{?$agent,#{@panestate},} }},error,#{?#{m:*running*,#{P:#{?$agent,#{@panestate},} }},running,#{?#{m:*done*,#{P:#{?$agent,#{@panestate},} }},done,#{?#{m:*A*,#{P:#{?$agent,A,}}},idle,}}}}}"
# An agent in the window holds an unread review: the tab's ◆.
fmt_review="#{m:*pending*,#{P:#{?$agent,#{@cockpit_review},} }}"

# Counts of agents waiting (nb) and failed (ne) in this session and in every session.
# The bar's "elsewhere" mark is fleet minus session, so no redraw walks the sessions.
fmt_snb="#{n:#{W:#{P:#{?#{==:#{@panestate},needs-input},#{?$agent,x,},}}}}"
fmt_sne="#{n:#{W:#{P:#{?#{==:#{@panestate},error},#{?$agent,x,},}}}}"
fmt_nb="#{n:#{S:#{W:#{P:#{?#{==:#{@panestate},needs-input},#{?$agent,x,},}}}}}"
fmt_ne="#{n:#{S:#{W:#{P:#{?#{==:#{@panestate},error},#{?$agent,x,},}}}}}"
fmt_nr="#{n:#{S:#{W:#{P:#{?#{==:#{@cockpit_review},pending},#{?$agent,x,},}}}}}"

# Theme slots, not hex: the colours follow each client's light or dark theme. Spaces,
# not commas, inside #[]: a comma would end the #{?} branch.
fmt_fleet="#{?#{e|>:$fmt_nb,0},#[fg=themered bold]▲$fmt_nb#[default] ,}"
fmt_fleet="$fmt_fleet#{?#{e|>:$fmt_ne,0},#[fg=themecyan]✕$fmt_ne#[default] ,}"
fmt_fleet="$fmt_fleet#{?#{e|>:$fmt_nr,0},#[fg=thememagenta]◆$fmt_nr#[default] ,}"
# ✦N, last: background subagents running, the sum of every agent pane's @cockpit_subs (#R
# repeats a mark N times, #n counts them). Touch mode is a client's, so its test is stored
# escaped (##{ #, #}) and runs when the bar draws #{E:@cockpit_fleet}.
fmt_ns="#{n:#{S:#{W:#{P:#{?$agent,#{R:x,#{@cockpit_subs}},}}}}}"
fmt_fleet="$fmt_fleet#{?#{e|>:$fmt_ns,0},##{?##{E:@cockpit_is_touch#}#,#,#[fg=themeyellow]✦$fmt_ns#[default] #},}"

# The gauge cells the bar's tab budget takes off (see agent-context).
fmt_cells='#{n:#{W:#{?#{E:@cockpit_ctx_on},xx#{@panestate_ctx}x,}}}'

# The formats live in global options, written once per version of them: inlined in
# every clause, a sweep of a few windows passed tmux's 16 KB command limit.
fmts=(state "$fmt_state" review "$fmt_review" snb "$fmt_snb" sne "$fmt_sne"
      nb "$fmt_nb" ne "$fmt_ne" fleet "$fmt_fleet" cells "$fmt_cells")
stamp=$(printf '%s' "${fmts[*]}" | cksum); stamp=${stamp%% *}
defs="if -F '#{!=:#{@cockpit_fmt_v},$stamp}' {"
for ((k = 0; k < ${#fmts[@]}; k += 2)); do
    defs="$defs set-option -g @cockpit_fmt_${fmts[k]} '${fmts[k + 1]}' ;"
done
defs="$defs set-option -g @cockpit_fmt_v $stamp }"

# set_if <scope flag> <option> <fmt name>: compare-then-set on target $T, since even an
# identical set-option forces a redraw.
set_if() { body="$body ; if -F -t $T '#{!=:#{E:@cockpit_fmt_$3},#{$2}}' { set-option $1F -t $T $2 '#{E:@cockpit_fmt_$3}' }"; }
# Only closed-set values reach these strings.
win_sums() {
    body="$body ; if -F -t $T '#{!=:#{E:@cockpit_fmt_state},#{@cockpit_win_state}}' { if -F -t $T '#{E:@cockpit_fmt_state}' { set-option -wF -t $T @cockpit_win_state '#{E:@cockpit_fmt_state}' } { set-option -wu -t $T @cockpit_win_state } }"
    body="$body ; if -F -t $T '#{E:@cockpit_fmt_review}' { if -F -t $T '#{!=:#{@cockpit_win_review},1}' { set-option -w -t $T @cockpit_win_review 1 } } { if -F -t $T '#{@cockpit_win_review}' { set-option -wu -t $T @cockpit_win_review } }"
}
sess_sums() {
    set_if - @cockpit_sess_nb snb; set_if - @cockpit_sess_ne sne
    # e|!=: an unset sum reads 0, so a session with no gauge is never written.
    body="$body ; if -F -t $T '#{e|!=:#{E:@cockpit_fmt_cells},#{@cockpit_ctx_all}}' { set-option -F -t $T @cockpit_ctx_all '#{E:@cockpit_fmt_cells}' }"
}
fleet_sums() { set_if -g @cockpit_fleet_nb nb; set_if -g @cockpit_fleet_ne ne; set_if -gq @cockpit_fleet fleet; }

# sweep: every window, session and the fleet, from the hooks for what moves or ends
# panes without a transition (move-window, kill-pane, a pane exiting, a session closing).
# Per event, never per redraw; sent in batches under 12 KB (tmux refuses a command
# over 16 KB), and a refused batch is an error, not silence.
if [ "$state" = sweep ]; then
    w="" batch="" rc=0
    flush() {
        [ -n "$batch" ] || return 0
        tmux if-shell -F 1 "${batch# ; }" || rc=1
        batch=""
    }
    add() {                   # one clause, a new batch when this one would pass 12 KB
        [ $(( ${#batch} + ${#body} )) -lt 12000 ] || flush
        batch="$batch$body"
    }
    body=" ; $defs"; add
    # No server means no windows: nothing to sweep, quietly.
    for w in $(tmux list-windows -a -F '#{window_id}' 2>/dev/null); do T=$w; body=""; win_sums; add; done
    # Quoted: tmux's parser leaves $<digit> alone today, and the id need not rely on it.
    for s in $(tmux list-sessions -F '#{session_id}' 2>/dev/null); do T="'$s'"; body=""; sess_sums; add; done
    [ -n "$w" ] || exit 0
    T=$w; body=""; fleet_sums; add
    flush
    exit "$rc"
fi

idle=""
# An agent-view background worker has no pane: its front end relays what matters. Already
# true of the empty-pane exit below; stated first so it does not depend on that guard.
[ -z "$pane" ] && [ "${CLAUDE_CODE_SESSION_KIND:-}" = bg ] && exit 0
# -t prefix-matches session names too, so anything but a %N id could hit another pane.
case "$pane" in
    %[0-9]*) ;;
    *) exit 0 ;;
esac

# How many background subagents the Stop payload on stdin lists in flight (#310, #313), in
# SUBS. Only subagents: an idle teammate stays "running" in claude's registry for the life of
# its team, and a shell or monitor task may never end. Matched structurally: inside a JSON
# string the quotes arrive escaped, so no message text can match. No payload, no head or no
# array: 0.
subs_count() {
    local payload re arr
    SUBS=0
    # head, not read_payload: bash reads a pipe a byte per syscall, about 2.4 s a MB, and the
    # 2 s deadline then cut the array off a long final message. The payload is compact JSON,
    # one line: claude writes it with a newline and closes stdin (2.1.317), so head returns.
    # Bounded all the same (#320): a writer that sends neither must not hold the Stop. A
    # timeout fails open to done. timeout is GNU coreutils; a box without it reads unbounded.
    local to=""; command -v timeout >/dev/null 2>&1 && to="timeout 2"
    payload=$($to head -n 1 2>/dev/null) || return 0
    # Regexes, linear in the payload: a `${payload#*key}` cut rescans it once per byte, and
    # the final message, any size, comes before the key. After `[`, whole strings or single
    # bytes other than `]`, so the match ends with the array (its entries are flat objects,
    # no nested array) and a `]` inside a string does not end it. Bytes, not characters: in a
    # UTF-8 locale glibc's multibyte matcher is quadratic on a long array, and a byte that is
    # not UTF-8 ends the match. Restored on return; nothing below forks. Still quadratic, even
    # under C: a payload repeating an unclosed `"background_tasks":[`, which valid JSON with
    # the key once cannot be.
    local LC_ALL=C
    re='"background_tasks": ?\[(("([^"\\]|\\.)*"|[^]"])*)'
    [[ $payload =~ $re ]] || return 0
    arr=${BASH_REMATCH[1]}
    # Counted from the end: the longest prefix before a marker ends at the last one, so each
    # pass drops one marker and what follows it, with no `#*` cut. A marker inside a string
    # cannot match: its quotes arrive as \", so a backslash follows `type`.
    re='^(.*)"type": ?"subagent"'
    while [[ $arr =~ $re ]]; do SUBS=$((SUBS + 1)) arr=${BASH_REMATCH[1]}; done
}

# @cockpit_subs <- SUBS, compare-then-set, and the fleet's ✦ sum with it: a Stop that holds
# the pane, or meets a sticky state, writes no state and so runs no sums of its own. Only
# digits reach the formats.
subs_write() {
    local cond
    if [ "$SUBS" -gt 0 ]; then
        cond="#{!=:#{@cockpit_subs},$SUBS}" body="set-option -p -t $pane @cockpit_subs $SUBS"
    else
        cond='#{@cockpit_subs}' body="set-option -pu -t $pane @cockpit_subs"
    fi
    T=$pane body="$body ; $defs"
    fleet_sums
    tmux if-shell -F -t "$pane" "$cond" "$body" 2>/dev/null
}

case "$state" in
notify)
    # ESC-cancel fires no hook at all; the idle Notification is the only way out of running.
    d=${BASH_SOURCE[0]}; [ -L "$d" ] && d=$(readlink "$d")
    # shellcheck source=lib/hook.sh
    . "${d%/*}/lib/hook.sh" 2>/dev/null || exit 0
    read_payload false
    # The English text match covers Claude versions that send no notification_type.
    json_str notification_type
    case "$REPLY" in
        permission_prompt|elicitation_dialog) state=needs-input ;;
        # The front end relays these for an agent view (#174): the pane is then the poller's.
        agent_needs_input) state=needs-input view=1 ;;
        agent_completed) view=1 ;;
        idle_prompt) state=off idle=1 ;;
        '') case "$payload" in
                *'waiting for your input'*) state=off idle=1 ;;
                *'needs your permission'*) state=needs-input ;;
                *) exit 0 ;;
            esac ;;
        *) exit 0 ;;
    esac
    if [ -n "$view" ]; then
        mark_agentview "$pane" "${d%/*}"
        # No state of its own: the poller reads the sessions and writes the pane.
        [ "$state" = notify ] && exit 0
    fi
    # Written here, not after the sticky guard below: a pane already on needs-input
    # can be asked something new, and that newer text must still land.
    if [ "$state" = needs-input ]; then
        json_str message
        # Untrusted text bound for a tmux format: strip control chars and cap it.
        msg=${REPLY//[$'\001'-$'\037']/}
        msg=${msg:0:120}
        # A call of its own, never in the batch: tmux splits a command list on a bare `;`.
        if [ -n "$msg" ]; then
            tmux set-option -p -t "$pane" @panestate_msg "$msg" 2>/dev/null
        else
            tmux set-option -pu -t "$pane" @panestate_msg 2>/dev/null
        fi
    fi
    ;;
session)
    # SessionStart and UserPromptSubmit carry the session's identity (#302): the reader is
    # then right from turn 1 and after /clear or --resume, before any Stop. They and
    # CwdChanged carry its cwd, the tree the board shows (#312). No state change. Every value
    # is untrusted: each is checked, then set with `set-option -p` (no format expansion) in a
    # call of its own. last_assistant_message is free text: never stored.
    d=${BASH_SOURCE[0]}; [ -L "$d" ] && d=$(readlink "$d")
    # shellcheck source=lib/hook.sh
    . "${d%/*}/lib/hook.sh" 2>/dev/null || exit 0
    # A capped read, not read_payload: the UserPromptSubmit payload carries the whole prompt,
    # and bash reads a pipe a byte at a time. The ids come first in what claude sends; one
    # that falls past the cap is skipped (the old value stays). Ends early on all three keys.
    has() { case "$payload" in *"\"$1\""*) return 0 ;; esac; return 1; }
    have_ids() { has session_id && has transcript_path && has cwd; }
    # Bytes, not characters: a UTF-8 locale would count `read -n` in characters.
    payload="" chunk="" lc_was=${LC_ALL-} lc_set=${LC_ALL+1}
    LC_ALL=C
    cap=4096 deadline=$(( SECONDS + 2 ))
    while left=$(( deadline - SECONDS )); [ "$left" -gt 0 ] && [ ${#payload} -lt $cap ]; do
        IFS= read -r -n $(( cap - ${#payload} )) -t "$left" chunk || { payload="$payload$chunk"; break; }
        payload="$payload$chunk
"; chunk=""
        have_ids && break
    done
    if [ -n "$lc_set" ]; then LC_ALL=$lc_was; else unset LC_ALL; fi
    # A value cut by the cap fails the UUID test or names no file, so it is never saved.
    json_str session_id; sid=$REPLY
    json_str transcript_path; tp=$REPLY
    # CwdChanged's new_cwd, else the cwd every event carries (#312). Only a whole JSON string:
    # one cut by the cap has no closing quote, and its prefix may well be a real directory.
    json_whole() {            # <key> -> REPLY, the string value; empty when not one
        local LC_ALL=C re="\"$1\": ?\"([^\"\\\\]*)\""
        REPLY=""; [[ $payload =~ $re ]] && REPLY=${BASH_REMATCH[1]}
    }
    json_whole new_cwd; dir=$REPLY; [ -n "$dir" ] || { json_whole cwd; dir=$REPLY; }
    # Absolute, no control char (a newline would split the board's row), an existing directory.
    case "$dir" in /*) ;; *) dir="" ;; esac
    case "$dir" in *[$'\001'-$'\037\177']*) dir="" ;; esac
    [ -n "$dir" ] && [ ! -d "$dir" ] && dir=""
    # One read for both: the session saved before and the cwd the hooks saw last.
    had=$(tmux display-message -p -t "$pane" '#{@cockpit_session}'$'\037''#{@cockpit_cwd}' 2>/dev/null)
    cur=${had%%$'\037'*} seen=${had#*$'\037'}
    uuid='^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
    new=""
    if [[ $sid =~ $uuid ]]; then
        # A new session (/clear, --resume): the old transcript is not its transcript.
        [ "$cur" != "$sid" ] && new=1 && tmux set-option -pu -t "$pane" @cockpit_transcript 2>/dev/null
        tmux set-option -p -t "$pane" @cockpit_session "$sid" 2>/dev/null
    fi
    # @cockpit_dir is written when the agent moved or a new session began, not on every prompt:
    # an agent driving a hand-made worktree with `git -C` sets it itself (docs/review.md), and
    # that holds until it cds. tmux takes an argument's trailing `;` for a separator; `\;` is a
    # literal one.
    if [ -n "$dir" ] && { [ "$dir" != "$seen" ] || [ -n "$new" ]; }; then
        arg=$dir; case "$arg" in *\;) arg="${arg%;}\\;" ;; esac
        tmux set-option -p -t "$pane" @cockpit_dir "$arg" 2>/dev/null
        tmux set-option -p -t "$pane" @cockpit_cwd "$arg" 2>/dev/null
    fi
    # Only a regular file inside the projects tree, symlinks and `..` resolved. '#' never
    # appears in a real one (claude turns it into '-'), so it is refused outright, in the
    # path given and in the path it resolves to.
    root=${CLAUDE_CONFIG_DIR:-${HOME:-}/.claude}/projects
    odd() { case "/$1/" in */../*|*'#'*|*[$'\001'-$'\037\177']*|*\\*) return 0 ;; esac; return 1; }
    if [ -n "$tp" ] && [ -n "${HOME:-}" ] && command -v realpath >/dev/null 2>&1; then
        case "$tp" in /*) odd "$tp" && tp="" ;; *) tp="" ;; esac
        if [ -n "$tp" ]; then
            tp=$(realpath -- "$tp" 2>/dev/null) && root=$(realpath -- "$root" 2>/dev/null) || tp=""
        fi
        if [ -n "$tp" ] && ! odd "$tp" && [ -f "$tp" ]; then
            case "$tp" in "$root"/*) tmux set-option -p -t "$pane" @cockpit_transcript "$tp" 2>/dev/null ;; esac
        fi
    fi
    exit 0
    ;;
wake)
    # TeammateIdle wakes the lead with no hook of its own, so lift done back to running.
    ;;
done)
    # A Stop while background subagents run ends the turn, not the work (#310): claude wakes
    # the session as each reports back, and the last report-back turn's Stop writes done.
    # No state is written meanwhile, so sticky states and the counters stay as they are; the
    # count is (#313). The poller has no payload, and a terminal is a person typing the command.
    if [ -z "$poll" ] && [ ! -t 0 ]; then
        subs_count; subs_write
        [ "$SUBS" -gt 0 ] && exit 0
    fi
    ;;
esac

# `when` guards the transition on the current @panestate. needs-input and error are
# sticky against Stop/idle; an unchanged state is refused because every set redraws.
cur='#{@panestate}'
case "$state" in
    running)     when="#{!=:$cur,running}" ;;
    needs-input) when="#{!=:$cur,needs-input}" ;;
    error)       when="#{?#{m/r:^(error|needs-input)\$,$cur},0,1}" ;;
    done)        when="#{?#{m/r:^(done|needs-input|error)\$,$cur},0,1}" ;;
    wake)        when="#{?$cur,#{==:$cur,done},1}" ;;
    # Claude goes idle while blocked on a prompt too, so idle must not clear an alert.
    off)         when=1
                 [ -n "$idle" ] && when="#{?#{m/r:^(done|needs-input|error)\$,$cur},0,1}" ;;
    recount)     when=1 ;;
    *) exit 0 ;;
esac

if [ -n "$poll" ]; then
    # compare-then-set only: every set redraws, and nothing is sticky for the poller.
    case "$state" in
        off) when="#{?$cur,1,0}"; idle=1 ;;
        *)   when="#{!=:$cur,$state}" ;;
    esac
    # The ask is untrusted text for a tmux option: strip control chars, cap it, and write it
    # in a call of its own (a bare `;` argument splits a command list). Read first so an
    # unchanged ask costs no redraw.
    if [ "$state" = needs-input ]; then
        msg=${4:-}; msg=${msg//[$'\001'-$'\037']/}; msg=${msg:0:120}
        have=$(tmux show-option -pqv -t "$pane" @panestate_msg 2>/dev/null)
        if [ -n "$msg" ] && [ "$have" != "$msg" ]; then
            tmux set-option -p -t "$pane" @panestate_msg "$msg" 2>/dev/null
        fi
    fi
fi

if [ "$state" = off ]; then
    # No early exit when already clear: a fresh agent's SessionStart must still light its ○ dot.
    body="if -F -t $pane '$cur' { set-option -pu -t $pane @panestate }"
    # An ended session takes its review marks with it; an idle one keeps them. And its subagent
    # count (#313): SessionStart's off is a new process, which runs none. Not at idle: the lead
    # idles while its subagents work, and a report-back's UserPromptSubmit leaves the others.
    [ -n "$idle" ] || body="$body ; set-option -pu -t $pane @cockpit_review ; set-option -pu -t $pane @cockpit_review_spool ; set-option -pu -t $pane @cockpit_subs"
elif [ "$state" = recount ]; then
    body=""
else
    [ "$state" = wake ] && state=running
    body="set-option -p -t $pane @panestate $state"
    # Entering running means the human pressed Enter, so a delivered-but-unsent review is gone.
    # Not on wake: nobody pressed Enter.
    [ "$state" = running ] && [ "$1" != wake ] && [ -z "$poll" ] \
        && body="$body ; set-option -pu -t $pane @cockpit_review"
fi

case "$state" in
    running|off) body="$body ; set-option -pu -t $pane @panestate_msg" ;;
    # The poller's done/error follow a needs-input whose ask would otherwise stay.
    done|error) [ -z "$poll" ] || body="$body ; set-option -pu -t $pane @panestate_msg" ;;
esac

T=$pane
body="$body ; $defs"
win_sums; sess_sums; fleet_sums
body="$body ; display-message -p -t $pane '#{@cockpit_tui_pid}'"
# Fail-open: a hook must never block the agent that fired it.
# A hook of this pane's own session (TMUX_PANE is its pane) that is not an agent view's relayed
# notification means the pane is a plain session again: the mark from an earlier agent-view
# visit would have the poller overwrite its states every tick (#174). The same invocation, and
# outside `when`, so a pane that is already in the state still loses it.
unmark=()
if [ -z "$poll" ] && [ -z "$view" ] && [ "$pane" = "${TMUX_PANE:-}" ]; then
    unmark=(if-shell -F -t "$pane" '#{@cockpit_agentview}' \
        "set-option -pu -t $pane @cockpit_agentview" ';')
fi
tui_pid=$(tmux ${unmark[@]+"${unmark[@]}"} if-shell -F -t "$pane" "$when" "${body# ; }" \
    2>/dev/null || true)

# A published pid outlives its process and SIGUSR1 terminates by default, so verify
# the name before signalling (see AGENTS.md).
if [ -n "$tui_pid" ]; then
    tui_comm=""
    # -r first: the stale pid is the one absent from /proc, so `read || ps` would fork ps every time.
    if [ -r "/proc/$tui_pid/comm" ]; then
        read -r tui_comm 2>/dev/null < "/proc/$tui_pid/comm"
    elif [ ! -d /proc/self ]; then
        tui_comm=$(ps -o comm= -p "$tui_pid" 2>/dev/null)   # macOS: ps prints a path
    fi
    if [ "${tui_comm##*/}" = cockpit-tui ]; then
        kill -USR1 "$tui_pid" 2>/dev/null || true
    fi
fi
