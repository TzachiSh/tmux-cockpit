#!/usr/bin/env bash
# Record a tmux pane's agent state. Called from Claude Code hooks and tmux hooks.
#   usage: agent-state <running|needs-input|error|done|off|notify> [pane-id]
# The pane defaults to $TMUX_PANE; tmux hooks have no TMUX_PANE, so they pass it.
# State is a per-pane tmux option, so it dies with the pane.
set -u

state="${1:-off}"
pane="${2:-${TMUX_PANE:-}}"
# Must be a pane id. tmux resolves -t by prefix-matching session names too, so a
# stray argument like "pstes" happily resolves to session "pstest" and we would
# write state onto someone else's pane. Callers only ever pass %N.
case "$pane" in
    %[0-9]*) ;;
    *) exit 0 ;;
esac

# State lives in a per-pane tmux option, not a file. tmux evaluates it directly
# inside status/border formats, so a redraw costs zero shell spawns -- and the
# option dies with the pane, so there is nothing to garbage collect.
current=$(tmux show-option -pqv -t "$pane" @panestate 2>/dev/null || true)

case "$state" in
notify)
    # Pressing ESC to cancel fires NO Claude Code hook -- not Stop, not
    # SessionEnd -- so a cancelled pane would sit on "running" forever. Claude
    # does emit a Notification once it goes idle, which lets us recover.
    # Bounded read, not `cat`. cat waits for EOF, and the writer can hold the
    # pipe open without sending anything -- which wedges the hook, and a wedged
    # hook blocks the agent that fired it. read -t gives up instead; the partial
    # line survives in $chunk, so a payload arriving without a trailing newline
    # is still seen.
    # One deadline for the WHOLE read, not per line: a writer emitting a line
    # every second would keep a per-line timeout alive forever, and the contract
    # here is that a hook never blocks the agent that fired it.
    payload="" chunk="" deadline=$(( SECONDS + 2 ))
    while left=$(( deadline - SECONDS )); [ "$left" -gt 0 ]; do
        IFS= read -r -t "$left" chunk || { payload="$payload$chunk"; break; }
        payload="$payload$chunk"; chunk=""
    done
    case "$payload" in
        *'waiting for your input'*)
            # Claude emits this while it is BLOCKED on a permission prompt too,
            # so clearing here would wipe the alert precisely because you have
            # not answered yet. Only a "running" pane is genuinely idle now.
            # Both clear when work resumes: UserPromptSubmit / PostToolUse
            # overwrite the state. Switching windows must NOT clear them --
            # scanning the tabs is exactly when you need the flags to survive.
            case "$current" in needs-input|error|done) exit 0 ;; esac
            state=off ;;
        *'needs your permission'*) state=needs-input ;;
        *) exit 0 ;;                        # unrelated notification: ignore
    esac
    ;;
esac

# Reject anything that is not a real state. Without this an unknown argument --
# a typo, or a mode removed from the config but still referenced somewhere --
# is written to the option verbatim and every reader then sees garbage.
case "$state" in
    running|needs-input|error|done|off) ;;
    *) exit 0 ;;
esac

# Only needs-input and error are STICKY: they must survive a Stop that fires
# while a permission prompt is still open, which used to demote a red alert to
# green. Work resuming (running) or an explicit off always clears them.
#
# running is deliberately NOT sticky -- running -> done is how every agent
# finishes, and blocking it meant green could never appear at all.
#
# The two sticky states are ordered: needs-input outranks error, because a
# permission prompt still on screen is the thing actually blocking you.
case "$current" in
    needs-input)
        case "$state" in running|off) ;; *) exit 0 ;; esac ;;
    error)
        case "$state" in running|off|needs-input) ;; *) exit 0 ;; esac ;;
esac

if [ "$state" = off ]; then
    tmux set-option -pu -t "$pane" @panestate 2>/dev/null || true
else
    [ "$current" = "$state" ] && exit 0     # unchanged: skip the redraw
    tmux set-option -p -t "$pane" @panestate "$state" 2>/dev/null || true
fi

# Repaint now instead of waiting up to status-interval seconds.
tmux refresh-client -S 2>/dev/null || true
