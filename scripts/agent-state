#!/bin/bash
# Record a tmux pane's agent state in per-pane tmux options.
#   usage: agent-state <running|needs-input|error|done|off|interrupted|input-ended|notify|
#          wake|recount> [pane-id]
#          agent-state <sub-start|sub-stop|sub-idle|sub-end>   append to the session's
#                                          subagent log (#361)
#          agent-state <sub-taskstop|sub-reconcile>   a TaskStop to the same log, a Stop's
#                                          in-flight set to its .live file (#403, #423)
#          agent-state session [pane-id]   save the payload's session_id, transcript_path (#302)
#                                          and cwd as @cockpit_dir (#312)
#          agent-state sweep [seq]   every window's and session's summaries (tmux hooks), and
#                                          the agent-poll that serves the server (#448)
#          agent-state poll <running|needs-input|error|done|off> <pane-id> [ask]   (agent-poll)
# The pane defaults to $TMUX_PANE; tmux hooks have no TMUX_PANE, so they pass it.
# Every @panestate write must go through here, or the window/fleet counters go stale.
set -u

# sub-start|sub-stop|sub-idle|sub-end: the documented subagent hooks (SubagentStart,
# SubagentStop, TeammateIdle, SessionEnd) append to a per-session log the board reads
# (#361). No pane, no tmux call, no state; always exit 0. Before the formats below: it needs none.
# sub-taskstop (PostToolUse, matcher TaskStop) and sub-reconcile (Stop) add what those miss: a
# TaskStop mid-turn, and the set still in flight at the parent's turn end (#403).
case "${1:-}" in
sub-start|sub-stop|sub-idle|sub-end|sub-taskstop|sub-reconcile)
    d=${BASH_SOURCE[0]}; case $d in (*/*) ;; (*) d=./$d ;; esac
    [ -L "$d" ] && d=$(n=0
        while [ -L "$d" ] && [ $((n += 1)) -le 40 ] && t=$(readlink "$d"); do
            case $t in (/*) d=$t ;; (*) d=${d%/*}/$t ;; esac; done; printf %s "$d")
    # shellcheck source=lib/subslog.sh
    . "${d%/*}/lib/subslog.sh" 2>/dev/null || exit 0
    case "$1" in
    sub-end) subs_end ;;
    sub-taskstop) subs_taskstop ;;
    sub-reconcile) subs_reconcile ;;
    *) subs_record "${1#sub-}" ;;
    esac
    exit 0
    ;;
esac

state="${1:-off}"
poll="" view=""
if [ "$state" = poll ]; then
    # poll <state> <pane> [ask]: the agent-view poller's write (#174). It owns the state, so
    # the stickiness below does not apply, and it may only write a closed set of values.
    poll=1; state="${2:-}"; pane="${3:-}"
    case "$state" in needs-input|running|error|done|off) ;; *) exit 0 ;; esac
else
    pane="${2:-${TMUX_PANE:-}}"
fi
# Window, session and fleet summaries are precomputed here so status redraws walk no
# panes (tmux#2774/#3352). They refresh only on a transition in that window or session.
# Cockpit's own popup is no agent (#1248): on tmux next-3.9 it is a pane the #{P:} walks reach.
d=${BASH_SOURCE[0]}; case $d in (*/*) ;; (*) d=./$d ;; esac
[ -L "$d" ] && d=$(n=0
    while [ -L "$d" ] && [ $((n += 1)) -le 40 ] && t=$(readlink "$d"); do
        case $t in (/*) d=$t ;; (*) d=${d%/*}/$t ;; esac; done; printf %s "$d")
# shellcheck source=lib/fmt.sh
. "${d%/*}/lib/fmt.sh" 2>/dev/null || exit 0
agent="#{?$COCKPIT_NOT_POPUP,#{m/i:*|#{b:pane_current_command}|*,#{@cockpit_agents_glob}},0}"

# Worst state in the window: needs-input > error > running > done > idle ("A" = agent with no state).
fmt_state="#{?#{m:*needs-input*,#{P:#{?$agent,#{@panestate},} }},needs-input,#{?#{m:*error*,#{P:#{?$agent,#{@panestate},} }},error,#{?#{m:*running*,#{P:#{?$agent,#{@panestate},} }},running,#{?#{m:*done*,#{P:#{?$agent,#{@panestate},} }},done,#{?#{m:*A*,#{P:#{?$agent,A,}}},idle,}}}}}"
# An agent in the window holds an unread review: the tab's ◆. 1 or empty, as stored.
fmt_review="#{?#{m:*pending*,#{P:#{?$agent,#{@cockpit_review},} }},1,}"

# Counts of agents waiting (nb) and failed (ne) in this session and in every session.
# The bar's "elsewhere" mark is fleet minus session, so no redraw walks the sessions.
fmt_snb="#{n:#{W:#{P:#{?#{==:#{@panestate},needs-input},#{?$agent,x,},}}}}"
fmt_sne="#{n:#{W:#{P:#{?#{==:#{@panestate},error},#{?$agent,x,},}}}}"
fmt_nb="#{n:#{S:#{W:#{P:#{?#{==:#{@panestate},needs-input},#{?$agent,x,},}}}}}"
fmt_ne="#{n:#{S:#{W:#{P:#{?#{==:#{@panestate},error},#{?$agent,x,},}}}}}"
fmt_nr="#{n:#{S:#{W:#{P:#{?#{==:#{@cockpit_review},pending},#{?$agent,x,},}}}}}"

# Theme slots, not hex: the colours follow each client's light or dark theme. Spaces,
# not commas, inside #[]: a comma would end the #{?} branch.
# ▲ and ✕ read the counts fleet_sums writes just before the fleet: they walk no pane, where
# each walked every pane twice.
fnb='#{@cockpit_fleet_nb}' fne='#{@cockpit_fleet_ne}'
fmt_fleet="#{?#{e|>:$fnb,0},#[fg=themered bold]▲$fnb#[default] ,}"
fmt_fleet="$fmt_fleet#{?#{e|>:$fne,0},#[fg=themecyan]✕$fne#[default] ,}"
fmt_fleet="$fmt_fleet#{?#{e|>:$fmt_nr,0},#[fg=thememagenta]◆$fmt_nr#[default] ,}"
# ✦N, last: background subagents running, the sum of every agent pane's @cockpit_subs (#R
# repeats a mark N times, #n counts them). Touch mode is a client's, so its test is stored
# escaped (##{ #, #}) and runs when the bar draws #{E:@cockpit_fleet}.
fmt_ns="#{n:#{S:#{W:#{P:#{?$agent,#{R:x,#{@cockpit_subs}},}}}}}"
fmt_fleet="$fmt_fleet#{?#{e|>:$fmt_ns,0},##{?##{E:@cockpit_is_touch#}#,#,#[fg=themeyellow]✦$fmt_ns#[default] #},}"

# The gauge cells the bar's tab budget takes off (see agent-context).
fmt_cells='#{n:#{W:#{?#{E:@cockpit_ctx_on},xx#{@panestate_ctx}x,}}}'

# The formats live in global options, written once per version of them: inlined in
# every clause, a sweep of a few windows passed tmux's 16 KB command limit.
fmts=(state "$fmt_state" review "$fmt_review" snb "$fmt_snb" sne "$fmt_sne"
      nb "$fmt_nb" ne "$fmt_ne" fleet "$fmt_fleet" cells "$fmt_cells")
stamp=$(printf '%s' "${fmts[*]}" | cksum); stamp=${stamp%% *}
# A test whose cut (see put) must not skip the work reads 1 only when nothing is to do, and
# the work is its else branch.
defs="if -F '#{?#{==:#{@cockpit_fmt_v},$stamp},1,0}' {} {"
for ((k = 0; k < ${#fmts[@]}; k += 2)); do
    defs="$defs set-option -g @cockpit_fmt_${fmts[k]} '${fmts[k + 1]}' ;"
done
defs="$defs set-option -g @cockpit_fmt_v $stamp }"

# put <scope> <option> <fmt name> [e]: <option> on target $T becomes the expansion of
# @cockpit_fmt_<fmt name>, or is unset when that is empty in window scope; e compares as
# numbers (unset reads 0). Written only when it differs: even an identical set redraws.
# tmux 3.7+ cuts a format that runs past 100 ms of wall time from that point on (#707): each
# later expansion reads "". A server descheduled mid-compare on a loaded box read two empty
# strings as equal and kept a stale count, or wrote a cut value. So the test reads 1 only
# when the compare is equal and whole: a cut before the 1 is expanded leaves it empty, and
# the cut never lifts. Anything but 1 writes, in the else branch. A write is tested again
# and made once more if that fails, so a cut costs one more write; only two in a hook stay.
put() {
    local test set
    test="#{?#{${4:+e|}==:#{E:@cockpit_fmt_$3},#{$2}},1,0}"
    set="set $1F -t $T $2 '#{E:@cockpit_fmt_$3}'"
    [ "$1" = -w ] && set="if -F -t $T '#{E:@cockpit_fmt_$3}' { $set } { set -wu -t $T $2 }"
    body="$body ; if -F -t $T '$test' {} { $set ; if -F -t $T '$test' {} { $set } }"
}
# Only closed-set values reach these strings.
win_sums() { put -w @cockpit_win_state state; put -w @cockpit_win_review review; }
sess_sums() {
    put - @cockpit_sess_nb snb; put - @cockpit_sess_ne sne
    # e: an unset sum reads 0, so a session with no gauge is never written.
    put - @cockpit_ctx_all cells e
}
fleet_sums() {
    put -g @cockpit_fleet_nb nb; put -g @cockpit_fleet_ne ne; put -gq @cockpit_fleet fleet
}

# sweep: every window, session and the fleet, from the hooks for what moves or ends
# panes without a transition (move-window, kill-pane, a pane exiting, a session closing).
# Per event, never per redraw; sent in batches under 12 KB (tmux refuses a command
# over 16 KB), and a refused batch is an error, not silence.
# With a seq (the hooks', #258) it is debounced: a burst of N events (a resurrect
# restore, kill-session) ran N full sweeps, O(N²) in the windows. Each event's sweep
# pauses, then walks only if no newer event bumped @cockpit_sweep_seq meanwhile; the
# newest one always walks, after the last event. No lock: a sweep that dies leaves the
# counts stale until the next event, never stuck. No seq (the load): at once.
if [ "$state" = sweep ]; then
    w="" batch="" rc=0 only=""
    case "${2:-}" in
        ''|*[!0-9]*) ;;
        *) sleep 0.2; only="#{==:#{@cockpit_sweep_seq},$2}" ;;
    esac
    flush() {
        [ -n "$batch" ] || return 0
        tmux if-shell -F 1 "${batch# ; }" || rc=1
        batch=""
    }
    add() {                   # one clause, a new batch when this one would pass 12 KB
        [ $(( ${#batch} + ${#body} )) -lt 12000 ] || flush
        batch="$batch$body"
    }
    body=" ; $defs"; add
    # No server means no windows: nothing to sweep, quietly. A superseded sweep lists
    # none either: the seq test rides in this call, so it costs no fork of its own.
    fw='#{window_id}'; [ -z "$only" ] || fw="#{?$only,$fw,}"
    for w in $(tmux list-windows -a -F "$fw" 2>/dev/null); do T=$w; body=""; win_sums; add; done
    [ -n "$w" ] || exit 0
    # Quoted: tmux's parser leaves $<digit> alone today, and the id need not rely on it.
    for s in $(tmux list-sessions -F '#{session_id}' 2>/dev/null); do T="'$s'"; body=""; sess_sums; add; done
    T=$w; body=""; fleet_sums; add
    flush
    # The one poller per server (#448): the load and every window or pane change make sure it
    # runs. Only a sweep that walked (a superseded one exited above), so a burst starts one.
    d=${BASH_SOURCE[0]}; case $d in (*/*) ;; (*) d=./$d ;; esac
    [ -L "$d" ] && d=$(n=0
        while [ -L "$d" ] && [ $((n += 1)) -le 40 ] && t=$(readlink "$d"); do
            case $t in (/*) d=$t ;; (*) d=${d%/*}/$t ;; esac; done; printf %s "$d")
    # shellcheck source=lib/hook.sh
    if . "${d%/*}/lib/hook.sh" 2>/dev/null; then ensure_poller "${d%/*}"; fi
    exit "$rc"
fi

idle=""
# An agent-view background worker has no pane: its front end relays what matters. Already
# true of the empty-pane exit below; stated first so it does not depend on that guard.
[ -z "$pane" ] && [ "${CLAUDE_CODE_SESSION_KIND:-}" = bg ] && exit 0
# -t prefix-matches session names too, so anything but a %N id could hit another pane.
case "$pane" in
    %[0-9]*) ;;
    *) exit 0 ;;
esac

# subs_cmd <- the tmux command for @cockpit_subs <- SUBS, compare-then-set, and the fleet's
# ✦ sum with it: a Stop that holds the pane, or meets a sticky state, writes no state and so
# runs no sums of its own. Only digits reach the formats. A Stop that holds runs it alone;
# any other rides in the one invocation below, so done still costs one tmux call.
subs_cmd=()
subs_build() {
    local cond body T
    if [ "$SUBS" -gt 0 ]; then
        cond="#{!=:#{@cockpit_subs},$SUBS}" body="set-option -p -t $pane @cockpit_subs $SUBS"
    else
        cond='#{@cockpit_subs}' body="set-option -pu -t $pane @cockpit_subs"
    fi
    T=$pane body="$body ; $defs"
    fleet_sums
    subs_cmd=(if-shell -F -t "$pane" "$cond" "$body")
}

# safe_word <text> <cap> -> REPLY: the run of [A-Za-z0-9._-] that starts <text>, at most <cap>
# bytes. Nothing else ever leaves it: the text is untrusted and lands in a tmux option the bar
# and board print. The letters are spelled out, not a range: a range follows the locale.
al=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789
safe_word() {
    local w=${1%%[!"$al"._-]*}
    REPLY=${w:0:$2}
}
# whole_word <key> -> REPLY: the payload's own "<key>" string, only when it is whole and comes
# before "tool_input": one cut by a cap or an escape names nothing, and so does one inside the
# tool's input, which may hold the same key (#1403). The key is matched with its quotes, so text
# inside a string, where the quotes arrive escaped, cannot match. Then safe_word, 64 bytes at
# most.
whole_word() {
    local LC_ALL=C re="\"$1\": ?\"([^\"\\\\]*)\"" s=${payload%%\"tool_input\"*}
    REPLY=""; [[ $s =~ $re ]] && safe_word "${BASH_REMATCH[1]}" 64
}
# agent_key -> REPLY: the payload's own agent_id, read before "tool_input" (a main-thread call
# has none of its own, and its input may hold one, #1403) by subs_id's rule in lib/subslog.sh:
# the whole id or none, never a cut one, which two agents of one long label share (#1487).
# Empty on the main thread. Status 1 when the payload names an agent whose id subs_id refuses:
# that id names no ask.
agent_key() {
    local payload=${payload%%\"tool_input\"*}
    subs_id agent_id
    [ -n "$REPLY" ] || [[ $payload != *'"agent_id":'* ]]
}
# call_key -> ask_when, the test a tool event passes to end a waiting ask that has a key
# (#1403). PostToolUse and PostToolUseFailure need the ask's agent and tool. PreToolUse needs
# its agent only: the next call after an ask the person refused, which fires no hook of its
# own. SubagentStart never passes, and neither does a tool event of a refused agent id
# (#1487). Empty for any other event, which follows the old rule.
call_key() {
    ask_when=""
    agent_key; local known=$? a=$REPLY
    if is_event PreToolUse; then ask_when="#{m:$a/*,#{@panestate_ask}}"
    elif is_event SubagentStart; then ask_when=0
    elif is_event PostToolUse || is_event PostToolUseFailure; then
        whole_word tool_name; ask_when="#{==:#{@panestate_ask},$a/$REPLY}"
    fi
    [ "$known" = 0 ] || [ -z "$ask_when" ] || ask_when=0
}
# prog_name <- the program a Bash tool_input's command runs: its first word, path dropped, 32
# at most, and only when that whole word is [A-Za-z0-9._/+-]. Anything else names no program,
# and the ask reads plain "Bash": a word with `=`, a quote, `(`, `;` or `$` may carry a
# value, an argument or a path, and the board shows it to anyone at the screen (#1330). So
# `FOO=1 git` names none either (#1334: skipping NAME=value leaked a value three times).
# JSON's \n, \t and \r are blanks. A word cut by the 4 KB cap is cut short, no more.
prog_name() {
    local LC_ALL=C s w re='"command": ?"([^"]*)'
    REPLY=""
    s=${payload#*\"tool_input\"}
    [ "$s" != "$payload" ] && [[ $s =~ $re ]] || return 0
    s=${BASH_REMATCH[1]}; s=${s//\\[ntr]/ }
    s=${s#"${s%%[! $'\t']*}"}; w=${s%%[ $'\t']*}
    case $w in ''|*[!"$al"._/+-]*) return 0 ;; esac
    w=${w##*/}; REPLY=${w:0:32}
}

is_event() { case "$payload" in *"\"hook_event_name\":\"$1\""*) return 0 ;;
    *"\"hook_event_name\": \"$1\""*) return 0 ;; esac; return 1; }

case "$state" in
needs-input|error)
    # PermissionRequest names the tool (#1330), and PostToolUseFailure, which runs error as
    # StopFailure does, is its tool's end (#1331). The poller has no payload, and a terminal
    # is a person typing the command.
    [ -z "$poll" ] && [ ! -t 0 ] || state_only=1
    # $d is the script's own path, resolved once at the top: nothing on this path reassigns it.
    # agent_key's subs_id is lib/subslog.sh's (#1487). A load that fails reads no payload, as
    # one of hook.sh does.
    # shellcheck source=lib/subslog.sh
    [ -n "${state_only:-}" ] || . "${d%/*}/lib/subslog.sh" 2>/dev/null || state_only=1
    # shellcheck source=lib/hook.sh
    if [ -n "${state_only:-}" ]; then :
    elif ! . "${d%/*}/lib/hook.sh" 2>/dev/null; then :
    elif [ "$state" = needs-input ]; then
        # The tool name and the command's head come before the rest of tool_input, which can
        # be a whole file: 4 KB is read, no more.
        read_capped 4096 true
        if is_event PermissionRequest; then
            whole_word tool_name; tool=$REPLY msg=$REPLY
            if [ "$msg" = Bash ]; then prog_name; [ -z "$REPLY" ] || msg="Bash: $REPLY"; fi
            # Before the sticky guard, as notify writes: a pane already waiting can be asked
            # again. Argv, not a format. No tool, no text, so notify's ask stays. The same call
            # keeps the ask's key, <agent_id>/<tool_name> with no agent on the main thread: only
            # a call of that agent ends it (#1403, call_key). An ask that names no tool has no
            # key, and any running ends it. So does the ask of an agent whose id subs_id refuses
            # (#1487, agent_key), which still names its tool. The key goes first: a cut option
            # name ends the list there (#1450), and a cut on the text's name must not take the
            # key with it.
            if [ -z "$tool" ]; then
                tmux set-option -pu -t "$pane" @panestate_ask 2>/dev/null
            elif agent_key; then
                tmux set-option -p -t "$pane" @panestate_ask "$REPLY/$tool" ';' \
                    set-option -p -t "$pane" @panestate_msg "$msg" 2>/dev/null
            else
                tmux set-option -pu -t "$pane" @panestate_ask ';' \
                    set-option -p -t "$pane" @panestate_msg "$msg" 2>/dev/null
            fi
        fi
    else
        # 4 KB, as above: bash reads a pipe a byte per syscall, and a failed Write's tool_input
        # can be a whole file, which held the hook 2 s (#1334). is_interrupt comes after
        # tool_input and the error text: past the cap it is not seen.
        read_capped 4096 true
        if is_event PostToolUseFailure; then
            # A tool the person stopped (Esc) did not fail.
            case "$payload" in *'"is_interrupt":true'*|*'"is_interrupt": true'*) exit 0 ;; esac
            # A tool's failure is not the turn's (#1331): it ends the tool as PostToolUse
            # does, and answers an approved ask (#1341). Only StopFailure stays error.
            state=running
            call_key
        fi
    fi
    ;;
running)
    # A tool event names its agent and tool: while an ask with a key waits, only a call of the
    # agent that asked ends it (#1403, call_key). Other agents and parallel calls fire tool
    # hooks all the while. 4 KB, as above: the keys come before tool_input. The poller has no
    # payload, and a terminal is a person typing the command. A caller with no payload of its
    # own hands it /dev/null (cockpit-event, review-gate): an open stdin holds the read 2 s.
    # shellcheck source=lib/hook.sh
    if [ -z "$poll" ] && [ ! -t 0 ] && . "${d%/*}/lib/hook.sh" 2>/dev/null; then
        read_capped 4096 true
        # agent_key's subs_id is lib/subslog.sh's (#1487). A load that fails keys no call, as
        # one of hook.sh does.
        # shellcheck source=lib/subslog.sh
        . "${d%/*}/lib/subslog.sh" 2>/dev/null && call_key
    fi
    ;;
notify)
    # ESC-cancel fires no hook at all; the idle Notification is the only way out of running.
    d=${BASH_SOURCE[0]}; case $d in (*/*) ;; (*) d=./$d ;; esac
    [ -L "$d" ] && d=$(n=0
        while [ -L "$d" ] && [ $((n += 1)) -le 40 ] && t=$(readlink "$d"); do
            case $t in (/*) d=$t ;; (*) d=${d%/*}/$t ;; esac; done; printf %s "$d")
    # shellcheck source=lib/hook.sh
    . "${d%/*}/lib/hook.sh" 2>/dev/null || exit 0
    read_payload false
    # The English text match covers Claude versions that send no notification_type.
    json_str notification_type; ntype=$REPLY
    case "$REPLY" in
        permission_prompt|elicitation_dialog) state=needs-input ;;
        # The front end relays these for an agent view (#174): the pane is then the poller's.
        agent_needs_input) state=needs-input view=1 ;;
        agent_completed) view=1 ;;
        idle_prompt) state=off idle=1 ;;
        '') case "$payload" in
                *'waiting for your input'*) state=off idle=1 ;;
                *'needs your permission'*) state=needs-input ;;
                *) exit 0 ;;
            esac ;;
        *) exit 0 ;;
    esac
    if [ -n "$view" ]; then
        mark_agentview "$pane" "${d%/*}"
        # No state of its own: the poller reads the sessions and writes the pane.
        [ "$state" = notify ] && exit 0
    fi
    # Written here, not after the sticky guard below: a pane already on needs-input
    # can be asked something new, and that newer text must still land.
    # A permission_prompt follows its PermissionRequest about 6 s later (#1330): a pane already
    # waiting with an ask keeps that hook's text, which names the tool. Any other state's text
    # gives way. One read; a cut one reads no 1 and writes, as before.
    keep=""
    if [ "$ntype" = permission_prompt ]; then
        keep=$(tmux display-message -p -t "$pane" \
            '#{?#{&&:#{==:#{@panestate},needs-input},#{@panestate_msg}},1,0}' 2>/dev/null)
    fi
    if [ "$state" = needs-input ] && [ "$keep" != 1 ]; then
        json_str message
        # Untrusted text bound for a tmux format: strip control chars and cap it.
        msg=${REPLY//[$'\001'-$'\037']/}
        msg=${msg:0:120}
        # A call of its own, never in the batch: tmux splits a command list on a bare `;`.
        if [ -n "$msg" ]; then
            tmux set-option -p -t "$pane" @panestate_msg "$msg" 2>/dev/null
        else
            tmux set-option -pu -t "$pane" @panestate_msg 2>/dev/null
        fi
    fi
    ;;
session)
    # SessionStart and UserPromptSubmit carry the session's identity (#302): the reader is
    # then right from turn 1 and after /clear or --resume, before any Stop. They and
    # CwdChanged carry its cwd, the tree the board shows (#312). No state change. Every value
    # is untrusted: each is checked, then set with `set-option -p` (no format expansion) in a
    # call of its own. last_assistant_message is free text: never stored.
    d=${BASH_SOURCE[0]}; case $d in (*/*) ;; (*) d=./$d ;; esac
    [ -L "$d" ] && d=$(n=0
        while [ -L "$d" ] && [ $((n += 1)) -le 40 ] && t=$(readlink "$d"); do
            case $t in (/*) d=$t ;; (*) d=${d%/*}/$t ;; esac; done; printf %s "$d")
    # shellcheck source=lib/hook.sh
    . "${d%/*}/lib/hook.sh" 2>/dev/null || exit 0
    # shellcheck source=lib/claudedir.sh
    . "${d%/*}/lib/claudedir.sh" 2>/dev/null || exit 0
    # A capped read, not read_payload: the UserPromptSubmit payload carries the whole prompt,
    # and bash reads a pipe a byte at a time. The ids come first in what claude sends; one
    # that falls past the cap is skipped (the old value stays). Ends early on all three keys.
    has() { case "$payload" in *"\"$1\""*) return 0 ;; esac; return 1; }
    have_ids() { has session_id && has transcript_path && has cwd; }
    read_capped 4096 have_ids
    # A value cut by the cap fails the UUID test or names no file, so it is never saved.
    json_str session_id; sid=$REPLY
    json_str transcript_path; tp=$REPLY
    # CwdChanged's new_cwd, else the cwd every event carries (#312). Only a whole JSON string:
    # one cut by the cap has no closing quote, and its prefix may well be a real directory.
    json_whole() {            # <key> -> REPLY, the string value; empty when not one
        local LC_ALL=C re="\"$1\": ?\"([^\"\\\\]*)\""
        REPLY=""; [[ $payload =~ $re ]] && REPLY=${BASH_REMATCH[1]}
    }
    json_whole new_cwd; dir=$REPLY; [ -n "$dir" ] || { json_whole cwd; dir=$REPLY; }
    # Absolute, no control char (a newline would split the board's row), an existing directory.
    case "$dir" in /*) ;; *) dir="" ;; esac
    case "$dir" in *[$'\001'-$'\037\177']*) dir="" ;; esac
    [ -n "$dir" ] && [ ! -d "$dir" ] && dir=""
    # One read: the session saved before, the cwd the hooks saw last, the dir, and whether the
    # dir as found at the session's start is recorded (0 or 1, see below). A #707 cut empties
    # every expansion after it, so the record test goes last: read whole, it vouches for every
    # field before it. Anything else (a cut, no pane) writes nothing; the next hook does.
    # Parsed from the right first, since a hand-set dir may hold any byte.
    us=$'\037' f="#{@cockpit_session}"
    f+="$us#{@cockpit_cwd}$us#{@cockpit_dir}$us#{?#{@cockpit_dir_before},1,0}"
    had=$(tmux display-message -p -t "$pane" "$f" 2>/dev/null)
    rec=${had##*"$us"} rest=${had%"$us"*}
    case "$rec" in 0|1) ;; *) exit 0 ;; esac
    cur=${rest%%"$us"*} rest=${rest#*"$us"}
    seen=${rest%%"$us"*} was=${rest#*"$us"}
    # @cockpit_dir_before (#323): the dir as this session found it, which SessionEnd's `off`
    # puts back. Written once, by the first hook with none, so later writes never move it;
    # SessionEnd's `off` drops it. "=" + the value, so an empty dir is a record too: a format
    # reads an unset option and an empty one alike.
    if [ "$rec" = 0 ]; then
        arg="=$was"; case "$arg" in *\;) arg="${arg%;}\\;" ;; esac
        tmux set-option -p -t "$pane" @cockpit_dir_before "$arg" 2>/dev/null
    fi
    # Past the record test: $cur is from a whole read.
    new=""
    save_session "$pane" "$sid" "$cur" && new=1
    # @cockpit_dir is written when the agent moved or a new session began, not on every prompt:
    # an agent driving a hand-made worktree with `git -C` sets it itself (docs/review.md), and
    # that holds until it cds or the session ends (#323). tmux takes an argument's trailing `;`
    # for a separator; `\;` is a literal one.
    if [ -n "$dir" ] && { [ "$dir" != "$seen" ] || [ -n "$new" ]; }; then
        arg=$dir; case "$arg" in *\;) arg="${arg%;}\\;" ;; esac
        tmux set-option -p -t "$pane" @cockpit_dir "$arg" 2>/dev/null
        tmux set-option -p -t "$pane" @cockpit_cwd "$arg" 2>/dev/null
    fi
    # Only a regular file inside the projects tree, symlinks and `..` resolved. '#' never
    # appears in a real one (claude turns it into '-'), so it is refused outright, in the
    # path given and in the path it resolves to.
    claude_cfg_dir
    root=$claude_cfg/projects
    odd() { case "/$1/" in */../*|*'#'*|*[$'\001'-$'\037\177']*|*\\*) return 0 ;; esac; return 1; }
    if [ -n "$tp" ] && [ -n "${HOME:-}" ] && command -v realpath >/dev/null 2>&1; then
        case "$tp" in /*) odd "$tp" && tp="" ;; *) tp="" ;; esac
        if [ -n "$tp" ]; then
            tp=$(realpath -- "$tp" 2>/dev/null) && root=$(realpath -- "$root" 2>/dev/null) || tp=""
        fi
        if [ -n "$tp" ] && ! odd "$tp" && [ -f "$tp" ]; then
            case "$tp" in "$root"/*) tmux set-option -p -t "$pane" @cockpit_transcript "$tp" 2>/dev/null ;; esac
        fi
    fi
    exit 0
    ;;
wake)
    # TeammateIdle wakes the lead with no hook of its own, so lift done back to running.
    ;;
done)
    # A Stop while background subagents run ends the turn, not the work (#310): claude wakes
    # the session as each reports back, and the last report-back turn's Stop writes done.
    # No state is written meanwhile, so sticky states and the counters stay as they are; the
    # count is (#313). The poller has no payload, and a terminal is a person typing the command.
    # The read and the count are lib/hook.sh's, shared with review-gate (#315). A read that
    # fails counts 0: the Stop fails open to done (#320).
    # 10 s, not 2 (#743): a 1 MB payload through a 64 KiB pipe on a loaded box, or a writer
    # that pauses, can take past 2 s and showed done with subagents in flight. A bound on
    # progress instead cost a temp file and three more processes on every Stop, and failed a
    # single long pause that this one reads. The cost: a writer that never ends holds 10 s.
    if [ -z "$poll" ] && [ ! -t 0 ]; then
        SUBS=0
        # $d is the script's own path, resolved once at the top.
        # shellcheck source=lib/hook.sh
        if . "${d%/*}/lib/hook.sh" 2>/dev/null && read_stop 10; then subs_count; fi
        subs_build
        if [ "$SUBS" -gt 0 ]; then tmux "${subs_cmd[@]}" 2>/dev/null; exit 0; fi
    fi
    ;;
esac

# `when` guards the transition on the current @panestate. needs-input and error, a failed
# turn's (#1331), are sticky against Stop/idle; an unchanged state is refused: a set redraws.
cur='#{@panestate}'
case "$state" in
    # A waiting ask with a key ends only on a call of the agent that asked it (#1403, call_key).
    running)     when="#{!=:$cur,running}"
                 [ -z "${ask_when:-}" ] ||
                     when="#{?#{&&:#{==:$cur,needs-input},#{@panestate_ask}},$ask_when,$when}" ;;
    needs-input) when="#{!=:$cur,needs-input}" ;;
    error)       when="#{?#{m/r:^(error|needs-input)\$,$cur},0,1}" ;;
    done)        when="#{?#{m/r:^(done|needs-input|error)\$,$cur},0,1}" ;;
    wake)        when="#{?$cur,#{==:$cur,done},1}" ;;
    # Claude goes idle while blocked on a prompt too, so idle must not clear an alert.
    off)         when=1
                 [ -n "$idle" ] && when="#{?#{m/r:^(done|needs-input|error)\$,$cur},0,1}" ;;
    # An interrupted turn (#1330): from any state, sticky ones too, with off's idle body below,
    # so the review marks and the subagent count stay.
    interrupted) when=1 idle=1 ;;
    # An ask that ended with no answer (#1332): Esc on a permission prompt ends the main turn
    # and fires no Stop. Only over needs-input whose key is the main thread's, /<tool> (#1403),
    # then with interrupted's idle body. An ask with no key has no known owner, and stays.
    input-ended) when="#{&&:#{==:$cur,needs-input},#{m:/*,#{@panestate_ask}}}"
                 state=interrupted idle=1 ;;
    recount)     when=1 ;;
    *) exit 0 ;;
esac

if [ -n "$poll" ]; then
    # compare-then-set only: every set redraws, and nothing is sticky for the poller.
    case "$state" in
        off) when="#{?$cur,1,0}"; idle=1 ;;
        *)   when="#{!=:$cur,$state}" ;;
    esac
    # The ask is untrusted text for a tmux option: strip control chars, cap it, and write it
    # in a call of its own (a bare `;` argument splits a command list). Read first so an
    # unchanged ask costs no redraw.
    if [ "$state" = needs-input ]; then
        msg=${4:-}; msg=${msg//[$'\001'-$'\037']/}; msg=${msg:0:120}
        have=$(tmux show-option -pqv -t "$pane" @panestate_msg 2>/dev/null)
        if [ -n "$msg" ] && [ "$have" != "$msg" ]; then
            tmux set-option -p -t "$pane" @panestate_msg "$msg" 2>/dev/null
        fi
    fi
fi

# Each set at the top of the body's list, and of unmark's below, carries -q (#1450). tmux expands
# an option's name as a format, and a #707 cut reads it as "": the set fails, and without -q that
# failure drops the rest of the list, the sums and the boards' wake with it, or the transition.
# With -q only that set is lost. A cut on @panestate's own name keeps the old state, until the
# pane's next event.
if [ "$state" = off ] || [ "$state" = interrupted ]; then
    # No early exit when already clear: a fresh agent's SessionStart must still light its ○ dot.
    body="if -F -t $pane '#{?$cur,0,1}' {} { set-option -pu -t $pane @panestate }"
    # An ended session takes its review marks with it; an idle one keeps them. And its subagent
    # count (#313): SessionStart's off is a new process, which runs none. Not at idle: the lead
    # idles while its subagents work, and a report-back's UserPromptSubmit leaves the others.
    [ -n "$idle" ] || body="$body ; set-option -pqu -t $pane @cockpit_review ; set-option -pqu -t $pane @cockpit_review_spool ; set-option -pqu -t $pane @cockpit_subs"
elif [ "$state" = recount ]; then
    body=""
else
    [ "$state" = wake ] && state=running
    body="set-option -pq -t $pane @panestate $state"
    # Entering running means the human pressed Enter, so a delivered-but-unsent review is gone.
    # Not on wake: nobody pressed Enter.
    [ "$state" = running ] && [ "$1" != wake ] && [ -z "$poll" ] \
        && body="$body ; set-option -pqu -t $pane @cockpit_review"
fi

# @panestate_since (#225): the epoch second the pane entered needs-input, for tm's "waiting
# Nm" and its longest-waiting-first order. Written here only, inside `when`: needs-input's
# guard refuses an unchanged state, so a pane that stays waiting keeps its first stamp. Any
# other transition clears it. Wall clock, the one clock a reader in another process shares
# (tmux's own activity times are epochs too); the reader counts a stamp from the future as 0.
# A builtin first, so bash 4.2+ forks nothing; macOS's bash 3.2 pays one `date`.
if [ "$state" = needs-input ]; then
    now=${EPOCHSECONDS:-}
    [ -n "$now" ] || printf -v now '%(%s)T' -1 2>/dev/null
    case "$now" in ''|*[!0-9]*) now=$(date +%s 2>/dev/null) ;; esac
    case "$now" in ''|*[!0-9]*) ;; *) body="$body ; set-option -pq -t $pane @panestate_since $now" ;; esac
elif [ "$state" != recount ]; then
    body="$body ; if -F -t $pane '#{?#{@panestate_since},0,1}' {}"
    body="$body { set-option -pu -t $pane @panestate_since }"
fi

case "$state" in
    # The ask's text goes, and its key (#1403) with it.
    running|off|interrupted) body="$body ; set-option -pqu -t $pane @panestate_msg"
                             body="$body ; set-option -pqu -t $pane @panestate_ask" ;;
    # The poller's done/error follow a needs-input whose ask would otherwise stay.
    done|error) [ -z "$poll" ] || { body="$body ; set-option -pqu -t $pane @panestate_msg"
                                    body="$body ; set-option -pqu -t $pane @panestate_ask"; } ;;
esac

# A hook of this pane's own session (TMUX_PANE is its pane) that is not an agent view's relayed
# notification means the pane is a plain session again: the mark from an earlier agent-view
# visit would have the poller overwrite its states every tick (#174). The same invocation, and
# outside `when`, so a pane that is already in the state still loses it.
# It is a foreground session's pane too (#448): @cockpit_fg, the epoch second of its last state
# change, tells agent-poll not to bind it to a background job of the same name, which would
# overwrite what these hooks write. The poller binds it only to a job that started after that
# second: the session itself, sent to the background with the left arrow (no hook says so).
# Set when the pane has none (with any bind it had), refreshed with each state change, inside
# `when`. The session's end (SessionEnd runs `off`) takes it away: the pane may show a job
# next. The event is read from the payload, a builtin read capped at 4 KB. Without a builtin
# clock the value is one that no job starts after.
fgown="" ended="" payload="" fgnow=""
if [ -z "$poll" ] && [ -z "$view" ] && [ "$pane" = "${TMUX_PANE:-}" ]; then
    fgown=1
    if [ "${1:-off}" = off ] && [ ! -t 0 ]; then
        IFS= read -r -t 2 -n 4096 payload 2>/dev/null
        case "$payload" in *'"hook_event_name":"SessionEnd"'*|*'"hook_event_name": "SessionEnd"'*)
            ended=1 ;; esac
    fi
    fgnow=${EPOCHSECONDS:-}
    [ -n "$fgnow" ] || printf -v fgnow '%(%s)T' -1 2>/dev/null
    case "$fgnow" in ''|*[!0-9]*) fgnow=9999999999 ;; esac
    [ -n "$ended" ] || body="$body ; set-option -pq -t $pane @cockpit_fg $fgnow"
fi

T=$pane
body="$body ; $defs"
win_sums; sess_sums; fleet_sums
# Wake every running board: each lists `wait-for -S <its channel> ; ` in @cockpit_board_wake
# (tui/src/push.rs), and run-shell -C runs that list inside this call. No board, an empty list.
body="$body ; run-shell -C '#{@cockpit_board_wake}'"
# Fail-open: a hook must never block the agent that fired it.
unmark=()
if [ -n "$fgown" ]; then
    fgset="set-option -p -t $pane @cockpit_fg $fgnow"
    for o in job job_name job_state job_session; do
        fgset="$fgset ; set-option -pu -t $pane @cockpit_$o"
    done
    fgcond='#{?#{@cockpit_fg},0,1}'
    [ -z "$ended" ] || { fgset="set-option -pu -t $pane @cockpit_fg"; fgcond='#{@cockpit_fg}'; }
    unmark=(if-shell -F -t "$pane" '#{@cockpit_agentview}' \
        "set-option -pu -t $pane @cockpit_agentview" ';'
        if-shell -F -t "$pane" "$fgcond" "$fgset" ';')
    # The config dir this session's claude uses, from the hook's own env, in this same call: a
    # pane the poller may bind is polled against that dir's agents (#194). Argv, escaped by
    # cfg_arg for tmux's own parse; one it refuses is not recorded, so the pane is the default
    # dir's, and said (#685). With Claude Code's env scrub on it sees none, and says so; a hook
    # that sees the scrub off or a dir takes that message back (#1429, scrub_note).
    cfgarg="" scrub=""
    # $d is the script's own path, resolved once at the top.
    # shellcheck source=lib/hook.sh
    if . "${d%/*}/lib/hook.sh" 2>/dev/null; then
        scrub_note; scrub=1
        [ -z "${CLAUDE_CONFIG_DIR:-}" ] || cfgarg=$(cfg_arg "$CLAUDE_CONFIG_DIR") || cfgarg=""
    fi
    if [ -n "$cfgarg" ]; then
        unmark+=(set-option -pq -t "$pane" @cockpit_cfg "$cfgarg" ';'
            set-option -gq @cockpit_cfg_any 1 ';')
    else
        unmark+=(set-option -pqu -t "$pane" @cockpit_cfg ';')
        [ -z "${CLAUDE_CONFIG_DIR:-}" ] \
            || unmark+=(set-option -gq @cockpit_poll_err "${CFG_BAD:-}" ';')
    fi
    [ -z "$scrub" ] || unmark+=(if-shell -F -t "$pane" "$SCRUB_IF" "$SCRUB_DO" ';')
fi
# The session's end puts @cockpit_dir back to the value `session` recorded at its start (#323):
# what the hooks and the agent set goes, a dir set by hand before the agent started stays.
# @cockpit_cwd and the record go with it, in this same call. Only at SessionEnd, read from the
# payload: `off` also runs at SessionStart. Not when the reason is clear or resume: a new
# session follows in this pane at once, and nothing makes this hook finish before that
# session's first hook writes, so a restore could land after it. The reasons are clear, resume,
# logout, prompt_input_exit and other (https://code.claude.com/docs/en/hooks, SessionEnd).
# The record stays, and that session's end puts it back. The record is read as a value, not
# a format, so no #707 cut can write a cut value. With no record (a session begun before
# #323), the hooks' rule: they write the dir and @cockpit_cwd together, so a dir that differs
# from the cwd stays; that test reads 1 only when whole.
if [ -n "$ended" ]; then
    case "$payload" in
    *'"reason":"clear"'*|*'"reason": "clear"'*|*'"reason":"resume"'*|*'"reason": "resume"'*) ;;
    *)
        before=$(tmux show-option -pqv -t "$pane" @cockpit_dir_before 2>/dev/null)
        case "$before" in
            =)  unmark+=(set-option -pqu -t "$pane" @cockpit_dir ';') ;;
            =*) arg=${before#=}; case "$arg" in *\;) arg="${arg%;}\\;" ;; esac
                unmark+=(set-option -pq -t "$pane" @cockpit_dir "$arg" ';') ;;
            *)  unmark+=(if-shell -F -t "$pane" '#{?#{==:#{@cockpit_dir},#{@cockpit_cwd}},1,0}'
                    "set-option -pu -t $pane @cockpit_dir" ';') ;;
        esac
        unmark+=(set-option -pqu -t "$pane" @cockpit_cwd ';'
            set-option -pqu -t "$pane" @cockpit_dir_before ';')
        ;;
    esac
fi
# The guard must not skip the transition on a cut either (see put). So it reads 1 only for a
# refusal read whole, which runs nothing and parses no body: the hooks that fire most
# (PreToolUse, PostToolUse) are refused. Anything else tests it again, in the else branch,
# and runs the body unless that reads a whole refusal. The body rides there as a quoted
# string, parsed once when it runs (in braces tmux parsed it twice).
# The cost: when both reads are cut, a refused transition runs. A Stop or idle then drops a
# sticky needs-input or error, another agent's tool call drops an ask (#1403), and a refused
# running clears @cockpit_review. Running only on a whole 1 the second time would fail closed
# there, but then one cut there skips a transition that is due, and one cut is far likelier
# than two; master skipped on one cut.
skip="#{?#{==:$when,1},0,1}"
# Escaped for tmux's double quotes; no body has any of the three today, so no pass is made.
q=${body# ; } bs=\\ dq='"' dl='$'
case $q in *[\\\"\$]*)
    q=${q//"$bs"/"$bs$bs"}; q=${q//"$dq"/"$bs$dq"}; q=${q//"$dl"/"$bs$dl"} ;;
esac
tmux ${unmark[@]+"${unmark[@]}"} ${subs_cmd[@]+"${subs_cmd[@]}" ';'} \
    if-shell -F -t "$pane" "$skip" "" "if -F -t $pane '$skip' '' \"$q\"" \
    >/dev/null 2>&1 || true
