#!/bin/bash
# Record a tmux pane's agent state in per-pane tmux options.
#   usage: agent-state <running|needs-input|error|done|off|notify|wake|recount> [pane-id]
# The pane defaults to $TMUX_PANE; tmux hooks have no TMUX_PANE, so they pass it.
# Every @panestate write must go through here, or the window/fleet counters go stale.
set -u

state="${1:-off}"
pane="${2:-${TMUX_PANE:-}}"
idle=""
# -t prefix-matches session names too, so anything but a %N id could hit another pane.
case "$pane" in
    %[0-9]*) ;;
    *) exit 0 ;;
esac

case "$state" in
notify)
    # ESC-cancel fires no hook at all; the idle Notification is the only way out of running.
    d=${BASH_SOURCE[0]}; [ -L "$d" ] && d=$(readlink "$d")
    # shellcheck source=lib/hook.sh
    . "${d%/*}/lib/hook.sh" 2>/dev/null || exit 0
    read_payload false
    # The English text match covers Claude versions that send no notification_type.
    json_str notification_type
    case "$REPLY" in
        permission_prompt|agent_needs_input|elicitation_dialog) state=needs-input ;;
        idle_prompt) state=off idle=1 ;;
        '') case "$payload" in
                *'waiting for your input'*) state=off idle=1 ;;
                *'needs your permission'*) state=needs-input ;;
                *) exit 0 ;;
            esac ;;
        *) exit 0 ;;
    esac
    # Written here, not after the sticky guard below: a pane already on needs-input
    # can be asked something new, and that newer text must still land.
    if [ "$state" = needs-input ]; then
        json_str message
        # Untrusted text bound for a tmux format: strip control chars and cap it.
        msg=${REPLY//[$'\001'-$'\037']/}
        msg=${msg:0:120}
        # A call of its own, never in the batch: tmux splits a command list on a bare `;`.
        if [ -n "$msg" ]; then
            tmux set-option -p -t "$pane" @panestate_msg "$msg" 2>/dev/null
        else
            tmux set-option -pu -t "$pane" @panestate_msg 2>/dev/null
        fi
    fi
    ;;
wake)
    # TeammateIdle wakes the lead with no hook of its own, so lift done back to running.
    ;;
esac

# `when` guards the transition on the current @panestate. needs-input and error are
# sticky against Stop/idle; an unchanged state is refused because every set redraws.
cur='#{@panestate}'
case "$state" in
    running)     when="#{!=:$cur,running}" ;;
    needs-input) when="#{!=:$cur,needs-input}" ;;
    error)       when="#{?#{m/r:^(error|needs-input)\$,$cur},0,1}" ;;
    done)        when="#{?#{m/r:^(done|needs-input|error)\$,$cur},0,1}" ;;
    wake)        when="#{?$cur,#{==:$cur,done},1}" ;;
    # Claude goes idle while blocked on a prompt too, so idle must not clear an alert.
    off)         when=1
                 [ -n "$idle" ] && when="#{?#{m/r:^(done|needs-input|error)\$,$cur},0,1}" ;;
    recount)     when=1 ;;
    *) exit 0 ;;
esac

if [ "$state" = off ]; then
    # No early exit when already clear: a fresh agent's SessionStart must still light its ○ dot.
    body="if -F -t $pane '$cur' { set-option -pu -t $pane @panestate }"
    # An ended session takes its review marks with it; an idle one keeps them.
    [ -n "$idle" ] || body="$body ; set-option -pu -t $pane @cockpit_review ; set-option -pu -t $pane @cockpit_review_spool"
elif [ "$state" = recount ]; then
    body=""
else
    [ "$state" = wake ] && state=running
    body="set-option -p -t $pane @panestate $state"
    # Entering running means the human pressed Enter, so a delivered-but-unsent review is gone.
    # Not on wake: nobody pressed Enter.
    [ "$state" = running ] && [ "$1" != wake ] && body="$body ; set-option -pu -t $pane @cockpit_review"
fi

case "$state" in
    running|off) body="$body ; set-option -pu -t $pane @panestate_msg" ;;
esac

# Window and fleet summaries are precomputed here so status redraws walk no panes
# (tmux#2774/#3352). They refresh only on a transition in that window.
fmt_needs='#{m:*needs-input*,#{P:#{?#{m:*|#{pane_current_command}|*,#{@cockpit_agents_glob}},#{@panestate},} }}'

# Worst state in the window: needs-input > error > running > done > idle ("A" = agent with no state).
fmt_state='#{?#{m:*needs-input*,#{P:#{?#{m:*|#{pane_current_command}|*,#{@cockpit_agents_glob}},#{@panestate},} }},needs-input,#{?#{m:*error*,#{P:#{?#{m:*|#{pane_current_command}|*,#{@cockpit_agents_glob}},#{@panestate},} }},error,#{?#{m:*running*,#{P:#{?#{m:*|#{pane_current_command}|*,#{@cockpit_agents_glob}},#{@panestate},} }},running,#{?#{m:*done*,#{P:#{?#{m:*|#{pane_current_command}|*,#{@cockpit_agents_glob}},#{@panestate},} }},done,#{?#{m:*A*,#{P:#{?#{m:*|#{pane_current_command}|*,#{@cockpit_agents_glob}},A,}}},idle,}}}}}'

fmt_nb='#{n:#{S:#{W:#{P:#{?#{==:#{@panestate},needs-input},#{?#{m:*|#{pane_current_command}|*,#{@cockpit_agents_glob}},x,},}}}}}'
fmt_ne='#{n:#{S:#{W:#{P:#{?#{==:#{@panestate},error},#{?#{m:*|#{pane_current_command}|*,#{@cockpit_agents_glob}},x,},}}}}}'
fmt_nr='#{n:#{S:#{W:#{P:#{?#{==:#{@cockpit_review},pending},#{?#{m:*|#{pane_current_command}|*,#{@cockpit_agents_glob}},x,},}}}}}'

# ##{...#} and ### store literal colour tokens, so #{E:} resolves them at render and
# a theme sourced after the plugin still wins.
fmt_fleet="#{?#{e|>:$fmt_nb,0},#[fg=##{@thm_red#}###,bold]▲$fmt_nb#[default] ,}"
fmt_fleet="$fmt_fleet#{?#{e|>:$fmt_ne,0},#[fg=##{@thm_peach#}]✕$fmt_ne#[default] ,}"
fmt_fleet="$fmt_fleet#{?#{e|>:$fmt_nr,0},#[fg=##{@thm_sky#}]◆$fmt_nr#[default] ,}"

# One command list, so parallel hooks cannot interleave a stale read. Every write is
# compare-then-set, since even an identical set-option forces a redraw.
# Only closed-set values reach this string; the untrusted ask text was written above.
body="$body ; if -F -t $pane '$fmt_needs' { if -F -t $pane '#{!=:#{@cockpit_win_needs},1}' { set-option -w -t $pane @cockpit_win_needs 1 } } { if -F -t $pane '#{@cockpit_win_needs}' { set-option -wu -t $pane @cockpit_win_needs } }"
body="$body ; if -F -t $pane '#{!=:$fmt_state,#{@cockpit_win_state}}' { if -F -t $pane '$fmt_state' { set-option -wF -t $pane @cockpit_win_state '$fmt_state' } { set-option -wu -t $pane @cockpit_win_state } }"
body="$body ; if -F -t $pane '#{!=:$fmt_fleet,#{@cockpit_fleet}}' { set-option -gqF -t $pane @cockpit_fleet '$fmt_fleet' }"
body="$body ; display-message -p -t $pane '#{@cockpit_tui_pid}'"
# Fail-open: a hook must never block the agent that fired it.
tui_pid=$(tmux if-shell -F -t "$pane" "$when" "${body# ; }" 2>/dev/null || true)

# A published pid outlives its process and SIGUSR1 terminates by default, so verify
# the name before signalling (see AGENTS.md).
if [ -n "$tui_pid" ]; then
    tui_comm=""
    # -r first: the stale pid is the one absent from /proc, so `read || ps` would fork ps every time.
    if [ -r "/proc/$tui_pid/comm" ]; then
        read -r tui_comm 2>/dev/null < "/proc/$tui_pid/comm"
    elif [ ! -d /proc/self ]; then
        tui_comm=$(ps -o comm= -p "$tui_pid" 2>/dev/null)   # macOS: ps prints a path
    fi
    if [ "${tui_comm##*/}" = cockpit-tui ]; then
        kill -USR1 "$tui_pid" 2>/dev/null || true
    fi
fi
