#!/bin/bash
# review-gate -- the second Stop hook (examples/claude-hooks.json), beside
# `agent-state done`. Two jobs at the one moment the plugin knows an agent has
# reached a turn boundary:
#
#   1. hand over a review that was queued while the agent was busy. tmux-review
#      --deliver arms @cockpit_review_spool with the composed review's path when
#      the pane is running or on a prompt; here the file's text is printed as
#      hookSpecificOutput.additionalContext on stdout and the hook exits 0 --
#      which keeps the turn going and lands in the transcript as "Stop hook
#      feedback", with no hook-error line (hooks reference; CHANGELOG v2.1.163).
#      `exit 2` + the same text on stderr is the documented fallback and routes
#      the same way ("a hook that blocks by exiting 2 routes the same way as
#      reason"), so nothing here depends on which one the harness prefers.
#      Output over 10,000 characters is auto-saved by the harness with a preview
#      and a path, so an oversized review needs no pointer logic of its own.
#      Zero keystrokes, no paste, no Enter, no focus change, and the turn
#      boundary is by construction: this hook IS the boundary.
#   2. flag the pane ◆ (@cockpit_review pending) when its diff against the
#      review base is non-empty, so the fleet says "finished, unreviewed"
#      instead of only "finished" -- and stash the conversation title and the
#      session id the payload carries, for the tab and for prefix i.
#
# A third, unrelated job lives here too under `--pretool` (PreToolUse, matcher
# Bash, examples/claude-hooks.json): while a side fixer (tmux-fixer) is alive
# for this pane, deny a Bash command that matches its guard pattern. See that
# section below for why it shares this file instead of its own script.
#
# agent-state's discipline, verbatim: pane id shape guard, bounded stdin read
# with one deadline, one JSON field pulled by parameter expansion (no jq),
# silent no-op on anything unparseable, fail-open everywhere. A hook must never
# block the agent that fired it; the hooks entry carries "timeout": 5 as the
# outer bound, the read stops at the fields it wants rather than at EOF, and
# this script is built to finish in well under one second.
set -u
pane=${TMUX_PANE:-}
state="${XDG_STATE_HOME:-$HOME/.local/state}/tmux-cockpit/review"
# Pane ids are per-server, so the socket path from $TMUX joins the key: the live
# server's %5 and a private `tmux -L` one's %5 are two panes (issue #88). `_`
# doubled before `/` becomes `_` keeps distinct paths distinct, with no fork --
# which --pretool, on every Bash call, cannot afford. Duplicated in tmux-fixer,
# which writes the fixer- marker this reads.
srv=${TMUX:-}; srv=${srv%%,*}; srv=${srv//_/__}; key="${srv////_}-${pane#%}"

# --- --concede <line>: the agent will not meet the active /goal ----------------
# Claude Code's /goal rewakes the agent on every Stop its evaluator judges not
# met, with no cap and no way for the agent to give up (issue #52). The line is
# kept per pane; the next Stop ends the turn with it as the stop reason. Not a
# hook but a foreground call, so unlike everything below it says what it did:
# a silent no-op here would leave the agent in exactly the loop it is escaping.
if [ "${1:-}" = --concede ]; then
    # $TMUX as well as the pane id: without it the key is not the one the Stop
    # hook will look under, and a concession that silently never fires is worse
    # than one that says it was not taken.
    case "$pane${TMUX:-}" in %[0-9]*/*) ;; *) echo "review-gate --concede: not in a tmux pane; nothing recorded" >&2; exit 1 ;; esac
    # Before the write, whose own ${2} expansion would abort the script under
    # set -u -- inside a 2>/dev/null group, so even bash's complaint is eaten.
    [ -n "${2:-}" ] || { echo "review-gate --concede: needs a line saying what blocks the goal; nothing recorded" >&2; exit 1; }
    { mkdir -p -- "$state" && printf '%s' "${2:0:400}" > "$state/concede-$key"; } 2>/dev/null \
        || { echo "review-gate --concede: cannot write $state; nothing recorded" >&2; exit 1; }
    echo "concession recorded; your next turn ends here, with that line as the reason"
    exit 0
fi
case "$pane" in %[0-9]*) ;; *) exit 0 ;; esac

# --- fixer liveness (mirror of tmux-fixer's; a hook fires on every Bash call
# and must not exec a second script just to stat three files) ------------------
fixer_alive() {               # <sess>
    local f="$1/fixer" p dl
    [ -d "$f" ] || return 1
    [ -f "$1/handover" ] && return 1
    dl=$(cat -- "$f/deadline" 2>/dev/null); case "$dl" in ''|*[!0-9]*) return 1 ;; esac
    [ "$(date +%s)" -lt "$dl" ] || return 1
    p=$(cat -- "$f/pane" 2>/dev/null)
    [ "$p" = pending ] && return 0
    tmux list-panes -a -F '#{pane_id}' 2>/dev/null | grep -qx -- "$p"
}

# Bounded stdin read, one deadline for the whole thing: read -t so a writer
# that holds the pipe open (Claude Code does, past the payload) cannot wedge
# the hook, the partial line kept, and the newline `read` strips put back so
# two lines cannot fuse into a field name that was never sent. Shared by the
# drain below and by --pretool -- one read, one deadline, used from both ends
# of this script instead of two copies of the same loop.
read_payload() {
    payload="" chunk=""
    local deadline=$(( SECONDS + 2 )) left
    while left=$(( deadline - SECONDS )); [ "$left" -gt 0 ]; do
        IFS= read -r -t "$left" chunk || { payload="$payload$chunk"; break; }
        payload="$payload$chunk
"; chunk=""
        case $payload in
            *'"transcript_path"'*'"session_id"'*|*'"session_id"'*'"transcript_path"'*|*'"tool_input"'*) break ;;
        esac
    done
}
# "name":"value" -> value, control chars stripped, length capped. Not a JSON
# parser: an escaped quote inside the value truncates it, which is fine for a
# path, a UUID, a title, or (in --pretool) a command prefix.
field() {
    local v
    case "$payload" in
        *"\"$1\""*) v=${payload#*\""$1"\"}; v=${v#*:}; v=${v#*\"}; v=${v%%\"*} ;;
        *) v="" ;;
    esac
    v=${v//[$'\001'-$'\037']/}
    printf '%s' "${v:0:200}"
}
# JSON string body by parameter expansion, no jq (not a dependency here, and a
# fork on the agent's turn boundary is exactly what this script avoids). The
# three whitespace controls become their escapes FIRST, so the strip of
# everything else cannot eat them.
json() {                            # <text> -> the JSON string body
    local s=$1
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    s=${s//$'\n'/\\n}
    s=${s//$'\r'/\\r}
    s=${s//$'\t'/\\t}
    printf '%s' "${s//[$'\001'-$'\037']/}"
}

# --- --pretool: the gate (PreToolUse, matcher Bash) ----------------------------
# Fires on EVERY Bash call, so the common case (no side fixer) must be one
# stat and nothing else -- no tmux, no git, not even `dirname` -- which is why
# this sits above `here=` below and everything that follows it. With a live
# fixer and a guard pattern the guarded command is denied with a reason; a
# deny ends the turn by default (hooks-guide, v2.1.210+), which is the point --
# no in-turn route-around; the Stop that follows holds and hands over.
marker="$state/fixer-$key"
if [ "${1:-}" = --pretool ]; then
    [ -f "$marker" ] || exit 0
    sess=$(cat -- "$marker" 2>/dev/null)
    # A dead fixer opens the gate; the marker itself is left for delivery (the
    # Stop hold) or a re-spawn to own -- --pretool only reads it, never removes it.
    fixer_alive "$sess" || exit 0
    guard=$(cat -- "$sess/fixer/guard" 2>/dev/null); [ -n "$guard" ] || exit 0
    read_payload
    cmd=$(field command)
    printf '%s' "$cmd" | grep -Eq -- "$guard" || exit 0
    reason="the side fix \"$(cat -- "$sess/fixer/reason")\" is repairing this right now (pane $(cat -- "$sess/fixer/pane")); this run would give invalid results — skip it and continue with your task; you will get a one-line handover when it finishes."
    printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"%s"}}\n' "$(json "$reason")"
    exit 0
fi
here=$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)

# The deadline is the BACKSTOP, not the exit: Claude Code keeps a hook's stdin
# open after the payload (the wedge the notify arm documents), so waiting for
# EOF would spend the full two seconds on every single Stop. Both fields in
# hand is everything section 2 needs, so that is where read_payload's loop
# stops. Read once, up front, for both the hold below and section 2's fields --
# read_payload is only ever called once per run now.
read_payload
case "$payload" in *'"stop_hook_active":true'*|*'"stop_hook_active": true'*) active=true ;; *) active=false ;; esac

# --- 2. the flag, and the two payload fields worth keeping --------------------
# A function: the end of the script in the normal case, and called from
# end_turn below so a pane whose turn is cut short still shows ◆, its title
# and its session id.
flag_pane() {
    tx=$(field transcript_path)
    sid=$(field session_id)
    title=""
    if [ -n "$tx" ] && [ -f "$tx" ]; then
        # The newest ai-title record wins; read from the end (9 ms on a 64 MB
        # project dir, measured). tac is GNU, tail -r is BSD; neither means no title.
        rec=$( { tac -- "$tx" 2>/dev/null || tail -r -- "$tx" 2>/dev/null; } | grep -m1 '"ai-title"')
        case "$rec" in
            *'"aiTitle"'*) title=${rec#*\"aiTitle\"}; title=${title#*:}; title=${title#*\"}; title=${title%%\"*} ;;
        esac
        title=${title//[$'\001'-$'\037']/}
        title=${title:0:120}
    fi

    # One read for everything this decides against; one write per value that
    # actually changed -- every set-option is a redraw.
    sep=$'\037'
    cur=$(tmux display-message -p -t "$pane" \
        '#{@cockpit_review}'"$sep"'#{@cockpit_title}'"$sep"'#{@cockpit_session}' 2>/dev/null)
    review=${cur%%"$sep"*};  cur=${cur#*"$sep"}
    title_cur=${cur%%"$sep"*}; sid_cur=${cur#*"$sep"}

    if "$here/tmux-review" --delta "$pane" >/dev/null 2>&1; then want=pending; else want=""; fi
    if [ "$review" != "$want" ]; then
        if [ -n "$want" ]; then tmux set-option -p -t "$pane" @cockpit_review pending 2>/dev/null
        else                    tmux set-option -pu -t "$pane" @cockpit_review 2>/dev/null; fi
        "$here/agent-state" recount "$pane"
    fi
    # Untrusted strings each get a call of their own (agent-state's rule: a bare
    # `;` argument splits a tmux command list).
    [ -n "$title" ] && [ "$title" != "$title_cur" ] && tmux set-option -p -t "$pane" @cockpit_title "$title" 2>/dev/null
    [ -n "$sid" ]   && [ "$sid"   != "$sid_cur"   ] && tmux set-option -p -t "$pane" @cockpit_session "$sid" 2>/dev/null
}

# --- the rewake cap ------------------------------------------------------------
# stop_hook_active:true marks a Stop that a stop hook's block caused. A chain
# of them is one turn the agent keeps ending and being sent back into; the
# count lives in a file per pane and a Stop with the flag false (a fresh user
# turn) drops it. At @cockpit_rewake_cap (default 10, 0 disables) the turn ends
# here: `continue:false` is honoured before any sibling hook's block, the goal
# itself stays set (only Claude Code can clear it), and the user's next prompt
# resumes it. A concession ends the turn on the first Stop, whatever the flag.
# Ending the turn skips the hold and the drain: a queued review stays armed
# for the Stop after the human's next prompt, never lost. Two stats on the
# common Stop, nothing else.
loop="$state/loop-$key"
concede="$state/concede-$key"
end_turn() {                                # <reason>  ends the turn, exit 0
    rm -f -- "$loop" "$concede"
    tmux set-option -pu -t "$pane" @cockpit_hold 2>/dev/null   # a hold leaked by a killed poll; section 0's own clear is skipped
    flag_pane >/dev/null 2>&1
    printf '{"continue":false,"stopReason":"%s"}\n' "$(json "cockpit: $1")"
    exit 0
}
if [ -f "$concede" ] && [ ! -L "$concede" ]; then
    if [ -n "$(find "$concede" -mmin -60 2>/dev/null)" ]; then
        { IFS= read -r why || :; } < "$concede"; why=${why//[$'\001'-$'\037']/}
        end_turn "the agent conceded the goal: ${why:-no reason given}"
    fi
    rm -f -- "$concede"     # an hour old: a killed agent's, or a pane id reused after a server restart
fi
if [ "$active" = true ]; then
    n=$(cat -- "$loop" 2>/dev/null); case "$n" in ''|*[!0-9]*) n=0 ;; esac
    n=$((n + 1)); mkdir -p -- "$state" 2>/dev/null; printf '%s' "$n" > "$loop"
    # 10 digits or more falls back like any other unusable value: past intmax
    # `[ -gt ]` errors instead of comparing, which would leave the cap off.
    cap=$(tmux show-option -gqv @cockpit_rewake_cap 2>/dev/null); case "$cap" in ''|*[!0-9]*|??????????*) cap=10 ;; esac
    [ "$cap" -gt 0 ] && [ "$n" -ge "$cap" ] && \
        end_turn "$n stop-hook rewakes in one turn (@cockpit_rewake_cap $cap); /goal clear ends the goal, a new prompt resumes it"
else
    [ ! -e "$loop" ] || rm -f -- "$loop"
fi

# --- 0. the hold: a side fix (tmux-fixer) is alive for this pane --------------
# While its pane exists, no handover is written and the deadline has not
# passed, this hook WAITS -- one invocation, one poll, no block-and-rewake (the
# cap counts decisions, not seconds; the hook entry's timeout is 330 s, above
# the 300 s default deadline). Fail-open: a dead pane, a past deadline, a
# missing file -> proceed at once. Never on a stop_hook_active Stop.
#
# The marker is the ONLY way this finds sess -- it is never removed by
# --pretool or by tmux-fixer, only by the delivery below, so a fixer that
# finished between two Stops is still found here (no live tmux-review/git
# lookup on every Stop of every pane just to cover that gap).
ctx=""
sess=""; [ -f "$marker" ] && sess=$(cat -- "$marker" 2>/dev/null)
if [ -n "$sess" ] && [ "$active" != true ] && [ -d "$sess/fixer" ]; then
    reason=$(cat -- "$sess/fixer/reason" 2>/dev/null); reason=${reason//[$'\001'-$'\037']/}
    if fixer_alive "$sess"; then
        tmux set-option -p -t "$pane" @cockpit_hold "$reason" 2>/dev/null
        tmux display-message "held: $reason (side fix in $(cat -- "$sess/fixer/pane" 2>/dev/null)) — $pane resumes when it finishes" 2>/dev/null
        while fixer_alive "$sess"; do sleep 1; done
    fi
    # Outside the fixer_alive branch on purpose: this hook can be killed
    # mid-poll (the hook entry's 330 s timeout, or a user interrupt), which
    # leaves @cockpit_hold set with nothing left to clear it -- the next
    # Stop still finds the same record and reaches this line, so an
    # already-leaked value is unset here too, not only the one this
    # invocation itself set.
    tmux set-option -pu -t "$pane" @cockpit_hold 2>/dev/null
    # Reached with no hold (a dead pane or a past deadline from the start) or
    # after one (the pane went away without writing a handover): either way,
    # a record with no handover means the job never finished cleanly.
    { [ -f "$sess/handover" ] && [ ! -L "$sess/handover" ]; } || ctx="a side task (\"$reason\") was running and did not finish; earlier results may be stale."
fi
if [ -n "$sess" ] && [ -f "$sess/handover" ] && [ ! -L "$sess/handover" ]; then
    ctx=$(head -c 400 -- "$sess/handover"); ctx=${ctx//[$'\001'-$'\037']/}
    rm -f -- "$sess/handover"
fi
if [ -n "$ctx" ]; then
    ctx="$ctx"$'\n'"Continue with your task."
    # Also runs when the deadline passed with the fixer's pane still alive
    # (fixer_alive already reads false there): the handover it writes later
    # has no marker to be found by and is never delivered here -- it is
    # only cleared at the next spawn -- and the --pretool guard, which also
    # depends on the marker, stops applying from this point on.
    rm -rf -- "$sess/fixer" "$marker"            # delivered: the record and the gate's marker end here
fi

# --- 1. the drain -------------------------------------------------------------
spool=$(tmux show-option -pqv -t "$pane" @cockpit_review_spool 2>/dev/null)
review=""
if [ -n "$spool" ] && [ -f "$spool" ] && [ ! -L "$spool" ]; then
    # Disarm BEFORE speaking. A Stop hook that re-emits its own reason on the
    # Stop it caused is a rewake loop (codex-plugin-cc#248), and Claude Code
    # caps nothing (2.1.246: its Stop handler only counts), so the disarm is
    # the only guard. A crash past this line loses one review; never repeats one.
    tmux set-option -pu -t "$pane" @cockpit_review_spool 2>/dev/null
    review=$(cat -- "$spool")
    rm -f -- "$spool"
    rmdir -- "${spool%/*}" 2>/dev/null
fi
if [ -n "$ctx" ] || [ -n "$review" ]; then
    # A handover alone means the agent works again too -- the sibling hook
    # wrote `done` for this same Stop, and additionalContext (from the hold or
    # the drain) means another turn is starting, so say so here whenever this
    # emits anything, not only on a queued review. Muted: stdout is a protocol
    # channel from here on, and one stray byte would not be JSON any more.
    "$here/agent-state" running "$pane" >/dev/null 2>&1
    # Joined as one additionalContext, handover/warning first: a blank line
    # only between the two when both are present, never a bare trailing one
    # when the review is empty (the ctx-alone case above).
    sep=""; [ -n "$ctx" ] && [ -n "$review" ] && sep=$'\n\n'
    printf '{"hookSpecificOutput":{"hookEventName":"Stop","additionalContext":"%s"}}\n' \
        "$(json "$ctx$sep$review")"
    exit 0
fi

flag_pane
exit 0
