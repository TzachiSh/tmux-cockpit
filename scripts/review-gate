#!/bin/bash
# review-gate: the second Stop hook beside `agent-state done`. Hands over a review
# queued while the agent was busy, and flags the pane ◆ when its diff is unreviewed.
#   --concede <line>: end the agent's next turn, giving up the active /goal (#52).
# Fail-open everywhere: a hook must never block the agent that fired it.
set -u
pane=${TMUX_PANE:-}
# An agent-view background worker has no pane; its front end relays what matters (#174).
# --concede is the agent's own call, not a hook, and still says it recorded nothing.
[ "${1:-}" != --concede ] && [ -z "$pane" ] && [ "${CLAUDE_CODE_SESSION_KIND:-}" = bg ] && exit 0
state="${XDG_STATE_HOME:-$HOME/.local/state}/tmux-cockpit/review"
# Pane ids are per-server, so the socket joins the key (#88). Prefix-free encoding,
# no fork.
srv=${TMUX:-}; srv=${srv%%,*}; srv=${srv//_/__}; key="${srv//\//_.}-${pane#%}"

# --- --concede: /goal rewakes on every unmet Stop with no cap or way out ---------
# A foreground call, so it reports what it did: a silent no-op would leave the loop.
if [ "${1:-}" = --concede ]; then
    # Without $TMUX the key differs from the one the Stop hook looks under.
    if ! case "$pane" in %[0-9]*) [ -n "${TMUX:-}" ] ;; *) false ;; esac
    then echo "review-gate --concede: not in a tmux pane; nothing recorded" >&2; exit 1; fi
    # Checked first: under set -u the write's own ${2} would abort silently inside 2>/dev/null.
    [ -n "${2:-}" ] || { echo "review-gate --concede: needs a line saying what blocks the goal; nothing recorded" >&2; exit 1; }
    { mkdir -p -- "$state" && printf '%s' "${2:0:400}" > "$state/concede-$key"; } 2>/dev/null \
        || { echo "review-gate --concede: cannot write $state; nothing recorded" >&2; exit 1; }
    echo "concession recorded; your next turn ends here, with that line as the reason"
    exit 0
fi
# Retired, but settings.json from an older install still runs it on every Bash
# call: without this it would run the Stop path below. install.sh drops it.
[ "${1:-}" = --pretool ] && exit 0
case "$pane" in %[0-9]*) ;; *) exit 0 ;; esac

d=${BASH_SOURCE[0]}; [ -L "$d" ] && d=$(readlink "$d")
# shellcheck source=lib/hook.sh
. "${d%/*}/lib/hook.sh" 2>/dev/null || exit 0

# shellcheck disable=SC2317,SC2329  # called by read_payload
have_fields() {
    case $payload in
        *'"transcript_path"'*'"session_id"'*|*'"session_id"'*'"transcript_path"'*) return 0 ;;
    esac
    return 1
}
field() {
    local v
    json_str "$1"
    v=${REPLY//[$'\001'-$'\037']/}
    printf '%s' "${v:0:200}"
}
# The whitespace controls become escapes first, so the control-char strip cannot eat them.
json() {                            # <text> -> the JSON string body
    local s=$1
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    s=${s//$'\n'/\\n}
    s=${s//$'\r'/\\r}
    s=${s//$'\t'/\\t}
    printf '%s' "${s//[$'\001'-$'\037']/}"
}

here=$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)

# Stops at the fields it needs: Claude Code keeps stdin open past the payload.
read_payload have_fields
case "$payload" in *'"stop_hook_active":true'*|*'"stop_hook_active": true'*) active=true ;; *) active=false ;; esac

# --- the ◆ flag, title and session id; also run when a turn is cut short ---------
flag_pane() {
    tx=$(field transcript_path)
    sid=$(field session_id)
    title=""
    if [ -n "$tx" ] && [ -f "$tx" ]; then
        # Newest ai-title wins, so read from the end. tac is GNU, tail -r is BSD.
        rec=$( { tac -- "$tx" 2>/dev/null || tail -r -- "$tx" 2>/dev/null; } | grep -m1 '"ai-title"')
        case "$rec" in
            *'"aiTitle"'*) title=${rec#*\"aiTitle\"}; title=${title#*:}; title=${title#*\"}; title=${title%%\"*} ;;
        esac
        title=${title//[$'\001'-$'\037']/}
        title=${title:0:120}
    fi

    # One read, and a write only per changed value: every set-option redraws.
    sep=$'\037'
    cur=$(tmux display-message -p -t "$pane" \
        '#{@cockpit_review}'"$sep"'#{@cockpit_title}'"$sep"'#{@cockpit_session}' 2>/dev/null)
    review=${cur%%"$sep"*};  cur=${cur#*"$sep"}
    title_cur=${cur%%"$sep"*}; sid_cur=${cur#*"$sep"}

    # 2: the diff could not be read (#944). Then the mark stays as it is: a refusal is
    # neither a change to review nor a clean tree.
    "$here/tmux-review" --delta "$pane" >/dev/null 2>&1
    case $? in 0) want=pending ;; 2) want=$review ;; *) want="" ;; esac
    if [ "$review" != "$want" ]; then
        if [ -n "$want" ]; then tmux set-option -p -t "$pane" @cockpit_review pending 2>/dev/null
        else                    tmux set-option -pu -t "$pane" @cockpit_review 2>/dev/null; fi
        "$here/agent-state" recount "$pane"
    fi
    # Untrusted strings get a call each: a bare `;` argument splits a tmux command list.
    [ -n "$title" ] && [ "$title" != "$title_cur" ] && tmux set-option -p -t "$pane" @cockpit_title "$title" 2>/dev/null
    [ -n "$sid" ]   && [ "$sid"   != "$sid_cur"   ] && tmux set-option -p -t "$pane" @cockpit_session "$sid" 2>/dev/null
}

# --- the rewake cap ------------------------------------------------------------
# A chain of stop_hook_active Stops is one turn being sent back again and again.
# At @cockpit_rewake_cap the turn ends; a queued review stays armed for the next one.
loop="$state/loop-$key"
concede="$state/concede-$key"
end_turn() {                                # <reason>  ends the turn, exit 0
    rm -f -- "$loop" "$concede"
    flag_pane >/dev/null 2>&1
    printf '{"continue":false,"stopReason":"%s"}\n' "$(json "cockpit: $1")"
    exit 0
}
if [ -f "$concede" ] && [ ! -L "$concede" ]; then
    if [ -n "$(find "$concede" -mmin -60 2>/dev/null)" ]; then
        { IFS= read -r why || :; } < "$concede"; why=${why//[$'\001'-$'\037']/}
        end_turn "the agent conceded the goal: ${why:-no reason given}"
    fi
    rm -f -- "$concede"     # stale: a killed agent's, or a reused pane id
fi
if [ "$active" = true ]; then
    n=$(cat -- "$loop" 2>/dev/null); case "$n" in ''|*[!0-9]*) n=0 ;; esac
    n=$((n + 1)); mkdir -p -- "$state" 2>/dev/null; printf '%s' "$n" > "$loop"
    # 10+ digits fall back too: past intmax `[ -gt ]` errors and would leave the cap off.
    cap=$(tmux show-option -gqv @cockpit_rewake_cap 2>/dev/null); case "$cap" in ''|*[!0-9]*|??????????*) cap=10 ;; esac
    [ "$cap" -gt 0 ] && [ "$n" -ge "$cap" ] && \
        end_turn "$n stop-hook rewakes in one turn (@cockpit_rewake_cap $cap); /goal clear ends the goal, a new prompt resumes it"
else
    [ ! -e "$loop" ] || rm -f -- "$loop"
fi

# --- the drain -----------------------------------------------------------------
spool=$(tmux show-option -pqv -t "$pane" @cockpit_review_spool 2>/dev/null)
review=""
if [ -n "$spool" ] && [ -f "$spool" ] && [ ! -L "$spool" ]; then
    # Disarm before speaking: re-emitting on the Stop this caused is a rewake loop
    # (codex-plugin-cc#248). A crash past here loses one review, never repeats one.
    tmux set-option -pu -t "$pane" @cockpit_review_spool 2>/dev/null
    review=$(cat -- "$spool")
    rm -f -- "$spool"
    rmdir -- "${spool%/*}" 2>/dev/null
fi
if [ -n "$review" ]; then
    # The sibling hook just wrote `done`, but additionalContext starts another turn.
    # Muted: stdout is the JSON channel from here on.
    "$here/agent-state" running "$pane" >/dev/null 2>&1
    printf '{"hookSpecificOutput":{"hookEventName":"Stop","additionalContext":"%s"}}\n' \
        "$(json "$review")"
    exit 0
fi

flag_pane
exit 0
