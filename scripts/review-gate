#!/bin/bash
# review-gate: the third Stop hook, after agent-state's done and sub-reconcile. Hands over a review
# queued while the agent was busy, and flags the pane ◆ when its diff is unreviewed.
#   --concede <line>: end the agent's next turn, giving up the active /goal (#52).
# Fail-open everywhere: a hook must never block the agent that fired it.
set -u
pane=${TMUX_PANE:-}
# An agent-view background worker has no pane; its front end relays what matters (#174).
# --concede is the agent's own call, not a hook, and still says it recorded nothing.
[ "${1:-}" != --concede ] && [ -z "$pane" ] && [ "${CLAUDE_CODE_SESSION_KIND:-}" = bg ] && exit 0
d=${BASH_SOURCE[0]}; case $d in (*/*) ;; (*) d=./$d ;; esac
[ -L "$d" ] && d=$(n=0
    while [ -L "$d" ] && [ $((n += 1)) -le 40 ] && t=$(readlink "$d"); do
        case $t in (/*) d=$t ;; (*) d=${d%/*}/$t ;; esac; done; printf %s "$d")
# The state folder (lib/xdg.sh, #1588). With none, --concede refuses, and a Stop keeps no rewake
# count and reads no concession; the drain and the mark still run.
# shellcheck source=lib/xdg.sh
. "${d%/*}/lib/xdg.sh" 2>/dev/null || { [ "${1:-}" = --concede ] || exit 0
    echo "review-gate --concede: lib/xdg.sh cannot load; nothing recorded" >&2; exit 1; }
if state_home; then state=$REPLY/tmux-cockpit/review; else state=; fi
# Pane ids are per-server, so the socket joins the key (#88). Prefix-free encoding,
# no fork.
srv=${TMUX:-}; srv=${srv%%,*}; srv=${srv//_/__}; key="${srv//\//_.}-${pane#%}"

# --- --concede: /goal rewakes on every unmet Stop with no cap or way out ---------
# A foreground call, so it reports what it did: a silent no-op would leave the loop.
if [ "${1:-}" = --concede ]; then
    # Without $TMUX the key differs from the one the Stop hook looks under.
    if ! case "$pane" in %[0-9]*) [ -n "${TMUX:-}" ] ;; *) false ;; esac
    then echo "review-gate --concede: not in a tmux pane; nothing recorded" >&2; exit 1; fi
    # Checked first: under set -u the write's own ${2} would abort silently inside 2>/dev/null.
    [ -n "${2:-}" ] || { echo "review-gate --concede: needs a line saying what blocks the goal; nothing recorded" >&2; exit 1; }
    [ -n "$state" ] || { echo "review-gate --concede: $NO_STATE_HOME; nothing recorded" >&2; exit 1; }
    { mkdir -p -- "$state" && printf '%s' "${2:0:400}" > "$state/concede-$key"; } 2>/dev/null \
        || { echo "review-gate --concede: cannot write $state; nothing recorded" >&2; exit 1; }
    echo "concession recorded; your next turn ends here, with that line as the reason"
    exit 0
fi
case "$pane" in %[0-9]*) ;; *) exit 0 ;; esac

# shellcheck source=lib/hook.sh
. "${d%/*}/lib/hook.sh" 2>/dev/null || exit 0

field() {
    local v
    json_str "$1"
    v=${REPLY//[$'\001'-$'\037']/}
    printf '%s' "${v:0:200}"
}
# The whitespace controls become escapes first, so the control-char strip cannot eat them.
json() {                            # <text> -> the JSON string body
    local s=$1
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    s=${s//$'\n'/\\n}
    s=${s//$'\r'/\\r}
    s=${s//$'\t'/\\t}
    printf '%s' "${s//[$'\001'-$'\037']/}"
}

# The sibling scripts sit beside the real script: d, resolved above, not a link (#1283).
here=$(cd -P "$(dirname "$d")" && pwd)

# The payload's whole line, as agent-state done reads it (#315): background_tasks, the work
# still in flight, comes after last_assistant_message, which can be any size. 2 s, as
# read_capped's deadline, inside the hook's own 5 s timeout. SUBS is empty when the read fails,
# and whether the Stop is paused is then not known.
if read_stop 2; then subs_count; else SUBS=""; fi
# The fields come from its first 4 KB, as agent-state session reads its ids (#308, #315): an id
# past the cap is not seen, and the glob and the cuts below never walk a long final message.
# The Stop example puts the fields used here before last_assistant_message. Common fields it
# does not place (scratchpad_dir and others) may come earlier: if the stop_hook_active token
# does not end within the first 4096 bytes, it reads false and that Stop resets the rewake
# count. Bytes, not characters.
first_bytes() { local LC_ALL=C; payload=${payload:0:$1}; }
first_bytes 4096
case "$payload" in *'"stop_hook_active":true'*|*'"stop_hook_active": true'*) active=true ;; *) active=false ;; esac

# --- the ◆ flag, title and session id; also run when a turn is cut short ---------
flag_pane() {
    tx=$(field transcript_path)
    sid=$(field session_id)
    title=""
    if [ -n "$tx" ] && [ -f "$tx" ]; then
        # Newest ai-title wins, so read from the end. tac is GNU, tail -r is BSD.
        rec=$( { tac -- "$tx" 2>/dev/null || tail -r -- "$tx" 2>/dev/null; } | grep -m1 '"ai-title"')
        case "$rec" in
            *'"aiTitle"'*) title=${rec#*\"aiTitle\"}; title=${title#*:}; title=${title#*\"}; title=${title%%\"*} ;;
        esac
        title=${title//[$'\001'-$'\037']/}
        title=${title:0:120}
    fi

    # One read, and a write only per changed value: every set-option redraws. A #707 cut
    # empties every expansion after it, so the last field reads 1 only on a whole read, and
    # only then is the session saved: a cut would read as a new id and drop the transcript.
    # The title is the one field read by elimination, since a hand-set title may hold any byte.
    sep=$'\037'
    f="#{@cockpit_review}$sep#{@cockpit_review_err}$sep#{@cockpit_title}$sep#{@cockpit_session}"
    f="$f$sep#{?#{pane_id},1,0}"
    cur=$(tmux display-message -p -t "$pane" "$f" 2>/dev/null)
    whole=${cur##*"$sep"}; cur=${cur%"$sep"*}
    sid_cur=${cur##*"$sep"}; cur=${cur%"$sep"*}
    review=${cur%%"$sep"*}; cur=${cur#*"$sep"}
    err_cur=${cur%%"$sep"*}; title_cur=${cur#*"$sep"}

    # A Stop paused on background subagents is no turn's end (#315): Claude Code wakes the
    # session as each one reports back, and the Stop that ends the last of them decides. The
    # mark and its reason stay as they are. A payload that could not be read cannot tell
    # which Stop this is: the mark stays, and the reason says so.
    if [ -z "$SUBS" ]; then want=$review err="the Stop payload cannot be read"
    elif [ "$SUBS" -gt 0 ]; then want=$review err=$err_cur
    else
        # 0 is a change to review, 1 a clean tree. Anything else leaves the mark as it is:
        # 2, the diff, the pane's work dir or its repo could not be read (#944, #959, #1286),
        # 3, tmux-review could not load, and 126, 127 or a signal, it could not run (#959),
        # are neither. Those say why in @cockpit_review_err (#960).
        "$here/tmux-review" --delta "$pane" >/dev/null 2>&1
        rc=$?
        case $rc in
            0) want=pending err="" ;;
            1) want="" err="" ;;
            2) want=$review err="the diff cannot be read" ;;
            3) want=$review err="tmux-review cannot load" ;;
            *) want=$review err="tmux-review cannot run (exit $rc)" ;;
        esac
    fi
    if [ "$review" != "$want" ]; then
        if [ -n "$want" ]; then tmux set-option -p -t "$pane" @cockpit_review pending 2>/dev/null
        else                    tmux set-option -pu -t "$pane" @cockpit_review 2>/dev/null; fi
        "$here/agent-state" recount "$pane"
    fi
    # Written and said only on a change: the option is what remembers the last reason, since
    # each Stop is a new process (agent-poll's poll_err shape). Only after a whole read, as the
    # session is: a #707 cut empties err_cur, and the next whole read settles it (#1312).
    if [ "$whole" = 1 ] && [ "$err" != "$err_cur" ]; then
        if [ -n "$err" ]; then
            tmux set-option -p -t "$pane" @cockpit_review_err "$err" 2>/dev/null
            # shellcheck source=lib/fmt.sh
            if . "${d%/*}/lib/fmt.sh" 2>/dev/null; then
                # the pane by its label (#1407), read in a subshell: only here, on a change
                # shellcheck source=lib/label.sh
                who=$(. "${d%/*}/lib/label.sh" 2>/dev/null && label_ask "$pane") || who=
                dmsg "tmux-cockpit: the ◆ of ${who:-the pane} cannot be updated: $err" 2>/dev/null
            fi
        else tmux set-option -pu -t "$pane" @cockpit_review_err 2>/dev/null; fi
    fi
    # Untrusted strings get a call each: a bare `;` argument splits a tmux command list.
    [ -n "$title" ] && [ "$title" != "$title_cur" ] && tmux set-option -p -t "$pane" @cockpit_title "$title" 2>/dev/null
    # The UUID test and the transcript drop are agent-state session's (#315).
    [ "$whole" = 1 ] && save_session "$pane" "$sid" "$sid_cur"
}

# --- the rewake cap ------------------------------------------------------------
# A chain of stop_hook_active Stops is one turn being sent back again and again.
# At @cockpit_rewake_cap the turn ends; a queued review stays armed for the next one.
loop="$state/loop-$key"
concede="$state/concede-$key"
end_turn() {                                # <reason>  ends the turn, exit 0
    rm -f -- "$loop" "$concede"
    flag_pane >/dev/null 2>&1
    printf '{"continue":false,"stopReason":"%s"}\n' "$(json "cockpit: $1")"
    exit 0
}
if [ -n "$state" ] && [ -f "$concede" ] && [ ! -L "$concede" ]; then
    if [ -n "$(find "$concede" -mmin -60 2>/dev/null)" ]; then
        { IFS= read -r why || :; } < "$concede"; why=${why//[$'\001'-$'\037']/}
        end_turn "the agent conceded the goal: ${why:-no reason given}"
    fi
    rm -f -- "$concede"     # stale: a killed agent's, or a reused pane id
fi
if [ -z "$state" ]; then :      # no state folder: no rewake count (#1588)
elif [ "$active" = true ]; then
    n=$(cat -- "$loop" 2>/dev/null); case "$n" in ''|*[!0-9]*) n=0 ;; esac
    n=$((n + 1)); mkdir -p -- "$state" 2>/dev/null; printf '%s' "$n" > "$loop"
    # 10+ digits fall back too: past intmax `[ -gt ]` errors and would leave the cap off.
    cap=$(tmux show-option -gqv @cockpit_rewake_cap 2>/dev/null); case "$cap" in ''|*[!0-9]*|??????????*) cap=10 ;; esac
    [ "$cap" -gt 0 ] && [ "$n" -ge "$cap" ] && \
        end_turn "$n stop-hook rewakes in one turn (@cockpit_rewake_cap $cap); /goal clear ends the goal, a new prompt resumes it"
else
    [ ! -e "$loop" ] || rm -f -- "$loop"
fi

# --- the drain -----------------------------------------------------------------
spool=$(tmux show-option -pqv -t "$pane" @cockpit_review_spool 2>/dev/null)
review=""
if [ -n "$spool" ] && [ -f "$spool" ] && [ ! -L "$spool" ]; then
    # Disarm before speaking: re-emitting on the Stop this caused is a rewake loop
    # (codex-plugin-cc#248). A crash past here loses one review, never repeats one.
    tmux set-option -pu -t "$pane" @cockpit_review_spool 2>/dev/null
    review=$(cat -- "$spool")
    rm -f -- "$spool"
    rmdir -- "${spool%/*}" 2>/dev/null
fi
if [ -n "$review" ]; then
    # The sibling hook just wrote `done`, but additionalContext starts another turn.
    # Muted: stdout is the JSON channel from here on. stdin from /dev/null: agent-state reads a
    # payload there, and this one's stdin, past the payload read above, may stay open (#1403).
    "$here/agent-state" running "$pane" < /dev/null >/dev/null 2>&1
    printf '{"hookSpecificOutput":{"hookEventName":"Stop","additionalContext":"%s"}}\n' \
        "$(json "$review")"
    exit 0
fi

flag_pane
exit 0
