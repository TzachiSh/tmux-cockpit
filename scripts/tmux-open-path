#!/usr/bin/env bash
# tmux-open-path — pick a path off the line you clicked, and open it.
#   tmux-open-path <pane-id>                 picker for that pane's @cockpit_click_line
#   tmux-open-path --preview <path> [line]   render one preview pane
#   tmux-open-path --dry-run <dir> <line>   what a click on <line> would open
#
# --dry-run touches no tmux and opens nothing: it prints one "path:line:col" per
# candidate. Use it when a click did nothing and you want to see what the line
# actually resolved to.
#
# Bound to M-MouseDown1Pane, which stashes the clicked line in the pane option
# @cockpit_click_line first. It reads the whole LINE, not the word under the cursor:
# tmux's word-separators include / . : and -, so #{mouse_word} on
# "src/foo-bar.ts:31" hands back "foo", which is not a file.
#
# Every click opens the PICKER, the same popup the branch segment gives you --
# never a file straight to the editor. One candidate still gets the popup: the
# point is to see what the line resolved to, with a preview of the spot, and
# then decide. Opening on a single guess is how you end up in the wrong file.
#
# Editor: VS Code by default, jumping to the line. For a terminal editor instead:
#   set -g @cockpit_editor nvim   # opens in a new tmux window at +LINE
set -uo pipefail

# bash 4+ (4.4 for `mapfile -d` in tmux-where). Without this the 3.2 failure is
# silent and wrong rather than loud: `declare -A` errors, then the same
# assignment quietly creates an INDEXED array with an arithmetic subscript.
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
    printf '%s needs bash 4 or newer (found %s). On macOS: brew install bash\n' \
           "${BASH_SOURCE[0]##*/}" "${BASH_VERSION:-unknown}" >&2
    exit 1
fi

# Under `set -u` a bare $HOME aborts the whole script where HOME is unset -- a
# run-shell from a stripped environment, or a systemd-launched tmux. tmux-where
# already guards this; a "~/..." token on a clicked line used to kill this one.
H=${HOME:-/nonexistent}

# --- preview ------------------------------------------------------------------
# Its own subcommand rather than a shell string inside --preview: the logic
# below needs conditionals and git, and threading that through fzf's quoting
# produced something nobody could read or test. fzf quotes the placeholders it
# substitutes, so the path arrives here as one argument however odd it is.
# What changed in this file, as an actual diff -- everything uncommitted from
# one base (staged, unstaged, and brand-new files alike), and an honest sentence
# when there is nothing. Bound to ^G in the pickers.
if [ "${1:-}" = --preview-diff ]; then
    f=${2:-}
    case "$f" in "~") f=${HOME:-/nonexistent} ;; "~/"*) f="${HOME:-/nonexistent}/${f#\~/}" ;; esac
    [ -n "$f" ] && [ -e "$f" ] || { printf 'gone: %s\n' "$f"; exit 0; }
    if [ -d "$f" ]; then d=$f; else case "$f" in */*) d=${f%/*} ;; *) d=. ;; esac; fi
    # Resolve d, or a RELATIVE path answers about the wrong directory: for
    # "scripts/tmux-open-path", d=scripts and git -C scripts looks for
    # scripts/scripts/... -- matching nothing and reporting "no uncommitted
    # changes" about a file that is modified. A confident wrong answer.
    d=$(cd "$d" 2>/dev/null && pwd) || d=.
    # d is now the file's OWN directory -- so the pathspec handed to git must
    # be the basename, not $f with its directory prefix still attached, or the
    # exact doubling this comment already warned about comes back one level
    # later: "-C .../scripts" diffing "scripts/foo.sh" looks for
    # "scripts/scripts/foo.sh". Reproduced: every nested file's preview read
    # "no uncommitted changes" regardless of its real state, masked until now
    # because root-level fixtures have a basename identical to their whole
    # relative path, so the doubling never showed up in them.
    base=${f##*/}
    if ! git -C "$d" rev-parse --git-dir >/dev/null 2>&1; then
        printf 'not in a git repository\n'; exit 0
    fi
    if [ -d "$f" ]; then
        st=$(git -C "$f" -c color.status=always status --short 2>/dev/null | head -40)
        dd=$(git -C "$f" diff --color=always --stat 2>/dev/null | head -40)
        if [ -n "$st$dd" ]; then printf '%s\n%s\n' "$st" "$dd"
        else printf 'no uncommitted changes under %s\n' "${f##*/}"; fi
        exit 0
    fi
    # This used to capture the WHOLE coloured diff into a shell variable, then
    # run git diff a second time (--stat) just for one summary line -- a
    # 21MB/400k-line diff measured 2.06s + 177MB RSS per render, rerun on every
    # arrow key. --numstat is the cheap presence check AND the stat source (one
    # small counted line, not the diff text); the diff itself now streams
    # straight through awk to head, never held in a bash variable.
    #
    # The base is `git diff HEAD` -- staged AND unstaged in one call, the same
    # base tmux-review --lines reviews from. The old "unstaged, else --cached"
    # rule made the two disagree in opposite directions: --lines dropped the
    # whole index the moment one unstaged edit existed, while this preview kept
    # showing the staged file it had just been told did not change. Same helper
    # body as tmux-review's tree_diff(), inlined -- these are one-shot scripts
    # and neither sources the other. An unborn HEAD has no HEAD to diff
    # against, so that one case keeps the old fallback.
    headok=0; untracked=0; cached=0
    git -C "$d" rev-parse -q --verify HEAD >/dev/null 2>&1 && headok=1
    if [ "$headok" -eq 1 ]; then
        numstat=$(git -C "$d" -c core.quotePath=false diff --numstat HEAD -- "$base" 2>/dev/null)
    else
        numstat=$(git -C "$d" -c core.quotePath=false diff --numstat -- "$base" 2>/dev/null)
        if [ -z "$numstat" ]; then
            numstat=$(git -C "$d" -c core.quotePath=false diff --cached --numstat -- "$base" 2>/dev/null)
            cached=1
        fi
    fi
    # A brand-new file has no diff against any base -- it is in no tree and no
    # index -- so every preview of one used to read "no uncommitted changes"
    # about a file the picker had just listed. --no-index against /dev/null is
    # its whole content as one added hunk, rendered in the same shape as a
    # tracked file's: one stat line, then the diff from its first @@.
    if [ -z "$numstat" ] && \
       [ -n "$(git -C "$d" -c core.quotePath=false ls-files --others --exclude-standard -- "$base" 2>/dev/null)" ]; then
        untracked=1
        numstat=$(git -C "$d" -c core.quotePath=false diff --numstat --no-index -- /dev/null "$f" 2>/dev/null)
    fi
    if [ -z "$numstat" ]; then
        printf 'no uncommitted changes in %s\n' "${f##*/}"
        exit 0
    fi
    add=${numstat%%$'\t'*}; rest=${numstat#*$'\t'}; del=${rest%%$'\t'*}
    case "$add" in
        ''|*[!0-9]*) printf '%s (binary)\n' "$base" ;;
        *)           printf '%s | %s insertion(s), %s deletion(s)\n' "$base" "$add" "$del" ;;
    esac
    if [ "$untracked" -eq 1 ]; then
        git -C "$d" -c core.quotePath=false diff --color=always --no-index -- /dev/null "$f" 2>/dev/null \
            | awk '/^\x1b\[[0-9;]*m@@|^@@/{h=1} h' | head -400
    elif [ "$headok" -eq 1 ]; then
        git -C "$d" -c core.quotePath=false diff --color=always HEAD -- "$base" 2>/dev/null \
            | awk '/^\x1b\[[0-9;]*m@@|^@@/{h=1} h' | head -400
    elif [ "$cached" -eq 1 ]; then
        git -C "$d" -c core.quotePath=false diff --color=always --cached -- "$base" 2>/dev/null \
            | awk '/^\x1b\[[0-9;]*m@@|^@@/{h=1} h' | head -400
    else
        git -C "$d" -c core.quotePath=false diff --color=always -- "$base" 2>/dev/null \
            | awk '/^\x1b\[[0-9;]*m@@|^@@/{h=1} h' | head -400
    fi
    exit 0
fi

if [ "${1:-}" = --preview ]; then
    f=${2:-}; l=${3:-}
    # Anything that is not a plain line number is no line number. It reaches the
    # arithmetic below otherwise, where bash reads a bare word as a variable name
    # and `set -u` kills the preview with "abc: unbound variable".
    case "$l" in *[!0-9]*|"") l="" ;; esac
    case "$f" in "~") f=$H ;; "~/"*) f="$H/${f#\~/}" ;; esac
    [ -n "$f" ] && [ -e "$f" ] || { printf 'gone: %s\n' "$f"; exit 0; }

    # A directory: what is happening in it, then what is in it. The status
    # block alone rendered a CLEAN repo's directory as zero bytes -- a blank
    # pane in the normal state of a repo, which read as broken. The listing is
    # -A: the dotfiles this audience most wants to reach (.claude/, .gitignore)
    # were invisible, with .git/ alone filtered as noise.
    if [ -d "$f" ]; then
        st=$(git -C "$f" -c color.status=always status --short 2>/dev/null | head -40)
        [ -n "$st" ] && printf '%s\n\n' "$st"
        ls -1Ap -- "$f" 2>/dev/null | grep -vx '\.git/' | head -60
        exit 0
    fi

    [ -r "$f" ] || { printf 'unreadable: %s\n' "$f"; exit 0; }

    # An empty file has no lines for grep to match, so the binary test below
    # calls it binary. Say what it actually is -- clicking a file you just
    # created should not accuse it of being a blob.
    [ -s "$f" ] || { printf 'empty file\n'; exit 0; }

    # grep -I calls it binary on the same rule git does. Dumping one into a
    # preview pane fills it with control codes and can leave the terminal in a
    # strange state, so say what it is instead. The pattern is '' rather than
    # '.': a file of nothing but blank lines has lines, but none with a
    # character in, and '.' would call that binary too.
    if ! grep -Iq '' -- "$f" 2>/dev/null; then
        printf 'binary file\n\n'
        file -b -- "$f" 2>/dev/null
        wc -c < "$f" 2>/dev/null | { read -r n; printf '%s bytes\n' "$n"; }
        exit 0
    fi

    # No target line means nothing anchors the view -- and if the file has
    # uncommitted changes, those are almost always why it is on the line you
    # clicked. Lead with the diff; ^F flips to the plain content, ^G back.
    # A line number wins over the diff: the jump target is the point then.
    if [ -z "$l" ]; then
        case "$f" in */*) _d=${f%/*} ;; *) _d=. ;; esac
        if git -C "$_d" rev-parse --git-dir >/dev/null 2>&1; then
            _diff=$(git -C "$_d" diff --color=always -- "$f" 2>/dev/null)
            [ -n "$_diff" ] && { printf '%s\n' "$_diff" | head -400; exit 0; }
        fi
    fi

    # Markdown renders as markdown -- headings, bold, tables -- when nothing
    # more specific applies. A target line still wins (rich cannot anchor to a
    # line and the jump is the point), and so does an uncommitted diff, which
    # already returned above. rich ships with this machine's python3; the
    # import probe costs ~25ms and only runs for .md files.
    case "$f" in
        *.md|*.markdown|*.mdown|*.mkd)
            if [ -z "$l" ] && python3 -c 'import rich' 2>/dev/null; then
                head -400 -- "$f" | python3 -m rich.markdown \
                    -c -w "${FZF_PREVIEW_COLUMNS:-80}" -t ansi_dark - 2>/dev/null && exit 0
            fi ;;
    esac

    # Window the snippet around the target line: enough above to see how you
    # got there, more below because that is where you are going. The lead-in
    # scales to the preview fzf actually gave us -- a fixed 10 lines pushed the
    # TARGET off the bottom of a 7-row preview, and the one thing this pane
    # exists to show was structurally never on screen at small sizes.
    if [ -n "$l" ]; then
        above=$(( ${FZF_PREVIEW_LINES:-40} / 3 )); [ "$above" -gt 10 ] && above=10
        first=$(( l > above ? l - above : 1 )); last=$(( l + 40 ))
    else                first=1; last=200; fi

    # bat gives syntax colour, line numbers, AND -- via the "changes" style -- the
    # git gutter, so an edited line is marked +/~ right beside its content. That
    # is both things you want from a snippet at once. Debian ships it as batcat.
    # A minified bundle is one line of megabytes. bat --wrap=never does not
    # truncate, it declines to WRAP -- the whole line is still piped into the
    # preview on every cursor move (measured: 3.2MB for one 3MB line). Fall
    # through to the awk path, which caps each line, when the file looks like
    # that. Measured over [first,last] -- the actual RENDER WINDOW bat is about
    # to draw -- not a fixed 1-200: a 3MB line at line 500 sailed past a
    # 1-200-only guard (bat still renders any target line up to 2000) and
    # dumped 3MB into fzf per cursor move, the exact failure this guard exists
    # to prevent.
    longest=$(awk -v s="$first" -v e="$last" \
              'NR < s { next } NR > e { exit } { if (length($0) > m) m = length($0) } END { print m+0 }' \
              "$f" 2>/dev/null)
    # ...and cap the TARGET line too: bat highlights sequentially from line 1,
    # so its cost is linear in the line number -- measured 15s at line 50000
    # and unbounded beyond, re-run on every cursor move. A deep stack-trace
    # line (bundle.js:48213) made the picker hang. The awk path is flat.
    bat=""
    if [ "${longest:-0}" -le 1000 ] && [ "${last:-0}" -le 2000 ]; then
        bat=$(command -v batcat 2>/dev/null || command -v bat 2>/dev/null || true)
    fi
    if [ -n "$bat" ]; then
        # bat's --highlight-line paints a #333333 band -- measured at 1.4:1
        # against common dark themes, found by counting rows, not by looking.
        # A marker COLUMN is prepended instead: ▸ on the target, a space on
        # every other line, so alignment holds and no ANSI byte is clobbered.
        if [ -n "$l" ]; then
            "$bat" --style=numbers,changes --color=always --paging=never \
                   --terminal-width="$(( ${FZF_PREVIEW_COLUMNS:-80} - 1 ))" --wrap=never \
                   --line-range "$first:$last" --highlight-line "$l" \
                   -- "$f" 2>/dev/null \
            | awk -v r=$(( l - first + 1 )) \
                  'NR==r { printf "\033[1;33m▸\033[0m%s\n", $0; next }
                          { printf " %s\n", $0 }' && exit 0
        else
            "$bat" --style=numbers,changes --color=always --paging=never \
                   --terminal-width="${FZF_PREVIEW_COLUMNS:-80}" --wrap=never \
                   --line-range "$first:$last" \
                   -- "$f" 2>/dev/null && exit 0
        fi
    fi

    # No bat: line numbers, and the target line in reverse video so the eye lands
    # on it without counting rows.
    awk -v s="$first" -v e="$last" -v t="${l:-0}" '
        NR > e { exit }
        NR >= s { line = substr($0, 1, 1000)
                  if (NR == t) printf "\033[7m%6d  %s\033[0m\n", NR, line
                  else         printf "%6d  %s\n", NR, line }
    ' "$f" 2>/dev/null
    exit 0
fi

PICK=0 DRY=0 BROWSE=0
# Clicking the DIRECTORY segment in the status bar lands here: no clicked line,
# no candidates -- straight into the folder browser at the pane's working dir.
# The binding runs this inside a display-popup, so a tty is already there.
[ "${1:-}" = --browse ]  && { BROWSE=1; shift; }
[ "${1:-}" = --pick ]    && { PICK=1; shift; }   # re-entry from the popup below
[ "${1:-}" = --dry-run ] && { DRY=1;  shift; }

note() { [ "$DRY" -eq 1 ] || tmux display-message "$*"; }

if [ "$BROWSE" -eq 1 ]; then
    dir=${1:-$PWD}; line=""; pane=""
    win=$(tmux display-message -p '#{window_id}' 2>/dev/null)
elif [ "$DRY" -eq 1 ]; then
    dir=${1:-$PWD}; line=${2:-}; pane=""; win=""
else
    pane=${1:-}
    [ -n "$pane" ] || {
        printf 'usage: tmux-open-path [--pick] <pane-id>\n' >&2
        printf '       tmux-open-path --dry-run <dir> <line>\n' >&2
        exit 2
    }
    # The binding rewrites @cockpit_click_line on every click, so there is nothing stale
    # to clear -- and leaving it set is what lets the popup re-derive this list.
    line=$(tmux show-options -p -t "$pane" -qv @cockpit_click_line)
    dir=$(tmux display-message -p -t "$pane" '#{pane_current_path}')
    win=$(tmux display-message -p -t "$pane" '#{window_id}')
fi

[ "$BROWSE" -eq 1 ] || [ -n "$line" ] || { note "no line under the click"; exit 0; }

# --- candidates ---------------------------------------------------------------
# Every token on the line that resolves to something on disk, in the order they
# appear. Existence is the filter: it is the only test that cannot be fooled by a
# word that merely looks like a path.
declare -a FILES=() LINES=() COLS=()
declare -A seen=()

consider() {  # consider <path> <line> <col> — record it if it exists
    local p=$1 l=$2 c=$3 abs
    [ -n "$p" ] || return 0
    case "$p" in
        "~") p="$H" ;;
        "~/"*) p="$H/${p#\~/}" ;;
    esac
    case "$p" in
        /*) abs=$p ;;
        *)  abs=$dir/$p ;;
    esac
    [ -e "$abs" ] || return 1
    abs=${abs//\/.\//\/}                    # "dir/./bin/x" reads badly in the message
    [ -z "${seen[$abs]:-}" ] || return 0
    seen[$abs]=1
    FILES+=("$abs"); LINES+=("$l"); COLS+=("$c")
    return 0
}

# Terminals wrap paths in punctuation: "src/a.ts", (src/a.ts), 'src/a.ts',
# and prose ends them with , ; or a full stop. Strip both ends, not the
# middle -- a path may legitimately contain almost anything else.
# Leading strip is an explicit set, NOT [:punct:]: that class contains / ~ .
# and _, so it ate the first character of every absolute and ~ path.
#
# The answer lands in $TOK rather than on stdout: a command substitution is a
# fork, and this runs once per token on the line, twice for a wrapped one.
strip_ends() {
    TOK=$1
    while [ -n "$TOK" ]; do
        case "$TOK" in
            [\(\[\{\'\"\`\<]*) TOK=${TOK#?} ;;
            *) break ;;
        esac
    done
    while [ -n "$TOK" ]; do
        # Stop before eating the ")" of "file(12,3)" -- tsc and MSVC print that
        # shape, and losing the bracket turns the location into unparseable text.
        [[ $TOK =~ \([0-9]+,[0-9]+\)$ ]] && break
        # Same for the ")" of "Write(src/a.ts)": that bracket is what marks the
        # token as a wrapper worth unwrapping below. Strip it and the token
        # becomes "Write(src/a.ts", which is nothing at all.
        [[ $TOK =~ ^[A-Za-z_][A-Za-z0-9_-]*\(.+\)$ ]] && break
        case "$TOK" in
            *[\)\]\}\'\"\`,\;:.]) TOK=${TOK%?} ;;
            *) break ;;
        esac
    done
}

# One token, in the shapes tools print paths in. 0 when it recorded something.
try_token() {
    local tok=$1
    # file(12,3) — the shape tsc and MSVC print.
    if [[ $tok =~ ^(.+)\(([0-9]+),([0-9]+)\)$ ]]; then
        consider "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" && return 0
    fi
    # file:12:3 and file:12 — grep, eslint, stack traces, every compiler.
    if [[ $tok =~ ^(.+):([0-9]+):([0-9]+)$ ]]; then
        consider "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" && return 0
    fi
    if [[ $tok =~ ^(.+):([0-9]+)$ ]]; then
        consider "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "" && return 0
    fi
    consider "$tok" "" "" && return 0
    # git diff headers name the same file twice, as a/path and b/path.
    case "$tok" in
        a/*|b/*) consider "${tok#?/}" "" "" && return 0 ;;
    esac
    return 1
}

# Splitting $line uses the shell's own word rules, and those include PATHNAME
# EXPANSION. A line that merely mentioned a wildcard -- "rm *", a compiler note
# containing [ab]* -- was expanded against this process's cwd, inventing tokens
# that the existence check below then accepted as real candidates. Under
# run-shell that cwd is the tmux server's, which is very often the same tree the
# pane is in, so the invented files existed and got opened. -f keeps the tokens
# literal; nothing here wants a glob.
set -f
ntok=0
for raw in $line; do
    ntok=$((ntok + 1))
    # 0.31ms/token, linear: a real clicked line has a handful of tokens, but a
    # 112KB line (4000 path-shaped tokens) measured 1.59s in this loop alone.
    # Capped like the preview guard above -- degrade, don't stall the click.
    [ "$ntok" -gt 500 ] && break
    strip_ends "$raw"; tok=$TOK
    [ -n "$tok" ] || continue
    try_token "$tok" && continue
    # Claude Code prints its tool calls as Write(path), Read(path:12),
    # Edit(path) -- the path is real, the Name( ) around it is not, and the
    # whole token resolves to nothing. Unwrap and try the inside, itself
    # stripped so a nested "(Write(a.ts))" still lands.
    #
    # The tsc shape file(12,3) is NOT this and must not be unwrapped: its
    # inner is a line/column pair, try_token already resolved it above, and
    # a bare "12,3" would then be looked up as a filename.
    #
    # The two tests are separate statements on purpose: written as one
    # "[[ a ]] && [[ ${BASH_REMATCH[1]} ]]" chain, bash clears BASH_REMATCH
    # before the second operand expands, and `set -u` kills the script with
    # "BASH_REMATCH[1]: unbound variable" on the first Write(...) line.
    if [[ $tok =~ ^[A-Za-z_][A-Za-z0-9_-]*\((.+)\)$ ]]; then
        inner=${BASH_REMATCH[1]}
        if ! [[ $inner =~ ^[0-9]+,[0-9]+$ ]]; then
            strip_ends "$inner"
            [ -n "$TOK" ] && try_token "$TOK" && continue
        fi
    fi
done
set +f

# --- open ---------------------------------------------------------------------
# tmux runs these command strings through sh, so every path in one has to be
# shell-quoted. Wrapping it in single quotes by hand breaks on the first path
# containing a quote -- the quote closes early and the rest of the name is read
# as syntax, which opens the wrong file or runs a word of it as a command.
shq() { printf '%q' "$1"; }

open_one() {
    local file=$1 ln=$2 col=$3 editor
    editor=$(tmux show-options -gqv @cockpit_editor)
    if [ -z "$editor" ]; then
        # The old, unprefixed name. Kept working for one release; it is generic
        # enough that another plugin could reasonably want it.
        editor=$(tmux show-options -gqv @open-editor)
        [ -n "$editor" ] && tmux display-message \
            "tmux-cockpit: @open-editor has been renamed @cockpit_editor"
    fi
    # VS Code stays the default, but only where it is actually installed.
    # Otherwise fall back to the editor the user already told the shell about.
    if [ -z "$editor" ] && ! command -v code >/dev/null 2>&1; then
        editor=${VISUAL:-${EDITOR:-}}
    fi
    if [ -n "$editor" ]; then
        # A terminal editor gets a tmux window of its own, next to the output you
        # clicked from. -t is not optional: without it the window is created in
        # whichever session tmux considers current, which is the session with the
        # most recent client -- not necessarily the one you clicked in. It takes a
        # WINDOW, not a pane, so -a puts the new one right after the clicked one.
        tmux new-window -t "$win" -a -c "$dir" -n "${file##*/}" \
             "$editor ${ln:++$ln} $(shq "$file")"
        return
    fi
    if command -v code >/dev/null 2>&1; then
        # Launched by the tmux SERVER, not by this script. This runs inside the
        # picker popup, and a popup kills its whole process group the moment it
        # closes -- which is immediately, since the script exits right after.
        # A plain `code ... &` therefore died before it could hand the file to
        # the running VS Code window, and nothing opened. Measured: a child
        # backgrounded in a popup never survives; one owned by the server does.
        if [ -d "$file" ]; then
            # A folder is a workspace, not a file spec: --goto on a directory
            # parses it as file:line and does not open the folder.
            tmux run-shell -b "code $(shq "$file") >/dev/null 2>&1"
        else
            tmux run-shell -b "code --goto $(shq "$file:${ln:-1}:${col:-1}") >/dev/null 2>&1"
        fi
        note "opened ${file/#$H/\~}${ln:+:$ln}"
        return
    fi
    # Saying "opened" for a command that was never found is worse than doing
    # nothing: it sends you looking for the bug anywhere but here.
    note "no editor found -- set @cockpit_editor, or \$VISUAL/\$EDITOR, or install code"
}

if [ "$DRY" -eq 1 ]; then
    for i in "${!FILES[@]}"; do
        printf '%s:%s:%s\n' "${FILES[$i]}" "${LINES[$i]:-}" "${COLS[$i]:-}"
    done
    exit 0
fi

if [ "$BROWSE" -eq 0 ] && [ ${#FILES[@]} -eq 0 ]; then
    # A popup you have to dismiss is the wrong answer to "there was nothing
    # there" -- the status line says it and gets out of the way.
    note "no file on that line"
    exit 0
fi

# Opt-in instant open. The default stays "always show the picker" -- seeing
# what the line resolved to is the point -- but a lone candidate that carried
# an explicit :line is machine output (a stack trace, a compiler error, a grep
# hit), not a guess, and some people want those to just open.
#   set -g @cockpit_open_single line     lone candidate WITH a line number
#   set -g @cockpit_open_single always   any lone candidate
if [ "$PICK" -eq 0 ] && [ "$BROWSE" -eq 0 ] && [ ${#FILES[@]} -eq 1 ] && [ ! -d "${FILES[0]}" ]; then
    case "$(tmux show-options -gqv @cockpit_open_single)" in
        always) open_one "${FILES[0]}" "${LINES[0]}" "${COLS[0]}"; exit 0 ;;
        line)   [ -n "${LINES[0]}" ] && { open_one "${FILES[0]}" "${LINES[0]}" "${COLS[0]}"; exit 0; } ;;
    esac
fi

# Otherwise ask, even for a single candidate. The click arrives via run-shell,
# which has no terminal, so the picker needs a popup -- which re-enters this
# script with --pick and rebuilds the same list.
if [ "$PICK" -eq 0 ] && [ "$BROWSE" -eq 0 ]; then
    # Geometry comes from the same options the branch popup uses, read at click
    # time so changing them needs no reload.
    pw=$(tmux show-option -gqv @cockpit_popup_width);  pw=${pw:-70%}
    ph=$(tmux show-option -gqv @cockpit_popup_height); ph=${ph:-70%}
    tmux display-popup -t "$pane" -E -w "$pw" -h "$ph" \
        -T " open path · #{b:pane_current_path} " \
        "$(shq "$0") --pick $(shq "$pane")"
    exit 0
fi

# Field 2 is the display path, field 3 the line number (blank when the token
# carried none). fzf quotes both when it substitutes them.
# Browse INTO a directory instead of throwing it at the editor: Enter descends,
# ".." climbs, a file opens, ^O opens the highlighted entry as-is (which is how
# you deliberately hand a whole folder to VS Code). Runs in the same popup, so
# it costs nothing new; each level is one fzf round in a loop.
# The last three path components, with a leading ellipsis when clipped. Deep in
# a tree the browser prompt was 66 of 68 columns of PREFIX -- no room to type,
# and the leaf (the part that says where you are) was what truncation removed.
tail3() {
    local p=${1/#$H/\~} a b c r
    r=$p; c=${r##*/}; r=${r%/*}
    [ "$r" = "$p" ] && { printf '%s' "$p"; return; }
    b=${r##*/}; r=${r%/*}
    [ "$r/$b" = "$p" ] || [ -z "$r" ] && { printf '%s' "$p"; return; }
    a=${r##*/}; r=${r%/*}
    if [ -z "$r" ] || [ "$r" = "$p" ] || [ "$r" = "~" ] || [ "$r" = "" ]; then
        printf '%s' "$p"
    else
        printf '…/%s/%s/%s' "$a" "$b" "$c"
    fi
}

browse() {
    local dir=$1 out key sel
    dir=$(cd "$dir" 2>/dev/null && pwd) || return 0
    while :; do
        # -A: the dotfiles this audience most wants (.claude/, .gitignore)
        # were unreachable; .git/ alone is filtered as noise. load:down starts
        # the cursor on the first real entry instead of ../, where a second
        # Enter just climbed straight back out.
        out=$( cd "$dir" && { printf '../\n'; ls -1Ap 2>/dev/null | grep -vx '\.git/'; } \
            | fzf --reverse --info=inline-right --cycle --scroll-off=2 --color=16 \
                  --expect=ctrl-o \
                  --bind 'load:down' \
                  --bind 'ctrl-/:toggle-preview,ctrl-u:preview-half-page-up,ctrl-d:preview-half-page-down' \
                  --bind "ctrl-g:change-preview($(shq "$0") --preview-diff {})+change-preview-label( diff )" \
                  --bind "ctrl-f:change-preview($(shq "$0") --preview {})+change-preview-label( content )" \
                  --prompt="$(tail3 "$dir")/ " \
                  --header='↵ open / enter dir   ^O as-is
^G diff   ^F content   ^/ preview   esc cancel' \
                  --preview="$(shq "$0") --preview {}" \
                  --preview-label=' content ' --preview-label-pos=2 \
                  --preview-window='down,65%,border-top') || return 0
        key=${out%%$'\n'*}; sel=${out#*$'\n'}
        [ -n "$sel" ] && [ "$sel" != "$key" ] || sel=""
        [ -n "$sel" ] || return 0
        if [ "$key" = ctrl-o ]; then
            open_one "$dir/${sel%/}" "" ""; return 0
        fi
        case "$sel" in
            ../) dir=$(cd "$dir/.." && pwd) || return 0 ;;
            */)  dir=$(cd "$dir/${sel%/}" && pwd) || return 0 ;;
            *)   open_one "$dir/$sel" "" ""; return 0 ;;
        esac
    done
}

if [ "$BROWSE" -eq 1 ]; then
    command -v fzf >/dev/null || { note "the folder browser needs fzf"; exit 0; }
    browse "$dir"
    exit 0
fi

if command -v fzf >/dev/null; then
    # Size the split from the popup fzf actually lives in, not from a fixed
    # percentage: 85% was right at 40 rows and starved the list to ONE row at
    # 17. The list gets the rows it has (capped), the preview gets the rest.
    avail=$(tput lines 2>/dev/null || echo 24)
    lrows=${#FILES[@]}; [ "$lrows" -gt 8 ] && lrows=8
    pshare=$(( avail - lrows - 5 ))          # prompt + 2-line header + border
    [ "$pshare" -lt 5 ] && pshare=5
    # Field 4 is display-only: relative to the pane's own directory when the
    # candidate is under it -- which is how the token read in the output --
    # with the line number kept. The absolute path stays in field 2 for the
    # preview commands. --keep-right protects the basename:line end when a
    # long row still truncates.
    out=$(for i in "${!FILES[@]}"; do
               case "${FILES[$i]}" in
                   "$dir"/*) disp=${FILES[$i]#"$dir"/} ;;
                   *)        disp=${FILES[$i]/#$H/\~} ;;
               esac
               printf '%s\t%s\t%s\t%s%s\n' "$i" "${FILES[$i]/#$H/\~}" "${LINES[$i]}" \
                      "$disp" "${LINES[$i]:+:${LINES[$i]}}"
           done | fzf --reverse --info=inline-right --cycle --scroll-off=2 --color=16 \
                      --delimiter=$'\t' --with-nth=4 --multi --keep-right \
                      --expect=ctrl-o \
                      --bind 'ctrl-/:toggle-preview,ctrl-u:preview-half-page-up,ctrl-d:preview-half-page-down' \
                      --bind "ctrl-g:change-preview($(shq "$0") --preview-diff {2})+change-preview-label( diff )" \
                      --bind "ctrl-f:change-preview($(shq "$0") --preview {2} {3})+change-preview-label( content )" \
                      --prompt='open> ' \
                      --header='↵ open (folder: browse)   tab mark   ^O as-is
^G diff   ^F content   ^/ preview   esc cancel' \
                      --preview="$(shq "$0") --preview {2} {3}" \
                      --preview-label=' content ' --preview-label-pos=2 \
                      --preview-window="down,$pshare,border-top")
    [ -n "$out" ] || exit 0
    # --expect puts the pressed key on line 1, the selections after it.
    key=${out%%$'\n'*}
    picks=${out#*$'\n'}
    [ "$picks" != "$out" ] || exit 0
    [ -n "$picks" ] || exit 0
    if [ "$key" = ctrl-o ]; then
        # Open exactly what is marked, as it is -- this is how a folder goes to
        # the editor whole (VS Code opens it as a workspace) instead of being
        # browsed into.
        while IFS= read -r row; do
            i=${row%%$'\t'*}
            open_one "${FILES[$i]}" "${LINES[$i]}" "${COLS[$i]}"
        done <<<"$picks"
        exit 0
    fi
    # --multi returns one row per marked file (or just the cursor row). A
    # compiler error naming a header and its source, a diff naming two files:
    # tab-mark both, open both. Tab means the same thing in tm's kill picker.
    #
    # A directory is a place, not a file: picking one alone BROWSES it -- Enter
    # descends, .. climbs, ^O in the browser is the deliberate "hand this whole
    # folder to the editor". In a multi-selection directories are skipped, so
    # marking three files and a folder opens the files rather than surprising
    # you with an editor window per directory.
    n=$(printf '%s\n' "$picks" | grep -c .)
    while IFS= read -r row; do
        i=${row%%$'\t'*}
        if [ -d "${FILES[$i]}" ]; then
            [ "$n" -eq 1 ] && browse "${FILES[$i]}"
            continue
        fi
        open_one "${FILES[$i]}" "${LINES[$i]}" "${COLS[$i]}"
    done <<<"$picks"
else
    # No fzf: a numbered menu still beats no picker at all.
    printf 'Open which path?\n'
    select f in "${FILES[@]}"; do [ -n "${f:-}" ] && break; done
    [ -n "${f:-}" ] || exit 0
    i=0
    for j in "${!FILES[@]}"; do [ "${FILES[$j]}" = "$f" ] && i=$j; done
    open_one "${FILES[$i]}" "${LINES[$i]}" "${COLS[$i]}"
fi
