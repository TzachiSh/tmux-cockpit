#!/usr/bin/env bash
# tmux-open-path — pick a path off the line you clicked, and open it.
#   tmux-open-path <pane-id>                 picker for that pane's @cockpit_click_line
#   tmux-open-path --dry-run <dir> <line>   what a click on <line> would open
#
#   tmux-open-path --folder <pane-id>      browse that pane's folder (cockpit-tui files)
#
# --dry-run touches no tmux and opens nothing: one "path:line:col" per candidate.
# The binding stashes the whole clicked line in @cockpit_click_line: tmux's
# word-separators include / . : -, so #{mouse_word} on "src/foo-bar.ts:31" is "foo".
# One candidate opens at once; several open cockpit-tui pick (↵ opens, alt-c copies).
# Editor: VS Code by default, at the line; `set -g @cockpit_editor nvim` for a
# terminal editor in a new window.
set -uo pipefail

# bash 4+: on 3.2 `declare -A` fails and the assignment quietly makes an
# indexed array, so fail loudly instead.
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
    printf '%s needs bash 4 or newer (found %s). On macOS: brew install bash\n' \
           "${BASH_SOURCE[0]##*/}" "${BASH_VERSION:-unknown}" >&2
    exit 1
fi
d=${BASH_SOURCE[0]}; [ -L "$d" ] && d=$(readlink "$d")
# shellcheck source=lib/fmt.sh
. "${d%/*}/lib/fmt.sh" || exit 1   # fesc (#289)

# HOME can be unset (a systemd-launched tmux), and `set -u` would abort on it.
H=${HOME:-/nonexistent}

# --- vscode -------------------------------------------------------------------
# Sourced on demand: most clicks never reach VS Code. lib/ sits beside the real
# script.
vscode_lib() {
    local d=${BASH_SOURCE[0]}; [ -L "$d" ] && d=$(readlink "$d")
    # shellcheck source=lib/vscode.sh
    . "${d%/*}/lib/vscode.sh" 2>/dev/null && return 0
    # scripts/ without lib/ must still open files the ordinary ways.
    vscode_shim() { return 1; }
    vscode_open() { return 1; }
}

# open_one's `run-shell -b` re-entry: a popup kills its own process group.
if [ "${1:-}" = --vscode ]; then
    shift
    vscode_lib
    vscode_open "$@"
    exit $?
fi

PICK=0 DRY=0 FOLDER=0 BROWSE=0 VIEW=0
[ "${1:-}" = --folder ]  && { FOLDER=1; shift; } # the pane's folder, in the browser
[ "${1:-}" = --browse ]  && { BROWSE=1; shift; } # re-entry from the browser's popup
[ "${1:-}" = --pick ]    && { PICK=1; shift; }   # re-entry from the popup below
[ "${1:-}" = --view ]    && { VIEW=1; shift; }   # re-entry from md_view's popup (#283)
[ "${1:-}" = --dry-run ] && { DRY=1;  shift; }

# display-message expands formats: a clicked name like x#(cmd).txt must show, not run (#289)
note() { [ "$DRY" -eq 1 ] || tmux display-message "$(fesc "$*")"; }

# --- open ---------------------------------------------------------------------
# tmux runs these command strings through sh: every path in one is %q-quoted,
# since a hand-written '...' breaks on a name holding a quote.
shq() { printf '%q' "$1"; }

open_one() {
    local file=$1 ln=$2 col=$3 editor wn
    md_view "$file" "$ln" && return
    vscode_lib
    editor=$(tmux show-options -gqv @cockpit_editor)
    if [ -z "$editor" ]; then
        # The old, unprefixed name, kept working for one release.
        editor=$(tmux show-options -gqv @open-editor)
        [ -n "$editor" ] && tmux display-message \
            "cockpit: @open-editor renamed @cockpit_editor · update your tmux.conf"
    fi
    # VS Code only where it is installed (code on PATH, or the Remote-SSH shim),
    # else the shell's editor.
    if [ -z "$editor" ] && ! command -v code >/dev/null 2>&1 && ! vscode_shim >/dev/null; then
        editor=${VISUAL:-${EDITOR:-}}
    fi
    if [ -n "$editor" ]; then
        # -t: without it the window lands in the most recent client's session.
        # -c and -n expand formats, the command does not (#289): escape only those.
        # the window name drops what tmux refuses (#366); the editor keeps the real path
        wn=$(plain_name "${file##*/}")
        tmux new-window -t "$win" -a -c "$(fesc "$dir")" -n "$(fesc "$wn")" \
             "$editor ${ln:++$ln} $(shq "$file")" \
            || note "cockpit: tmux could not open a window for ${wn:-a file}"
        return
    fi
    if command -v code >/dev/null 2>&1; then
        # Launched by the server: the picker popup kills its process group as it
        # closes, and a backgrounded `code &` died before reaching VS Code.
        if [ -d "$file" ]; then
            # --goto on a directory parses it as file:line.
            tmux run-shell -b "$(fesc "code $(shq "$file") >/dev/null 2>&1")"
        else
            tmux run-shell -b \
                "$(fesc "code --goto $(shq "$file:${ln:-1}:${col:-1}") >/dev/null 2>&1")"
        fi
        note "cockpit: opened ${file/#$H/\~}${ln:+:$ln}"
        return
    fi
    # Remote-SSH and Coder: the CLI is not on tmux's PATH. Re-entered via
    # run-shell -b so the socket probe (~150 ms per dead socket) outlives the popup.
    if vscode_shim >/dev/null; then
        if [ -d "$file" ]; then
            tmux run-shell -b "$(fesc "$(shq "$0") --vscode $(shq "$file") >/dev/null 2>&1")"
        else
            tmux run-shell -b "$(fesc "$(shq "$0") --vscode --goto \
$(shq "$file:${ln:-1}:${col:-1}") >/dev/null 2>&1")"
        fi
        note "cockpit: opened ${file/#$H/\~}${ln:+:$ln}"
        return
    fi
    note "cockpit: no editor · set @cockpit_editor, \$VISUAL or install code"
}

# --- markdown (#283) ---------------------------------------------------------
# A markdown file opens read-only in cockpit-tui view; e goes on to open_one at
# the line it showed. run-shell has no terminal, so a popup re-enters with
# --view; from the picker's popup (one per client) it draws in place.
# 1: not for the viewer (another file, @cockpit_md_view off, no binary, failed).
# A third argument "any" lifts the markdown-extension gate: the browser's view
# verb sends every regular file here (#406).
md_view() {
    local file=$1 ln=$2 any=${3:-} out rc err size title
    if [ "$any" != any ]; then
        case ${file,,} in *.md|*.markdown|*.mdown|*.mkd) ;; *) return 1 ;; esac
    fi
    [ -f "$file" ] && [ -z "${MD_EDIT:-}" ] || return 1
    [ "$(tmux show-option -gqv @cockpit_md_view)" != off ] || return 1
    # shellcheck source=lib/tui.sh
    . "${d%/*}/lib/tui.sh" 2>/dev/null && [ -x "$COCKPIT_TUI_BIN" ] || return 1
    if [ "$PICK" -eq 0 ] && [ "$VIEW" -eq 0 ] && [ "$BROWSE" -eq 0 ]; then
        # a popup needs a client; decided here, as the popup's status is its
        # command's (129 when the client detaches)
        [ -n "$(tmux list-clients -t "$pane" -F x 2>/dev/null)" ] || return 1
        size=$(tmux display-message -p -t "$pane" '#{pane_width} #{pane_height}')
        # the border draws the name: no control character, no bidi mark
        title=$(plain_name "${file##*/}")
        # -d and -T expand formats, the command does not (#289)
        tmux display-popup -t "$pane" -E -x P -y P -w "${size% *}" -h "${size#* }" \
            -d "$(fesc "$dir")" -T "$(fesc " $title ")" \
            "$(shq "$0") --view $(shq "$pane") $(shq "$file") $(shq "$ln")"
        return 0
    fi
    # the viewer's ? (#365): the panel opens in this popup, then the viewer again
    local n='([1-9][0-9]{0,8})'
    # the basket's pane (#365 child 5): this script's own, and only as `%N`
    local bp=''
    [[ $pane =~ ^%[0-9]+$ ]] && bp=$pane
    while :; do
        err=$(mktemp 2>/dev/null) || err=/dev/null
        # on the viewer alone: this launcher routes its `ask` (#365), and its `a`
        # adds to the basket of the pane the file came from (#365 child 5);
        # COCKPIT_VIEW_BACK=1 from the browser, whose popup comes back on its close
        out=$(COCKPIT_VIEW_ASK=1 COCKPIT_BASKET_PANE="$bp" COCKPIT_VIEW_BACK=$BROWSE \
            "$COCKPIT_TUI_BIN" view ${ln:+--line "$ln"} -- "$file" 2>"$err"); rc=$?
        [ ! -s "$err" ] || cat "$err" >&2
        if tui_stale "$rc" "$err"; then rc=stale; fi
        [ "$err" = /dev/null ] || rm -f -- "$err"
        case $rc in
            0) ;;
            stale) note "cockpit: $TUI_STALE_MSG"; return 1 ;;
            *) note "cockpit: the viewer exited $rc · opening the editor"; return 1 ;;
        esac
        # what the viewer printed is untrusted until it is `edit <digits>` or
        # `ask <a> <b>`, two line numbers, a <= b; the file and the pane are this script's own
        if ! [[ $out =~ ^ask\ $n\ $n$ ]] || [ "${BASH_REMATCH[1]}" -gt "${BASH_REMATCH[2]}" ]; then
            break
        fi
        ln=${BASH_REMATCH[1]}
        "${d%/*}/cockpit-panel" -p "$pane" --ask "$file" "$ln" "${BASH_REMATCH[2]}"
        # a file gone meanwhile ends it, as the gates above would
        [ -f "$file" ] || return 0
    done
    # nothing printed is a plain close (q, esc): the browser takes that as back
    [[ $out =~ ^edit\ ([0-9]+)$ ]] || { [ -n "$out" ] || VIEW_CLOSED=1; return 0; }
    # a touch client has no use for VS Code: a terminal editor, at the line
    if touch_client; then term_edit "$file" "${BASH_REMATCH[1]}"; return 0; fi
    MD_EDIT=1 open_one "$file" "${BASH_REMATCH[1]}" ""
    return 0
}

# --- folder browser (#363) -------------------------------------------------------
# A touch client has no use for VS Code: it opens on the PC's desktop. #{E:..}
# expands the option as a format; unset or 0 is false.
touch_client() {
    local t
    t=$(tmux display-message -p -t "$pane" '#{E:@cockpit_is_touch}' 2>/dev/null)
    case $t in ""|0) return 1 ;; esac
}

# A terminal editor in a window of its own, in the file's folder; never VS Code.
term_edit() {
    local file=$1 ln=${2:-} editor fd bin wn at=
    [[ $ln =~ ^[0-9]+$ ]] || ln=
    editor=$(tmux show-options -gqv @cockpit_editor)
    [ -n "$editor" ] || editor=${VISUAL:-${EDITOR:-}}
    if [ -z "$editor" ]; then
        if command -v nvim >/dev/null 2>&1; then editor=nvim
        elif command -v vim >/dev/null 2>&1; then editor=vim; fi
    fi
    [ -n "$editor" ] || { note "cockpit: no terminal editor · set @cockpit_editor, \$VISUAL or \$EDITOR"; return 1; }
    # +N is the vi family's, nano's and emacs's way to a line; others get the file only
    bin=${editor%% *}; bin=${bin##*/}
    case $bin in vi|vim|nvim|nano|emacs|micro) at=${ln:++$ln} ;; esac
    fd=${file%/*}; fd=${fd:-/}
    wn=$(plain_name "${file##*/}")
    tmux new-window -t "$win" -a -c "$(fesc "$fd")" -n "$(fesc "$wn")" \
         "$editor ${at:+$at }$(shq "$file")" \
        || { note "cockpit: tmux could not open a window for ${wn:-a file}"; return 1; }
}

# The one line cockpit-tui files printed. It lists names anyone can create, so
# nothing is trusted until checked: one line, a known verb, an existing abs path.
browse_act() {
    local line=$1 verb path
    case $line in *$'\n'*) note "cockpit: the browser printed something that is not one line"; return 1 ;; esac
    verb=${line%% *}; path=${line#* }
    case $verb in open|view|copy|add) ;; *) verb='' ;; esac
    if [ "$verb" = "$line" ] || [ -z "$verb" ] \
       || [ "${path:0:1}" != / ] || [ ! -e "$path" ] \
       || { [ "$verb" = view ] && [ ! -f "$path" ]; } \
       || { [ "$verb" = add ] && { [ ! -f "$path" ] || [[ $path == *[[:cntrl:]]* ]]; }; }; then
        note "cockpit: the browser named something that is not a file here"; return 1
    fi
    # alt-a (#365 child 5): a regular file to the basket of this script's own
    # pane, and only a pane that reads %N
    if [ "$verb" = add ]; then
        local bp='' msg
        [[ $pane =~ ^%[0-9]+$ ]] && bp=$pane
        [ -n "$bp" ] || { note "cockpit: no pane to add the file for"; return 1; }
        msg=$("$COCKPIT_TUI_BIN" basket add "$bp" "$path" 2>/dev/null)
        note "cockpit: ${msg:-could not add the file}"; return 0
    fi
    if [ "$verb" = copy ]; then
        printf '%s\n' "$path" | tmux load-buffer -w - || { note "cockpit: could not copy"; return 1; }
        note "cockpit: copied ${path/#$H/\~}"; return 0
    fi
    # view: any regular file goes to the viewer, a touch client included (#406);
    # when the viewer cannot take it the file opens as `open` would
    if [ "$verb" = view ]; then md_view "$path" "" any && return 0; fi
    # open is the editor, markdown included (MD_EDIT skips open_one's viewer):
    # the viewer has its own verb now
    if [ ! -d "$path" ] && touch_client; then term_edit "$path"; else MD_EDIT=1 open_one "$path" "" ""; fi
}

# The browser's second line, `state <h> <i> <filter>` (COCKPIT_FILES_STATE=1,
# #574), as the flags that start it that way again, in STATE. A filter with a
# control or bidi character or over 200 characters is dropped: the binary never
# prints one, so it is not the browser's. 1 when the line is not a state line.
# Characters, not bytes: a UTF-8 locale for the checks, whatever the caller's.
# With none to be had, a non-ASCII filter counts long and is dropped.
browse_state() {
    local re='^state ([01]) ([01]) (.*)$' f u bidi
    for u in C.UTF-8 en_US.UTF-8; do
        { local LC_ALL=$u; } 2>/dev/null
        f=$'\xc3\xa9'; [ "${#f}" != 1 ] || break     # é, one character
    done
    # U+061C, U+200E-200F, U+202A-202E, U+2066-2069 as UTF-8 bytes: $'\u' would
    # be turned into text in the locale the script was read in
    bidi=$'\xd8\x9c\xe2\x80\x8e\xe2\x80\x8f\xe2\x80\xaa\xe2\x80\xab\xe2\x80\xac'
    bidi+=$'\xe2\x80\xad\xe2\x80\xae\xe2\x81\xa6\xe2\x81\xa7\xe2\x81\xa8\xe2\x81\xa9'
    STATE=()
    case $1 in *$'\n'*) return 1 ;; esac
    [[ $1 =~ $re ]] || return 1
    [ "${BASH_REMATCH[1]}" = 0 ] || STATE+=(--hidden)
    [ "${BASH_REMATCH[2]}" = 0 ] || STATE+=(--ignored)
    f=${BASH_REMATCH[3]}
    [ -z "$f" ] || [[ $f == *[[:cntrl:]]* || $f == *["$bidi"]* ]] || [ "${#f}" -gt 200 ] \
        || STATE+=(--filter "$f")
}

# --folder asks for a popup, which re-enters as --browse: run-shell has no terminal.
# A viewer closed with nothing done (VIEW_CLOSED) brings the browser back in the
# file's folder, on the file, with its toggles and filter; a loop, not a call per
# view. The loop's folder is `at`: `dir` stays the pane's, the editor window's -c
# in open_one.
browse_folder() {
    local pw ph err key rc sel='' path at=$dir
    local -a STATE=()
    # shellcheck source=lib/tui.sh
    . "${d%/*}/lib/tui.sh" 2>/dev/null && [ -x "$COCKPIT_TUI_BIN" ] \
        || { note "cockpit: cockpit-tui is missing · run scripts/tui-fetch"; return 1; }
    if [ "$BROWSE" -eq 0 ]; then
        pw=$(tmux show-option -gqv @cockpit_popup_width);  pw=${pw:-70%}
        ph=$(tmux show-option -gqv @cockpit_popup_height); ph=${ph:-70%}
        tmux display-popup -t "$pane" -E -w "$pw" -h "$ph" \
            -T " files · #{b:pane_current_path} " "$(shq "$0") --browse $(shq "$pane")"
        return 0
    fi
    while :; do
        # the viewed file's folder gone meanwhile: back where the browser started
        [ -d "$at" ] || { at=$dir; sel=''; }
        # back from the viewer: a binary without --select or the state flags, or
        # a name it cannot take (not UTF-8), still reopens the folder, on its
        # first row, fresh
        if [ -n "$sel" ]; then
            key=$(COCKPIT_FILES_STATE=1 "$COCKPIT_TUI_BIN" files "$at" --select "$sel" \
                ${STATE[@]+"${STATE[@]}"} 2>/dev/null); rc=$?
            # 101 and up is a panic or a signal, not an old binary: leave a trace
            [ "$rc" -lt 101 ] || printf 'cockpit: files --select exited %s\n' "$rc" >&2
            [ "$rc" -le 1 ] || sel=''
        fi
        if [ -z "$sel" ]; then
            # stderr to a file: a cockpit-tui older than this script is told apart from a crash
            err=$(mktemp 2>/dev/null) || err=/dev/null
            key=$(COCKPIT_FILES_STATE=1 "$COCKPIT_TUI_BIN" files "$at" 2>"$err"); rc=$?
            [ ! -s "$err" ] || cat "$err" >&2
            if tui_stale "$rc" "$err"; then
                [ "$err" = /dev/null ] || rm -f -- "$err"
                note "cockpit: $TUI_STALE_MSG"; return 1
            fi
            [ "$err" = /dev/null ] || rm -f -- "$err"
        fi
        # a second line is the state; anything else after the answer stays in
        # it, and browse_act refuses a line that is not one
        STATE=()
        case $key in *$'\n'*) browse_state "${key#*$'\n'}" && key=${key%%$'\n'*} ;; esac
        case "$rc" in
            0) VIEW_CLOSED=''; browse_act "$key"; rc=$?
               [ -n "$VIEW_CLOSED" ] || return "$rc"
               # browse_act took the line: one line, `view <an existing abs path>`
               path=${key#* }; at=${path%/*}; at=${at:-/}; sel=${path##*/} ;;
            1) return 0 ;;
            *) printf 'cockpit: files exited %s · see the lines above\n' "$rc" >&2
               read -rsn1 -p '[any key]'; return 1 ;;
        esac
    done
}

if [ "$DRY" -eq 1 ]; then
    dir=${1:-$PWD}; line=${2:-}; pane=""; win=""
else
    pane=${1:-}
    [ -n "$pane" ] || {
        printf 'usage: tmux-open-path [--pick | --folder | --browse] <pane-id>\n' >&2
        printf '       tmux-open-path --dry-run <dir> <line>\n' >&2
        exit 2
    }
    # Left set: the popup re-derives the list from it, and each click rewrites it.
    line=$(tmux show-options -p -t "$pane" -qv @cockpit_click_line)
    dir=$(tmux display-message -p -t "$pane" '#{pane_current_path}')
    win=$(tmux display-message -p -t "$pane" '#{window_id}')
    if [ "$FOLDER" -eq 1 ] || [ "$BROWSE" -eq 1 ]; then
        [ -n "$dir" ] || { note "cockpit: the pane has no folder"; exit 1; }
        browse_folder; exit $?
    fi
    [ "$VIEW" -eq 0 ] || { open_one "${2:-}" "${3:-}" ""; exit 0; }
fi

[ -n "$line" ] || {
    note "cockpit: no line under the click · click a line that names a path"; exit 0; }

# --- candidates ---------------------------------------------------------------
# Every token that exists on disk, in line order: existence is the one test a
# word that merely looks like a path cannot fool.
declare -a FILES=() LINES=() COLS=()
declare -A seen=()

consider() {  # consider <path> <line> <col> — record it if it exists
    local p=$1 l=$2 c=$3 abs
    [ -n "$p" ] || return 0
    case "$p" in
        "~") p="$H" ;;
        "~/"*) p="$H/${p#\~/}" ;;
    esac
    case "$p" in
        /*) abs=$p ;;
        *)  abs=$dir/$p ;;
    esac
    [ -e "$abs" ] || return 1
    abs=${abs//\/.\//\/}                    # "dir/./bin/x" reads badly in the message
    [ -z "${seen[$abs]:-}" ] || return 0
    seen[$abs]=1
    FILES+=("$abs"); LINES+=("$l"); COLS+=("$c")
    return 0
}

# Strip wrapping punctuation off both ends. The leading set is explicit, not
# [:punct:], which holds / ~ . _. The answer is in $TOK: $(...) would fork per token.
strip_ends() {
    TOK=$1
    while [ -n "$TOK" ]; do
        case "$TOK" in
            [\(\[\{\'\"\`\<]*) TOK=${TOK#?} ;;
            *) break ;;
        esac
    done
    while [ -n "$TOK" ]; do
        # Keep the ")" of tsc/MSVC's "file(12,3)".
        [[ $TOK =~ \([0-9]+,[0-9]+\)$ ]] && break
        # And of "Write(src/a.ts)": it marks the wrapper the loop unwraps.
        [[ $TOK =~ ^[A-Za-z_][A-Za-z0-9_-]*\(.+\)$ ]] && break
        case "$TOK" in
            *[\)\]\}\'\"\`,\;:.]) TOK=${TOK%?} ;;
            *) break ;;
        esac
    done
}

# One token, in the shapes tools print paths in. 0 when it recorded something.
try_token() {
    local tok=$1
    # file(12,3) — the shape tsc and MSVC print.
    if [[ $tok =~ ^(.+)\(([0-9]+),([0-9]+)\)$ ]]; then
        consider "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" && return 0
    fi
    # file:12:3 and file:12 — grep, eslint, stack traces, every compiler.
    if [[ $tok =~ ^(.+):([0-9]+):([0-9]+)$ ]]; then
        consider "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" && return 0
    fi
    if [[ $tok =~ ^(.+):([0-9]+)$ ]]; then
        consider "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "" && return 0
    fi
    consider "$tok" "" "" && return 0
    # git diff headers name the same file twice, as a/path and b/path.
    case "$tok" in
        a/*|b/*) consider "${tok#?/}" "" "" && return 0 ;;
    esac
    return 1
}

# set -f: word splitting also globs, and "rm *" on a line expanded against the
# server's cwd into files that existed and got opened.
set -f
ntok=0
for raw in $line; do
    ntok=$((ntok + 1))
    # 0.31 ms a token: a 112 KB line took 1.59 s, so cap rather than stall.
    [ "$ntok" -gt 500 ] && break
    strip_ends "$raw"; tok=$TOK
    [ -n "$tok" ] || continue
    try_token "$tok" && continue
    # Claude Code's Write(path), Read(path:12): unwrap and try the inside, but
    # not tsc's file(12,3). Two statements: in one `[[ ]] && [[ ]]` chain bash
    # clears BASH_REMATCH before the second expands, and set -u dies.
    if [[ $tok =~ ^[A-Za-z_][A-Za-z0-9_-]*\((.+)\)$ ]]; then
        inner=${BASH_REMATCH[1]}
        if ! [[ $inner =~ ^[0-9]+,[0-9]+$ ]]; then
            strip_ends "$inner"
            [ -n "$TOK" ] && try_token "$TOK" && continue
        fi
    fi
done
set +f

if [ "$DRY" -eq 1 ]; then
    for i in "${!FILES[@]}"; do
        printf '%s:%s:%s\n' "${FILES[$i]}" "${LINES[$i]:-}" "${COLS[$i]:-}"
    done
    exit 0
fi

if [ ${#FILES[@]} -eq 0 ]; then
    note "cockpit: no file on that line · nothing there resolved on disk"
    exit 0
fi

if [ ${#FILES[@]} -eq 1 ]; then
    open_one "${FILES[0]}" "${LINES[0]}" "${COLS[0]}"; exit 0
fi

# Several: a popup re-enters with --pick and rebuilds the list. A missing binary
# is said before the popup opens.
# shellcheck source=lib/tui.sh
. "${d%/*}/lib/tui.sh" 2>/dev/null && [ -x "$COCKPIT_TUI_BIN" ] \
    || { note "cockpit: cockpit-tui is missing · run scripts/tui-fetch"; exit 0; }
if [ "$PICK" -eq 0 ]; then
    pw=$(tmux show-option -gqv @cockpit_popup_width);  pw=${pw:-70%}
    ph=$(tmux show-option -gqv @cockpit_popup_height); ph=${ph:-70%}
    tmux display-popup -t "$pane" -E -w "$pw" -h "$ph" \
        -T " open path · #{b:pane_current_path} " \
        "$(shq "$0") --pick $(shq "$pane")"
    exit 0
fi

# pick prints the candidate's index, never the path, so a name with a tab or a
# newline cannot pass for a row.
rows=''
for i in "${!FILES[@]}"; do
    case "${FILES[$i]}" in
        "$dir"/*) disp=${FILES[$i]#"$dir"/} ;;
        *)        disp=${FILES[$i]/#$H/\~} ;;
    esac
    disp="$disp${LINES[$i]:+:${LINES[$i]}}"
    # pick strips control characters from a display; a tab would split it.
    disp=${disp//$'\t'/ }; disp=${disp//$'\n'/ }
    rows+="$i"$'\t'"$disp"$'\n'
done
# Stderr to a file: a cockpit-tui without --copy is told apart from a crash.
err=$(mktemp 2>/dev/null) || err=/dev/null
trap '[ "$err" = /dev/null ] || rm -f -- "$err"' EXIT
trap 'exit 130' INT TERM HUP
key=$(printf '%s' "$rows" | "$COCKPIT_TUI_BIN" pick --copy --prompt 'open' \
      --header 'open which path' 2>"$err"); rc=$?
[ ! -s "$err" ] || cat "$err" >&2
if tui_stale "$rc" "$err"; then note "cockpit: $TUI_STALE_MSG"; exit 1; fi
case "$rc" in
    0|10) ;;
    1)    exit 0 ;;
    *)    printf 'cockpit: pick exited %s · see the lines above\n' "$rc" >&2
          read -rsn1 -p '[any key]'; exit 1 ;;
esac
# The picker is untrusted text until proven an index into FILES.
[[ $key =~ ^[0-9]+$ ]] && [ "$key" -lt "${#FILES[@]}" ] \
    || { note "cockpit: the picker named something that is not a candidate"; exit 1; }
if [ "$rc" -eq 10 ]; then
    # alt-c: the path, absolute, to the client's clipboard and the paste buffer.
    printf '%s\n' "${FILES[$key]}" | tmux load-buffer -w - \
        || { note "cockpit: could not copy"; exit 1; }
    note "cockpit: copied ${FILES[$key]/#$H/\~}"; exit 0
fi
open_one "${FILES[$key]}" "${LINES[$key]}" "${COLS[$key]}"
