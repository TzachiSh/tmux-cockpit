#!/usr/bin/env bash
# tmux-open-path — pick a path off the line you clicked, and open it.
#   tmux-open-path <pane-id>                 picker for that pane's @cockpit_click_line
#   tmux-open-path --dry-run <dir> <line>   what a click on <line> would open
#
# --dry-run touches no tmux and opens nothing: it prints one "path:line:col" per
# candidate. Use it when a click did nothing and you want to see what the line
# actually resolved to.
#
# Bound to M-MouseDown1Pane, which stashes the clicked line in the pane option
# @cockpit_click_line first. It reads the whole LINE, not the word under the cursor:
# tmux's word-separators include / . : and -, so #{mouse_word} on
# "src/foo-bar.ts:31" hands back "foo", which is not a file.
#
# One candidate opens at once, a directory included. Several open the picker
# (cockpit-tui pick, the same popup the branch segment gives you): ↵ opens the
# row, alt-c copies its absolute path.
#   tmux-open-path --folder <pane-id>      browse that pane's folder (cockpit-tui files)
#
# --folder opens a popup running cockpit-tui files on the pane's folder. ↵ on a
# file prints "open <path>", alt-c "copy <path>". The line is untrusted: one
# line, a known verb, an absolute path that exists. On a touch client
# (@cockpit_is_touch) a file opens in a terminal editor window (@cockpit_editor,
# else $VISUAL, $EDITOR, nvim, vim), since VS Code would open on the PC's screen;
# elsewhere it opens as a clicked path does.
#
# Editor: VS Code by default, jumping to the line. For a terminal editor instead:
#   set -g @cockpit_editor nvim   # opens in a new tmux window at +LINE
set -uo pipefail

# bash 4+ (4.4 for `mapfile -d` in tmux-where). Without this the 3.2 failure is
# silent and wrong rather than loud: `declare -A` errors, then the same
# assignment quietly creates an INDEXED array with an arithmetic subscript.
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
    printf '%s needs bash 4 or newer (found %s). On macOS: brew install bash\n' \
           "${BASH_SOURCE[0]##*/}" "${BASH_VERSION:-unknown}" >&2
    exit 1
fi
d=${BASH_SOURCE[0]}; [ -L "$d" ] && d=$(readlink "$d")
# shellcheck source=lib/fmt.sh
. "${d%/*}/lib/fmt.sh" || exit 1   # fesc (#289)

# Under `set -u` a bare $HOME aborts the whole script where HOME is unset -- a
# run-shell from a stripped environment, or a systemd-launched tmux. tmux-where
# already guards this; a "~/..." token on a clicked line used to kill this one.
H=${HOME:-/nonexistent}

# --- vscode -------------------------------------------------------------------
# Sourced on demand, not at startup: most clicks never reach VS Code. lib/ sits
# beside the REAL script; install.sh links it by absolute path.
vscode_lib() {
    local d=${BASH_SOURCE[0]}; [ -L "$d" ] && d=$(readlink "$d")
    # shellcheck source=lib/vscode.sh
    . "${d%/*}/lib/vscode.sh" 2>/dev/null && return 0
    # A half-installed copy (scripts/ without lib/) must still open files the
    # ordinary ways rather than die on an undefined function.
    vscode_shim() { return 1; }
    vscode_open() { return 1; }
}

# Fire-and-forget: open_one hands this to `run-shell -b` because a popup kills
# its own process group, so nobody is left to read a failure. No fallback here
# for the same reason -- editor_cmd in tmux-review is where one can be seen.
if [ "${1:-}" = --vscode ]; then
    shift
    vscode_lib
    vscode_open "$@"
    exit $?
fi

PICK=0 DRY=0 FOLDER=0 BROWSE=0
[ "${1:-}" = --folder ]  && { FOLDER=1; shift; } # the pane's folder, in the browser
[ "${1:-}" = --browse ]  && { BROWSE=1; shift; } # re-entry from the browser's popup
[ "${1:-}" = --pick ]    && { PICK=1; shift; }   # re-entry from the popup below
[ "${1:-}" = --dry-run ] && { DRY=1;  shift; }

# display-message expands formats: a clicked name like x#(cmd).txt must show, not run (#289)
note() { [ "$DRY" -eq 1 ] || tmux display-message "$(fesc "$*")"; }

# --- open ---------------------------------------------------------------------
# tmux runs these command strings through sh, so every path in one has to be
# shell-quoted. Wrapping it in single quotes by hand breaks on the first path
# containing a quote -- the quote closes early and the rest of the name is read
# as syntax, which opens the wrong file or runs a word of it as a command.
shq() { printf '%q' "$1"; }

open_one() {
    local file=$1 ln=$2 col=$3 editor
    vscode_lib
    editor=$(tmux show-options -gqv @cockpit_editor)
    if [ -z "$editor" ]; then
        # The old, unprefixed name. Kept working for one release; it is generic
        # enough that another plugin could reasonably want it.
        editor=$(tmux show-options -gqv @open-editor)
        [ -n "$editor" ] && tmux display-message \
            "cockpit: @open-editor renamed @cockpit_editor · update your tmux.conf"
    fi
    # VS Code stays the default, but only where it is actually installed --
    # either as code(1) on PATH, or as the remote shim under ~/.vscode-server
    # that Remote-SSH and Coder install instead. Otherwise fall back to the
    # editor the user already told the shell about.
    if [ -z "$editor" ] && ! command -v code >/dev/null 2>&1 && ! vscode_shim >/dev/null; then
        editor=${VISUAL:-${EDITOR:-}}
    fi
    if [ -n "$editor" ]; then
        # A terminal editor gets a tmux window of its own, next to the output you
        # clicked from. -t is not optional: without it the window is created in
        # whichever session tmux considers current, which is the session with the
        # most recent client -- not necessarily the one you clicked in. It takes a
        # WINDOW, not a pane, so -a puts the new one right after the clicked one.
        # -c and -n expand formats, the command body does not (#289): escape
        # the first two only, or a # in the name reaches the editor doubled.
        tmux new-window -t "$win" -a -c "$(fesc "$dir")" -n "$(fesc "${file##*/}")" \
             "$editor ${ln:++$ln} $(shq "$file")"
        return
    fi
    if command -v code >/dev/null 2>&1; then
        # Launched by the tmux SERVER, not by this script. This runs inside the
        # picker popup, and a popup kills its whole process group the moment it
        # closes -- which is immediately, since the script exits right after.
        # A plain `code ... &` therefore died before it could hand the file to
        # the running VS Code window, and nothing opened. Measured: a child
        # backgrounded in a popup never survives; one owned by the server does.
        if [ -d "$file" ]; then
            # A folder is a workspace, not a file spec: --goto on a directory
            # parses it as file:line and does not open the folder.
            tmux run-shell -b "$(fesc "code $(shq "$file") >/dev/null 2>&1")"
        else
            tmux run-shell -b \
                "$(fesc "code --goto $(shq "$file:${ln:-1}:${col:-1}") >/dev/null 2>&1")"
        fi
        note "cockpit: opened ${file/#$H/\~}${ln:+:$ln}"
        return
    fi
    # Remote-SSH and Coder: VS Code is right there, but its CLI is not on the
    # PATH tmux was started with. Same run-shell -b as above, re-entering this
    # script so the socket probe (which runs the shim, ~150 ms per dead socket)
    # happens off the popup's dying process group.
    if vscode_shim >/dev/null; then
        if [ -d "$file" ]; then
            tmux run-shell -b "$(fesc "$(shq "$0") --vscode $(shq "$file") >/dev/null 2>&1")"
        else
            tmux run-shell -b "$(fesc "$(shq "$0") --vscode --goto \
$(shq "$file:${ln:-1}:${col:-1}") >/dev/null 2>&1")"
        fi
        note "cockpit: opened ${file/#$H/\~}${ln:+:$ln}"
        return
    fi
    # Saying "opened" for a command that was never found is worse than doing
    # nothing: it sends you looking for the bug anywhere but here.
    note "cockpit: no editor · set @cockpit_editor, \$VISUAL or install code"
}

# --- folder browser (#363) -------------------------------------------------------
# A touch client has no use for VS Code: it opens on the PC's desktop. #{E:..}
# expands the option as a format, as the status bar does; unset or 0 is false.
touch_client() {
    local t
    t=$(tmux display-message -p -t "$pane" '#{E:@cockpit_is_touch}' 2>/dev/null)
    case $t in ""|0) return 1 ;; esac
}

# A terminal editor in a window of its own, in the file's folder. Unlike open_one
# this never reaches for VS Code: the caller decided the client cannot see it.
term_edit() {
    local file=$1 editor fd
    editor=$(tmux show-options -gqv @cockpit_editor)
    [ -n "$editor" ] || editor=${VISUAL:-${EDITOR:-}}
    if [ -z "$editor" ]; then
        if command -v nvim >/dev/null 2>&1; then editor=nvim
        elif command -v vim >/dev/null 2>&1; then editor=vim; fi
    fi
    [ -n "$editor" ] || { note "cockpit: no terminal editor · set @cockpit_editor, \$VISUAL or \$EDITOR"; return 1; }
    fd=${file%/*}; fd=${fd:-/}
    tmux new-window -t "$win" -a -c "$(fesc "$fd")" -n "$(fesc "${file##*/}")" \
         "$editor $(shq "$file")"
}

# Acts on the one line cockpit-tui files printed. It is text from a program that
# lists names anyone can create, so nothing is trusted until it is checked.
browse_act() {
    local line=$1 verb path
    case $line in *$'\n'*) note "cockpit: the browser printed something that is not one line"; return 1 ;; esac
    verb=${line%% *}; path=${line#* }
    if [ "$verb" = "$line" ] || { [ "$verb" != open ] && [ "$verb" != copy ]; } \
       || [ "${path:0:1}" != / ] || [ ! -e "$path" ]; then
        note "cockpit: the browser named something that is not a file here"; return 1
    fi
    if [ "$verb" = copy ]; then
        printf '%s\n' "$path" | tmux load-buffer -w - || { note "cockpit: could not copy"; return 1; }
        note "cockpit: copied ${path/#$H/\~}"; return 0
    fi
    if [ ! -d "$path" ] && touch_client; then term_edit "$path"; else open_one "$path" "" ""; fi
}

# --folder asks for a popup, which re-enters as --browse: run-shell has no
# terminal to draw on, and the popup is where the printed line can be read.
browse_folder() {
    local pw ph err key rc
    # shellcheck source=lib/tui.sh
    . "${d%/*}/lib/tui.sh" 2>/dev/null && [ -x "$COCKPIT_TUI_BIN" ] \
        || { note "cockpit: cockpit-tui is missing · run scripts/tui-fetch"; return 1; }
    if [ "$BROWSE" -eq 0 ]; then
        pw=$(tmux show-option -gqv @cockpit_popup_width);  pw=${pw:-70%}
        ph=$(tmux show-option -gqv @cockpit_popup_height); ph=${ph:-70%}
        tmux display-popup -t "$pane" -E -w "$pw" -h "$ph" \
            -T " files · #{b:pane_current_path} " "$(shq "$0") --browse $(shq "$pane")"
        return 0
    fi
    # stderr to a file: a cockpit-tui older than this script is told apart from a crash
    err=$(mktemp 2>/dev/null) || err=/dev/null
    key=$("$COCKPIT_TUI_BIN" files "$dir" 2>"$err"); rc=$?
    [ ! -s "$err" ] || cat "$err" >&2
    if tui_stale "$rc" "$err"; then
        [ "$err" = /dev/null ] || rm -f -- "$err"
        note "cockpit: $TUI_STALE_MSG"; return 1
    fi
    [ "$err" = /dev/null ] || rm -f -- "$err"
    case "$rc" in
        0) browse_act "$key" ;;
        1) return 0 ;;
        *) printf 'cockpit: files exited %s · see the lines above\n' "$rc" >&2
           read -rsn1 -p '[any key]'; return 1 ;;
    esac
}

if [ "$DRY" -eq 1 ]; then
    dir=${1:-$PWD}; line=${2:-}; pane=""; win=""
else
    pane=${1:-}
    [ -n "$pane" ] || {
        printf 'usage: tmux-open-path [--pick | --folder] <pane-id>\n' >&2
        printf '       tmux-open-path --dry-run <dir> <line>\n' >&2
        exit 2
    }
    # The binding rewrites @cockpit_click_line on every click, so there is nothing stale
    # to clear -- and leaving it set is what lets the popup re-derive this list.
    line=$(tmux show-options -p -t "$pane" -qv @cockpit_click_line)
    dir=$(tmux display-message -p -t "$pane" '#{pane_current_path}')
    win=$(tmux display-message -p -t "$pane" '#{window_id}')
    # The cockpit table's o (the menu's Browse folder row and the status-bar path
    # tap replay it) browses the pane's folder (#363).
    if [ "$FOLDER" -eq 1 ] || [ "$BROWSE" -eq 1 ]; then
        [ -n "$dir" ] || { note "cockpit: the pane has no folder"; exit 1; }
        browse_folder; exit $?
    fi
fi

[ -n "$line" ] || {
    note "cockpit: no line under the click · click a line that names a path"; exit 0; }

# --- candidates ---------------------------------------------------------------
# Every token on the line that resolves to something on disk, in the order they
# appear. Existence is the filter: it is the only test that cannot be fooled by a
# word that merely looks like a path.
declare -a FILES=() LINES=() COLS=()
declare -A seen=()

consider() {  # consider <path> <line> <col> — record it if it exists
    local p=$1 l=$2 c=$3 abs
    [ -n "$p" ] || return 0
    case "$p" in
        "~") p="$H" ;;
        "~/"*) p="$H/${p#\~/}" ;;
    esac
    case "$p" in
        /*) abs=$p ;;
        *)  abs=$dir/$p ;;
    esac
    [ -e "$abs" ] || return 1
    abs=${abs//\/.\//\/}                    # "dir/./bin/x" reads badly in the message
    [ -z "${seen[$abs]:-}" ] || return 0
    seen[$abs]=1
    FILES+=("$abs"); LINES+=("$l"); COLS+=("$c")
    return 0
}

# Terminals wrap paths in punctuation: "src/a.ts", (src/a.ts), 'src/a.ts',
# and prose ends them with , ; or a full stop. Strip both ends, not the
# middle -- a path may legitimately contain almost anything else.
# Leading strip is an explicit set, NOT [:punct:]: that class contains / ~ .
# and _, so it ate the first character of every absolute and ~ path.
#
# The answer lands in $TOK rather than on stdout: a command substitution is a
# fork, and this runs once per token on the line, twice for a wrapped one.
strip_ends() {
    TOK=$1
    while [ -n "$TOK" ]; do
        case "$TOK" in
            [\(\[\{\'\"\`\<]*) TOK=${TOK#?} ;;
            *) break ;;
        esac
    done
    while [ -n "$TOK" ]; do
        # Stop before eating the ")" of "file(12,3)" -- tsc and MSVC print that
        # shape, and losing the bracket turns the location into unparseable text.
        [[ $TOK =~ \([0-9]+,[0-9]+\)$ ]] && break
        # Same for the ")" of "Write(src/a.ts)": that bracket is what marks the
        # token as a wrapper worth unwrapping below. Strip it and the token
        # becomes "Write(src/a.ts", which is nothing at all.
        [[ $TOK =~ ^[A-Za-z_][A-Za-z0-9_-]*\(.+\)$ ]] && break
        case "$TOK" in
            *[\)\]\}\'\"\`,\;:.]) TOK=${TOK%?} ;;
            *) break ;;
        esac
    done
}

# One token, in the shapes tools print paths in. 0 when it recorded something.
try_token() {
    local tok=$1
    # file(12,3) — the shape tsc and MSVC print.
    if [[ $tok =~ ^(.+)\(([0-9]+),([0-9]+)\)$ ]]; then
        consider "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" && return 0
    fi
    # file:12:3 and file:12 — grep, eslint, stack traces, every compiler.
    if [[ $tok =~ ^(.+):([0-9]+):([0-9]+)$ ]]; then
        consider "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" && return 0
    fi
    if [[ $tok =~ ^(.+):([0-9]+)$ ]]; then
        consider "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "" && return 0
    fi
    consider "$tok" "" "" && return 0
    # git diff headers name the same file twice, as a/path and b/path.
    case "$tok" in
        a/*|b/*) consider "${tok#?/}" "" "" && return 0 ;;
    esac
    return 1
}

# Splitting $line uses the shell's own word rules, and those include PATHNAME
# EXPANSION. A line that merely mentioned a wildcard -- "rm *", a compiler note
# containing [ab]* -- was expanded against this process's cwd, inventing tokens
# that the existence check below then accepted as real candidates. Under
# run-shell that cwd is the tmux server's, which is very often the same tree the
# pane is in, so the invented files existed and got opened. -f keeps the tokens
# literal; nothing here wants a glob.
set -f
ntok=0
for raw in $line; do
    ntok=$((ntok + 1))
    # 0.31ms/token, linear: a real clicked line has a handful of tokens, but a
    # 112KB line (4000 path-shaped tokens) measured 1.59s in this loop alone.
    # Capped: degrade, don't stall the click.
    [ "$ntok" -gt 500 ] && break
    strip_ends "$raw"; tok=$TOK
    [ -n "$tok" ] || continue
    try_token "$tok" && continue
    # Claude Code prints its tool calls as Write(path), Read(path:12),
    # Edit(path) -- the path is real, the Name( ) around it is not, and the
    # whole token resolves to nothing. Unwrap and try the inside, itself
    # stripped so a nested "(Write(a.ts))" still lands.
    #
    # The tsc shape file(12,3) is NOT this and must not be unwrapped: its
    # inner is a line/column pair, try_token already resolved it above, and
    # a bare "12,3" would then be looked up as a filename.
    #
    # The two tests are separate statements on purpose: written as one
    # "[[ a ]] && [[ ${BASH_REMATCH[1]} ]]" chain, bash clears BASH_REMATCH
    # before the second operand expands, and `set -u` kills the script with
    # "BASH_REMATCH[1]: unbound variable" on the first Write(...) line.
    if [[ $tok =~ ^[A-Za-z_][A-Za-z0-9_-]*\((.+)\)$ ]]; then
        inner=${BASH_REMATCH[1]}
        if ! [[ $inner =~ ^[0-9]+,[0-9]+$ ]]; then
            strip_ends "$inner"
            [ -n "$TOK" ] && try_token "$TOK" && continue
        fi
    fi
done
set +f

if [ "$DRY" -eq 1 ]; then
    for i in "${!FILES[@]}"; do
        printf '%s:%s:%s\n' "${FILES[$i]}" "${LINES[$i]:-}" "${COLS[$i]:-}"
    done
    exit 0
fi

if [ ${#FILES[@]} -eq 0 ]; then
    # A popup you have to dismiss is the wrong answer to "there was nothing
    # there" -- the status line says it and gets out of the way.
    note "cockpit: no file on that line · nothing there resolved on disk"
    exit 0
fi

# One candidate is not a question: it opens at once, a directory included.
if [ ${#FILES[@]} -eq 1 ]; then
    open_one "${FILES[0]}" "${LINES[0]}" "${COLS[0]}"; exit 0
fi

# Several: ask. The click arrives via run-shell, which has no terminal, so the
# picker needs a popup -- which re-enters this script with --pick and rebuilds
# the same list. A missing binary is said before the popup opens, not after it
# has flashed.
# shellcheck source=lib/tui.sh
. "${d%/*}/lib/tui.sh" 2>/dev/null && [ -x "$COCKPIT_TUI_BIN" ] \
    || { note "cockpit: cockpit-tui is missing · run scripts/tui-fetch"; exit 0; }
if [ "$PICK" -eq 0 ]; then
    # Geometry comes from the same options the branch popup uses, read at click
    # time so changing them needs no reload.
    pw=$(tmux show-option -gqv @cockpit_popup_width);  pw=${pw:-70%}
    ph=$(tmux show-option -gqv @cockpit_popup_height); ph=${ph:-70%}
    tmux display-popup -t "$pane" -E -w "$pw" -h "$ph" \
        -T " open path · #{b:pane_current_path} " \
        "$(shq "$0") --pick $(shq "$pane")"
    exit 0
fi

# cockpit-tui pick draws the list on /dev/tty and prints the chosen key. The key
# is the candidate's index and nothing else: the path never travels through the
# picker, so a name with a tab or a newline in it cannot be mistaken for a row.
# The display is relative to the pane's own directory when the candidate is under
# it, which is how the token read in the output, with the line number kept.
rows=''
for i in "${!FILES[@]}"; do
    case "${FILES[$i]}" in
        "$dir"/*) disp=${FILES[$i]#"$dir"/} ;;
        *)        disp=${FILES[$i]/#$H/\~} ;;
    esac
    disp="$disp${LINES[$i]:+:${LINES[$i]}}"
    # pick strips control characters from a display; a tab would split it.
    disp=${disp//$'\t'/ }; disp=${disp//$'\n'/ }
    rows+="$i"$'\t'"$disp"$'\n'
done
# Stderr goes to a file so a cockpit-tui older than this script (it does not know
# --copy) can be told apart from a crash, as tm and tmux-branch do.
err=$(mktemp 2>/dev/null) || err=/dev/null
trap '[ "$err" = /dev/null ] || rm -f -- "$err"' EXIT
trap 'exit 130' INT TERM HUP
key=$(printf '%s' "$rows" | "$COCKPIT_TUI_BIN" pick --copy --prompt 'open' \
      --header 'open which path' 2>"$err"); rc=$?
[ ! -s "$err" ] || cat "$err" >&2
if tui_stale "$rc" "$err"; then note "cockpit: $TUI_STALE_MSG"; exit 1; fi
case "$rc" in
    0|10) ;;
    1)    exit 0 ;;
    *)    printf 'cockpit: pick exited %s · see the lines above\n' "$rc" >&2
          read -rsn1 -p '[any key]'; exit 1 ;;
esac
# The picker is untrusted text until proven an index into FILES.
[[ $key =~ ^[0-9]+$ ]] && [ "$key" -lt "${#FILES[@]}" ] \
    || { note "cockpit: the picker named something that is not a candidate"; exit 1; }
if [ "$rc" -eq 10 ]; then
    # alt-c: the path, absolute, to the client's clipboard and the paste buffer.
    printf '%s\n' "${FILES[$key]}" | tmux load-buffer -w - \
        || { note "cockpit: could not copy"; exit 1; }
    note "cockpit: copied ${FILES[$key]/#$H/\~}"; exit 0
fi
open_one "${FILES[$key]}" "${LINES[$key]}" "${COLS[$key]}"
