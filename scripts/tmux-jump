#!/usr/bin/env bash
# Jump to the next pane whose agent is waiting on you, across every session.
set -u

# The bind passes the pane: run-shell sets no $TMUX_PANE (#45).
cur="${1:-${TMUX_PANE:-}}"
blocked=()
pending=()
review_pending=()
# Sorted for a stable cycle. The agent-glob guard skips stale marks left on a
# pane that is no longer an agent.
# Cut by position, not `read id state review`: IFS splitting drops empty fields.
while IFS= read -r line; do
    id=${line%% *}
    rest=${line#* }
    state=${rest%% *}
    review=${rest#* }
    if [ "$state" = needs-input ]; then
        blocked+=("$id")
    elif [ "$review" = sent ]; then
        pending+=("$id")
    elif [ "$review" = pending ]; then
        review_pending+=("$id")
    fi
done < <(tmux list-panes -a -F '#{pane_id} #{?#{m:*|#{pane_current_command}|*,#{@cockpit_agents_glob}},#{@panestate},} #{?#{m:*|#{pane_current_command}|*,#{@cockpit_agents_glob}},#{@cockpit_review},}' 2>/dev/null | sort -t% -k2 -n)

# Order of urgency: blocked agents, unsent reviews, then unread diffs.
# The +alternate form: bash < 4.4 reads an empty array as unset under set -u.
blocked+=(${pending[@]+"${pending[@]}"})
blocked+=(${review_pending[@]+"${review_pending[@]}"})

if [ ${#blocked[@]} -eq 0 ]; then
    tmux display-message "cockpit: no agent needs you" 2>/dev/null
    exit 0
fi

next=${blocked[0]}
for i in "${!blocked[@]}"; do
    if [ "${blocked[$i]}" = "$cur" ]; then
        next=${blocked[$(( (i + 1) % ${#blocked[@]} ))]}
        break
    fi
done

# switch-client fails without a client; the selection below still applies.
tmux switch-client -t "$next" 2>/dev/null || true
tmux select-window -t "$next" 2>/dev/null
tmux select-pane   -t "$next" 2>/dev/null
exit 0
