#!/usr/bin/env bash
# tmux-branch — switch the git branch of a directory.
#   tmux-branch [-c pane_command] [-p pane_id] [dir]   dir defaults to $PWD
#   tmux-branch --title pane_id   keeps the popup's folder name on the pane, for prefix b
set -uo pipefail

# bash 4, as every cockpit script: lib/git.sh and the rest are not written for 3.2.
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
    printf '%s needs bash 4 or newer (found %s). On macOS: brew install bash\n' \
           "${BASH_SOURCE[0]##*/}" "${BASH_VERSION:-unknown}" >&2
    exit 1
fi
d=${BASH_SOURCE[0]}; case $d in (*/*) ;; (*) d=./$d ;; esac
[ -L "$d" ] && d=$(n=0
    while [ -L "$d" ] && [ $((n += 1)) -le 40 ] && t=$(readlink "$d"); do
        case $t in (/*) d=$t ;; (*) d=${d%/*}/$t ;; esac; done; printf %s "$d")
# shellcheck source=lib/pane.sh
. "${d%/*}/lib/pane.sh" || exit 1

PANE_CMD=""
PANE_ID=""
while [ $# -gt 0 ]; do
    case "$1" in
        -c) PANE_CMD="${2:-}"; shift 2 || break ;;
        -p) PANE_ID="${2:-}"; shift 2 || break ;;
        --title) TITLE_PANE="${2:-}"; shift 2 || break ;;
        -h|--help) sed -n '2,4p' "$0" >&2; exit 0 ;;
        --) shift; break ;;
        *)  break ;;
    esac
done

# prefix b's run-shell, before its popup opens (#1345): a binding cannot run
# pane_workdir, so this keeps the name of the folder the popup will use on the pane,
# and the popup's -T reads #{@cockpit_branch_title}. A format's value is not expanded
# again, so a # in the name stays text. Quiet and exit 0 on every path: run-shell
# shows any output or failure, and the popup opens after it either way.
if [ -n "${TITLE_PANE+x}" ]; then
    is_pane "$TITLE_PANE" || exit 0
    # shellcheck source=lib/workdir.sh
    . "${d%/*}/lib/workdir.sh" 2>/dev/null || exit 0
    t=$(pane_workdir "$TITLE_PANE"); t=${t%/}; t=${t##*/}
    tmux set-option -p -t "$TITLE_PANE" @cockpit_branch_title "${t:-/}" >/dev/null 2>&1
    exit 0
fi

# The client that pressed prefix b, left on the pane by the key (#360). Taken and
# cleared at start, before the other libs load (#480). That narrows the window to
# bash start and pane.sh; a press inside it still takes this run's pin.
CLIENT=""
[ -n "${TMUX:-}" ] && CLIENT=$(take_pane_opt "$PANE_ID" @cockpit_branch_client)

# The script's git reads look at the pane's own repo: a popup inherits tmux's
# environment, where a dotfiles setup's GIT_DIR would point them at another.
# git-env.sh strips what the picker's gitsafe strips (#730).
# shellcheck source=lib/git-env.sh
. "${d%/*}/lib/git-env.sh" || exit 1
# shellcheck source=lib/git.sh
. "${d%/*}/lib/git.sh" || exit 1
# shellcheck source=lib/tui.sh
. "${d%/*}/lib/tui.sh" || exit 1
# shellcheck source=lib/workdir.sh
. "${d%/*}/lib/workdir.sh" || exit 1
# shellcheck source=lib/fmt.sh
. "${d%/*}/lib/fmt.sh" || exit 1
# shellcheck source=lib/tmpdir.sh
. "${d%/*}/lib/tmpdir.sh" || exit 1

DIR="${1:-}"
# A popup's $PWD is the session's start dir, and a bare display-message picks
# the most recently active client. -p pins the pane the popup came from.
# The folder is the tree the board's row shows: an agent's declared @cockpit_dir,
# else pane_current_path (#1345).
if [ -z "$DIR" ] && [ -n "${TMUX:-}" ]; then
    if [ -n "$PANE_ID" ]; then
        DIR=$(pane_workdir "$PANE_ID")
        [ -n "$PANE_CMD" ] || PANE_CMD=$(tmux display-message -p -t "$PANE_ID" '#{pane_current_command}' 2>/dev/null)
    else
        DIR=$(pane_workdir "$(tmux display-message -p '#{pane_id}' 2>/dev/null)")
        [ -n "$PANE_CMD" ] || PANE_CMD=$(tmux display-message -p '#{pane_current_command}' 2>/dev/null)
    fi
fi
DIR="${DIR:-$PWD}"

# The popup closes when this script exits, taking any error with it.
pause() { printf '\n[any key]'; read -rsn1; }
fail()  { printf '%s\n' "$*" >&2; pause; exit 1; }

cd "$DIR" 2>/dev/null || fail "cockpit: no such directory: $DIR"

# tmux only knows the local cwd, so an ssh pane would name this machine's repo.
[ "$PANE_CMD" = ssh ] && fail "cockpit: this pane is inside ssh · $DIR is local, not that host"

# git() refuses a repo whose config names a filter driver with '=', and the rev-parse
# below would then read as "not a git repository" (#330). One line, before any git read.
if git_refused .; then fail "$GIT_REFUSAL"; fi

git rev-parse --git-dir >/dev/null 2>&1 || fail "cockpit: not a git repository: $DIR"

redraw() { [ -n "${TMUX:-}" ] && tmux refresh-client -S 2>/dev/null; return 0; }

# cockpit-tui draws the picker and runs every action itself, goto included (#228): a refusal
# is a note on its screen, and it prints nothing once an action ran. A line on stdout comes
# from a binary older than the plugin, and nothing here acts on it (#1271).
[ -x "$COCKPIT_TUI_BIN" ] || fail "cockpit: cockpit-tui is missing ($COCKPIT_TUI_BIN) · run scripts/tui-fetch"

# One stderr capture for the picker, removed on any exit, taken only when mktemp's answer
# is a new, empty file of the user's (#1322). Without one the picker runs as before, a stale
# binary is just "exited", and a message says why: the picker's alternate screen would cover
# a line on stderr, and the popup closes with the picker.
own_tmpfile err 2>/dev/null \
    || dmsg ${CLIENT:+-c "$CLIENT"} \
        "cockpit: no temp file for cockpit-tui's errors (own_tmpfile: $own_tmpfile_why)"
if [ -n "$err" ]; then
    trap 'trap "" HUP INT TERM; rm -f -- "$err"' EXIT  # a signal must not stop the rm (#1411)
    trap 'trap "" HUP INT TERM; exit 130' INT TERM HUP
fi

# The binary reads $COCKPIT_GLYPHS, never the option (#293), as tm passes it.
glyphs=$(tmux show-option -gqv @cockpit_glyphs 2>/dev/null)
[ -z "$glyphs" ] || export COCKPIT_GLYPHS="$glyphs"
# goto's origin pane and pinned client, in the environment. Set here, so none is inherited.
export COCKPIT_BRANCH_PANE="$PANE_ID" COCKPIT_BRANCH_CLIENT="$CLIENT"
if [ -n "$err" ]; then
    pick=$("$COCKPIT_TUI_BIN" branch -C "$PWD" 2>"$err"); rc=$?
    [ ! -s "$err" ] || cat "$err" >&2
    ! tui_stale "$rc" "$err" || fail "cockpit: $TUI_STALE_MSG"
else
    pick=$("$COCKPIT_TUI_BIN" branch -C "$PWD"); rc=$?
fi
case "$rc" in
    0) ;;
    1) exit 0 ;;
    *) pause; exit 1 ;;
esac
[ -z "$pick" ] \
    || fail "cockpit: unexpected answer from cockpit-tui: $pick"$'\n'"cockpit: $TUI_STALE_MSG"
redraw
