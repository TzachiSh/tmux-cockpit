#!/usr/bin/env bash
# tmux-branch — switch the git branch of a directory.
#   tmux-branch [-c pane_command] [-p pane_id] [dir]   dir defaults to $PWD
#
# Bound to a left-click on the branch segment of the tmux status bar, which is
# why every failure ends in a "press a key" pause: a popup that exits instantly
# would take its error message with it.
set -uo pipefail

# bash 4+ (4.4 for `mapfile -d` in tmux-where). Without this the 3.2 failure is
# silent and wrong rather than loud: `declare -A` errors, then the same
# assignment quietly creates an INDEXED array with an arithmetic subscript.
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
    printf '%s needs bash 4 or newer (found %s). On macOS: brew install bash\n' \
           "${BASH_SOURCE[0]##*/}" "${BASH_VERSION:-unknown}" >&2
    exit 1
fi

# Under `set -u` a bare $HOME aborts the script wherever HOME is unset -- a tmux
# server started by systemd or launchd. The other two scripts already guard it.
H=${HOME:-/nonexistent}

PANE_CMD=""
PANE_ID=""
while [ $# -gt 0 ]; do
    case "$1" in
        -c) PANE_CMD="${2:-}"; shift 2 || break ;;
        -p) PANE_ID="${2:-}"; shift 2 || break ;;
        -h|--help) sed -n '2,3p' "$0" >&2; exit 0 ;;
        --) shift; break ;;
        *)  break ;;
    esac
done

DIR="${1:-}"
# A popup is not a pane: it does not inherit the pane's cwd, and $TMUX_PANE inside
# it is not the pane you clicked from. Ask tmux which pane the client is actually
# on instead of trusting $PWD.
#
# Bare `display-message -p` (no -t) has no client of its own to resolve
# from inside a popup -- it falls back to whichever attached client was most
# recently active, which is often a DIFFERENT session than the one the popup
# was opened from -- and $PWD is worse: a popup starts in the SESSION's
# directory, the first window's. -p pane_id, when the caller has it (the
# binds in cockpit.tmux and full.tmux.conf's menu do), pins the query to the
# actual pane the popup came from; without it we fall back to best effort.
if [ -z "$DIR" ] && [ -n "${TMUX:-}" ]; then
    if [ -n "$PANE_ID" ]; then
        DIR=$(tmux display-message -p -t "$PANE_ID" '#{pane_current_path}' 2>/dev/null)
        [ -n "$PANE_CMD" ] || PANE_CMD=$(tmux display-message -p -t "$PANE_ID" '#{pane_current_command}' 2>/dev/null)
    else
        DIR=$(tmux display-message -p '#{pane_current_path}' 2>/dev/null)
        [ -n "$PANE_CMD" ] || PANE_CMD=$(tmux display-message -p '#{pane_current_command}' 2>/dev/null)
    fi
fi
DIR="${DIR:-$PWD}"

# --- output helpers ----------------------------------------------------------
# A popup dies the moment this script returns, so anything worth reading has to
# hold the window open itself.
pause() { printf '\n[any key]'; read -rsn1; }
fail()  { printf '%s\n' "$*" >&2; pause; exit 1; }

cd "$DIR" 2>/dev/null || fail "no such directory: $DIR"

# tmux only knows the LOCAL cwd, so a pane sitting in ssh would hand us this
# machine's repo — and switching a branch you cannot see is worse than refusing.
[ "$PANE_CMD" = ssh ] && fail "this pane is inside ssh; $DIR is local, not the host you are looking at"

git rev-parse --git-dir >/dev/null 2>&1 || fail "not a git repository: $DIR"

# Redraw the status bar now instead of waiting for the next status-interval tick.
redraw() { [ -n "${TMUX:-}" ] && tmux refresh-client -S 2>/dev/null; return 0; }

current=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || printf '')

# Last three path components; the leaf is what identifies the repo, and it was
# the part the header's truncation threw away.
tail3() {
    local p=${1/#$H/\~} a b c r
    r=$p; c=${r##*/}; r=${r%/*}
    [ "$r" = "$p" ] && { printf '%s' "$p"; return; }
    b=${r##*/}; r=${r%/*}
    [ "$r/$b" = "$p" ] || [ -z "$r" ] && { printf '%s' "$p"; return; }
    a=${r##*/}; r=${r%/*}
    if [ -z "$r" ] || [ "$r" = "$p" ] || [ "$r" = "~" ]; then
        printf '%s' "$p"
    else
        printf '…/%s/%s/%s' "$a" "$b" "$c"
    fi
}

# --- switching ---------------------------------------------------------------
# Checkout failures are the normal case, not the exception: a dirty tree, or a
# branch already checked out in another worktree. git's own message names the
# files or the worktree, so show it rather than a summary of it.
switch_to() {
    local target=$1 out
    if [ "$target" = "$current" ]; then
        printf 'already on %s\n' "$target"; redraw; sleep 0.4; return 0
    fi
    if out=$(git switch "$target" 2>&1); then
        printf '%s\n' "$out"; redraw; sleep 0.6; return 0
    fi
    printf '%s\n' "$out" >&2; pause; return 1
}

switch_remote() {  # origin/foo -> local foo tracking it
    local ref=$1 out
    if out=$(git switch --track "$ref" 2>&1); then
        printf '%s\n' "$out"; redraw; sleep 0.6; return 0
    fi
    printf '%s\n' "$out" >&2; pause; return 1
}

# Ask git what the name IS; never infer it from the shape of the string. A local
# branch is very often called "feature/one", so routing on a slash sent local
# branches down the remote path and created a stray "one" tracking branch.
route() {
    local name=$1
    if git show-ref --quiet --verify "refs/heads/$name"; then
        switch_to "$name"
    elif git show-ref --quiet --verify "refs/remotes/$name"; then
        switch_remote "$name"
    else
        fail "no such branch: $name"
    fi
}

create() {
    local name=$1 out
    # git's own ref rules, not a hand-rolled character class. Pause-and-return
    # rather than exit: the caller loops back into the picker.
    if ! git check-ref-format --branch "$name" >/dev/null 2>&1; then
        printf 'invalid branch name: %s\n' "$name" >&2; pause; return 1
    fi
    if out=$(git switch -c "$name" 2>&1); then
        printf '%s\n' "$out"; redraw; sleep 0.6; return 0
    fi
    printf '%s\n' "$out" >&2; pause; return 1
}

# --- the list ----------------------------------------------------------------
# Most-recently-committed first: the branch you want is nearly always one of the
# top few, which alphabetical order buries. Each row is "<branch>\t<relative age>".
list_branches() {
    local ref age name
    declare -A have=()
    while IFS=$'\t' read -r ref age; do
        have[$ref]=1
        printf '%s\t%s\n' "$ref" "$age"
    done < <(git for-each-ref --sort=-committerdate \
                 --format='%(refname:short)%09%(committerdate:relative)' refs/heads)
    # Remotes that have no local branch of the same name yet. Skipping the ones
    # that do keeps every row a distinct destination. The lookup is an array, not
    # a grep per row: this list is rebuilt on every click.
    while IFS=$'\t' read -r ref age; do
        case "$ref" in */HEAD) continue ;; esac
        name=${ref#*/}
        [ -n "${have[$name]:-}" ] && continue
        printf '%s\t%s\n' "$ref" "$age"
    done < <(git for-each-ref --sort=-committerdate \
                 --format='%(refname:short)%09%(committerdate:relative)' refs/remotes)
}

# Two parallel arrays: refs for the machine, display rows for the eye. The
# display marks the branch you are ON with ● -- the header said it, the list
# did not, and the current branch looked like a normal destination. No column
# dependency: the display pads itself.
# Which branches are checked out in a LINKED worktree: git refuses to switch to
# those, and the picker used to let you walk into that error blind. One
# git worktree list per open -- off the redraw path, so the cost is nothing.
declare -A wt=()
wtpath="" 
while IFS= read -r wl; do
    case "$wl" in
        'worktree '*) wtpath=${wl#worktree } ;;
        'branch refs/heads/'*)
            [ "$wtpath" = "$(git rev-parse --show-toplevel 2>/dev/null)" ] || \
                wt[${wl#branch refs/heads/}]="⑂${wtpath##*/}" ;;
    esac
done < <(git worktree list --porcelain 2>/dev/null)

refs=(); disps=()
row=""
while IFS=$'\t' read -r ref age; do
    if [ "$ref" = "$current" ]; then m='●'; else m=' '; fi
    refs+=("$ref")
    # printf -v formats in the running shell instead of forking a subshell per
    # branch -- 5000 branches: 16.9s forked, ~1s in-process (for-each-ref
    # itself is 0.12s; the fork was 99% of the old cost).
    printf -v row '%s %-32s %-16s %s' "$m" "$ref" "($age)" "${wt[$ref]:-}"
    disps+=("$row")
done < <(list_branches)
[ ${#refs[@]} -eq 0 ] && fail "no branches yet in $DIR"

if ! command -v fzf >/dev/null; then
    # No fzf: a numbered menu still beats no picker at all.
    printf 'Switch branch in %s (now: %s)\n' "${DIR/#$H/\~}" "${current:-detached}"
    select row in "${disps[@]}"; do
        [ -n "${row:-}" ] || exit 0
        break
    done
    [ -n "${row:-}" ] || exit 0
    for j in "${!disps[@]}"; do [ "${disps[$j]}" = "$row" ] && route "${refs[$j]}"; done
    exit
fi

# --print-query puts whatever was typed on line 1, so the create key can name a
# branch from a search that matched nothing. --expect reports the key on line 2;
# fzf 0.44 has no print() action, and --expect works everywhere.
#
# alt-enter, NOT ctrl-n. ctrl-n is fzf's own move-down (verified: one ctrl-n in a
# three-row list accepts the SECOND row), and an --expect key exits fzf the
# moment it is pressed -- so binding create to it meant anyone navigating with
# emacs keys created a branch named by their filter, or hit "type a name before
# ^N", which closes the popup and loses their place. alt-enter is the fzf idiom
# for "act on the literal query" and collides with nothing.
# Size the split from the real popup height: a fixed 65% preview hid branches
# while leaving blank preview rows, and this is the picker that most often has
# a long list.
avail=$(tput lines 2>/dev/null || echo 24)
lrows=${#refs[@]}; maxl=$(( avail / 3 )); [ "$lrows" -gt "$maxl" ] && lrows=$maxl
psz=$(( avail - lrows - 5 ))
[ "$psz" -lt 5 ] && psz=5

# A failed switch RETURNS here with the query preserved, instead of dying at
# "[any key]" and making you reopen the picker and retype. The failure paths
# are the normal case -- a dirty tree, a branch held by a worktree -- and each
# already showed git's own message; now it costs a keypress, not the flow.
query=""
while :; do
    out=$(for i in "${!refs[@]}"; do printf '%s\t%s\n' "${refs[$i]}" "${disps[$i]}"; done \
        | fzf --print-query --expect=alt-enter --query="$query" \
              --reverse --no-multi --info=inline-right --cycle --scroll-off=2 --color=16 \
              --delimiter=$'\t' --with-nth=2 \
              --bind 'ctrl-/:toggle-preview,ctrl-u:preview-half-page-up,ctrl-d:preview-half-page-down' \
              --prompt="switch> " \
              --header="↵ switch   alt-↵ new branch from what you typed   ^/ preview   esc cancel
on ${current:-detached HEAD} · $(tail3 "$DIR")" \
              --preview='git log --color=always --oneline --graph --decorate -30 {1} 2>/dev/null' \
              --preview-window="down,$psz,border-top")
    rc=$?
    # fzf's exit codes matter here: 0 = a row accepted, 1 = NO MATCH -- which is
    # exactly the state alt-enter creates a branch from, since the new name
    # matches nothing -- and 130 = esc/ctrl-c. Treating 1 as a cancel silently
    # swallowed every create of a genuinely new name.
    case "$rc" in
        0|1) ;;
        *)   exit 0 ;;
    esac

    query=$(sed -n 1p <<<"$out")
    key=$(sed -n 2p <<<"$out")
    pick=$(sed -n 3p <<<"$out")

    if [ "$key" = alt-enter ]; then
        if [ -z "$query" ]; then
            printf 'type a name before alt-enter\n' >&2; pause; continue
        fi
        create "$query" && exit 0
        continue
    fi

    [ -n "$pick" ] || exit 0          # esc, or an empty selection
    route "${pick%%$'\t'*}" && exit 0 # field 1 is the ref, exactly as git named it
done