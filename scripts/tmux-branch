#!/usr/bin/env bash
# tmux-branch — switch the git branch of a directory.
#   tmux-branch [-c pane_command] [-p pane_id] [dir]   dir defaults to $PWD
set -uo pipefail

# bash 4, as every cockpit script: lib/git.sh and the rest are not written for 3.2.
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
    printf '%s needs bash 4 or newer (found %s). On macOS: brew install bash\n' \
           "${BASH_SOURCE[0]##*/}" "${BASH_VERSION:-unknown}" >&2
    exit 1
fi
# The switch lands in the repo the picker listed, the pane's own: a popup
# inherits tmux's environment, where a dotfiles setup's GIT_DIR would point it
# at another. GIT_CEILING_DIRECTORIES stays: it can only stop the search lower.
unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE
d=${BASH_SOURCE[0]}; [ -L "$d" ] && d=$(readlink "$d")
# shellcheck source=lib/pane.sh
. "${d%/*}/lib/pane.sh" || exit 1

PANE_CMD=""
PANE_ID=""
while [ $# -gt 0 ]; do
    case "$1" in
        -c) PANE_CMD="${2:-}"; shift 2 || break ;;
        -p) PANE_ID="${2:-}"; shift 2 || break ;;
        -h|--help) sed -n '2,3p' "$0" >&2; exit 0 ;;
        --) shift; break ;;
        *)  break ;;
    esac
done

# The client that pressed prefix b, left on the pane by the key (#360). Taken and
# cleared at start, before the other libs load (#480). That narrows the window to
# bash start and pane.sh; a press inside it still takes this run's pin.
CLIENT=""
[ -n "${TMUX:-}" ] && CLIENT=$(take_pane_opt "$PANE_ID" @cockpit_branch_client)

# shellcheck source=lib/git.sh
. "${d%/*}/lib/git.sh" || exit 1
# shellcheck source=lib/tui.sh
. "${d%/*}/lib/tui.sh" || exit 1
# shellcheck source=lib/workdir.sh
. "${d%/*}/lib/workdir.sh" || exit 1
# shellcheck source=lib/fmt.sh
. "${d%/*}/lib/fmt.sh" || exit 1

DIR="${1:-}"
# A popup's $PWD is the session's start dir, and a bare display-message picks
# the most recently active client. -p pins the pane the popup came from.
if [ -z "$DIR" ] && [ -n "${TMUX:-}" ]; then
    if [ -n "$PANE_ID" ]; then
        DIR=$(tmux display-message -p -t "$PANE_ID" '#{pane_current_path}' 2>/dev/null)
        [ -n "$PANE_CMD" ] || PANE_CMD=$(tmux display-message -p -t "$PANE_ID" '#{pane_current_command}' 2>/dev/null)
    else
        DIR=$(tmux display-message -p '#{pane_current_path}' 2>/dev/null)
        [ -n "$PANE_CMD" ] || PANE_CMD=$(tmux display-message -p '#{pane_current_command}' 2>/dev/null)
    fi
fi
DIR="${DIR:-$PWD}"

# The popup closes when this script exits, taking any error with it.
pause() { printf '\n[any key]'; read -rsn1; }
fail()  { printf '%s\n' "$*" >&2; pause; exit 1; }

cd "$DIR" 2>/dev/null || fail "cockpit: no such directory: $DIR"

# tmux only knows the local cwd, so an ssh pane would name this machine's repo.
[ "$PANE_CMD" = ssh ] && fail "cockpit: this pane is inside ssh · $DIR is local, not that host"

# git() refuses a repo whose config names a filter driver with '=', and the rev-parse
# below would then read as "not a git repository" (#330). One line, before any git read
# (the picker, wt_list's two rereads, the switches).
if git_refused .; then fail "$GIT_REFUSAL"; fi

git rev-parse --git-dir >/dev/null 2>&1 || fail "cockpit: not a git repository: $DIR"

redraw() { [ -n "${TMUX:-}" ] && tmux refresh-client -S 2>/dev/null; return 0; }

current=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || printf '')

# Failures are common (dirty tree, branch held by a worktree); git's own message
# names the cause, so show it verbatim.
switch_to() {
    local target=$1 out
    if [ "$target" = "$current" ]; then
        printf 'already on %s\n' "$target"; redraw; sleep 0.4; return 0
    fi
    if out=$(git switch "$target" 2>&1); then
        printf '%s\n' "$out"; redraw; sleep 0.6; return 0
    fi
    printf '%s\n' "$out" >&2; pause; return 1
}

switch_remote() {  # origin/foo -> local foo tracking it
    local ref=$1 out
    if out=$(git switch --track "$ref" 2>&1); then
        printf '%s\n' "$out"; redraw; sleep 0.6; return 0
    fi
    printf '%s\n' "$out" >&2; pause; return 1
}

create() {
    local name=$1 out
    # Return, not exit: the caller loops back into the picker.
    if ! git check-ref-format --branch "$name" >/dev/null 2>&1; then
        printf 'invalid branch name: %s\n' "$name" >&2; pause; return 1
    fi
    if out=$(git switch -c "$name" 2>&1); then
        printf '%s\n' "$out"; redraw; sleep 0.6; return 0
    fi
    printf '%s\n' "$out" >&2; pause; return 1
}

# A pane's directory belongs to the deepest worktree that contains it, so a pane
# in a worktree nested under the checkout is not a pane of the checkout.
owner_of() {                  # <dir>  sets OWNER to the worktree path holding it, or ""
    local w
    OWNER=
    for w in ${WORKTREES[@]+"${WORKTREES[@]}"}; do
        if [ "$1" = "$w" ] || [[ $1 == "$w"/* ]]; then
            [ ${#w} -gt ${#OWNER} ] && OWNER=$w
        fi
    done
}

# WORKTREES: every worktree path. -z keeps a path with a newline in one record but needs
# git 2.36; older git rejects it and prints nothing, so the plain porcelain is read, and
# a record with a line that is no worktree attribute (a path cut by a newline) is dropped.
# So is one that is not this repo's (#348, #532): a newline name can forge a whole
# `worktree <dir>` line, and <dir> may be any checkout. The main checkout's .git is the
# common dir; a linked tree's .git file names a dir in its worktrees/ whose gitdir file
# names that .git back. Each file is read whole, as git reads it. -ef compares inodes, so
# a symlinked, hard-linked or relative path matches, as it does for git, and nothing
# forks. A path that is gone is kept, so goto still says "is gone".
wt_ours() {                   # <path> <common-dir>  true for a tree of the repo at <common-dir>
    local g='' b=''
    [ -e "$1" ] || return 0
    [ -d "$1/.git" ] && { [ "$1/.git" -ef "$2" ]; return; }
    [ -f "$1/.git" ] || return 1
    IFS= read -r g 2>/dev/null < "$1/.git"
    [[ $g == "gitdir: "?* ]] || return 1
    g=${g#gitdir: }; [[ $g == /* ]] || g=$1/$g
    [ "$g/.." -ef "$2/worktrees" ] && [ -f "$g/gitdir" ] || return 1
    IFS= read -r b 2>/dev/null < "$g/gitdir"
    [ -n "$b" ] || return 1
    [[ $b == /* ]] || b=$g/$b
    [ "$b" -ef "$1/.git" ]
}
wt_list() {
    # git's attribute lines: a label is a whole line, locked and prunable may add a reason
    local attr='^(HEAD |branch |bare$|detached$|(locked|prunable)( |$))'
    local rec line top common cur='' ok=1
    WORKTREES=()
    while IFS= read -r -d '' rec; do
        [[ $rec == "worktree "* ]] && WORKTREES+=("${rec#worktree }")
    done < <(git worktree list --porcelain -z 2>/dev/null)
    [ ${#WORKTREES[@]} -gt 0 ] && return 0
    # Asked from the top: before 2.13 the answer was the cwd's prefix plus a path from the top.
    top=$(git rev-parse --show-toplevel 2>/dev/null); top=${top:-$PWD}
    common=$(git -C "$top" rev-parse --git-common-dir 2>/dev/null)
    [ -n "$common" ] || return 0
    [[ $common == /* ]] || common=$top/$common
    while IFS= read -r line || [ -n "$line" ]; do
        if [[ $line == "worktree "* ]]; then
            [ -n "$cur" ] && [ "$ok" = 1 ] && wt_ours "$cur" "$common" && WORKTREES+=("$cur")
            cur=${line#worktree }; ok=1
        elif [ -n "$line" ] && [[ ! $line =~ $attr ]]; then
            ok=0
        fi
    done < <(git worktree list --porcelain 2>/dev/null)
    [ -n "$cur" ] && [ "$ok" = 1 ] && wt_ours "$cur" "$common" && WORKTREES+=("$cur")
    return 0
}

# Jump to the worktree that holds a branch (#303): the agent pane in it if there is
# one, any pane in it, else a new window there. Never a cd of an existing pane.
# The path comes off cockpit-tui's line, so it is checked against git's own list.
goto() {
    local path=$1 w id row dir ag='' sh='' found='' t=()
    wt_list
    for w in ${WORKTREES[@]+"${WORKTREES[@]}"}; do [ "$w" = "$path" ] && found=1; done
    if [ -z "$found" ]; then
        printf 'cockpit: not a worktree of this repository: %s\n' "$path" >&2; pause; return 1
    fi
    if [ ! -d "$path" ]; then
        printf 'cockpit: %s is gone · git worktree prune\n' "$path" >&2; pause; return 1
    fi
    # One tree per pane, the one tmux-review reviews (#470): the binary is asked
    # for each pane whose answer could differ from the rule without it.
    while IFS= read -r row; do
        workdir_row "$row"
        [[ $WD_ID =~ ^%[0-9]+$ ]] || continue
        dir=''
        workdir_need "$WD_AGENT" "$WD_OPT" && dir=$(workdir_ask "$WD_ID")
        workdir_pick "$dir" "$WD_OPT" "$WD_CWD"
        owner_of "$WORKDIR"
        [ "$OWNER" = "$path" ] || continue
        if [ "$WD_AGENT" = 1 ]; then ag=${ag:-$WD_ID}; else sh=${sh:-$WD_ID}; fi
    done < <(tmux list-panes -a -F "$WORKDIR_FMT" 2>/dev/null)
    id=${ag:-$sh}
    if [ -n "$id" ]; then
        # switch-client fails without a client; the selection below still applies.
        # Bare, tmux would move the most recently active client (#360).
        tmux switch-client ${CLIENT:+-c "$CLIENT"} -t "$id" 2>/dev/null || true
        tmux select-window -t "$id" 2>/dev/null
        tmux select-pane   -t "$id" 2>/dev/null
        return 0
    fi
    # new-window -t takes a window, not a pane: beside the one the popup came from
    if [[ $PANE_ID =~ ^%[0-9]+$ ]]; then
        id=$(tmux display-message -p -t "$PANE_ID" '#{window_id}' 2>/dev/null)
        [[ $id =~ ^@[0-9]+$ ]] && t=(-a -t "$id")
    fi
    w=$(fesc "$path")   # -c is expanded as a format
    if tmux new-window "${t[@]}" -c "$w" 2>/dev/null; then return 0; fi
    printf 'cockpit: could not open a window in %s\n' "$path" >&2; pause; return 1
}

# cockpit-tui draws the picker and prints one action line. This script reads it as
# untrusted text: a fixed verb, one line, a name git accepts and a ref that exists.
act() {
    local line=$1 verb arg ns
    verb=${line%% *}; arg=${line#* }
    case "$verb" in
        switch) ns=heads ;;
        track)  ns=remotes ;;
        create) ns= ;;
        goto)   goto "$arg"; return ;;
        *)      printf 'cockpit: unexpected answer from cockpit-tui: %s\n' "$line" >&2; pause; return 1 ;;
    esac
    if [ "$line" = "$verb" ] || [ -z "$arg" ] || [[ $line == *$'\n'* ]] \
       || ! git check-ref-format --branch "$arg" >/dev/null 2>&1; then
        printf 'cockpit: not a branch name: %s\n' "$arg" >&2; pause; return 1
    fi
    case "$verb" in
        create) create "$arg" ;;
        *)
            git show-ref --quiet --verify "refs/$ns/$arg" \
                || { printf 'cockpit: no such branch: %s\n' "$arg" >&2; pause; return 1; }
            if [ "$verb" = switch ]; then switch_to "$arg"; else switch_remote "$arg"; fi ;;
    esac
}

[ -x "$COCKPIT_TUI_BIN" ] || fail "cockpit: cockpit-tui is missing ($COCKPIT_TUI_BIN) · run scripts/tui-fetch"

# One stderr capture for the whole loop, removed on any exit. Without mktemp the
# picker runs as before, and a stale binary is just "exited".
err=$(mktemp 2>/dev/null) || err=
if [ -n "$err" ]; then trap 'rm -f -- "$err"' EXIT; trap 'exit 130' INT TERM HUP; fi

# The binary reads $COCKPIT_GLYPHS, never the option (#293), as tm passes it.
glyphs=$(tmux show-option -gqv @cockpit_glyphs 2>/dev/null)
[ -z "$glyphs" ] || export COCKPIT_GLYPHS="$glyphs"
# A failed action returns to the picker; esc leaves.
while :; do
    if [ -n "$err" ]; then
        : > "$err"
        pick=$("$COCKPIT_TUI_BIN" branch -C "$PWD" 2>"$err"); rc=$?
        [ ! -s "$err" ] || cat "$err" >&2
        ! tui_stale "$rc" "$err" || fail "cockpit: $TUI_STALE_MSG"
    else
        pick=$("$COCKPIT_TUI_BIN" branch -C "$PWD"); rc=$?
    fi
    case "$rc" in
        0) ;;
        1) exit 0 ;;
        *) pause; exit 1 ;;
    esac
    act "$pick" && exit 0
done
