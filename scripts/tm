#!/usr/bin/env bash
# tm — tmux session launcher.
#   tm <name>        attach to <name>, creating it if missing
#   tm               pick a session; a name nothing matches + ↵ creates it
#   tm --needs       pick among the sessions waiting on you or in error
#   tm -k [name...]  kill sessions (no name = pick one: ^X twice)
#   tm -l            list sessions
#   tm -h            this help
set -uo pipefail

# mapfile needs bash 4; macOS still ships 3.2.
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
    printf '%s needs bash 4 or newer (found %s). On macOS: brew install bash\n' \
           "${BASH_SOURCE[0]##*/}" "${BASH_VERSION:-unknown}" >&2
    exit 1
fi

# Not readlink -f: BSD readlink lacks -f before macOS 12.3, which would leave
# SELF empty and the popup it opens running nothing.
SELF="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
printf -v QSELF '%q' "$SELF"

die() { printf '%s\n' "$*" >&2; exit 1; }
command -v tmux >/dev/null || die "cockpit: tmux is not installed · install tmux, then rerun"

# fesc, the format escaper: lib/ sits beside the real script, not the install
# symlink. Parameter expansion, not dirname: tm runs on a PATH that may hold
# nothing but tmux.
tm_d=${BASH_SOURCE[0]}; [ -L "$tm_d" ] && tm_d=$(readlink "$tm_d")
case $tm_d in */*) tm_d=${tm_d%/*} ;; *) tm_d=. ;; esac
# shellcheck source=lib/fmt.sh
. "$tm_d/lib/fmt.sh" || die "cockpit: tm could not load lib/fmt.sh"

# \037 between fields: tab is IFS whitespace and a run of empty fields would
# collapse.
US=$'\037'

# lib/ sits beside the real script, not the install symlink. Loaded when the
# picker opens: `tm <name>` and `tm -l` never need it.
load_tui() {
  local d=${BASH_SOURCE[0]}; [ -L "$d" ] && d=$(readlink "$d")
  # shellcheck source=lib/tui.sh
  . "$(cd -P "$(dirname "$d")" && pwd)/lib/tui.sh" 2>/dev/null && [ -x "$COCKPIT_TUI_BIN" ]
}

usage() {
  cat >&2 <<'USAGE'
tm — tmux session launcher.
  tm <name>        attach to <name>, creating it if missing
  tm               pick a session; a name nothing matches + ↵ creates it
  tm --needs       pick among the sessions waiting on you or in error
  tm -k [name...]  kill sessions (no name = pick one: ^X twice)
  tm -l            list sessions
  tm -h            this help
In the picker: ↵ switch · alt-↵ creates the typed name even when rows match ·
^X twice kills · F2 renames · 1-9 jump while the filter is empty · F1 keys · esc close
USAGE
}

# tmux forbids '.' and ':' in session names, and reads a leading '-' as an option.
clean() {
  local n="${1//[.: ]/_}"
  n=${n//[$'\001'-$'\037'$'\177']/}     # an Escape pressed at the prompt is a byte, not a cancel
  while [ "${n#-}" != "$n" ]; do n="${n#-}"; done
  printf '%s' "$n"
}

list() { tmux list-sessions -F '#{session_name}' 2>/dev/null; }

# Resurrect's own choice: ~/.tmux/resurrect only when it exists, XDG otherwise.
default_dir() {
  [ -d ~/.tmux/resurrect ] && { printf '%s' ~/.tmux/resurrect; return; }
  printf '%s' "${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect"
}

# Needs a live server to read @resurrect-dir, so call it after the placeholder.
saved() {
  local dir
  dir=$(tmux show-option -gqv @resurrect-dir)
  # The same three substitutions resurrect's sed does.
  dir=${dir//'$HOME'/$HOME}; dir=${dir//'$HOSTNAME'/${HOSTNAME:-}}; dir=${dir//\~/$HOME}
  [ -n "$dir" ] || dir=$(default_dir)
  [ -e "$dir/last" ]
}

# No sessions but a resurrect save or plugin on disk: start a server so
# continuum can restore (#106) and @resurrect-dir can be read (#110).
restore_if_empty() {
  [ -z "$(list)" ] || return 0
  [ -e "$(default_dir)/last" ] ||
    [ -d ~/.tmux/plugins/tmux-resurrect ] ||
    [ -d "${XDG_CONFIG_HOME:-$HOME/.config}/tmux/plugins/tmux-resurrect" ] || return 0
  # A unique name: resurrect restores into a session it can see, and the kill
  # below would take those windows too.
  local placeholder="_restore$$" s=()
  if tmux new-session -d -s "$placeholder" 2>/dev/null && saved &&
     [ "$(tmux show-option -gqv @continuum-restore)" = on ]; then
    printf 'cockpit: Restoring saved sessions...\n' >&2
    for _ in {1..100}; do
      mapfile -t s < <(list); [ ${#s[@]} -gt 1 ] && break; sleep 0.1
    done
    # continuum has more gates than the option (halt file, server age), so
    # say so rather than let the prompt below imply the sessions are gone.
    [ ${#s[@]} -gt 1 ] ||
      printf 'cockpit: no restore after 10s · prefix+^r restores by hand\n' >&2
  fi
  tmux kill-session -t "=$placeholder" 2>/dev/null
}

ask_name() {
  # Runs in $(...), where exit only leaves the subshell: an empty name is the
  # cancel go() reads.
  local n
  read -r -p "${1:-New session name (empty cancels): }" n || return 0
  n=$(clean "$n")
  [ -n "$n" ] || return 0
  printf '%s' "$n"
}

# $TMUX survives detach, and switch-client from a detached shell hijacks some
# other terminal's client.
in_client() {
  [ -n "${TMUX:-}" ] || return 1
  local n
  # $TMUX's last field is the session id, in a pane and in a popup (#45). A popup's
  # $TMUX_PANE is inherited from the server's start env and names some other pane.
  n=$(tmux display-message -p -t "\$${TMUX##*,}" '#{session_attached}' 2>/dev/null)
  [ -n "$n" ] || [ -z "${TMUX_PANE:-}" ] \
    || n=$(tmux display-message -p -t "$TMUX_PANE" '#{session_attached}' 2>/dev/null)
  [ -n "$n" ] && [ "$n" -gt 0 ] 2>/dev/null
}

num() { [[ ${1:-} =~ ^[0-9]+$ ]]; }

# Not has-session -t "=NAME": tmux reads "=$5x" as a session id and finds nothing.
sid_of() {  # sid_of NAME -- that session's id, empty when there is none
  local id n
  while IFS=' ' read -r id n; do
    [ "$n" = "$1" ] && { printf '%s' "$id"; return; }
  done < <(tmux list-sessions -F '#{session_id} #{session_name}' 2>/dev/null)
}

enter() {  # enter SESSION_ID
  if in_client; then
    # -c: the client that pressed prefix+s, not another device on the same session.
    tmux switch-client ${TM_CLIENT:+-c "$TM_CLIENT"} -t "$1"
  else
    # -d: detach stale clients, which a --no-reap host never removes (#145).
    tmux attach-session -d -t "$1"
  fi
}

go() {  # go NAME -- that session, created first when missing
  local name=$1 dir="" id
  [ -n "$name" ] || exit 0    # a cancelled prompt, or a name clean() emptied
  id=$(sid_of "$name")
  if [ -z "$id" ]; then
    # In a popup $PWD is the session's start dir, not the active pane's (#41).
    [ -n "${TMUX:-}" ] && dir=$(tmux display-message -p -t "\$${TMUX##*,}" '#{pane_current_path}' 2>/dev/null)
    id=$(tmux new-session -d -P -F '#{session_id}' -s "$(fesc "$name")" -c "$(fesc "${dir:-$PWD}")") && [ -n "$id" ] ||
      die "cockpit: could not create session '$name'"
  fi
  enter "$id"
}

kill_one() {  # kill_one NAME
  local id
  [ -n "$1" ] || return 0
  id=$(sid_of "$1")
  [ -n "$id" ] && tmux kill-session -t "$id" 2>/dev/null && printf 'killed: %s\n' "$1" >&2
}

# Yours: the popup's, else $TMUX_PANE's when its tty is ours (a moved pane keeps
# its birth $TMUX; a popup inherits a leaked $TMUX_PANE, #212), else $TMUX's.
own() {
  [ -n "${TM_SID:-}" ] && return 0
  local t p s
  if [ -n "${TMUX_PANE:-}" ] && t=$(tty 2>/dev/null); then
    read -r p s < <(tmux display-message -p -t "$TMUX_PANE" '#{pane_tty} #{session_id}' 2>/dev/null)
    [ "${p:-}" = "$t" ] && TM_SID=$s
  fi
  [ -n "${TM_SID:-}" ] || { [ -n "${TMUX:-}" ] && TM_SID="\$${TMUX##*,}"; }
  export TM_SID=${TM_SID:-}
}

# prefix+s runs this, as display-popup takes a size, not a format. The client
# and its session come from the binding: the popup itself knows neither.
popup() {  # popup CLIENT SESSION_ID CLIENT_WIDTH CLIENT_HEIGHT [--needs]
  local client=$1 sid=$2 cw=$3 ch=$4 needs=${5:-} st='#{W:#{@cockpit_win_state} }'
  local n nneed touch pw ph t=0 rows w h hmax
  num "$cw" && num "$ch" || die "cockpit: tm --popup needs the client's width and height"
  IFS=$US read -r n nneed touch pw ph < <(tmux display-message -p \
    "#{server_sessions}$US#{n:#{S:#{?#{m:*needs-input*,$st},x,#{?#{m:*error*,$st},x,}}}}$US#{@cockpit_touch}$US#{@cockpit_popup_width}$US#{@cockpit_popup_height}")
  num "$n" && num "$nneed" || die "cockpit: tm --popup could not count the sessions"
  case ${touch:-auto} in on) t=1 ;; off) ;; *) [ "$cw" -lt 100 ] && t=1 ;; esac
  rows=$n; [ -n "$needs" ] && [ "$nneed" -gt 0 ] && rows=$nneed
  # 5 = the prompt, the header line, the footer and the popup's border (2); the
  # list takes the rows. 14 is the floor: the border takes 2 and the screen needs
  # 12 inside it, or it draws its "too short" card.
  if [ "$t" = 1 ]; then
    w=$cw; ceiling w "$pw" "$cw"
    h=$((rows + 5)); clamp h 14 "$ch"; ceiling h "$ph" "$ch"
  else
    w=$((cw * 70 / 100)); [ "$cw" -ge 160 ] || w=$((cw * 90 / 100))
    # The user's size options are ceilings, not sizes.
    ceiling w "$pw" "$cw"
    hmax=$((ch * 70 / 100)); clamp hmax 14 "$ch"; ceiling hmax "$ph" "$ch"
    h=$((rows + 5)); clamp h 14 "$hmax"
  fi
  local cmd
  printf -v cmd 'TM_POPUP=1 TM_SID=%q TM_CLIENT=%q %s%s' "$sid" "$client" "$QSELF" "${needs:+ --needs}"
  # A client under 14 lines has no room for a popup and its border: a window of
  # the client's session has it all.
  if [ "$ch" -lt 14 ]; then
    tmux new-window -t "$sid:" -n sessions "$cmd"
    return
  fi
  tmux display-popup -c "$client" -t "$sid" -w "$w" -h "$h" -T ' sessions ' -E "$cmd"
}

clamp() {  # clamp VAR LOW HIGH -- HIGH wins when the two cross
  local _v=${!1}
  [ "$_v" -ge "$2" ] || _v=$2
  [ "$_v" -le "$3" ] || _v=$3
  printf -v "$1" '%d' "$_v"
}

ceiling() {  # ceiling VAR OPTION WHOLE -- OPTION as N% of WHOLE or N cells
  local c
  case $2 in
    *[!0-9%]*|'') return 0 ;;
    *%) c=$((${2%\%} * $3 / 100)) ;;
    *)  c=$2 ;;
  esac
  [ "${!1}" -le "$c" ] || printf -v "$1" '%d' "$c"
}

# Says why nothing happened: on stderr, and on the client's status line, since a
# popup closes and takes its stderr with it.
refuse() {
  printf '✕ %s\n' "$*" >&2
  [ -z "${TM_POPUP:-}" ] || tmux display-message ${TM_CLIENT:+-c "$TM_CLIENT"} "$(fesc "cockpit: ✕ $*")" 2>/dev/null
  return 1
}

# Re-checked here, not trusted from the picker: the id must be $N, and the name
# the person saw must still be the live name, since a rename or a new session
# with a reused id could have landed between the print and now.
confirm() {  # confirm ID EXPECTED -- prints the live name; fails with a note
  local live
  [[ $1 =~ ^\$[0-9]+$ ]] || { refuse "the picker named '$1', which is not a session id; nothing changed"; return 1; }
  live=$(tmux display-message -p -t "$1" '#{session_name}' 2>/dev/null)
  [ -n "$live" ] || { refuse "session $1 is gone; nothing changed"; return 1; }
  [ "$live" = "$2" ] || { refuse "session $1 is now called '$live', not '$2'; nothing changed"; return 1; }
  printf '%s' "$live"
}

# The first line of a side file the picker wrote, or nothing.
side() { local l=''; IFS= read -r l < "$1" 2>/dev/null; printf '%s' "$l"; }

# Runs the picker and acts on the one action line it wrote. It never mutates
# itself. kill and rename run again afterwards, in the same popup.
pick() {
  local verb arg rest rc live new glyphs d
  local -a a
  # Global, not local: the EXIT trap runs after this function has returned.
  PICK_DIR=$(mktemp -d) || die "cockpit: no temp dir for the picker"
  d=$PICK_DIR
  trap 'rm -rf "$PICK_DIR"' EXIT
  trap 'exit 130' INT TERM HUP
  # ascii is the picker's only other glyph tier: any other value draws the default.
  glyphs=$(tmux show-option -gqv @cockpit_glyphs 2>/dev/null)
  while :; do
    rm -f "$d"/act "$d"/act.text "$d"/act.expect
    own
    a=(sessions)
    [ "${TM_NEEDS:-}" = 1 ] && a+=(--needs)
    [[ ${TM_SID:-} =~ ^\$[0-9]+$ ]] && a+=(--current "$TM_SID")
    # CLAUDECODE leaks in from an agent's shell and must not mark the binary as its child.
    env -u CLAUDECODE COCKPIT_ACTION="$d/act" ${glyphs:+COCKPIT_GLYPHS=$glyphs} "$COCKPIT_TUI_BIN" "${a[@]}"; rc=$?
    case $rc in 0) ;; 1) return 0 ;; *) die "cockpit: the sessions picker exited $rc · see the lines above" ;; esac
    verb='' arg='' rest=''
    read -r verb arg rest < "$d/act" 2>/dev/null
    [ -z "$rest" ] || die "cockpit: the picker wrote an action line tm cannot read"
    case $verb in
      switch)
        [[ $arg =~ ^\$[0-9]+$ ]] || die "cockpit: the picker named '$arg', which is not a session id"
        enter "$arg"; return ;;
      new-session)
        [ "$arg" = - ] || die "cockpit: new-session takes '-', not '$arg'"
        go "$(clean "$(side "$d/act.text")")"; return ;;
      kill-session)
        live=$(confirm "$arg" "$(side "$d/act.expect")") || return 1
        own
        [ "$arg" != "${TM_SID:-}" ] || { refuse "$live is the session you are in; nothing killed"; return 1; }
        tmux kill-session -t "$arg" 2>/dev/null || { refuse "could not kill $live"; return 1; }
        printf 'killed: %s\n' "$live" >&2 ;;
      rename-session)
        live=$(confirm "$arg" "$(side "$d/act.expect")") || return 1
        new=$(clean "$(side "$d/act.text")")
        [ -n "$new" ] || { refuse "no name to rename $live to; nothing changed"; return 1; }
        tmux rename-session -t "$arg" -- "$(fesc "$new")" 2>/dev/null || { refuse "could not rename $live to '$new'"; return 1; }
        printf 'renamed: %s -> %s\n' "$live" "$new" >&2 ;;
      *) die "cockpit: the picker wrote an action tm does not know: $verb" ;;
    esac
  done
}

# The picker needs a terminal and the binary; without either, list and ask.
can_pick() { [ -t 0 ] && load_tui; }

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  -l|--list) list; exit 0 ;;
  --popup)   shift; popup "$@"; exit ;;
  --needs)   export TM_NEEDS=1; shift ;;
  -k|--kill)
    shift
    if [ $# -gt 0 ]; then
      for s in "$@"; do kill_one "$(clean "$s")"; done
      exit 0
    fi
    [ -n "$(list)" ] || die "cockpit: no tmux sessions to kill"
    # In the picker ^X kills the highlighted session, twice to confirm.
    if can_pick; then pick; exit; fi
    printf 'Kill which session?\n' >&2; list >&2
    kill_one "$(ask_name 'Name (empty cancels): ')"
    exit 0 ;;
esac
# An internal piece that failed part-way must never reach the name below:
# "tm --rows" would create a session called "rows".
case "${1:-}" in -*) die "cockpit: unknown option: $1 · try tm -h" ;; esac

if [ $# -gt 0 ] && [ -n "$1" ]; then
  go "$(clean "$1")"
  exit
fi

# A popup always has a session, its own; restoring belongs to a login shell.
[ -n "${TM_POPUP:-}" ] || restore_if_empty
sessions=$(list)
if [ -z "$sessions" ]; then
  printf 'cockpit: No tmux sessions running.\n' >&2
  go "$(ask_name)"
  exit
fi
if ! can_pick; then
  printf 'Sessions:\n%s\n' "$sessions" >&2
  go "$(ask_name 'Session (a new name creates it, empty cancels): ')"
  exit
fi
pick
