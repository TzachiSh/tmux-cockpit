#!/usr/bin/env bash
# tm — tmux session launcher.
#   tm <name>        attach to <name>, creating it if missing
#   tm               pick a session; a name nothing matches + ↵ creates it
#   tm --needs       pick among the sessions waiting on you or in error
#   tm -k [name...]  kill sessions (no name = pick them, Tab selects several)
#   tm -l            list sessions
#   tm -h            this help
set -uo pipefail

# mapfile needs bash 4; macOS still ships 3.2.
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
    printf '%s needs bash 4 or newer (found %s). On macOS: brew install bash\n' \
           "${BASH_SOURCE[0]##*/}" "${BASH_VERSION:-unknown}" >&2
    exit 1
fi

# Not readlink -f: BSD readlink lacks -f before macOS 12.3, which would leave
# SELF empty and every fzf binding silently dead.
SELF="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
printf -v QSELF '%q' "$SELF"

die() { printf '%s\n' "$*" >&2; exit 1; }
command -v tmux >/dev/null || die "cockpit: tmux is not installed · install tmux, then rerun"

# \037 between fields: tab is IFS whitespace and a run of empty fields would
# collapse.
US=$'\037'
R=$'\033[0m'
# The same agent test agent-state uses, so a stale @panestate is not believed.
AGENT='#{m:*|#{pane_current_command}|*,#{@cockpit_agents_glob}}'
K_KILL='↵ kill · ⇥ mark · esc cancel'

# lib/ sits beside the real script, not the install symlink. Loaded lazily:
# --rows and the kill bindings run on every fzf reload.
load_theme() {
  local d=${BASH_SOURCE[0]}; [ -L "$d" ] && d=$(readlink "$d")
  # shellcheck source=lib/fzf.sh
  . "${d%/*}/lib/fzf.sh" \
    || die "cockpit: the fzf theme is missing · reinstall from the repo"
}

usage() {
  cat >&2 <<'USAGE'
tm — tmux session launcher.
  tm <name>        attach to <name>, creating it if missing
  tm               pick a session; a name nothing matches + ↵ creates it
  tm --needs       pick among the sessions waiting on you or in error
  tm -k [name...]  kill sessions (no name = pick them, Tab selects several)
  tm -l            list sessions
  tm -h            this help
In the picker: ↵ switch · alt-↵ creates the typed name even when rows match ·
^X twice kills · ^/ preview · 1-9 jump while the query is empty · esc close
USAGE
}

# tmux forbids '.' and ':' in session names, and reads a leading '-' as an option.
clean() {
  local n="${1//[.: ]/_}"
  n=${n//[$'\001'-$'\037'$'\177']/}     # an Escape pressed at the prompt is a byte, not a cancel
  while [ "${n#-}" != "$n" ]; do n="${n#-}"; done
  printf '%s' "$n"
}

list() { tmux list-sessions -F '#{session_name}' 2>/dev/null; }

# Resurrect's own choice: ~/.tmux/resurrect only when it exists, XDG otherwise.
default_dir() {
  [ -d ~/.tmux/resurrect ] && { printf '%s' ~/.tmux/resurrect; return; }
  printf '%s' "${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect"
}

# Needs a live server to read @resurrect-dir, so call it after the placeholder.
saved() {
  local dir
  dir=$(tmux show-option -gqv @resurrect-dir)
  # The same three substitutions resurrect's sed does.
  dir=${dir//'$HOME'/$HOME}; dir=${dir//'$HOSTNAME'/${HOSTNAME:-}}; dir=${dir//\~/$HOME}
  [ -n "$dir" ] || dir=$(default_dir)
  [ -e "$dir/last" ]
}

# No sessions but a resurrect save or plugin on disk: start a server so
# continuum can restore (#106) and @resurrect-dir can be read (#110).
restore_if_empty() {
  [ -z "$(list)" ] || return 0
  [ -e "$(default_dir)/last" ] ||
    [ -d ~/.tmux/plugins/tmux-resurrect ] ||
    [ -d "${XDG_CONFIG_HOME:-$HOME/.config}/tmux/plugins/tmux-resurrect" ] || return 0
  # A unique name: resurrect restores into a session it can see, and the kill
  # below would take those windows too.
  local placeholder="_restore$$" s=()
  if tmux new-session -d -s "$placeholder" 2>/dev/null && saved &&
     [ "$(tmux show-option -gqv @continuum-restore)" = on ]; then
    printf 'cockpit: Restoring saved sessions...\n' >&2
    for _ in {1..100}; do
      mapfile -t s < <(list); [ ${#s[@]} -gt 1 ] && break; sleep 0.1
    done
    # continuum has more gates than the option (halt file, server age), so
    # say so rather than let the prompt below imply the sessions are gone.
    [ ${#s[@]} -gt 1 ] ||
      printf 'cockpit: no restore after 10s · prefix+^r restores by hand\n' >&2
  fi
  tmux kill-session -t "=$placeholder" 2>/dev/null
}

ask_name() {
  # Runs in $(...), where exit only leaves the subshell: an empty name is the
  # cancel go() reads.
  local n
  read -r -p "${1:-New session name (empty cancels): }" n || return 0
  n=$(clean "$n")
  [ -n "$n" ] || return 0
  printf '%s' "$n"
}

# $TMUX survives detach, and switch-client from a detached shell hijacks some
# other terminal's client.
in_client() {
  [ -n "${TMUX:-}" ] || return 1
  local n
  # $TMUX's last field is the session id, in a pane and in a popup (#45). A popup's
  # $TMUX_PANE is inherited from the server's start env and names some other pane.
  n=$(tmux display-message -p -t "\$${TMUX##*,}" '#{session_attached}' 2>/dev/null)
  [ -n "$n" ] || [ -z "${TMUX_PANE:-}" ] \
    || n=$(tmux display-message -p -t "$TMUX_PANE" '#{session_attached}' 2>/dev/null)
  [ -n "$n" ] && [ "$n" -gt 0 ] 2>/dev/null
}

num() { [[ ${1:-} =~ ^[0-9]+$ ]]; }

# Not has-session -t "=NAME": tmux reads "=$5x" as a session id and finds nothing.
sid_of() {  # sid_of NAME -- that session's id, empty when there is none
  local id n
  while IFS=' ' read -r id n; do
    [ "$n" = "$1" ] && { printf '%s' "$id"; return; }
  done < <(tmux list-sessions -F '#{session_id} #{session_name}' 2>/dev/null)
}

enter() {  # enter SESSION_ID
  if in_client; then
    tmux switch-client -t "$1"
  else
    # -d: detach stale clients, which a --no-reap host never removes (#145).
    tmux attach-session -d -t "$1"
  fi
}

go() {  # go NAME -- that session, created first when missing
  local name=$1 dir="" id
  [ -n "$name" ] || exit 0    # a cancelled prompt, or a name clean() emptied
  id=$(sid_of "$name")
  if [ -z "$id" ]; then
    # In a popup $PWD is the session's start dir, not the active pane's (#41).
    [ -n "${TMUX:-}" ] && dir=$(tmux display-message -p -t "\$${TMUX##*,}" '#{pane_current_path}' 2>/dev/null)
    id=$(tmux new-session -d -P -F '#{session_id}' -s "$name" -c "${dir:-$PWD}") && [ -n "$id" ] ||
      die "cockpit: could not create session '$name'"
  fi
  enter "$id"
}

kill_one() {  # kill_one NAME
  local id
  [ -n "$1" ] || return 0
  id=$(sid_of "$1")
  [ -n "$id" ] && tmux kill-session -t "$id" 2>/dev/null && printf 'killed: %s\n' "$1" >&2
}

# Your own session is the pane's, since a pane moved to another session keeps
# the $TMUX it was born with. pick() exports it for the reloads.
own() {
  [ -n "${TM_SID:-}" ] && return 0
  [ -n "${TMUX_PANE:-}" ] && TM_SID=$(tmux display-message -p -t "$TMUX_PANE" '#{session_id}' 2>/dev/null)
  [ -n "${TM_SID:-}" ] || { [ -n "${TMUX:-}" ] && TM_SID="\$${TMUX##*,}"; }
  export TM_SID=${TM_SID:-}
}

# --- the picker's pieces; the fzf bindings call each one as tm --<piece> ------

declare -A G=() C=()
glyphs() {
  case ${TM_GLYPHS:-} in
    ascii) G=([needs-input]='!' [error]=x [running]='*' [done]=+ [idle]=. [att]=@) ;;
    # Many Nerd Font builds draw these 2 cells wide while wcwidth says 1, so
    # they are opt-in only.
    nerd)  G=([needs-input]=$'\xef\x83\xb3' [error]=$'\xef\x81\x97' [running]=$'\xef\x85\x84'
              [done]=$'\xef\x81\x98' [idle]=$'\xef\x84\x8c' [att]=$'\xef\x84\x88') ;;
    *)     G=([needs-input]=▲ [error]=✕ [running]=● [done]=✓ [idle]=○ [att]=◉) ;;
  esac
  G[none]=' '    # an empty shell is not an idle agent
}

# Fills C with one SGR per role. TM_SGR carries them to the reloads, so the
# palette costs one tmux call per picker, not one per reload.
palette() {
  local roles=(needs-input error running done dim soft) v=() i k h s=''
  if [ -z "${TM_SGR:-}" ]; then
    load_theme; _cockpit_fzf_thm
    for k in red peach yellow green overlay_1 overlay_2; do
      h=${COCKPIT_THM[$k]#\#}
      # Only #rrggbb becomes a colour; a named one leaves the role plain.
      [[ $h =~ ^[0-9a-fA-F]{6}$ ]] &&
        printf -v h '\033[38;2;%d;%d;%dm' "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}" || h=''
      s+=$h$US
    done
    export TM_SGR=$s
  fi
  IFS=$US read -r -a v <<<"$TM_SGR"
  for i in "${!roles[@]}"; do C[${roles[$i]}]=${v[$i]:-}; done
  C[idle]=${C[dim]} C[none]=''
}

# LW = the list's own width. The preview takes the right half while that half
# is 60+ columns (the <60 alternative in pick).
LW=0
listw() {
  local cols=${FZF_COLUMNS:-}
  num "$cols" || cols=$(tput cols 2>/dev/null)
  num "$cols" || cols=80
  LW=$cols
  [ $((cols / 2)) -lt 60 ] || LW=$((cols - cols / 2))
}

trunc() {  # trunc VAR TEXT WIDTH -- TEXT cut with … to at most WIDTH cells
  local _t=$2 _w=$3
  [ "$_w" -gt 0 ] || _w=1
  [ "${#_t}" -le "$_w" ] || _t="${_t:0:_w-1}…"
  printf -v "$1" '%s' "$_t"
}

fit() {  # fit VAR TEXT WIDTH -- trunc, then space-padded to WIDTH
  local _f
  trunc _f "$2" "$3"
  printf -v "$1" '%s%*s' "$_f" $(($3 - ${#_f})) ''
}

ago() {  # ago VAR SECONDS
  local s=$2
  if   [ "$s" -lt 60 ];    then printf -v "$1" now
  elif [ "$s" -lt 3600 ];  then printf -v "$1" '%dm' $((s / 60))
  elif [ "$s" -lt 86400 ]; then printf -v "$1" '%dh' $((s / 3600))
  else                          printf -v "$1" '%dd' $((s / 86400))
  fi
}

# Untrusted agent text, read alone so no byte of it can reach a record split.
ask_of() {  # ask_of VAR PANE_ID
  local _a
  _a=$(tmux show-options -pqv -t "$2" @panestate_msg 2>/dev/null)
  printf -v "$1" '%s' "${_a//[$'\001'-$'\037'$'\177']/}"
}

# A header line, then id<TAB>number glyph<TAB>name<TAB>rest per session: fzf
# shows 2.. and searches the name.
rows() {
  glyphs; palette; listw; own
  local now fmt end='\n'
  printf -v now '%(%s)T' -1
  # Only ids, counts and names: agent text never shares this output.
  fmt="#{session_id}$US#{session_windows}$US#{session_attached}"
  fmt+="$US#{?session_last_attached,#{session_last_attached},#{session_created}}"
  fmt+="$US#{n:#{W:#{P:#{?$AGENT,x,}}}}"
  fmt+="$US#{W:#{@cockpit_win_state} }$US#{session_name}"

  local id name nw att last ws na st band nband=0
  local -a recs=()
  local -A n=([needs-input]=0 [error]=0 [running]=0)
  while IFS=$US read -r id nw att last na ws name; do
    [[ $id =~ ^\$[0-9]+$ ]] && num "$nw" && num "$att" && num "$last" && num "$na" || continue
    case " $ws" in
      *" needs-input "*) st=needs-input band=0 ;;
      *" error "*)       st=error band=1 ;;
      *" running "*)     st=running band=2 ;;
      *" done "*)        st=done band=2 ;;
      *)                 st=idle band=2 ;;
    esac
    [ "$na" -gt 0 ] || { st=none band=2; }
    [ -n "${n[$st]:-}" ] && n[$st]=$((n[$st] + 1))
    # Your own session goes last, and your own client is not "elsewhere".
    [ "$id" = "$TM_SID" ] && { band=9; att=$((att - 1)); }
    [ "$band" -le 1 ] && nband=$((nband + 1))
    recs+=("$band$US$((now - last))$US$id$US$nw$US$att$US$st$US$na$US$name")
  done < <(tmux list-sessions -F "$fmt" 2>/dev/null)
  local total=${#recs[@]}

  # "7 sessions · ▲2 · ✕1 · ●1"; --needs reads "needs you · ▲2 ✕1".
  local hdr sep=" ${C[dim]}·$R " k r
  local -a counted=(needs-input error running)
  if [ "${TM_NEEDS:-}" = 1 ] && [ "$nband" -gt 0 ]; then
    local -a keep=()
    for r in "${recs[@]}"; do case $r in [01]"$US"*) keep+=("$r") ;; esac; done
    recs=("${keep[@]}")
    hdr="${C[dim]}needs you ·$R"; sep=' '; counted=(needs-input error)
  else
    hdr="${C[dim]}$total session$([ "$total" = 1 ] || echo s)$R"
    # An empty band falls back to every session rather than an empty popup.
    [ "${TM_NEEDS:-}" = 1 ] && hdr="${C[dim]}nothing needs you ·$R $hdr"
  fi
  for k in "${counted[@]}"; do
    [ "${n[$k]}" -gt 0 ] || continue
    hdr+="$sep${C[$k]}${G[$k]}${n[$k]}$R"
  done
  printf "\t%s$end" "$hdr"
  [ "${#recs[@]}" -gt 0 ] || return 0

  # Sort: needs-input, error, then most recently attached; your own last.
  mapfile -t recs < <(printf '%s\n' "${recs[@]}" | sort -t "$US" -k1,1n -k2,2n)
  # Frozen order: a reload reuses the first render's, so numbers and the cursor
  # keep their session (fzf's --track --id-nth would block typing on each reload).
  if [ -n "${TM_DIR:-}" ]; then
    if [ -s "$TM_DIR/order" ]; then
      local -A at=() ; local -a sorted=() late=() ids=()
      mapfile -t ids < "$TM_DIR/order"
      for k in "${!ids[@]}"; do at[${ids[$k]}]=$k; done
      for r in "${recs[@]}"; do
        IFS=$US read -r _ _ id _ <<<"$r"
        if [ -n "${at[$id]:-}" ]; then sorted[${at[$id]}]=$r; else late+=("$r"); fi
      done
      recs=("${sorted[@]}" "${late[@]}")
    else
      for r in "${recs[@]}"; do IFS=$US read -r _ _ id _ <<<"$r"; printf '%s\n' "$id"; done > "$TM_DIR/order"
    fi
  fi

  # The full name, never cut: fzf searches only what it shows, so a cut name
  # would stop matching its own tail and ↵ would create a duplicate.
  local i=0 age num g a here rest when ag wn
  for r in "${recs[@]}"; do
    IFS=$US read -r band age id nw att st na name <<<"$r"
    i=$((i + 1)); num=' '; [ "$i" -le 9 ] && num=$i
    g="${C[$st]}${G[$st]}$R"
    a=' '; [ "$att" -gt 0 ] && a="${C[dim]}${G[att]}$R"
    if [ "$LW" -ge 60 ]; then
      here=''; [ "$band" = 9 ] && here=" (here)"
      # 22 cells for the name: the name, the tab fzf draws as one space, padding.
      if [ "$na" -gt 0 ]; then ag="$na agent"; [ "$na" = 1 ] || ag+=s; else ag='—'; fi
      wn="$nw win"; [ "$nw" = 1 ] || wn+=s
      when=''; [ "$band" = 9 ] || ago when "$age"
      fit ag "$ag" 10; fit wn "$wn" 7
      printf -v rest '%s%*s%s%s %s  %s%4s%s' "${here:+${C[soft]}$here$R}" \
        $((21 - ${#name} - ${#here} > 0 ? 21 - ${#name} - ${#here} : 1)) '' \
        "$ag" "$wn" "$a" "${C[soft]}" "$when" "$R"
    else
      here=''; [ "$band" = 9 ] && here="‹here›"
      printf -v rest '%s%*s%s' "${here:+${C[soft]}$here$R}" \
        $((23 - ${#name} - ${#here} > 0 ? 23 - ${#name} - ${#here} : 1)) '' "$a"
    fi
    printf "%s\t%s %s \t%s\t%s$end" "$id" "$num" "$g" "$name" "$rest"
  done
}

# The session's windows with their state, then the tail of its most urgent pane.
preview() {  # preview SESSION_ID
  glyphs; palette
  local s=$1 w=${FZF_PREVIEW_COLUMNS:-60} l=${FZF_PREVIEW_LINES:-20}
  local wi pid pa wa st cmd rank best=9 worst='' active='' name sname=''
  local -a order=() ; local -A wst=() wcmd=() wpane=() wrank=()
  local -A rk=([needs-input]=0 [error]=1 [running]=2 [done]=3 [idle]=4 [none]=5)
  while IFS=$US read -r wi pid pa wa st name cmd; do
    num "$wi" && [[ $pid =~ ^%[0-9]+$ ]] || continue
    sname=$name st=${st:-none}; rank=${rk[$st]:-5}
    [ -n "${wrank[$wi]:-}" ] || { order+=("$wi"); wrank[$wi]=9; }
    if [ "$rank" -lt "${wrank[$wi]}" ] || { [ "$pa" = 1 ] && [ "$rank" = "${wrank[$wi]}" ]; }; then
      wrank[$wi]=$rank; wst[$wi]=$st; wcmd[$wi]=$cmd; wpane[$wi]=$pid
    fi
    [ "$rank" -lt "$best" ] && { best=$rank; worst=$pid; }
    [ "$pa$wa" = 11 ] && active=$pid
  done < <(tmux list-panes -s -t "$s" -F "#{window_index}$US#{pane_id}$US#{pane_active}$US#{window_active}$US#{?$AGENT,#{?@panestate,#{@panestate},idle},}$US#{session_name}$US#{pane_current_command}" 2>/dev/null)
  [ "${#order[@]}" -gt 0 ] || return 0
  # No agent anywhere: the pane you would land on.
  [ "$best" -lt 5 ] || worst=$active

  printf '%s%s · %d window%s%s\n' "${C[dim]}" "$sname" "${#order[@]}" "$([ "${#order[@]}" = 1 ] || echo s)" "$R"
  local txt msg
  for wi in "${order[@]}"; do
    st=${wst[$wi]}
    case $st in
      needs-input) ask_of msg "${wpane[$wi]}"; txt="${C[needs-input]}needs you:$R $msg" ;;
      error)       ask_of msg "${wpane[$wi]}"; txt="${C[error]}error:$R $msg" ;;
      none)        txt="${C[dim]}no agent$R" ;;
      *)           txt="${C[dim]}$st$R" ;;
    esac
    fit cmd "${wcmd[$wi]//[$'\001'-$'\037'$'\177']/}" 8
    printf ' %s %s%s%s %s %s\n' "$wi" "${C[$st]}" "${G[$st]}" "$R" "$cmd" "$txt"
  done
  printf -v txt '%*s' "$w" ''
  printf '%s%s%s\n' "${C[dim]}" "${txt// /─}" "$R"
  # -J joins wrapped lines; no -e, so the agent's colours do not fight the theme.
  local -a tail=()
  mapfile -t tail < <(tmux capture-pane -p -J -t "$worst" 2>/dev/null)
  while [ "${#tail[@]}" -gt 0 ] && [ -z "${tail[-1]// /}" ]; do unset 'tail[-1]'; done
  local room=$((l - ${#order[@]} - 2))
  [ "$room" -gt 0 ] && [ "${#tail[@]}" -gt 0 ] &&
    printf '%s\n' "${tail[@]: -$((room < ${#tail[@]} ? room : ${#tail[@]}))}"
}

footer() {  # the resting footer for the list's width
  listw
  if   [ "$LW" -ge 80 ]; then printf '%s' '↵ switch · type a name + ↵ creates · ^X kill · ^/ preview · 1-9 jump · esc close'
  elif [ "$LW" -ge 64 ]; then printf '%s' '↵ switch · type a name + ↵ creates · ^X kill · ^/ preview · esc'
  else                        printf '%s' '↵ go · name+↵ new · ^X kill · esc'
  fi
}

act() {  # act ACTION TEXT -- ACTION(TEXT) in a bracket pair TEXT does not contain
  local p
  for p in '()' '[]' '{}' '<>' '~~' '!!' '@@' '##' '$$' '%%' '^^' '&&' '**' '//' ';;' '||'; do
    case $2 in *"${p:1}"*) continue ;; esac
    printf '%s%s%s%s' "$1" "${p:0:1}" "$2" "${p:1}"; return
  done
}

# $TM_DIR/armed holds the footer's state: empty when it rests, =ID while a kill
# is armed, ! for a one-off message, + for the create hint.
ARMED=''
armed() { ARMED=''; [ -s "$TM_DIR/armed" ] && read -r ARMED < "$TM_DIR/armed"; }

arm() {  # arm ID -- the fzf actions for ^X on that session
  palette; armed; own
  local id=$1 name att na nr nw what='' h
  if [ "$ARMED" = "=$id" ]; then
    # The reload goes last: fzf drops whatever a chain holds after it.
    printf '%s+change-header()+%s+%s' "$(act execute-silent "$QSELF --kill-armed")" \
      "$(act change-footer "$(footer)")" "$(act reload-sync "$QSELF --rows")"
    return
  fi
  IFS=$US read -r name att na nr nw < <(tmux display-message -p -t "$id" \
    "#{session_name}$US#{session_attached}$US#{n:#{W:#{P:#{?$AGENT,x,}}}}$US#{n:#{W:#{P:#{?$AGENT,#{?#{==:#{@panestate},running},x,},}}}}$US#{n:#{W:#{P:#{?$AGENT,#{?#{==:#{@panestate},needs-input},x,},}}}}" 2>/dev/null)
  [ -n "${name:-}" ] || return 0
  if [ "$id" = "$TM_SID" ]; then
    printf '!\n' > "$TM_DIR/armed"
    printf 'change-footer:%s%s is this session · detach or use tm -k%s' "${C[needs-input]}" "$name" "$R"
    return
  fi
  printf '=%s\n' "$id" > "$TM_DIR/armed"
  # What you would lose, the most surprising first: §3.3 wants "attached elsewhere" seen.
  [ "$att" -gt 0 ] && what+=" · attached elsewhere"
  [ "$nw" -gt 0 ] && what+=" · $nw waiting"
  [ "$nr" -gt 0 ] && what+=" · $nr running"
  if [ "$na" -gt 0 ]; then what+=" · $na agent"; [ "$na" = 1 ] || what+=s; else what+=' · no agents'; fi
  h=$(act change-header "${C[needs-input]}kill $name?$R ${C[dim]}${what# · }$R")
  [ -z "$h" ] || printf '%s+' "$h"
  printf 'change-footer:%s^X again kills%s%s · any key cancels%s' "${C[needs-input]}" "$R" "${C[dim]}" "$R"
}

disarm() {  # disarm [ID] -- restore the header and footer, unless ID is the armed row
  armed
  [ -n "$ARMED" ] || return 0
  [ -n "${1:-}" ] && [ "$ARMED" = "=$1" ] && return 0
  : > "$TM_DIR/armed"
  printf 'change-header()+%s' "$(act change-footer "$(footer)")"
}

# The query matches nothing: say that ↵ creates it (§2.5).
result() {
  armed
  if [ "${FZF_MATCH_COUNT:-1}" = 0 ] && [ -n "${FZF_QUERY:-}" ] && [ "${ARMED:0:1}" != = ]; then
    printf '+\n' > "$TM_DIR/armed"
    printf 'change-footer:↵ create "%s" · esc' "$(clean "$FZF_QUERY")"
  elif [ "$ARMED" = + ]; then
    disarm
  fi
}

pick() {
  local cols glyph
  load_theme
  glyph=$(tmux display-message -p '#{@cockpit_glyphs}' 2>/dev/null)
  cols=$(tput cols 2>/dev/null); num "$cols" || cols=80
  TM_DIR=$(mktemp -d) || die "cockpit: no temp dir for the picker"
  trap 'rm -rf "$TM_DIR"' EXIT
  trap 'exit 130' INT TERM HUP
  export TM_DIR TM_GLYPHS=${glyph:-} TM_NEEDS=${TM_NEEDS:-}
  palette; own

  local -a THEME args digits=()
  local n foot
  foot=$(FZF_COLUMNS=$cols footer)
  mapfile -t THEME < <(cockpit_fzf_args highlight-line "footer=$foot")
  for n in 1 2 3 4 5 6 7 8 9; do
    digits+=(--bind "$n:transform:[ -z \"\$FZF_QUERY\" ] && [ $n -le \"\$FZF_MATCH_COUNT\" ] && echo 'pos($n)+accept' || echo 'put($n)'")
  done
  args=(--height="$([ -n "${TM_POPUP:-}" ] && echo 100% || echo 40%)" --reverse --no-multi
        --info=inline-right --cycle --scroll-off=2 --tiebreak=index
        --delimiter=$'\t' --with-nth=2.. --nth=2 --header-lines=1 --footer-border=line
        --print-query --prompt='session> '
        --preview="$QSELF --preview {1}"
        # fzf still starts a shell per event; the -s test spares it starting tm.
        --bind "ctrl-/:toggle-preview+transform:[ ! -s \"\$TM_DIR/armed\" ] || $QSELF --disarm"
        --bind "ctrl-x:transform:$QSELF --arm {1}"
        --bind "focus:transform:[ ! -s \"\$TM_DIR/armed\" ] || $QSELF --disarm {1}"
        --bind "change:transform:[ ! -s \"\$TM_DIR/armed\" ] || $QSELF --disarm"
        --bind 'alt-enter:print(new)+accept'
        --bind "resize:$(act transform "$QSELF --resized")+$(act reload-sync "$QSELF --rows")"
        "${digits[@]}")
  args+=(--bind "every(2):$(act reload-sync "$QSELF --rows")+refresh-preview"
         --bind "result:transform:[ \"\$FZF_MATCH_COUNT\" != 0 ] && [ ! -s \"\$TM_DIR/armed\" ] || $QSELF --result"
         --preview-window='right,50%,border-left,<60(down,12,border-top)')

  local out rc query line
  out=$(FZF_COLUMNS=$cols rows | fzf "${THEME[@]}" "${args[@]}"); rc=$?
  # 0 picked, 1 nothing matched; 130 is esc, 2 an fzf error.
  case $rc in 0|1) ;; 2) die "cockpit: fzf failed · tm needs fzf 0.73+" ;; *) exit 0 ;; esac
  query=${out%%$'\n'*}
  local -a lines=()
  mapfile -t lines <<<"${out#*$'\n'}"
  [ "$out" = "$query" ] && lines=()
  for line in "${lines[@]}"; do [ "$line" = new ] && { go "$(clean "$query")"; return; }; done
  for line in "${lines[@]}"; do
    case $line in *$'\t'*) enter "${line%%$'\t'*}"; return ;; esac
  done
  go "$(clean "$query")"
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  -l|--list) list; exit 0 ;;
  --rows)    rows; exit ;;
  --preview) preview "${2:-}"; exit ;;
  --footer)  footer; exit ;;
  --arm)     arm "${2:-}"; exit ;;
  --disarm)  disarm "${2:-}"; exit ;;
  --result)  result; exit ;;
  --resized) : > "$TM_DIR/armed"; printf 'change-header()+%s' "$(act change-footer "$(footer)")"; exit ;;
  --kill-armed)
    # arm() never arms your own session, so this kills what the user confirmed.
    armed; : > "$TM_DIR/armed"
    [ "${ARMED:0:1}" != = ] || tmux kill-session -t "${ARMED#=}" 2>/dev/null
    exit 0 ;;
  --needs)   export TM_NEEDS=1; shift ;;
  -k|--kill)
    shift
    if [ $# -gt 0 ]; then
      for s in "$@"; do kill_one "$(clean "$s")"; done
      exit 0
    fi
    [ -n "$(list)" ] || die "cockpit: no tmux sessions to kill"
    doomed=()
    if command -v fzf >/dev/null; then
      load_theme
      mapfile -t THEME < <(cockpit_fzf_args highlight-line "footer=$K_KILL")
      # The red --color must come after the theme for fzf to let it win.
      mapfile -t doomed < <(rows \
        | fzf "${THEME[@]}" \
              --multi --height=40% --reverse --info=inline-right --cycle --scroll-off=2 \
              --delimiter=$'\t' --with-nth=2.. --nth=2 --header-lines=1 \
              --color=prompt:red,pointer:red,marker:red --marker='✗' \
              --prompt='kill session> ')
      for s in "${doomed[@]}"; do
        IFS=$'\t' read -r id _ name _ <<<"$s"
        tmux kill-session -t "$id" 2>/dev/null && printf 'killed: %s\n' "$name" >&2
      done
    else
      printf 'Kill which session?\n' >&2; list >&2
      kill_one "$(ask_name 'Name (empty cancels): ')"
    fi
    exit 0 ;;
esac
# An internal piece that failed part-way must never reach the name below:
# "tm --rows" would create a session called "rows".
case "${1:-}" in -*) die "cockpit: unknown option: $1 · try tm -h" ;; esac

if [ $# -gt 0 ] && [ -n "$1" ]; then
  go "$(clean "$1")"
  exit
fi

# A popup always has a session, its own; restoring belongs to a login shell.
[ -n "${TM_POPUP:-}" ] || restore_if_empty
sessions=$(list)
if [ -z "$sessions" ]; then
  printf 'cockpit: No tmux sessions running.\n' >&2
  go "$(ask_name)"
  exit
fi
if ! command -v fzf >/dev/null; then
  printf 'Sessions:\n%s\n' "$sessions" >&2
  go "$(ask_name 'Session (a new name creates it, empty cancels): ')"
  exit
fi
pick
