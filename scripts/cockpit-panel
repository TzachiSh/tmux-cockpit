#!/usr/bin/env bash
# cockpit-panel — the shell half of the panel: it does the paste the binary prints.
#   cockpit-panel -p <pane>     the pane the key was pressed in
#   cockpit-panel -p <pane> --ask <file> <a> <b>
#                               the viewer's ? (#365): a question about lines a-b
# ^Z in the panel hides it: the state is kept per pane and the next run on the
# same pane brings it back (#278).
# The action comes back through a file, never $(…): ratatui paints on stdout.
set -u

DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)" || exit 1
LOG=${COCKPIT_LOG:-${XDG_STATE_HOME:-$HOME/.local/state}/tmux-cockpit/tui.log}
# shellcheck source=lib/pane.sh
. "$DIR/scripts/lib/pane.sh" || exit 1
# shellcheck source=lib/tui.sh
. "$DIR/scripts/lib/tui.sh" || exit 1
# shellcheck source=lib/fmt.sh
. "$DIR/scripts/lib/fmt.sh" || exit 1
# shellcheck source=lib/basket.sh
. "$DIR/scripts/lib/basket.sh" || exit 1
BIN=$COCKPIT_TUI_BIN

# $EPOCHREALTIME needs bash 5, and no portable `date` flag gives microseconds.
log() {
    local ts=${EPOCHREALTIME:-}; ts=${ts/./}; [ -n "$ts" ] || ts="$(date +%s)000000"
    printf '%s cockpit-panel: %s\n' "$ts" "$*" >> "$LOG"
}

PANE='' ask=()
case "${1:-}" in
    -p) PANE=${2:-} ;;
    *)  printf 'usage: cockpit-panel -p <pane> [--ask <file> <a> <b>]\n' >&2; exit 2 ;;
esac
# --ask (#365): the first run opens on the question; the binary checks the lines again
if [ "${3:-}" = --ask ]; then
    n='^[1-9][0-9]{0,8}$'
    if [ "$#" -ne 6 ] || [ -z "$4" ] || ! [[ $5 =~ $n && $6 =~ $n ]] || [ "$5" -gt "$6" ]; then
        printf 'usage: cockpit-panel -p <pane> --ask <file> <a> <b>\n' >&2; exit 2
    fi
    ask=(--ask "$4" "$5" "$6")
elif [ "$#" -gt 2 ]; then
    printf 'usage: cockpit-panel -p <pane> [--ask <file> <a> <b>]\n' >&2; exit 2
fi
# In a popup a bare display-message picks the most recently active client.
say=(display-message); is_pane "$PANE" && say+=(-t "$PANE")
# Opened from the board, the outcome is the board's note on its return rather
# than a status-line message; the board keeps a line starting with ✕ until a key.
said() {                      # <ok|fail> <text> <display-message argv...>
    local how=$1 text=$2; shift 2
    if [ -n "${COCKPIT_PANEL_NOTE:-}" ]; then
        [ "$how" = ok ] || text="✕ $text"
        # One line: a newline in, say, a pane's command would make the board refuse it.
        text=$(printf '%s' "$text" | LC_ALL=C tr '\000-\037\177' ' ')
        printf '%s\n' "$text" > "$COCKPIT_PANEL_NOTE" 2>/dev/null
    else
        # A format: the pane's command, a path or a pane id must not expand.
        tmux "$@" "$(fesc "$text")" 2>/dev/null
    fi
}
# The messages outside a paste; under COCKPIT_READONLY they go to the log only.
tell() {
    if [ -n "${COCKPIT_READONLY:-}" ] && [ -z "${COCKPIT_PANEL_NOTE:-}" ]; then log "readonly, not said: $1"; else said fail "$1" "${say[@]}"; fi
}

if [ ! -x "$BIN" ]; then
    tell "cockpit: the panel needs cockpit-tui: run $DIR/install.sh"
    exit 0
fi
is_pane "$PANE" || { tell "cockpit: the panel needs a pane id, not [$PANE]"; exit 0; }

mkdir -p "$(dirname "$LOG")" 2>/dev/null

# A hidden panel is one file per pane, keyed on the server's pid too: a new
# server hands out %0 again, and other -L servers share this directory. One the
# binary would refuse as over a day old (its HIDE_AGE) goes here, any server's.
HDIR=${XDG_STATE_HOME:-$HOME/.local/state}/tmux-cockpit/panel
spid=$(tmux display -p '#{pid}' 2>/dev/null) saved='' dropped=''
case "$spid" in ''|*[!0-9]*) ;; *) saved="$HDIR/$spid-${PANE#%}.state" ;; esac
if [ -n "$saved" ] && [ -d "$HDIR" ]; then
    find "$HDIR" -maxdepth 1 -name '*.state' -mmin +1440 -exec rm -f {} + 2>/dev/null
    # This server's other panes: one that is gone can never be brought back.
    for s in "$HDIR/$spid-"*.state; do
        n=${s##*/"$spid"-}; n=${n%.state}
        case "$n" in ''|*[!0-9]*) continue ;; esac
        [ "%$n" = "$PANE" ] && continue
        # display exits 0 on a gone pane, printing nothing: the id is what tells
        [ "$(tmux display -p -t "%$n" '#{pane_id}' 2>/dev/null)" = "%$n" ] && continue
        rm -f "$s" && dropped="$dropped %$n"
    done
fi
# A private 0700 directory: a name beside a mktemp file in a shared /tmp is
# one another user can create first, and its text would be pasted.
d=$(mktemp -d) || exit 1
f="$d/act"
buf="cockpit-panel-$$"
trap 'rm -rf "$d"' EXIT

# The action, run the way the binary asked; `last` says how it went, for a resume.
act() {
    # One line, `<verb> <pane-id>`; see cockpit-board for why the read is shaped so.
    local verb='' target='' rest='' bad='' want='' now='' before='' err n i
    read -r verb target rest 2>/dev/null < "$f"
    [ -n "$verb" ] || return 1
    [ -z "$rest" ] || bad=1
    case "$verb" in paste|send) ;; *) bad=1 ;; esac
    is_pane "$target" || bad=1
    # The binary only ever answers for the pane it was opened on.
    [ "$target" = "$PANE" ] || bad=1
    if [ -n "$bad" ]; then
        log "ignored action line [$verb $target $rest]"
        return 1
    fi

    [ -s "$f.text" ] || return 1
    # Screenshots and probes: the whole panel runs, and the pane is never written.
    if [ -n "${COCKPIT_READONLY:-}" ]; then
        log "readonly, not sent: $verb $target"
        [ -z "${COCKPIT_PANEL_NOTE:-}" ] || said fail "cockpit: COCKPIT_READONLY is set; nothing sent"
        last="failed:COCKPIT_READONLY is set; nothing sent"
        return 0
    fi
    # The answer was written for what the pane ran at capture time; a Claude Code
    # that exited since would take the prose as shell input.
    read -r want 2>/dev/null < "$f.cmd"
    now=$(tmux display -p -t "$target" '#{pane_current_command}' 2>/dev/null)
    if [ -z "$want" ] || [ "$now" != "$want" ]; then
        said fail "cockpit: the pane now runs ${now:-nothing}, not ${want:-?}; nothing sent" display-message -t "$target"
        log "$target now runs [$now], not [$want]; nothing sent"
        last="failed:the pane now runs ${now:-nothing}, not ${want:-?}"
        return 0
    fi
    if ! err=$(strip | tmux load-buffer -b "$buf" - 2>&1); then
        log "load-buffer failed for $target: ${err:-no error text}"
        said fail "cockpit: could not load the paste buffer; nothing sent to $target" "${say[@]}"
        last="failed:could not load the paste buffer"
        return 0
    fi
    # -p brackets the paste when the program asked for it; -d drops the buffer after.
    [ "$verb" = send ] && before=$(tmux capture-pane -p -t "$target" 2>/dev/null)
    if ! err=$(tmux paste-buffer -p -d -b "$buf" -t "$target" 2>&1); then
        tmux delete-buffer -b "$buf" 2>/dev/null
        log "paste-buffer failed for $target: ${err:-no error text}"
        said fail "cockpit: could not paste into $target; nothing sent" "${say[@]}"
        last="failed:could not paste into $target"
        return 0
    fi
    last=ok
    # #365 child 5: the refs went with this text, so the basket is spent; cleared
    # only when it still holds what was sent (a viewer may have added since)
    if [ -s "$f.basket" ] && ! basket_clear "$target" "$f.basket"; then
        log "the basket of $target changed since the send; kept"
    fi
    if [ "$verb" != send ]; then
        n=$(strip | wc -m)
        said ok "cockpit: inserted $((n)) chars into $target" "${say[@]}"
        return 0
    fi
    # Ink apps (Claude Code) can drop an Enter that lands in the same read as the
    # paste, so wait for the paste to show first: at most 20 x 50 ms.
    i=0
    while [ "$i" -lt 20 ] && [ "$(tmux capture-pane -p -t "$target" 2>/dev/null)" = "$before" ]; do
        sleep 0.05; i=$((i + 1))
    done
    tmux send-keys -t "$target" Enter 2>/dev/null
    said ok "cockpit: sent to $target" "${say[@]}"
    return 0
}
# Stripped again on the way: the binary already did, but this is what reaches the pane.
strip() { LC_ALL=C tr -d '\000-\010\013-\037\177' < "$f.text"; }

# Steps stay open across actions: the binary leaves $f.state beside the action
# line and is run again on it, in this same popup, until it exits with none.
resume=() last=
# Moved, not read in place: the run that takes it owns it, and a second client's
# prefix f on the same pane finds nothing.
# an ask opens on its own question: a panel hidden on this pane stays hidden for later
kept=''; [ -n "$saved" ] && { [ -e "$saved" ] || [ -L "$saved" ]; } && kept=1
if [ "${#ask[@]}" -eq 0 ] && [ -n "$kept" ] && mv -f "$saved" "$d/resume" 2>/dev/null; then
    resume=(--resume "$d/resume" --last hidden)
fi
# the pane keeps one hidden panel: an ask opened beside it is told, so its ^Z refuses
taken=''; [ "${#ask[@]}" -gt 0 ] && [ -n "$kept" ] && taken=1
glyphs=$(tmux show-option -gqv @cockpit_glyphs 2>/dev/null)   # #293: the binary reads only the env
# #623: as it is; the binary keeps only the CLI's effort words, medium for the rest
effort=$(tmux show-option -gqv @cockpit_panel_effort 2>/dev/null)
while :; do
    rm -f "$f" "$f.text" "$f.cmd" "$f.state" "$f.basket"
    # CLAUDECODE leaks in from the agent's environment and must not mark the call as its child.
    env -u CLAUDECODE COCKPIT_ACTION="$f" COCKPIT_LOG="$LOG" COCKPIT_PANEL_DROPPED="${dropped# }" \
        ${glyphs:+"COCKPIT_GLYPHS=$glyphs"} ${effort:+"COCKPIT_PANEL_EFFORT=$effort"} \
        ${taken:+COCKPIT_PANEL_HIDE_TAKEN=1} \
        "$BIN" panel "$PANE" ${resume[@]+"${resume[@]}"} ${ask[@]+"${ask[@]}"} 2>>"$LOG" || {
        rc=$?
        tell "cockpit: the panel exited $rc — see $LOG"
        exit 0
    }
    rm -f "$d/resume"; dropped='' ask=()
    # No action line and a state file: ^Z hid the panel. From the board the note
    # is the board's, and the board loop goes on as after esc.
    if [ ! -s "$f" ] && [ -s "$f.state" ]; then
        # never over a panel already hidden here (a binary that missed the env)
        if [ -n "$saved" ] && { [ -e "$saved" ] || [ -L "$saved" ]; }; then
            log "not hiding over the panel already hidden on $PANE"
            tell "cockpit: a panel is already hidden on $PANE; this one is closed"
            exit 0
        fi
        if [ -n "$saved" ] && mkdir -p "$HDIR" 2>/dev/null && chmod 700 "$HDIR" 2>/dev/null && mv -f "$f.state" "$saved"; then
            hk=$(tmux show-option -gqv @cockpit_panel_bound 2>/dev/null)
            if [ -n "$hk" ]; then hk="prefix $hk"; else hk="the panel key"; fi
            msg="cockpit: hidden · $hk on $PANE brings it back"
            if [ -n "${COCKPIT_READONLY:-}" ] && [ -z "${COCKPIT_PANEL_NOTE:-}" ]; then log "readonly, not said: $msg"; else said ok "$msg" "${say[@]}"; fi
        else
            log "could not keep the hidden panel of $PANE at [${saved:-no server pid}]"
            tell "cockpit: could not keep the hidden panel; it is lost"
        fi
        exit 0
    fi
    act || exit 0
    [ -s "$f.state" ] || exit 0
    mv -f "$f.state" "$d/resume" || exit 0
    resume=(--resume "$d/resume" --last "$last")
done
