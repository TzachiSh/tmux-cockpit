#!/usr/bin/env bash
# cockpit-panel — the shell half of the panel: it does the paste the binary prints.
#   cockpit-panel -p <pane>     the pane the key was pressed in
# The action comes back through a file, never $(…): ratatui paints on stdout.
set -u

DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)" || exit 1
BIN="$DIR/bin/cockpit-tui"
LOG=${COCKPIT_LOG:-${XDG_STATE_HOME:-$HOME/.local/state}/tmux-cockpit/tui.log}

# %<digits> only: the value reaches a tmux target or a script argument.
is_pane() { case "${1-}" in %*) case "${1#%}" in ''|*[!0-9]*) return 1 ;; esac ;; *) return 1 ;; esac; }

PANE=
case "${1:-}" in
    -p) PANE=${2:-} ;;
    *)  printf 'usage: cockpit-panel -p <pane>\n' >&2; exit 2 ;;
esac
# In a popup a bare display-message picks the most recently active client.
say=(display-message); is_pane "$PANE" && say+=(-t "$PANE")

if [ ! -x "$BIN" ]; then
    tmux "${say[@]}" "cockpit: the panel needs cockpit-tui: prefix U fetches it" 2>/dev/null
    exit 0
fi
is_pane "$PANE" || { tmux "${say[@]}" "cockpit: the panel needs a pane id, not [$PANE]" 2>/dev/null; exit 0; }

mkdir -p "$(dirname "$LOG")" 2>/dev/null
# A private 0700 directory: a name beside a mktemp file in a shared /tmp is
# one another user can create first, and its text would be pasted.
d=$(mktemp -d) || exit 1
f="$d/act"
buf="cockpit-panel-$$"
trap 'rm -rf "$d"' EXIT

# CLAUDECODE leaks in from the agent's environment and must not mark the call as its child.
env -u CLAUDECODE COCKPIT_ACTION="$f" COCKPIT_LOG="$LOG" "$BIN" panel "$PANE" 2>>"$LOG" || {
    rc=$?
    tmux "${say[@]}" "cockpit: the panel exited $rc — see $LOG" 2>/dev/null
    exit 0
}

# One line, `<verb> <pane-id>`; see cockpit-board for why the read is shaped so.
verb='' target='' rest=''
read -r verb target rest 2>/dev/null < "$f"
[ -n "$verb" ] || exit 0
bad=
[ -z "$rest" ] || bad=1
case "$verb" in paste|send) ;; *) bad=1 ;; esac
is_pane "$target" || bad=1
# The binary only ever answers for the pane it was opened on.
[ "$target" = "$PANE" ] || bad=1
if [ -n "$bad" ]; then
    ts=${EPOCHREALTIME:-}; ts=${ts/./}; [ -n "$ts" ] || ts="$(date +%s)000000"
    printf '%s cockpit-panel: ignored action line [%s]\n' "$ts" "$verb $target $rest" >> "$LOG"
    exit 0
fi

[ -s "$f.text" ] || exit 0
# Stripped again on the way: the binary already did, but this is what reaches the pane.
LC_ALL=C tr -d '\000-\010\013-\037\177' < "$f.text" | tmux load-buffer -b "$buf" - 2>/dev/null || exit 0
# -p brackets the paste when the program asked for it; -d drops the buffer after.
tmux paste-buffer -p -d -b "$buf" -t "$target" 2>/dev/null || { tmux delete-buffer -b "$buf" 2>/dev/null; exit 0; }
[ "$verb" = send ] && tmux send-keys -t "$target" Enter 2>/dev/null
exit 0
