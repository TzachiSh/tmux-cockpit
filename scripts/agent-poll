#!/bin/bash
# agent-poll: the state source for panes that show a background job (#174, #448). A job's
# turn runs in a background worker that reports no state to the terminal showing it, so the
# pane is written from `claude agents --json --all`:
#   - a pane whose title names exactly one background job (the bind rule, JQ_PROG below) shows
#     that job's state, and carries @cockpit_job <id> and @cockpit_job_name <name> while bound;
#   - any other pane marked @cockpit_agentview (by agent-state notify) shows the worst background
#     session, blocked > failed > working > done; none or stopped is idle.
# One poller per tmux server and Claude config dir (#194), its pid in the global
# @cockpit_poll_pid (or @cockpit_poll_pid_<key> for a dir, see KEY below), started by the load
# and window-event sweeps (agent-state sweep) and by a relayed agent notification. It stays for
# the life of the server: nothing a background job does may touch tmux (#174), so no hook could
# start it when a job appears. A tick is a list-panes; claude is read only when it can matter.
#   usage: agent-poll [--once]    --once: one poll, no publishing, then exit (the tests).
# Every @cockpit_bg_poll seconds (default 10; "off" never starts). It leaves when the server
# goes and on every signal; a failed or missing claude or jq writes nothing and the poller
# waits for the next tick. Writes go through `agent-state poll`.
set -u

once=0; [ "${1:-}" = --once ] && once=1
d=${BASH_SOURCE[0]}; [ -L "$d" ] && d=$(readlink "$d")
here=${d%/*}
# shellcheck source=lib/hook.sh
. "$here/lib/hook.sh" 2>/dev/null || exit 0
# shellcheck source=lib/fmt.sh
. "$here/lib/fmt.sh" 2>/dev/null || exit 0

# One poller per Claude config dir (#194). COCKPIT_POLL_KEY is the dir's cksum, empty for the
# default dir: this poller's slot, @cockpit_poll_pid or @cockpit_poll_pid_<key>, and the panes it
# serves, those whose @cockpit_cfg (the dir their hooks saw) is the CLAUDE_CONFIG_DIR it runs with.
KEY=${COCKPIT_POLL_KEY:-}
case "$KEY" in *[!0-9]*) exit 0 ;; esac
SLOT=@cockpit_poll_pid${KEY:+_$KEY}
MYDIR=${CLAUDE_CONFIG_DIR:-}
idle=0                        # ticks in a row with no pane of this dir; a dir poller leaves at 3

interval() {                  # -> seconds, or "off"
    local v; v=$(tmux show-option -gqv @cockpit_bg_poll 2>/dev/null)
    case "$v" in off) echo off ;; ''|*[!0-9]*|0) echo 10 ;; *) echo "$v" ;; esac
}

# One slot per server. The claim is a compare-and-set inside the tmux server, which runs one
# command at a time: the slot is taken only if it still holds what was read, whether that was
# nothing or a dead poller's pid, so two pollers racing for it cannot both win. A poller also
# rechecks the slot every tick (tick below), so a wrong answer from poll_alive costs one tick.
claim() {
    local cur have
    # A dir's slot is that dir's alone: two dirs on one cksum never share it (#194).
    if [ -n "$KEY" ]; then
        have=$(tmux show-option -gqv "@cockpit_poll_dir_$KEY" 2>/dev/null)
        if [ "$have" != "$MYDIR" ]; then
            tmux set-option -g @cockpit_poll_err "config dirs share a poller key: $KEY" 2>/dev/null
            return 1
        fi
    fi
    cur=$(tmux show-option -gqv "$SLOT" 2>/dev/null)
    if [ -n "$cur" ] && [ "$cur" != "$$" ] && poll_alive "$cur"; then return 1; fi
    # Not a pid: clear it, then compete for the empty slot like everyone else.
    case "$cur" in *[!0-9]*) tmux set-option -gu "$SLOT" 2>/dev/null; cur="" ;; esac
    tmux if-shell -F "#{==:#{$SLOT},$cur}" "set-option -g $SLOT $$" 2>/dev/null
    [ "$(tmux show-option -gqv "$SLOT" 2>/dev/null)" = "$$" ]
}
# Our own pid only (a later poller's stays), and a sleep child still running goes with us.
release() {
    local drop="set-option -gu $SLOT"
    [ -z "$KEY" ] || drop="$drop ; set-option -gu @cockpit_poll_dir_$KEY"
    tmux if-shell -F "#{==:#{$SLOT},$$}" "$drop" 2>/dev/null
    [ -n "$sleeper" ] && kill "$sleeper" 2>/dev/null
    # A signal between `sleep &` and `sleeper=$!` leaves the pid unsaved; the sleep is still a
    # live job of ours. A loop, not `kill $(jobs -p)`: with no job that would still run kill.
    local j; for j in $(jobs -p); do kill "$j" 2>/dev/null; done
    return 0
}

# Why the last read failed, in @cockpit_poll_err (cleared by a good one), and said once in a
# message: without it a poller that cannot run claude or jq is silent, and the stuck pane looks
# like #174 again. The option outlives this poller, so the next one does not say it again.
poll_err() {                  # <reason> | "" ; one tmux call per change
    [ "$1" = "$lasterr" ] && return 0
    if [ -n "$1" ]; then
        tmux set-option -g @cockpit_poll_err "$1" \; \
            display-message "$(fesc "tmux-cockpit: the agent view cannot poll: $1")" 2>/dev/null
    else tmux set-option -gu @cockpit_poll_err 2>/dev/null; fi
    lasterr=$1
}

# Fields of a pane row, each behind a "." so none is empty and `read` cannot fold the tabs
# (a leading empty field would vanish). The title is last: tmux escapes a tab in it.
T=$'\t'
PANE_FMT=".#{pane_id}$T.#{pane_current_command}$T.#{allow-set-title}"
PANE_FMT="$PANE_FMT$T.#{?#{m/i:*|#{pane_current_command}|*,#{@cockpit_agents_glob}},1,0}"
PANE_FMT="$PANE_FMT$T.#{@cockpit_agentview}$T.#{@cockpit_fg}"
PANE_FMT="$PANE_FMT$T.#{@cockpit_job}$T.#{@cockpit_job_name}$T.#{@cockpit_job_state}"
PANE_FMT="$PANE_FMT$T.#{@panestate}$T.#{$SLOT}$T.#{@cockpit_cfg}$T.#{pane_title}"

# jq program. Input: claude's JSON. $panes: "<pane id> TAB <@cockpit_fg> TAB <title>" lines of
# the panes that may be bound. Output, tab-separated: `W worst blockedname` (today's worst of
# all), then per pane `M pane jobid state name` (bound) or `D pane` (its title names two or
# more jobs).
# The bind rule (#448): the title, minus an optional leading "✳ " and with whitespace runs
# collapsed, equals one background job's name, collapsed the same way; done jobs count; a
# job without an id does not; an agent view's own title never binds. A pane with a foreground
# session's mark (@cockpit_fg, the epoch second of its last hook state change) binds only to a
# job that started after it: its own session, sent to the background with the left arrow. A
# startedAt that is no number counts as the epoch.
JQ_PROG='
  def clean: tostring | gsub("[\u0000-\u001f\u007f]"; " ");
  def norm: clean | [splits("\\s+")] | map(select(length > 0)) | join(" ");
  if type != "array" then error("not an array") else . end
  | [.[] | select(.kind == "background")] as $b
  | [$b[] | select(.state == "blocked")] as $bl
  | (if ($bl | length) > 0 then "blocked"
     elif any($b[]; .state == "failed") then "failed"
     elif any($b[]; .state == "working") then "working"
     elif any($b[]; .state == "done") then "done"
     else "idle" end) as $w
  | [$b[] | select((.id | type) == "string" and (.id | length) > 0)
     | {id: (.id | clean), state: ((.state // "none") | clean), name: ((.name // "") | norm),
        at: (if (.startedAt | type) == "number" then .startedAt / 1000 else 0 end)}
     | select(.name != "")] as $jobs
  | [$panes | split("\n")[] | select(length > 0) | split("\t")
     | {pane: .[0], fg: .[1],
        t: (.[2:] | join(" ") | if startswith("✳ ") then .[2:] else . end | norm)}
     | select(.t != "" and .t != "claude agents"
              and (.t | endswith(" · claude agents") | not))] as $ps
  | "W\t\($w)\t" + (if $w == "blocked"
        then (($bl[0].name // $bl[0].id // "session") | clean) else "" end),
    ($ps[] | . as $p | [$jobs[] | select(.name == $p.t)] as $m
     | if ($m | length) == 1
          and ($p.fg == "" or ($p.fg | test("^[0-9]{10,}$") and $m[0].at > ($p.fg | tonumber)))
       then "M\t\($p.pane)\t\($m[0].id)\t\($m[0].state)\t\($m[0].name[0:120])"
       elif ($m | length) > 1 and $p.fg == "" then "D\t\($p.pane)" else empty end)'

# A job's state as the pane shows it. An unknown one (research preview) is idle.
job_state() {                 # <claude state> -> the agent-state poll value
    case "$1" in
        blocked) echo needs-input ;; failed) echo error ;; working) echo running ;;
        done) echo done ;; *) echo off ;;
    esac
}

# The pane no longer shows the job it was bound to: forget it. Take back the state written for
# it only when the poller wrote it (@cockpit_job_state is what it last wrote and @panestate
# still holds that), and the pane is neither a marked agent view (the worst of all takes over)
# nor a foreground session's (its hooks own the state).
unbind() {                    # <pane> <marked: 1|""> <fg mark|""> <@panestate> <@cockpit_job_state>
    tmux set-option -pu -t "$1" @cockpit_job \; set-option -pu -t "$1" @cockpit_job_name \; \
        set-option -pu -t "$1" @cockpit_job_state 2>/dev/null
    [ "$2" = 1 ] && return 0
    [ -n "$3" ] && return 0
    [ -n "$5" ] && [ "${4:-off}" = "$5" ] || return 0
    "$here/agent-state" poll off "$1" >/dev/null 2>&1
}

# What one tick works from, set by scan_panes and read_jobs.
lastsig="" watched=""
S_LIVE="" S_BOUND="" S_CAND="" S_SIG="" S_ROWS=$'\n' S_SERIOUS="" S_OWN="" R_OUT=""

# One list-panes. Fills the S_ variables: S_LIVE the marked agent panes, S_BOUND the panes that
# carry a job and may keep it, S_CAND "pane TAB title" for the panes that may be bound, S_SIG
# the claude panes' ids and titles, S_ROWS one line per pane with what it carries,
# S_SERIOUS set when a pane is waiting on a read. Panes that cannot hold what they carry
# are cleaned here. 1: no server and no pane.
scan_panes() {
    local rows id cmd allow glob view fg job jname jstate pstate owner cfg title marked
    local seen=0 job_kept="" fgc
    S_LIVE="" S_BOUND="" S_CAND="" S_SIG="" S_ROWS=$'\n' S_SERIOUS="" S_OWN="" S_MINE=""
    rows=$(tmux list-panes -a -F "$PANE_FMT" 2>/dev/null) || return 1
    while IFS=$T read -r id cmd allow glob view fg job jname jstate pstate owner cfg title; do
        [ -n "$id" ] || continue
        seen=1
        S_OWN=${owner#.}
        # Another config dir's pane is another poller's: not read, cleaned or written here (#194).
        [ "${cfg#.}" = "$MYDIR" ] || continue
        S_MINE=1
        id=${id#.}; cmd=${cmd#.}; allow=${allow#.}; glob=${glob#.}; view=${view#.}
        fg=${fg#.}; job=${job#.}; jname=${jname#.}; jstate=${jstate#.}; pstate=${pstate#.}
        title=${title#.}
        marked=""; [ "$view" = 1 ] && marked=1
        if [ "$marked" = 1 ] && [ "$glob" != 1 ]; then
            tmux set-option -pu -t "$id" @cockpit_agentview 2>/dev/null   # claude left: not ours
            marked=""
        fi
        # A foreground session's pane is its hooks' (agent-state sets the mark). Not an agent
        # any more, it is nobody's.
        if [ -n "$fg" ] && [ "$glob" != 1 ]; then
            tmux set-option -pu -t "$id" @cockpit_fg 2>/dev/null; fg=""
        fi
        if [ "$marked" = 1 ]; then S_LIVE="$S_LIVE $id"; S_SERIOUS=1; fi
        if [ "$cmd" = claude ]; then
            S_SIG="$S_SIG$id$T$allow$T$title"$'\n'
            if [ "$allow" = 1 ] && [ -n "$title" ]; then
                # A session waiting on the user fires no hook, so a ▲ that the poller hid would
                # stay hidden: its mark compares as "never". (error is sticky and may bind.)
                fgc=$fg; [ -z "$fg" ] || [ "$pstate" != needs-input ] || fgc=never
                S_CAND="$S_CAND$id$T$fgc$T$title"$'\n'
                case " $watched " in *" $id "*) S_SERIOUS=1 ;; esac
                if [ -n "$job" ]; then S_BOUND="$S_BOUND $id"; S_SERIOUS=1; fi
                job_kept=1
            fi
        fi
        if [ -n "$job" ] && [ -z "$job_kept" ]; then
            unbind "$id" "$marked" "$fg" "$pstate" "$jstate"; job=""; jname=""; jstate=""
        fi
        job_kept=""
        S_ROWS="$S_ROWS$id$T.$job$T.$jname$T.$jstate$T.$pstate$T.$marked$T.$fg"$'\n'
    done <<EOT
$rows
EOT
    [ "$seen" = 1 ]
}

# Should claude be read, and what does it say? Sets R_OUT to the jq output. 1: not now.
# `claude agents` (about 0.3 s) runs only when it can matter: a marked agent view or a bound
# pane waits on a state, a pane's title named two jobs and may now name one, or the claude
# panes' ids and titles differ from the last read (a new viewer, or a job's first title). A
# box with no background job, or no viewer, pays the scan and nothing else.
read_jobs() {
    local out to=""
    [ -n "$S_SERIOUS" ] || [ "$S_SIG" != "$lastsig" ] || return 1
    [ -n "$S_SERIOUS" ] || [ -n "$S_SIG" ] || { lastsig=""; return 1; }
    # A read nobody waits on stays quiet when it cannot run, and is tried once per change of
    # the panes: a failing claude would otherwise be run again every tick, for nothing.
    [ -n "$S_SERIOUS" ] || lastsig=$S_SIG
    if ! command -v jq >/dev/null 2>&1; then
        [ -n "$S_SERIOUS" ] && poll_err "no jq on PATH"; return 1
    fi
    if ! command -v claude >/dev/null 2>&1; then
        [ -n "$S_SERIOUS" ] && poll_err "no claude on PATH"; return 1
    fi
    # timeout is GNU coreutils; a box without it still polls, unbounded.
    command -v timeout >/dev/null 2>&1 && to="timeout 5"
    out=$($to claude agents --json --all 2>/dev/null) \
        || { [ -n "$S_SERIOUS" ] && poll_err "claude agents failed"; return 1; }
    # An unknown state (research preview) is in no bucket; anything but an array is an error,
    # not "no sessions".
    R_OUT=$(jq -r --arg panes "$S_CAND" "$JQ_PROG" 2>/dev/null <<<"$out") \
        || { [ -n "$S_SERIOUS" ] && poll_err "claude agents gave unreadable json"; return 1; }
    return 0
}

# What a bound pane carries now, from S_ROWS: sets row_job, row_name, row_jstate, row_pstate,
# row_marked, row_fg.
pane_row() {                  # <pane>
    local r=${S_ROWS#*$'\n'"$1""$T"}
    r=${r%%$'\n'*}
    row_job=${r%%"$T"*}; r=${r#*"$T"}; row_job=${row_job#.}
    row_name=${r%%"$T"*}; r=${r#*"$T"}; row_name=${row_name#.}
    row_jstate=${r%%"$T"*}; r=${r#*"$T"}; row_jstate=${row_jstate#.}
    row_pstate=${r%%"$T"*}; r=${r#*"$T"}; row_pstate=${row_pstate#.}
    row_marked=${r%%"$T"*}; row_marked=${row_marked#.}
    row_fg=${r#*"$T"}; row_fg=${row_fg#.}
}

# Write what R_OUT says: a bound pane its job's state, a marked one the worst of all. Bound
# before and not now: the title moved on, or a second job took the name.
apply_jobs() {
    local tag a b c d worst="" wname="" st new="" dups="" arg id bound_now=""
    local bpane bid bstate bname
    while IFS=$T read -r tag a b c d; do
        case "$tag" in
            W) worst=$a; wname=$b ;;
            D) dups="$dups $a" ;;
            M) new="$new$a$T$b$T$c$T$d"$'\n' ;;
        esac
    done <<EOT
$R_OUT
EOT
    case "$worst" in
        blocked|failed|working|done|idle) ;;
        *) [ -n "$S_SERIOUS" ] && poll_err "claude agents gave unreadable json"; return 0 ;;
    esac
    poll_err ""
    lastsig=$S_SIG; watched=$dups
    while IFS=$T read -r bpane bid bstate bname; do
        [ -n "$bpane" ] || continue
        bound_now="$bound_now $bpane"; watched="$watched $bpane"
        pane_row "$bpane"
        st=$(job_state "$bstate")
        # The job first: the state write below wakes every board (#502), and a board woken
        # before the name is set shows the bind a poll late.
        if [ "$row_job" != "$bid" ] || [ "$row_name" != "$bname" ] \
            || [ "$row_jstate" != "$st" ]; then
            # tmux takes an argument's trailing `;` for a separator; `\;` is a literal one.
            arg=$bname; case "$arg" in *\;) arg="${arg%;}\;" ;; esac
            # An ex-foreground session (sent to the background) is a viewer now: its mark goes.
            tmux set-option -p -t "$bpane" @cockpit_job "$bid" \; \
                set-option -p -t "$bpane" @cockpit_job_name "$arg" \; \
                set-option -p -t "$bpane" @cockpit_job_state "$st" \; \
                set-option -pu -t "$bpane" @cockpit_fg 2>/dev/null
        fi
        "$here/agent-state" poll "$st" "$bpane" "$bname needs you" >/dev/null 2>&1
    done <<EOT
$new
EOT
    for id in $S_BOUND; do
        case " $bound_now " in *" $id "*) continue ;; esac
        pane_row "$id"
        unbind "$id" "$row_marked" "$row_fg" "$row_pstate" "$row_jstate"
    done
    case "$worst" in
        blocked) st=needs-input ;; failed) st=error ;; working) st=running ;;
        done) st=done ;; *) st=off ;;
    esac
    for id in $S_LIVE; do
        case " $bound_now " in *" $id "*) continue ;; esac
        "$here/agent-state" poll "$st" "$id" "$wname needs you" >/dev/null 2>&1
    done
}

# One tick. 0: carry on. 1: no server, or the slot is another poller's: stop.
tick() {
    scan_panes || return 1
    # Someone else holds the slot (it was taken over): leave it to them.
    [ "$once" = 1 ] || [ "$S_OWN" = "$$" ] || return 1
    # A dir poller with no pane of its dir for three ticks in a row leaves: a count, not a clock.
    # The default one stays, as nothing a job does could start it again (#194).
    if [ -n "$KEY" ] && [ -z "$S_MINE" ]; then
        idle=$((idle + 1)); [ "$idle" -lt 3 ] || return 1
        return 0
    fi
    idle=0
    read_jobs && apply_jobs
    return 0
}

[ "$(interval)" = off ] && exit 0
sleeper=""
lasterr=$(tmux show-option -gqv @cockpit_poll_err 2>/dev/null)
if [ "$once" = 1 ]; then tick; exit 0; fi

# Every exit path lets go of the slot; the signal handlers turn into exits so EXIT runs. In place
# before the claim: a HUP just after it publishes our pid would otherwise leave that pid behind.
# release only unsets a slot that holds our own pid, so running before any claim is harmless.
trap 'release' EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
trap 'exit 129' HUP
claim || exit 0
while :; do
    tick || break
    every=$(interval); [ "$every" = off ] && break
    # A background sleep + wait, so a signal ends the poller now, not after the sleep.
    sleep "$every" & sleeper=$!
    wait "$sleeper" 2>/dev/null
    sleeper=""      # reaped: release must not signal a number the kernel may have reused
done
