#!/usr/bin/env bash
# tui-fetch — put the optional cockpit-tui binary in the plugin's own bin/.
#
#   scripts/tui-fetch [--version <tag>]
#
# Run it from `prefix U` (tpm re-runs every *.tmux of a plugin it updates),
# never from a plain config load: a dead network on the tmux startup path
# makes every `source-file ~/.tmux.conf` pay the full curl timeout.
#
# The tag comes from --version, else @cockpit_tui_version, else the pin below.
# The checksum manifest is fetched BEFORE the tarball: "could not verify" is
# not "verified", and a name missing from the manifest means "no binary for
# this platform", not a failed download. Nothing is installed unless the
# extracted binary also reports the version its tag claims.
#
# Anything short of a verified binary leaves whatever is already in bin/ alone
# and exits 0 -- the binary is additive, and `prefix r` is the fleet view with
# or without it. Only a checksum or a version mismatch exits non-zero.
#
# The repository is private (#84): its release URLs 404 without credentials,
# so downloads ride the user's own `gh` login when `gh auth status` passes --
# the plugin never carries a token. A gh failure falls back to the plain URL.
#
# Never ~/.local/bin (install.sh owns its symlinks there), never sudo.
# COCKPIT_TUI_RELEASES overrides the release host, and an explicit URL is
# curl's alone -- the suite points it at a file:// tree gh could not serve.
# COCKPIT_TUI_REPO overrides the owner/repo gh downloads from.
set -u

PIN=cockpit-tui-v0.1.0
DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BIN="$DIR/bin"
RELEASES=${COCKPIT_TUI_RELEASES:-https://github.com/TzachiSh/tmux-cockpit/releases/download}

say() { printf 'tui-fetch: %s\n' "$1"; }

# Which credentials a download would ride (#84). Checked at download time, not
# here at the top: the already-current early exit must never pay gh's round trip.
auth_path() {
    if [ -z "${COCKPIT_TUI_RELEASES:-}" ] && command -v gh >/dev/null 2>&1 &&
       gh auth status >/dev/null 2>&1
    then printf 'via gh'; else printf 'unauthenticated'; fi
}

TAG=
case "${1:-}" in
    --version) TAG=${2:-}
               [ -n "$TAG" ] || { say "usage: tui-fetch [--version <tag>]" >&2; exit 2; } ;;
    --auth)    auth_path; echo; exit 0 ;;    # the tmux-review tui row asks
    -h|--help) sed -n '2,4p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    "")        ;;
    *)         say "usage: tui-fetch [--version <tag>]" >&2; exit 2 ;;
esac
[ -n "$TAG" ] || TAG=$(tmux show-option -gqv @cockpit_tui_version 2>/dev/null)
[ -n "$TAG" ] || TAG=$PIN

# The tag carries the package name because axotag wants `<package>-v<ver>`.
# Stripping the pre-#79 `tui-` form only makes such a pin COMPARE equal, never
# fetch: the URL is built from the tag as written.
norm() { local v=${1##* }; v=${v#cockpit-}; v=${v#tui-}; printf '%s\n' "${v#v}"; }

# 0.74.3 -> 0074003, "1.85.0 (abc)" -> 1085000. Never version_at_least
# (cockpit.tmux): ${v#*.} of a three-component version fails its own digit
# test and reads as 0, so 1.85 and 1.88 would compare equal.
vnum() { local v=${1%% *}; v=${v#v}; local IFS=.; set -- $v
    local a=${1:-0} b=${2:-0} c=${3:-0}
    a=${a%%[!0-9]*}; b=${b%%[!0-9]*}; c=${c%%[!0-9]*}
    printf '%d%03d%03d\n' "${a:-0}" "${b:-0}" "${c:-0}"; }

case "$(uname -s):$(uname -m)" in
    Linux:x86_64|Linux:amd64)    TARGET=x86_64-unknown-linux-musl ;;
    Linux:aarch64|Linux:arm64)   TARGET=aarch64-unknown-linux-musl ;;
    Darwin:x86_64)               TARGET=x86_64-apple-darwin ;;
    Darwin:arm64|Darwin:aarch64) TARGET=aarch64-apple-darwin ;;
    *) say "no release build for $(uname -s)/$(uname -m) -- cargo build --release --manifest-path $DIR/tui/Cargo.toml"
       exit 0 ;;
esac

sha_c() { if command -v sha256sum >/dev/null 2>&1; then sha256sum -c -; else shasum -a 256 -c -; fi; }

fetch() {                     # <asset> <dest>
    # gh first when logged in; a gh failure falls to the plain URL, never
    # straight to a source build -- checksum-first order is the same either way.
    if [ "$VIA" = 'via gh' ]; then
        gh release download -R "$REPO" "$TAG" -p "$1" -O "$2" >/dev/null 2>&1 && return 0
    fi
    curl -fsL --max-time 30 -o "$2" "$RELEASES/$TAG/$1"
}

# 2 and 3 both mean "no binary installed", but they are opposite facts: 2 is
# settled (this release has nothing for this platform, so build from source and
# remember it), 3 is a box that could not ask (offline, no tools) and must be
# free to ask again on the next press.
download() {                  # 0 installed · 1 refused · 2 nothing for this platform · 3 could not ask
    local tmp asset line bin got
    asset="cockpit-tui-$TARGET.tar.gz"
    command -v curl >/dev/null 2>&1 || { say "skip: curl is not installed"; return 3; }
    command -v sha256sum >/dev/null 2>&1 || command -v shasum >/dev/null 2>&1 || {
        say "skip: neither sha256sum nor shasum is installed to verify with"; return 3; }
    tmp=$(mktemp -d) || return 3
    trap 'rm -rf "$tmp"' RETURN
    # -fsL, not -fsSL: a tag that has not been cut yet is the ordinary case
    # before the first release, and curl's own "(22) ... 404" beside the line
    # below reads like a fault. Unauthenticated, the private repo 404s the
    # same way (#84), so that line names the likelier of the two.
    fetch sha256.sum "$tmp/sums" || {
        case $VIA in
            'via gh') say "skip: no release $TAG via gh (or offline)" ;;
            *)        say "skip: no release $TAG (private repository, or offline)" ;;
        esac
        return 3; }
    # cargo-dist writes one sha256sum line per asset, so a name that is not
    # there was never built for this platform -- a settled answer, unlike a
    # download that failed.
    line=$(grep -E " \*?${asset//./\\.}\$" "$tmp/sums") || {
        say "no binary for this platform in $TAG ($TARGET)"; return 2; }
    fetch "$asset" "$tmp/$asset" || {
        say "skip: $asset is missing from $TAG, $VIA (or offline)"; return 3; }
    ( cd "$tmp" && printf '%s\n' "$line" | sha_c ) >/dev/null 2>&1 || {
        say "REFUSED: $asset does not match its published checksum -- nothing installed" >&2; return 1; }
    tar -xzf "$tmp/$asset" -C "$tmp" 2>/dev/null || { say "could not extract $asset" >&2; return 1; }
    # Measured on dist 0.32.0: the archive is a cockpit-tui-<target>/ directory
    # holding the binary next to LICENSE and README, not a flat one. Look the
    # binary up rather than pinning either layout, and install only it.
    bin=$(find "$tmp" -type f -name cockpit-tui 2>/dev/null | head -1)
    [ -n "$bin" ] || { say "$asset holds no cockpit-tui" >&2; return 1; }
    chmod +x "$bin"
    # Only if it is actually there: `xattr -d` on a file with no quarantine
    # attribute exits 1 and prints, and curl+tar do not set one anyway.
    if [ "$(uname -s)" = Darwin ] && command -v xattr >/dev/null 2>&1 &&
       xattr -p com.apple.quarantine "$bin" >/dev/null 2>&1; then
        xattr -d com.apple.quarantine "$bin" 2>/dev/null
    fi
    # fzf's installer earned this one: a checksum says the bytes arrived
    # intact, not that they are the version the tag names. Run it in the temp
    # dir so a wrong answer never displaces the binary already installed.
    got=$("$bin" --version 2>/dev/null)
    # Two different answers. Saying nothing at all is this box's problem (wrong
    # libc, wrong arch) and source is the way out; running and naming another
    # version is a broken release, and installing it anyway is not.
    [ -n "$got" ] || { say "the $TAG build for $TARGET does not run here"; return 2; }
    [ "$(norm "$got")" = "$(norm "$TAG")" ] || {
        say "the $TAG tarball reports '$got' -- nothing installed" >&2; return 1; }
    install -m 755 "$bin" "$BIN/cockpit-tui" || return 1
    say "cockpit-tui $(norm "$TAG") -> $BIN/cockpit-tui $VIA"
}

build() {                     # 0 built · 2 skipped
    local floor rv log
    [ -f "$DIR/tui/Cargo.toml" ] || { say "no source tree at $DIR/tui to build from"; return 2; }
    command -v cargo >/dev/null 2>&1 || { say "no cargo either -- install rustup (https://rustup.rs) or wait for a release build"; return 2; }
    # Read, never hardcoded: the floor lives in Cargo.toml and a second copy
    # here would drift. Debian 13 ships 1.85 against ratatui's 1.88, so the
    # refusal below is the common case, not the corner.
    floor=$(sed -n 's/^ *rust-version *= *"\([^"]*\)".*/\1/p' "$DIR/tui/Cargo.toml" | head -1)
    rv=$(rustc --version 2>/dev/null | awk '{print $2}')
    if [ -n "$floor" ] && [ "$(vnum "$rv")" -lt "$(vnum "$floor")" ]; then
        say "cockpit-tui needs Rust >= $floor to build from source (found ${rv:-none}); install rustup and press prefix U again"
        return 2
    fi
    # Captured, not streamed: this runs from a keypress, and a screenful of
    # rustc diagnostics past the popup is not the answer to "why no binary".
    log=$(mktemp) || return 2
    trap 'rm -f "$log"' RETURN
    cargo build --release --manifest-path "$DIR/tui/Cargo.toml" > "$log" 2>&1 || {
        say "cargo build failed, last 5 lines:" >&2; tail -5 "$log" >&2; return 2; }
    install -m 755 "$DIR/tui/target/release/cockpit-tui" "$BIN/cockpit-tui" || return 2
    say "cockpit-tui built from source -> $BIN/cockpit-tui"
}

have=$("$BIN/cockpit-tui" --version 2>/dev/null)
if [ -n "$have" ] && [ "$(norm "$have")" = "$(norm "$TAG")" ]; then
    say "cockpit-tui $(norm "$TAG") already current"
    exit 0
fi
mkdir -p "$BIN" || exit 1
VIA=$(auth_path)
if [ "$VIA" = 'via gh' ]; then
    REPO=${COCKPIT_TUI_REPO:-}
    if [ -z "$REPO" ]; then
        REPO=$(git -C "$DIR" remote get-url origin 2>/dev/null)
        # git@github.com:o/r.git and https://github.com/o/r reduce the same
        # way: strip through github.com, one [:/] separator, then .git.
        case $REPO in
            *github.com*) REPO=${REPO#*github.com}; REPO=${REPO#[:/]}; REPO=${REPO%.git} ;;
            *)            REPO= ;;
        esac
    fi
    REPO=${REPO:-TzachiSh/tmux-cockpit}
fi
# The marker records a fact about the RELEASE -- this tag published nothing for
# this platform -- so it skips the download and never the source build. An
# unreachable host and a checksum refusal deliberately leave no marker: the
# first is transient and the second must shout on every press, and a marker
# would silence both until someone found a dotfile to delete.
if [ "$(cat "$BIN/.tried" 2>/dev/null)" = "$TAG" ]; then
    say "$TAG has no release build for $TARGET"
    rc=2
else
    download; rc=$?
fi
case "$rc" in
    0) rm -f "$BIN/.tried"; exit 0 ;;
    1) exit 1 ;;
    3) exit 0 ;;
esac
printf '%s\n' "$TAG" > "$BIN/.tried"
build
exit 0
