#!/usr/bin/env bash
# tmux-fixer: a side `claude -p` pane beside a busy agent, which review-gate holds
# at its next Stop until the fixer's pane is gone, then resumes with one handover line.
#   tmux-fixer -p <pane>                     the prefix f popup: job, guard, fence, spawn
#   tmux-fixer --run <pane> <sess> <job…>    inside the fixer pane: claude -p, then the handover
# State: <sess>/fixer/{pane,reason,deadline,fence,guard} and <sess>/handover.
set -uo pipefail

# Not $0: through an install.sh symlink it must still find its sibling and re-invoke itself.
SELF="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
REVIEW="$(dirname "$SELF")/tmux-review"

# For the command string tmux hands to sh.
shq() { printf '%q' "$1"; }

# --- --run: the wrapper --------------------------------------------------------
# The model writes nothing: the last "HANDOVER: " line of its result becomes
# <sess>/handover. On failure a fallback line is written first, so the hold opens.
handover_write() {            # <sess> <line>
    local line=${2//[$'\001'-$'\037']/}
    [ "${#line}" -gt 300 ] && line="${line:0:285}... (truncated)"
    (umask 077; printf '%s\n' "$line" > "$1/handover")
}
run_fixer() {                 # <main-pane> <sess> <job…>
    local pane=$1 sess=$2; shift 2
    local job="$*" f="$sess/fixer" sid out res rc reason line fence
    reason=$(cat -- "$f/reason" 2>/dev/null); reason=${reason:-$job}
    fence=$(tr '\n' ' ' < "$f/fence" 2>/dev/null)
    sid=$(uuidgen 2>/dev/null || cat /proc/sys/kernel/random/uuid 2>/dev/null || printf '%s-%s' "$$" "$(date +%s)")
    printf 'side fix for %s: %s\n(this pane closes itself when done; it stays open if claude fails)\n\n' "$pane" "$reason"
    # The main agent's dirty paths are denied to Edit (Write path rules are never
    # consulted); acceptEdits so a headless run never stalls on a prompt.
    local -a deny=()
    while IFS= read -r p; do [ -n "$p" ] && deny+=("Edit(./$p)"); done < "$f/fence"
    for g in commit push checkout switch stash reset rebase merge restore clean; do deny+=("Bash(git $g *)"); done
    # What the main agent has been doing, from its transcript; nothing (and the
    # prompt as it was) when the transcript is unreadable.
    local ctx="" tf
    if tf=$(transcript_file "$pane" 2>/dev/null) && [ -n "$tf" ]; then
        ctx=$(transcript_tail "$tf" 4096 2>/dev/null) || ctx=""
    fi
    [ -n "$ctx" ] && ctx="What the other agent has been doing
$ctx

"
    out=$(claude -p "$ctx$job

You are a SIDE TASK running beside another agent that is working in this repository right now. Do only this job. Do not touch these files, they are the other agent's live edits: ${fence:-none}. Do not commit. When you are done, your final message must be exactly ONE line that starts with 'HANDOVER: ' and states what changed and the observable delta (for example 'HANDOVER: tests fixed; suite 118s -> 8s; re-read any test file you had open'). No reasoning, no summary, one line." \
        --output-format json --permission-mode acceptEdits --max-turns 60 --session-id "$sid" \
        --allowedTools 'Bash(*)' --disallowedTools "${deny[@]}" 2>&1)
    rc=$?
    if command -v jq >/dev/null 2>&1; then res=$(printf '%s' "$out" | jq -r '.result // empty' 2>/dev/null)
    else res=$(printf '%s' "$out" | grep -o '"result":"[^"]*"' | head -1 | sed 's/^"result":"//; s/"$//'); fi
    line=$(printf '%s\n' "$res" | grep '^HANDOVER: ' | tail -1)
    [ -n "$line" ] || line="HANDOVER: side task finished without a handover line ($reason); re-check anything it may have touched"
    handover_write "$sess" "$line"
    if [ "$rc" -ne 0 ] || [ -z "$res" ]; then
        printf '%s\n\nclaude exited %s — the other agent has been told the job did not finish cleanly.\n↵ to close\n' "$out" "$rc"
        read -r _ 2>/dev/null
        exit 1
    fi
    printf '%s\n' "$line"
    exit 0
}

d=${BASH_SOURCE[0]}; [ -L "$d" ] && d=$(readlink "$d")
# shellcheck source=lib/fixer.sh
. "${d%/*}/lib/fixer.sh" || exit 1
# shellcheck source=lib/git.sh
. "${d%/*}/lib/git.sh" || exit 1
# shellcheck source=lib/transcript.sh
. "${d%/*}/lib/transcript.sh" || exit 1

# 252 -> 4m12s, 45 -> 45s, 3780 -> 1h3m.
fixer_age() {                 # <seconds>
    local s=$1
    if [ "$s" -ge 3600 ]; then printf '%dh%dm' $((s / 3600)) $((s % 3600 / 60))
    elif [ "$s" -ge 60 ]; then printf '%dm%02ds' $((s / 60)) $((s % 60))
    else printf '%ds' "$s"; fi
}
# One line for the popup: what the main agent is in the middle of. Nothing when unknown.
main_is_on() {                # <main-pane>
    local tf rows row tool age
    tf=$(transcript_file "$1" 2>/dev/null) && [ -n "$tf" ] || return 0
    rows=$(transcript_doing "$tf" 2>/dev/null) || return 0
    row=$(printf '%s\n' "$rows" | awk -F'\t' '$1 == "doing" { print; exit }')
    [ -n "$row" ] || return 0
    tool=$(printf '%s' "$row" | cut -f2); age=$(printf '%s' "$row" | cut -f3)
    [ -n "$tool" ] || return 0
    case "$age" in ''|*[!0-9]*) age="" ;; *) age=", $(fixer_age "$age")" ;; esac
    printf 'main is on: %s%s\n' "$tool" "$age"
}

# --- -p: the popup ---------------------------------------------------------------
# fixer_alive, not the mkdir, refuses a second spawn. The server spawns the pane
# (split-window -d), so the popup's lifetime never touches the fixer.
spawn_fixer() {               # <main-pane>
    local pane=$1 job guard sess f root dl fp marker srv
    case "$pane" in %[0-9]*) ;; *) printf 'cockpit: tmux-fixer: not a pane id: %s\n' "$pane" >&2; exit 2 ;; esac
    sess=$("$REVIEW" --sess "$pane") || { tmux display-message "cockpit: pane $pane is gone" 2>/dev/null; exit 1; }
    f="$sess/fixer"
    if fixer_alive "$sess"; then
        tmux display-message "cockpit: a side fix is already running for $pane: $(cat -- "$f/reason" 2>/dev/null) (pane $(cat -- "$f/pane" 2>/dev/null))" 2>/dev/null
        exit 1
    fi
    main_is_on "$pane"
    if [ -t 0 ]; then
        read -r -p 'side fix (one line, ↵ alone cancels): ' job
        read -r -p 'hold off commands matching (ERE, ↵ for none): ' guard
    else IFS= read -r job; IFS= read -r guard; fi
    job=${job//[$'\001'-$'\037']/}; guard=${guard//[$'\001'-$'\037']/}
    [ -n "$job" ] || exit 0
    root=$(git -C "$("$REVIEW" --dir "$pane")" rev-parse --show-toplevel 2>/dev/null) || {
        tmux display-message "cockpit: $pane is not in a git repo" 2>/dev/null; exit 1; }
    dl=$(tmux show-option -gqv @cockpit_fixer_deadline); case "$dl" in ''|*[!0-9]*) dl=300 ;; esac
    rm -rf -- "$f" "$sess/handover"            # a stale record and its unconsumed handover
    (umask 077; mkdir -- "$f") 2>/dev/null || { tmux display-message "cockpit: a side fix is already running for $pane" 2>/dev/null; exit 1; }
    printf '%s\n' "$job" > "$f/reason"; printf '%s\n' "$guard" > "$f/guard"
    printf '%s\n' $(( $(date +%s) + dl )) > "$f/deadline"; printf 'pending\n' > "$f/pane"
    # Strips git's outer C-quotes only; an escape inside (\t, \") stays literal.
    git -C "$root" --no-optional-locks -c core.quotePath=false status --porcelain 2>/dev/null \
        | sed 's/^...//; s/^.* -> //; s/^"//; s/"$//' > "$f/fence"
    # review-gate's key, verbatim (#88): the socket joins the per-server pane id.
    srv=${TMUX:-}; srv=${srv%%,*}; srv=${srv//_/__}
    marker="${XDG_STATE_HOME:-$HOME/.local/state}/tmux-cockpit/review/fixer-${srv//\//_.}-${pane#%}"
    (umask 077; printf '%s\n' "$sess" > "$marker")
    fp=$(tmux split-window -d -v -l 40% -t "$pane" -c "$root" -P -F '#{pane_id}' \
        "$(shq "$SELF") --run $(shq "$pane") $(shq "$sess") $(shq "$job")") || {
        rm -rf -- "$f" "$marker"; tmux display-message "cockpit: could not open the fixer pane" 2>/dev/null; exit 1; }
    printf '%s\n' "$fp" > "$f/pane"
    tmux display-message "cockpit: side fix running in $fp: $job — $pane is held at its next stop until it finishes${guard:+; commands matching /$guard/ are held off}" 2>/dev/null
    exit 0
}

case "${1:-}" in
    -p) shift; spawn_fixer "${1:-}" ;;
    --run) shift; run_fixer "${1:-}" "${2:-}" "${@:3}" ;;
    *) printf 'usage: tmux-fixer -p <pane> | --run <pane> <sess> <job…>\n' >&2; exit 2 ;;
esac
