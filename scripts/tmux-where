#!/usr/bin/env bash
# Right-hand status: where this pane actually is.
#
#   tmux-where path   <pane_pid> <pane_current_path>
#   tmux-where branch <pane_pid> <pane_current_path>
#
# tmux only knows the LOCAL cwd. When a pane is sitting in ssh, pane_current_path
# is still the local directory, so the stock modules show a path and a git branch
# that belong to this machine, not the one you are looking at. Detect ssh and say
# so instead of reporting something confidently wrong.
set -u

mode="${1:-path}"
pid="${2:-}"
path="${3:-}"
cmd="${4:-}"          # #{pane_current_command}, tmux's view of the foreground proc


# Branch, plus the worktree name when this path is a linked worktree.
# ONE git call for both: rev-parse takes several flags and answers in order, so
# asking separately would double the only real cost left in this script.
#   normal repo   ->  " main"
#   linked wt     ->  " main ⑂feat-x"
git_label() {
    local out br gd
    out=$(git -C "$path" rev-parse --abbrev-ref HEAD --git-dir 2>/dev/null) || return 0
    br=${out%%$'\n'*}
    gd=${out#*$'\n'}
    [ -n "$br" ] || return 0
    case "$gd" in
        */worktrees/*) printf ' %.20s ⑂%.14s' "$br" "${gd##*/worktrees/}" ;;
        *)             printf ' %.24s' "$br" ;;
    esac
}

# Fast path: tmux already knows the pane's foreground command. If it is not ssh,
# there is nothing to find and we skip the /proc walk entirely -- which is the
# case for every pane, almost always, on every redraw.
if [ -n "$cmd" ] && [ "$cmd" != ssh ]; then
    case "$mode" in
        path)   printf ' %s' "${path/#$HOME/\~}" ;;
        branch) git_label ;;
    esac
    exit 0
fi

# Walk the pane's process tree looking for ssh.
# Builds a parent->children map from /proc in ONE pass, then descends it. The
# previous version called pgrep per child (~15ms each, up to 4 levels), which
# dominated the cost of the whole status line.
ssh_cmd() {
    [ -n "$pid" ] || return 1
    local d c args kids next ppid
    declare -A KIDS
    for d in /proc/[0-9]*; do
        c=${d#/proc/}
        [ -r "$d/stat" ] || continue
        # stat: "pid (comm) state ppid ..."; comm may contain spaces and parens,
        # so slice past the LAST ')' before splitting.
        read -r line < "$d/stat" 2>/dev/null || continue
        line=${line##*) }
        set -- $line                      # $1=state $2=ppid
        ppid=$2
        KIDS[$ppid]="${KIDS[$ppid]:-} $c"
    done
    kids="$pid"
    for _ in 1 2 3 4; do
        next=""
        for c in $kids; do
            [ -r "/proc/$c/cmdline" ] || continue
            args=$(tr '\0' ' ' < "/proc/$c/cmdline" 2>/dev/null)
            case "$args" in
                ssh\ *|*/ssh\ *) printf '%s' "$args"; return 0 ;;
            esac
            next="$next ${KIDS[$c]:-}"
        done
        kids="$next"
        [ -n "${kids// /}" ] || break
    done
    return 1
}

# ssh [options] destination [command ...]
# The destination is the FIRST non-flag argument. Taking the last one breaks on
# "ssh host cmd arg", where the trailing token belongs to the remote command.
# Short flags bundle, and a bundle can end in an option that takes a value:
# "-nNp 2222 host". Matching only "-x" treats -nNp as a bare flag and then reads
# 2222 as the destination, so inspect the whole bundle rather than one letter.
ssh_target() {
    local args="$1" tok bundle rest c
    local takes_value='bcDEeFIiJLlmOoPpQRSWw'
    set -- $args
    shift                                   # drop "ssh"
    while [ $# -gt 0 ]; do
        tok="$1"
        case "$tok" in
            --) shift; [ $# -gt 0 ] && { printf '%s' "$1"; return 0; }; break ;;
            -*)
                bundle="${tok#-}"
                while [ -n "$bundle" ]; do
                    c="${bundle%"${bundle#?}"}"      # first char
                    rest="${bundle#?}"
                    case "$takes_value" in
                        *"$c"*)
                            # value attached ("-p2222") or the next arg ("-p 2222")
                            [ -n "$rest" ] || shift
                            break ;;
                    esac
                    bundle="$rest"
                done
                ;;
            *) printf '%s' "$tok"; return 0 ;;   # first bare word = destination
        esac
        shift
    done
    printf 'ssh'
}

if args=$(ssh_cmd); then
    case "$mode" in
        path)   printf ' 󰢹 %s' "$(ssh_target "$args")" ;;
        branch) printf '' ;;                # local branch is meaningless here
    esac
    exit 0
fi

case "$mode" in
    path)
        printf ' %s' "${path/#$HOME/\~}"
        ;;
    branch) git_label ;;
esac
exit 0
