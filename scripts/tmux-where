#!/usr/bin/env bash
# Right-hand status: the pane's path and branch, or its ssh host instead.
#   tmux-where path   <pane_pid> <pane_id>            -- cockpit.tmux's #() job, ssh panes only
#   tmux-where branch <pane_pid> <path> -              -- cockpit.tmux's #() job, non-ssh panes
#   tmux-where path   <pane_pid> <path> <command>      -- direct call: tests, manual use
#   tmux-where branch <pane_pid> <path> <command>
#   tmux-where branch --set <pane_id>                  -- the hooks' push into @cockpit_branch
set -u

mode="${1:-path}"
pid="${2:-}"
arg3="${3:-}"
arg4="${4:-}"
home=${HOME:-/nonexistent} tilde="~"   # a \~ in a bash 3.2 expansion keeps its \
# Trailing slashes off, so HOME=/x/al/ still matches /x/al itself.
while [ "$home" != / ] && [ "${home%/}" != "$home" ]; do home=${home%/}; done
# ~ for $HOME only at a path boundary: /x/alice is not under /x/al (#296). Into
# $shown, not printed: a $( ) would fork on every redraw.
tildify() {
    case "$1" in
        "$home")   shown=$tilde ;;
        "$home"/*) shown=$tilde${1#"$home"} ;;
        *)         shown=$1 ;;
    esac
}

path=""
cmd=""                # #{pane_current_command}, tmux's view of the foreground proc
# tmux expands #{...} inside a #() command before sh parses it, so the ssh job
# passes only pane_id, which no path can look like.
case "$arg3" in
    %[0-9]*) cmd=ssh ;;   # cockpit.tmux runs this form only when tmux says ssh
    *)
        path="$arg3"
        cmd="$arg4"
        ;;
esac


# " main", or " main ⑂feat-x" in a linked worktree. Reads .git without forking,
# since this runs per pane on every redraw; it ignores safe.directory on purpose.
git_label() {
    local d=$path gd head br wt

    while [ -n "$d" ] && [ "$d" != / ]; do
        [ -e "$d/.git" ] && break
        d=${d%/*}
    done
    [ -n "$d" ] && [ "$d" != / ] && [ -e "$d/.git" ] || return 0

    if [ -d "$d/.git" ]; then
        gd=$d/.git
    else
        # "gitdir: <path>", possibly relative (worktree or submodule).
        read -r _ gd 2>/dev/null < "$d/.git" || return 0
        gd=${gd%$'\r'}                       # a repo checked out on Windows
        [ -n "$gd" ] || return 0
        case "$gd" in /*) ;; *) gd=$d/$gd ;; esac
    fi
    [ -r "$gd/HEAD" ] || return 0
    read -r head 2>/dev/null < "$gd/HEAD" || return 0
    # read never strips \r, which would land raw in the status line.
    head=${head%$'\r'}

    case "$head" in
        'ref: refs/heads/'*) br=${head#ref: refs/heads/} ;;
        'ref: '*)            br=${head#ref: } ;;
        *)
            # Detached: git picks the short-hash width. The repo is the agent's,
            # so its config must not get to run a command.
            br=$(git -c core.fsmonitor= -c core.hooksPath=/dev/null -C "$path" rev-parse --short HEAD 2>/dev/null) || return 0
            [ -n "$br" ] || return 0
            br="@$br" ;;
    esac
    [ -n "$br" ] || return 0

    case "$gd" in
        */worktrees/*) wt=${gd##*/worktrees/}; printf ' %s ⑂%s' "${br:0:20}" "${wt:0:14}" ;;
        *)             printf ' %s' "${br:0:24}" ;;
    esac
}

# The bar reads the branch from a pane option, so no redraw runs a shell. Hooks call
# this on focus changes and prompts; the write is compare-then-set, since every
# set-option redraws. The format blanks it for an ssh pane.
if [ "$mode" = branch ] && [ "$pid" = --set ]; then
    case "$arg3" in %[0-9]*) ;; *) exit 0 ;; esac
    # The path last and NUL-read: it may hold a newline.
    IFS= read -r -d '' cur < <(tmux display-message -p -t "$arg3" \
        '#{@cockpit_branch}'$'\037''#{pane_current_path}' 2>/dev/null)
    path=${cur#*$'\037'}; path=${path%$'\n'}; cur=${cur%%$'\037'*}
    # #452: a worktree made by hand leaves the process in the main checkout, so
    # @cockpit_dir names the tree when it is one. Only an absolute path counts:
    # a relative one is resolved against this hook's cwd, and git_label's walk up
    # never ends on a path with no slash. NUL-read like the path above.
    IFS= read -r -d '' wdir < <(tmux show-option -pqv -t "$arg3" @cockpit_dir 2>/dev/null)
    wdir=${wdir%$'\n'}
    case "$wdir" in /*) [ -d "$wdir" ] && path=$wdir ;; esac
    [ -n "$path" ] || exit 0
    b=$(git_label); b=${b# }
    [ "$b" = "$cur" ] && exit 0
    if [ -n "$b" ]; then tmux set-option -p -t "$arg3" @cockpit_branch "$b" 2>/dev/null
    else tmux set-option -pu -t "$arg3" @cockpit_branch 2>/dev/null; fi
    exit 0
fi

if [ -n "$cmd" ] && [ "$cmd" != ssh ]; then
    case "$mode" in
        path)   tildify "$path"; printf ' %s' "$shown" ;;
        branch) git_label ;;
    esac
    exit 0
fi

# Is ssh anywhere under the pane? One /proc pass builds the child map.
ssh_cmd() {
    [ -n "$pid" ] || return 1
    local d c kids next ppid line a
    local -a KIDS seen    # indexed by pid: sparse, and bash 3.2 has no -A
    for d in /proc/[0-9]*; do
        c=${d#/proc/}
        [ -r "$d/stat" ] || continue
        # comm may contain spaces and parens: split after the last ')'.
        read -r line 2>/dev/null < "$d/stat" || continue
        line=${line##*) }
        set -- $line                      # $1=state $2=ppid
        ppid=$2
        KIDS[ppid]="${KIDS[$ppid]:-} $c"
    done
    # No depth limit; seen[] guards against a cycle.
    kids="$pid"
    while [ -n "${kids// /}" ]; do
        next=""
        for c in $kids; do
            [ -r "/proc/$c/cmdline" ] || continue
            # Keep argv elements whole: an -o value may contain spaces.
            ARGV=()
            while IFS= read -r -d '' a; do ARGV+=("$a"); done 2>/dev/null < "/proc/$c/cmdline"
            [ ${#ARGV[@]} -gt 0 ] || continue
            case "${ARGV[0]}" in
                ssh|*/ssh) return 0 ;;
            esac
            next="$next ${KIDS[$c]:-}"
        done
        kids=""
        for c in $next; do
            [ -n "${seen[$c]:-}" ] && continue
            seen[c]=1; kids="$kids $c"
        done
    done
    return 1
}

# The destination is the first non-option word. A flag bundle can end in an
# option that takes a value ("-nNp 2222 host").
ssh_target() {
    local tok bundle rest c
    local takes_value='BbcDEeFIiJLlmOoPpQRSWw'   # -B bind_interface included
    set -- "${ARGV[@]}"                     # real argv: values keep their spaces
    shift                                   # drop "ssh"
    while [ $# -gt 0 ]; do
        tok="$1"
        case "$tok" in
            --) shift; [ $# -gt 0 ] && { printf '%s' "$1"; return 0; }; break ;;
            -*)
                bundle="${tok#-}"
                while [ -n "$bundle" ]; do
                    c="${bundle%"${bundle#?}"}"      # first char
                    rest="${bundle#?}"
                    case "$takes_value" in
                        *"$c"*)
                            # value attached ("-p2222") or the next arg ("-p 2222")
                            [ -n "$rest" ] || shift
                            break ;;
                    esac
                    bundle="$rest"
                done
                ;;
            *) printf '%s' "$tok"; return 0 ;;   # first bare word = destination
        esac
        shift
    done
    printf 'ssh'
}

if ssh_cmd; then
    case "$mode" in
        path)   printf ' 󰢹 '; ssh_target ;;
        branch) printf '' ;;                # local branch is meaningless here
    esac
    exit 0
fi

# No /proc (macOS) or the pid exited, but tmux says ssh: never fall back to
# this machine's path and branch.
if [ "$cmd" = ssh ]; then
    case "$mode" in
        path)   printf ' 󰢹 ssh' ;;
        branch) printf '' ;;
    esac
    exit 0
fi

case "$mode" in
    path)
        tildify "$path"; printf ' %s' "$shown"
        ;;
    branch) git_label ;;
esac
exit 0
