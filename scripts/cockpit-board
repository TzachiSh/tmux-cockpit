#!/usr/bin/env bash
# cockpit-board — the shell half of the board, and the loop that brings it back.
#   cockpit-board -p <pane>     the pane the key was pressed in
# The action comes back through a file, never $(…): ratatui paints on stdout.
set -u

DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)" || exit 1
LOG=${COCKPIT_LOG:-${XDG_STATE_HOME:-$HOME/.local/state}/tmux-cockpit/tui.log}
# shellcheck source=lib/pane.sh
. "$DIR/scripts/lib/pane.sh" || exit 1
# shellcheck source=lib/tui.sh
. "$DIR/scripts/lib/tui.sh" || exit 1
BIN=$COCKPIT_TUI_BIN

# $EPOCHREALTIME needs bash 5, and no portable `date` flag gives microseconds.
log() {
    local ts=${EPOCHREALTIME:-}; ts=${ts/./}; [ -n "$ts" ] || ts="$(date +%s)000000"
    printf '%s cockpit-board: %s\n' "$ts" "$*" >> "$LOG"
}

sep=$'\037'
sq() { printf "'%s'" "${1//\'/\'\\\'\'}"; }   # close, escaped quote, reopen

PANE=
case "${1:-}" in
    -p) PANE=${2:-} ;;
    "") ;;
    *)  printf 'usage: cockpit-board -p <pane>\n' >&2; exit 2 ;;
esac
# In a popup a bare display-message picks the most recently active client.
say=(display-message); is_pane "$PANE" && say+=(-t "$PANE")

# Required, but a broken install gets a message rather than a dead key.
if [ ! -x "$BIN" ]; then
    tmux "${say[@]}" "cockpit: board needs cockpit-tui: run $DIR/install.sh" 2>/dev/null
    exit 0
fi

mkdir -p "$(dirname "$LOG")" 2>/dev/null
# A private 0700 directory: the note is shown on the board, so no other user
# may get to write it first.
d=$(mktemp -d) || exit 1
f="$d/act" note="$d/note"
trap 'rm -rf "$d"' EXIT

# @cockpit_board_return off: every action is one-way, as before the loop.
back() { [ "$(tmux show-option -gqv @cockpit_board_return 2>/dev/null)" != off ]; }

# The board comes back after review, info and panel, on the pane it acted on and
# with the action's last line as its note, until an action or an exit ends it.
args=()
while :; do
    : > "$f" || exit 0
    # The binary creates its sidecars new and refuses a stale one: a kill's
    # .expect from the last trip must not stand in for the next action's.
    rm -f -- "$f.expect"
    # The popup closes on exit, so log stderr. CLAUDECODE leaks in from the agent's
    # environment and must not mark the binary as its child.
    env -u CLAUDECODE COCKPIT_ACTION="$f" COCKPIT_LOG="$LOG" "$BIN" board ${args[@]+"${args[@]}"} 2>>"$LOG" || {
        rc=$?
        tmux "${say[@]}" "cockpit: the board exited $rc — see $LOG" 2>/dev/null
        exit 0
    }

    # One line, `<verb> <pane-id>`. Pre-set because a missing file skips the read
    # under set -u; no `|| exit`, as read fails on an unterminated line it did assign.
    verb='' target='' rest=''
    read -r verb target rest 2>/dev/null < "$f"
    [ -n "$verb" ] || exit 0                 # nothing chosen: the ordinary q
    bad=
    [ -z "$rest" ] || bad=1
    case "$verb" in *[!a-z]*) bad=1 ;; esac
    is_pane "$target" || bad=1
    # The binary ships on its own tag, so log grammar drift instead of ignoring it.
    if [ -n "$bad" ]; then
        log "ignored action line [$verb $target $rest]"
        exit 0
    fi

    # Each verb that returns writes at most one line to $note; a line starting
    # with ✕ is a failure or a refusal, which the board keeps until a key.
    : > "$note" || exit 0
    case "$verb" in
        # switch-client fails without a client; the selection below still applies.
        jump)
            tmux switch-client -t "$target" 2>/dev/null || true
            tmux select-window -t "$target" 2>/dev/null
            tmux select-pane   -t "$target" 2>/dev/null
            exit 0
            ;;
        # These draw in the board's popup: tmux allows one popup per client.
        # Its status is not a verdict: leaving the queue with esc is non-zero too.
        review)
            "$DIR/scripts/tmux-review" -p "$target"
            ;;
        panel)
            COCKPIT_PANEL_NOTE="$note" "$DIR/scripts/cockpit-panel" -p "$target"
            ;;
        info)
            "$DIR/scripts/tmux-review" -p "$target" --info || printf '✕ cockpit: no info for %s\n' "$target" > "$note"
            # One key, named: the next screen draws over this one.
            if back; then printf '\n  any key: back to the board'; else printf '\n  any key closes'; fi
            read -rsn1 _
            ;;
        deliver)
            tmux "${say[@]}" "cockpit: replying from the board is not wired up yet" 2>/dev/null
            exit 0
            ;;
        # #228 verbs
        # The board confirmed with the window's id (@N) and wrote it to $f.expect
        # first. A name is no identity (automatic-rename gives agents the same
        # one), so the id is compared: a pane moved to another window since is
        # refused, and what dies is the window that id names, never a re-lookup.
        kill)
            want=
            [ -f "$f.expect" ] && [ ! -L "$f.expect" ] && want=$(head -c 64 -- "$f.expect" 2>/dev/null | head -n 1)
            # window_name last: it is the one field a person can fill with anything.
            info=$(tmux display-message -p -t "$target" "#{?pane_id,#{window_id}$sep#{session_name}:#{window_index}$sep#{window_name},}" 2>/dev/null | head -n 1)
            have=${info%%"$sep"*}; label=${info#*"$sep"}
            where=${label%%"$sep"*}; label="$where $(printf %s "${label#*"$sep"}" | tr -d '\000-\037\177')"
            case "$want" in @[0-9]*) case "${want#@}" in *[!0-9]*) want= ;; esac ;; *) want= ;; esac
            if [ -z "$have" ]; then
                printf '✕ cockpit: %s is gone, nothing killed\n' "$target" > "$note"
            elif [ -z "$want" ]; then
                printf '✕ cockpit: not killed: the board named no window to confirm\n' > "$note"
            elif [ "$have" != "$want" ]; then
                printf '✕ cockpit: not killed: %s is now in window %s, you confirmed %s\n' "$target" "$have" "$want" > "$note"
            else
                # The check and the kill are one tmux call: a pane that moves in the
                # gap makes the format false and nothing dies. $want is @digits.
                tmux if-shell -F -t "$target" "#{==:#{window_id},$want}" "kill-window -t $want" 2>/dev/null
                if tmux list-windows -a -F '#{window_id}' 2>/dev/null | grep -qx -- "$want"; then
                    printf '✕ cockpit: not killed: %s left window %s or it would not close\n' "$target" "$want" > "$note"
                else
                    printf '✓ cockpit: killed window %s (%s)\n' "$want" "$label" > "$note"
                    log "killed window $want $label via $target"
                fi
            fi
            ;;
        # Today's --request path. It opens its own popup, and tmux silently
        # refuses a popup inside the board's (measured: display-popup returns 0 and
        # runs nothing), so the board closes first, like jump: a background job
        # waits for this wrapper to exit, then runs the request. Its output, the
        # composed batch on exit 10, is not shown anywhere.
        request)
            # run-shell expands formats (# becomes ##) and hands the string to sh.
            rq=$(sq "$DIR/scripts/tmux-review"); rq=${rq//#/##}
            tmux run-shell -b "while kill -0 $$ 2>/dev/null; do sleep 0.1; done; $rq -p $target --request $target >/dev/null 2>&1"
            exit 0
            ;;
        # Version skew: an older binary's verb (the retired `fix`) or a newer one's.
        *)
            log "unknown verb [$verb $target]"
            tmux "${say[@]}" "cockpit: the board sent \"$verb\", which this plugin does not know; prefix U updates the plugin and cockpit-tui" 2>/dev/null
            exit 0
            ;;
    esac
    back || exit 0
    args=(--select "$target")
    [ -s "$note" ] && args+=(--note "$note")
done
