#!/usr/bin/env bash
# cockpit-board — the shell half of the board, and the loop that brings it back.
#   cockpit-board -p <pane> [-c <client>]   the pane and client the key was pressed in
# The action comes back through a file, never $(…): ratatui paints on stdout.
set -u

# The plugin root is the parent of the REAL scripts/: `me` follows any chain of links,
# a relative target read from its own link's folder (#1290). Not d: d is a temp dir below.
me=${BASH_SOURCE[0]}; case $me in (*/*) ;; (*) me=./$me ;; esac
[ -L "$me" ] && me=$(n=0
    while [ -L "$me" ] && [ $((n += 1)) -le 40 ] && t=$(readlink "$me"); do
        case $t in (/*) me=$t ;; (*) me=${me%/*}/$t ;; esac; done; printf %s "$me")
DIR="$(cd -P "$(dirname "$me")/.." && pwd)" || exit 1
LOG=${COCKPIT_LOG:-${XDG_STATE_HOME:-$HOME/.local/state}/tmux-cockpit/tui.log}
# shellcheck source=lib/pane.sh
. "$DIR/scripts/lib/pane.sh" || exit 1

# $EPOCHREALTIME needs bash 5, and no portable `date` flag gives microseconds.
log() {
    local ts=${EPOCHREALTIME:-}; ts=${ts/./}; [ -n "$ts" ] || ts="$(date +%s)000000"
    printf '%s cockpit-board: %s\n' "$ts" "$*" >> "$LOG"
}

sep=$'\037'

# The client a jump moves: a bare switch-client moves the most recently active
# one, which may be another (#296). -c (the window forms), or what the popup's
# key left on the pane, read and cleared now, before the other libs load (#480)
# and the board runs. That narrows the window to bash start and pane.sh; a press
# inside it still takes this run's pin.
PANE='' CLIENT=''
while [ $# -gt 0 ]; do
    case "$1" in
        -p) PANE=${2:-}; shift ;;
        -c) CLIENT=${2:-}; shift ;;
        *)  printf 'usage: cockpit-board -p <pane> [-c <client>]\n' >&2; exit 2 ;;
    esac
    shift
done
[ -n "$CLIENT" ] || CLIENT=$(take_pane_opt "$PANE" @cockpit_board_client)
# shellcheck source=lib/tui.sh
. "$DIR/scripts/lib/tui.sh" || exit 1
# shellcheck source=lib/fmt.sh
. "$DIR/scripts/lib/fmt.sh" || exit 1
# shellcheck source=lib/cmdname.sh
. "$DIR/scripts/lib/cmdname.sh" || exit 1
# shellcheck source=lib/tmpdir.sh
. "$DIR/scripts/lib/tmpdir.sh" || exit 1
# shellcheck source=lib/label.sh
. "$DIR/scripts/lib/label.sh" || exit 1
BIN=$COCKPIT_TUI_BIN
# In a popup a bare display-message picks the most recently active client.
say() { if is_pane "$PANE"; then dmsg -t "$PANE" "$1"; else dmsg "$1"; fi; }

# Required, but a broken install gets a message rather than a dead key.
if [ ! -x "$BIN" ]; then
    say "cockpit: board needs cockpit-tui: run $DIR/install.sh" 2>/dev/null
    exit 0
fi

mkdir -p "$(dirname "$LOG")" 2>/dev/null
# A private 0700 directory: the note is shown on the board, so no other user
# may get to write it first. Taken only when it is a fresh dir of the user's own, as the
# trap removes it: a refusal ends the board as a failed mktemp does (#947), and says which
# check refused.
d=''; own_tmpdir d || {
    say "cockpit: no temp dir for the board (own_tmpdir: $own_tmpdir_why)" 2>/dev/null; exit 1; }
f="$d/act" note="$d/note"
trap 'trap "" HUP INT TERM; rm -rf "$d"' EXIT  # a signal must not stop the rm (#1411)
trap 'trap "" HUP INT TERM; exit 130' INT TERM HUP

# @cockpit_board_return off: every action is one-way, as before the loop.
back() { [ "$(tmux show-option -gqv @cockpit_board_return 2>/dev/null)" != off ]; }

# The board comes back after review and panel, on the pane it acted on and
# with the action's last line as its note, until an action or an exit ends it.
args=()
# The binary reads $COCKPIT_GLYPHS, never the option (#293), as tm passes it.
glyphs=$(tmux show-option -gqv @cockpit_glyphs 2>/dev/null)
while :; do
    : > "$f" || exit 0
    # The binary creates its sidecars new and refuses a stale one: a kill's
    # .expect from the last trip must not stand in for the next action's.
    rm -f -- "$f.expect"
    # The popup closes on exit, so log stderr. CLAUDECODE leaks in from the agent's
    # environment and must not mark the binary as its child.
    env -u CLAUDECODE COCKPIT_ACTION="$f" COCKPIT_LOG="$LOG" ${glyphs:+"COCKPIT_GLYPHS=$glyphs"} "$BIN" board ${args[@]+"${args[@]}"} 2>>"$LOG" || {
        rc=$?
        say "cockpit: the board exited $rc — see $LOG" 2>/dev/null
        exit 0
    }

    # One line, `<verb> <pane-id>`. Pre-set because a missing file skips the read
    # under set -u; no `|| exit`, as read fails on an unterminated line it did assign.
    verb='' target='' rest=''
    read -r verb target rest 2>/dev/null < "$f"
    [ -n "$verb" ] || exit 0                 # nothing chosen: the ordinary q
    bad=
    [ -z "$rest" ] || bad=1
    case "$verb" in *[!a-z]*) bad=1 ;; esac
    is_pane "$target" || bad=1
    # The binary ships on its own tag, so log grammar drift instead of ignoring it.
    if [ -n "$bad" ]; then
        log "ignored action line [$verb $target $rest]"
        exit 0
    fi

    # Each verb that returns writes at most one line to $note; a line starting
    # with ✕ is a failure or a refusal, which the board keeps until a key.
    : > "$note" || exit 0
    case "$verb" in
        # switch-client fails without a client; the selection below still applies.
        jump)
            tmux switch-client ${CLIENT:+-c "$CLIENT"} -t "$target" 2>/dev/null || true
            tmux select-window -t "$target" 2>/dev/null
            tmux select-pane   -t "$target" 2>/dev/null
            exit 0
            ;;
        # These draw in the board's popup: tmux allows one popup per client.
        # Its status is not a verdict: leaving the queue with esc is non-zero too.
        review)
            "$DIR/scripts/tmux-review" -p "$target"
            ;;
        panel)
            COCKPIT_PANEL_NOTE="$note" "$DIR/scripts/cockpit-panel" -p "$target"
            ;;
        deliver)
            say "cockpit: replying from the board is not wired up yet" 2>/dev/null
            exit 0
            ;;
        # #228 verbs
        # The board confirmed with `%N @W`, the pane and its window's id, and wrote
        # it to $f.expect first. A name is no identity (automatic-rename gives
        # agents the same one), so the ids are compared: a pane moved to another
        # window since is refused. Only the pane dies (#301), never its window.
        # An older binary's bare `@W` names no pane, so it is refused too: its
        # confirm promised the whole window.
        kill)
            want=
            [ -f "$f.expect" ] && [ ! -L "$f.expect" ] && want=$(head -c 64 -- "$f.expect" 2>/dev/null | head -n 1)
            have=$(tmux display-message -p -t "$target" "#{?pane_id,#{window_id},}" 2>/dev/null |
                head -n 1)
            [ "${want%% *}" = "$target" ] && want=${want#"$target" } || want=
            case "$want" in @[0-9]*) case "${want#@}" in *[!0-9]*) want= ;; esac ;; *) want= ;; esac
            # The notes name the pane by its label (#1407), read before the kill: a pane that
            # is gone has none. Only the log keeps the %N and the @W.
            lbl=
            [ -z "$have" ] || lbl=$(label_ask "$target")
            if [ -z "$have" ]; then
                printf '✕ cockpit: the pane is gone, nothing killed\n' > "$note"
            elif [ -z "$want" ]; then
                printf '✕ cockpit: not killed: the board named no window to confirm\n' > "$note"
            elif [ "$have" != "$want" ]; then
                printf '✕ cockpit: not killed: %s is not in the window you confirmed\n' "$lbl" \
                    > "$note"
            else
                # The check and the kill are one tmux call: a pane that moves in the
                # gap makes the format false and nothing dies. $want is @digits and
                # $target %digits, as is_pane checked. The test reads 1 only for a
                # compare tmux read whole (#736): tmux 3.7+ cuts a format past 100 ms
                # to "", and a bare == read the two cut sides as equal and killed a
                # pane that had moved. A cut now kills nothing, and the note says so.
                tmux if-shell -F -t "$target" "#{?#{==:#{window_id},$want},1,0}" \
                    "kill-pane -t $target" 2>/dev/null
                if tmux list-panes -a -F '#{pane_id}' 2>/dev/null | grep -qx -- "$target"; then
                    printf '✕ cockpit: not killed: %s left the window you confirmed or would not close\n' \
                        "$lbl" > "$note"
                else
                    printf '✓ cockpit: killed %s\n' "$lbl" > "$note"
                    log "killed pane $target in window $want ($lbl)"
                fi
            fi
            ;;
        # #301: `claude --resume <id>` in a new pane beside an ended agent, at
        # its pane's cwd: Claude Code never moves its process's cwd (#312), so
        # that is the project the session started in, where --resume looks.
        # $f.expect is the session id the row showed; the pane must hold it
        # still, and it must be a session id (lib/fmt.sh), as it goes on a command line.
        resume)
            want=
            [ -f "$f.expect" ] && [ ! -L "$f.expect" ] && want=$(head -c 64 -- "$f.expect" 2>/dev/null | head -n 1)
            is_session_id "$want" || want=
            # the cwd last: it is the free-form field
            info=$(tmux display-message -p -t "$target" "#{?pane_id,=#{@cockpit_session}$sep#{pane_current_path},}" 2>/dev/null | head -n 1)
            have=${info%%"$sep"*} dir=${info#*"$sep"}
            # A second copy of a live session: any pane, this one included, holds
            # the id and runs an agent (its command in
            # @cockpit_agents_glob, or a claude renamed to its version, read by
            # lib/cmdname.sh's version_cmd as the board's agentish reads it, #830). Checked
            # here, at the key, so a stale board cannot skip it. The command only,
            # not the process tree the board reads. It goes last: free-form.
            # Not @panestate: SessionStart and idle run `agent-state off`, so a
            # live claude (the one `o` just opened, too) often has none.
            live=
            fmt="#{pane_id}$sep#{@cockpit_session}"
            fmt+="$sep#{?#{m/i:*|#{b:pane_current_command}|*,#{@cockpit_agents_glob}},1,0}$sep#{pane_current_command}"
            [ -z "$want" ] || while IFS="$sep" read -r p s g cmd; do
                [ "$s" = "$want" ] || continue
                if [ "$g" = 1 ] || version_cmd "$cmd"; then live=$p; break; fi
            done < <(tmux list-panes -a -F "$fmt" 2>/dev/null)
            # Each note names a pane by its label, read as the note is written (#1407).
            if [ -z "$have" ]; then
                printf '✕ cockpit: the pane is gone, nothing resumed\n' > "$note"
            elif [ -z "$want" ]; then
                printf '✕ cockpit: not resumed: the board named no session id\n' > "$note"
            elif [ "${have#=}" != "$want" ]; then
                printf '✕ cockpit: not resumed: %s no longer holds session %s\n' \
                    "$(label_ask "$target")" "$want" > "$note"
            elif [ -n "$live" ]; then
                printf '✕ cockpit: %s is already running in %s\n' "${want:0:8}" \
                    "$(label_ask "$live")" > "$note"
            elif [ ! -d "$dir" ]; then
                printf '✕ cockpit: not resumed: %s has no directory to start in\n' \
                    "$(label_ask "$target")" > "$note"
            else
                # -c expands formats, so the directory goes through fesc; the
                # command does not, and $want is hex and dashes, quoted anyway.
                # exec: tmux runs the string as `<default-shell> -c`, and a shell
                # that forks its last command (dash) would stay the pane's process,
                # so the pane would read sh, no agent to the check above (#895).
                new=$(tmux split-window -P -F '#{pane_id}' -t "$target" -c "$(fesc "$dir")" \
                    "exec claude --resume $(shq "$want")" 2>/dev/null)
                if is_pane "$new"; then
                    log "resumed session $want in $new beside $target"
                    tmux switch-client ${CLIENT:+-c "$CLIENT"} -t "$new" 2>/dev/null || true
                    tmux select-window -t "$new" 2>/dev/null
                    tmux select-pane -t "$new" 2>/dev/null
                    exit 0
                fi
                printf '✕ cockpit: not resumed: tmux would not split %s\n' \
                    "$(label_ask "$target")" > "$note"
            fi
            ;;
        # Version skew: a verb from an older or a newer binary than this plugin.
        *)
            log "unknown verb [$verb $target]"
            unk="cockpit: the board sent \"$verb\", which this plugin does not know"
            say "$unk; prefix U updates the plugin and cockpit-tui" 2>/dev/null
            exit 0
            ;;
    esac
    back || exit 0
    args=(--select "$target")
    [ -s "$note" ] && args+=(--note "$note")
done
