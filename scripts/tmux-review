#!/usr/bin/env bash
# tmux-review — review an agent's uncommitted diff, one comment at a time, and
# hand the finished review back to the agent's pane.
#   tmux-review [-p pane_id]               no args: the fleet queue (bound to
#                                          prefix r), with that pane -- or,
#                                          without -p, the CLIENT's active
#                                          pane -- preselected
#   tmux-review --fleet                    the fleet queue's rows, no fzf
#   tmux-review --lines <dir>              the diff rows a review anchors to
#   tmux-review --loop <dir> <store>       the interactive picker (needs fzf);
#                                          ctrl-s asks, then exits 20
#                                          (deliver); esc leaves the batch
#                                          pinned (asks first when any are)
#   tmux-review --compose <store>          the composed review, ready to deliver
#   tmux-review --deliver <pane> <store>   one bracketed paste, typed-but-unsent
#
# --lines and --compose touch no tmux.
set -uo pipefail

# bash 4+ (4.4 for `mapfile -d` in tmux-where). Without this the 3.2 failure is
# silent and wrong rather than loud: `declare -A` errors, then the same
# assignment quietly creates an INDEXED array with an arithmetic subscript.
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
    printf '%s needs bash 4 or newer (found %s). On macOS: brew install bash\n' \
           "${BASH_SOURCE[0]##*/}" "${BASH_VERSION:-unknown}" >&2
    exit 1
fi

# Resolved once, not `$0`: a symlink from install.sh (or a PATH lookup) must
# still find its sibling tmux-open-path and re-invoke itself for --rows/--attach
# (fzf's reload/execute-silent binds run in a fresh subshell of their own).
SELF="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
OPENPATH="$(dirname "$SELF")/tmux-open-path"
# The lib sits beside the SCRIPT. install.sh links each script into ~/bin by
# its absolute path, so one readlink hop is the whole resolution; a plain
# run (no link) has nothing to read and keeps $SELF's own directory.
LIBDIR="$(dirname "$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "$SELF")")/lib"

# tmux runs bind/preview strings through sh, so every path inside one has to be
# shell-quoted -- the same reasoning as tmux-open-path's shq.
shq() { printf '%q' "$1"; }

# lines_mode's own "diff too large" row (below) is not a real anchor -- no
# file, no line -- so it shares this one string with attach(), which refuses
# to comment on it. A row-shaped notice, not a special case in every reader.
CAP_SENTINEL='(diff too large)'

# How a pane names itself, for the fleet queue and the ^S confirm alike; the
# fallback convention (and why #{host_short} reads as "unset") is the note
# above fleet_rows, examples/tmux.conf:42.
AGENT_TITLE_FMT='#{?#{==:#{pane_title},#{host_short}},#{window_name},#{s/^✳ //:#{pane_title}}}'

# `git -C <dir> diff` always emits paths relative to the repo ROOT, no matter
# how deep <dir> sits inside the tree -- but <dir> is the pane's own cwd, so
# from an agent working in a subdirectory those root-relative paths do not
# resolve against <dir> itself. Resolve once, at each entry point, and thread
# the root through everywhere a diff-row path gets turned back into a file:
# lines_mode (for consistency, even though git already normalizes this), the
# review-loop's preview `cd`, and the fleet queue's preview. Falls back to
# the caller's own dir when it is not a git worktree at all, so the existing
# "no diff" behavior for a non-repo pane is unchanged.
git_root() {
    local dir=$1 root
    root=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)
    printf '%s\n' "${root:-$dir}"
}

usage() {
    cat >&2 <<'USAGE'
tmux-review — review an agent's uncommitted diff, one comment at a time.
  tmux-review [-p pane_id]                the fleet queue, with that pane (or,
                                          without -p, the client's active pane)
                                          preselected; it returns to the queue
                                          after every review
  tmux-review --fleet                    the fleet queue's rows, no fzf
  tmux-review --lines <dir>              the diff rows a review anchors to
  tmux-review --loop <dir> <store>       the interactive picker (needs fzf);
                                          ctrl-s asks, then exits 20 (deliver);
                                          esc leaves the batch pinned (asks
                                          first when any are)
  tmux-review --copy <dir> [path]        the file, then its diff (no path: the whole diff), for the clipboard
  tmux-review --resnap <dir> <store>     re-snapshot the diff; names the comments that moved
  tmux-review --list <store>            every pinned comment, then a key
  tmux-review --compose <store>          the composed review, ready to deliver
  tmux-review --deliver <pane> <store>   paste it typed-but-unsent into <pane>; a busy pane gets it queued for its next Stop
  tmux-review --done <store>            after a by-hand --deliver: archive the batch, drop the snapshot
  tmux-review --delta <pane>            exit 0 when <pane>'s tree differs from its review base
  tmux-review --request <pane>          the agent asks: one popup on <pane>; the batch on stdout, exit 10
  tmux-review -p <pane> --info          one screen: state, review, base, session, review dir (prefix i)
In the picker: ↵ pin the typed comment on the row under the cursor   ^E editor   ^X delete its comments   ^L list   ^R refresh   ^B base   ^A approve   ^Y copy file+diff   alt-y copy all   ^S deliver (asks first)   esc leave (asks first)
(there is no accept-all: ↵ with nothing typed does nothing)
USAGE
}

# --- the base every review diffs against --------------------------------------
# ONE diff, whatever the base: staged, unstaged AND untracked changes come out
# of a single `git diff <base>`, because the diff runs against a COPY of the
# index that `git add -N -A` has extended with an intent-to-add entry for
# every untracked file. -N records the path only (no content is hashed), and
# a plain `git diff` then shows such a file as a new file against the working
# tree -- the documented use of intent-to-add. Measured on the eight goldens:
# byte-identical to the ls-files/awk synthesis this replaces, 12/12 runs.
#
# The copy is not optional: an `add` against the real index would rewrite the
# agent's own index under it. `cp -p`, not `cp`: git's racy-timestamp guard
# compares each entry's mtime with the INDEX FILE's mtime, and a fresh copy
# with a fresh mtime made git trust a same-size, same-second edit as clean --
# reproduced 1 run in 3 on the `spaces` fixture, 0 in 12 with -p. An unborn
# repo has no index to copy; the rm lets git start one from nothing.
#
# It also makes the approved checkpoint (^A, a tree that INCLUDES untracked
# files) diff exactly: against the real index `git diff <tree>` reports a
# file present in the tree but untracked here as DELETED (reproduced); with
# the -N entry it compares the file's content instead.
#
# --no-optional-locks on every call, the same discipline fleet_scan_root()
# uses: even a read can take index.lock, and this runs against a repo an
# AGENT is working in.
tree_diff() {
    local dir=$1; shift
    local idx gd head br rp
    # One rev-parse for the three facts every diff needs -- the git dir (whose
    # index to copy), HEAD, and the branch review_base keys on. rev-parse
    # carries on past an argument it cannot resolve, so an unborn HEAD leaves
    # two lines (git dir, "HEAD") and a born one three. This and review_base
    # were 10 forks per root; the 20-pane fleet gate (timeout 1) caught it.
    mapfile -t rp < <(git -C "$dir" --no-optional-locks rev-parse --absolute-git-dir HEAD --abbrev-ref HEAD 2>/dev/null)
    gd=${rp[0]-}; head=${rp[1]-}; br=${rp[2]-}
    [ -n "$gd" ] || return 1
    # A caller that scans many roots at once (fleet_rows) lends the one temp
    # dir it already owns, and the copy is named by PID and dies with that
    # dir: mktemp + rm per root were 40 of the fleet's forks.
    if [ -n "${TREE_DIFF_TMP:-}" ]; then idx=$TREE_DIFF_TMP/idx.$BASHPID
    else idx=$(mktemp) || return 1; fi
    cp -p -- "$gd/index" "$idx" 2>/dev/null || rm -f -- "$idx"
    GIT_INDEX_FILE=$idx git -C "$dir" --no-optional-locks add -N -A 2>/dev/null
    if [ -n "$br" ]; then
        local base
        base=$(review_base "$dir" "${COCKPIT_REVIEW_BASE:-auto}" "$br" "$head"); base=${base%%$'\t'*}
        GIT_INDEX_FILE=$idx git -C "$dir" --no-optional-locks -c core.quotePath=false \
            diff --no-color --no-ext-diff "$base" "$@" 2>/dev/null
    else
        local out
        out=$(GIT_INDEX_FILE=$idx git -C "$dir" --no-optional-locks -c core.quotePath=false diff --no-color --no-ext-diff "$@" 2>/dev/null)
        [ -n "$out" ] || out=$(GIT_INDEX_FILE=$idx git -C "$dir" --no-optional-locks -c core.quotePath=false diff --no-color --no-ext-diff --cached "$@" 2>/dev/null)
        printf '%s\n' "$out"
    fi
    [ -n "${TREE_DIFF_TMP:-}" ] || rm -f -- "$idx"
}

# --- which base ---------------------------------------------------------------
# Four cases, the first that holds (when-how lens §2.3; revdiff's auto-detect):
#   since-review  refs/cockpit/reviewed/<branch> exists (^A wrote it)  -> only what moved since
#   branch        merge-base of the upstream (else origin/HEAD, else main/master) and HEAD,
#                 when that is not HEAD itself                          -> the branch + uncommitted
#   uncommitted   HEAD                                                  -> today's view
# MODE forces one; a forced mode that does not hold falls through to the next,
# so the printed mode is the one that HELD -- next_base relies on that.
# Prints "<rev>\t<label>\t<mode>". Never called on an unborn HEAD.
review_base() {               # <dir> [auto|since-review|branch|uncommitted] [branch] [head-sha]
    local dir=$1 mode=${2:-auto} br=${3:-} head=${4:-} ref up mb
    local name sha ups track sym ckpt="" bups="" btrack="" ohead="" osha="" mainsha="" mastersha="" upsha=""
    [ -n "$br" ] || br=$(git -C "$dir" --no-optional-locks rev-parse --abbrev-ref HEAD 2>/dev/null)
    ref="refs/cockpit/reviewed/${br:-HEAD}"
    # Every ref the cases below ask about, from ONE for-each-ref rather than a
    # rev-parse per candidate (seven, before): the checkpoint; the branch's
    # upstream, whose :track is "[gone]" exactly when `--verify @{u}` would
    # refuse it and "" when it sits at HEAD; origin/HEAD's target; main;
    # master. Rows come back sorted by name, not by our preference, so they
    # are collected first and chosen after. A pattern also matches refs BELOW
    # it (refs/heads/main/x when no main exists), hence the exact names.
    while IFS=$'\t' read -r name sha ups track sym; do
        case "$name" in
            "$ref")                   ckpt=$sha ;;
            "refs/heads/$br")         [ -n "$head" ] || head=$sha; bups=$ups; btrack=$track ;;
            refs/remotes/origin/HEAD) ohead=$sym; osha=$sha ;;
            refs/heads/main)          mainsha=$sha ;;
            refs/heads/master)        mastersha=$sha ;;
        esac
    done < <(git -C "$dir" --no-optional-locks for-each-ref \
        --format='%(refname)%09%(objectname)%09%(upstream:short)%09%(upstream:track)%09%(symref:short)' \
        -- "$ref" "refs/heads/$br" refs/remotes/origin/HEAD refs/heads/main refs/heads/master 2>/dev/null)
    case "$mode" in auto|since-review)
        [ -z "$ckpt" ] || { printf '%s\tsince last review\tsince-review\n' "$ckpt"; return 0; } ;;
    esac
    case "$mode" in auto|since-review|branch)
        # The upstream, else origin/HEAD, else main, else master -- and, where
        # the rows already say the merge-base IS HEAD, no merge-base fork: an
        # upstream that is not ahead of us, or a fallback whose sha is HEAD's.
        if [ -n "$bups" ] && [ "$btrack" != '[gone]' ]; then
            up=$bups; case "$btrack" in *ahead*) upsha="" ;; *) upsha=$head ;; esac
        elif [ -n "$ohead" ];     then up=$ohead;  upsha=$osha
        elif [ -n "$mainsha" ];   then up=main;    upsha=$mainsha
        elif [ -n "$mastersha" ]; then up=master;  upsha=$mastersha
        else up=""
        fi
        if [ -n "$up" ] && { [ -z "$head" ] || [ "$upsha" != "$head" ]; }; then
            mb=$(git -C "$dir" --no-optional-locks merge-base "$up" HEAD 2>/dev/null)
            [ -n "$head" ] || head=$(git -C "$dir" --no-optional-locks rev-parse HEAD 2>/dev/null)
            if [ -n "$mb" ] && [ "$mb" != "$head" ]; then
                printf '%s\tvs %s\tbranch\n' "$mb" "$up"; return 0
            fi
        fi ;;
    esac
    printf 'HEAD\tuncommitted\tuncommitted\n'
}

# The mode after CUR among those that hold, wrapping -- ^B's cycle.
next_base() {                 # <dir> <current-mode>
    local dir=$1 cur=$2 m first="" prev="" out
    for m in since-review branch uncommitted; do
        out=$(review_base "$dir" "$m"); [ "${out##*$'\t'}" = "$m" ] || continue
        [ -n "$first" ] || first=$m
        [ -n "$prev" ] && [ "$prev" = "$cur" ] && { printf '%s\n' "$m"; return 0; }
        prev=$m
    done
    printf '%s\n' "$first"
}

# Exit 0 when PANE's tree differs from its review base -- the one question the
# Stop hook asks. Reads the mode the pane's own review chose with ^B, if any.
delta_mode() {                # <pane>
    local pane=$1 dir root sess mode
    dir=$(tmux display-message -p -t "$pane" '#{pane_current_path}' 2>/dev/null)
    [ -n "$dir" ] || return 1
    root=$(git_root "$dir")
    git -C "$root" --no-optional-locks rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 1
    sess=$(session_dir "$pane" "$root")
    mode=$(cat -- "$sess/comments.md.base" 2>/dev/null)
    export COCKPIT_REVIEW_BASE=${mode:-auto}
    [ -n "$(tree_diff "$root" --numstat)" ]
}

# --- --lines -------------------------------------------------------------
# Every +/- hunk line of the working tree's diff, one tab-separated row per
# line: path, line, fragment, display. `line` anchors a `+` (or context-side)
# row to the NEW file; a deletion has no line in the new file, so its row
# carries the OLD line number instead, prefixed "-" -- the same (+)/(-) split
# the compose grammar uses for its headers.
#
# Everything uncommitted is ONE set -- staged, unstaged and brand-new files --
# because that is what "review what I have not committed" means. See tree_diff
# below for the base.

# ${#s} counts CHARACTERS in a UTF-8 locale and BYTES in C. The cap below is a
# byte cap and `head -c` is a byte bound, so the length that decides it has to
# be measured in C. In a UTF-8 locale a non-ASCII diff measures up to 4x short,
# and that does not merely miss the cap: it reads a capture that WAS truncated
# at the budget as one that fit, and hands the truncated diff to the parse.
# Same idiom as pad_field() at the bottom of this file.
bytelen() { local LC_ALL=C; printf '%s\n' "${#1}"; }

lines_mode() {
    local dir=$1
    [ -n "$dir" ] || return 0

    # core.quotePath=false: with git's default (true) a path holding any
    # non-ASCII byte comes out C-quoted and octal-escaped -- `--- "a/caf\303\251.txt"`
    # -- and the header match below (/^--- a\//, /^\+\+\+ b\//) needs a bare
    # `a/`/`b/`, so a quoted header matched neither. The file's every row was
    # then attributed to the PREVIOUS file (or dropped, if it was first): the
    # agent got told to edit café's lines in alpha.txt. Turning quoting off
    # makes the path literal in both the diff headers and numstat, so the two
    # stay keyed on the same name. (A path with a literal tab/quote is still
    # git-quoted even here -- the residual narrow case; non-ASCII is the common
    # one and is fixed.)
    #
    # numstat FIRST and the full diff only after the cap below has let it
    # through: COUNTING is cheap, CAPTURING is what costs. `git diff
    # --numstat` carries every number the cap needs, and on a tree the cap
    # exists to refuse (30 regenerated lockfiles, 6,000,030 changed rows,
    # 38 MB on disk) it is 0.75s and 32 MB against the full capture's 3.25s
    # and 222 MB -- which this used to pay first, to fill a variable it then
    # threw away for a one-row notice.
    local diff numstat
    numstat=$(tree_diff "$dir" --numstat)

    # Untracked files are rows of the same diff: see tree_diff's intent-to-add copy.

    # A giant single-file diff -- a regenerated lockfile, a vendored bundle, a
    # minified asset -- would feed the per-row parse below tens of thousands of
    # rows. The review popup is MODAL and runs lines_mode at startup and on
    # every reload, so that parse locked the one client for minutes to hours
    # (measured: a 100k-row single-file diff did not finish in 5 minutes, while
    # the git diff and the awk themselves cost ~0.03s -- the shell row-build is
    # the whole cost). numstat's own add+del columns already total the exact
    # number of +/- rows this function emits, at the one cheap git call made
    # just above -- so count first and, past a cap, emit a single notice
    # instead of parsing at all. The popup then always appears at once and esc
    # still cancels it. 5000 is well past any diff a human reads line-by-line
    # yet far below where the parse is felt.
    #
    # Rows are not the only way a diff gets too big to hand a reviewer. 4000
    # rows of a 1500-column minified line sit comfortably under the row cap
    # and are still 5.7 MB to capture, parse into shell rows, and render as an
    # fzf list of 1500-column entries. So the same pass caps on BYTES too --
    # 4 MB -- and it MEASURES those bytes rather than estimating them.
    #
    # Two estimators were tried here first and both broke, in opposite
    # directions. `size * (add+del) / lines`, a per-file average, is dominated
    # by the short lines while the diff is dominated by the long one: 100,000
    # one-byte lines beside one 5 MB line estimated 103 bytes and captured
    # 10 MB (0.91s, 82 MB RSS, in the modal popup, for a two-row review).
    # Flooring it with `maxlen * (add+del)` catches that and inverts the
    # error: it charges the widest line in a file to EVERY changed row of it,
    # whatever the change was, and since the cap is a per-review TOTAL one
    # such file takes every other file down with it -- a 744-byte, 26-row
    # review refused as "(6.8 MB)", an unrelated one-line Go change lost along
    # with it. That estimate also needed `wc -L`, and on a wc without it the
    # sized map came back empty and the byte cap vanished in silence (4000
    # rows parsed, 1.02s, where the cap had fired before).
    #
    # There is no estimate that is both safe and fair, because the thing being
    # guessed at -- how many bytes these particular rows are -- is exactly
    # what a diff already knows. So take the real number, and BOUND the taking
    # of it: capture once through `head -c cap+1` and let git die on SIGPIPE
    # past that. A 400 MB diff then costs the 4 MB read that proves it too
    # big, not the 2.06s/177MB a full capture measured -- and when it fits,
    # what came back IS the diff the parse below reads, so nothing is diffed
    # twice and the "capture only after the cap decides" property is kept.
    #
    # numstat still runs first, for the ROW cap: rows can exceed 5000 while
    # the bytes stay under 4 MB (12001 rows of "1\n" is 24 KB), and counting
    # them is the cheap call already made above.
    local cap=5000 bytecap=$(( 4 * 1024 * 1024 )) total=0 bytes=0
    local nadd ndel nfile reason=
    while IFS=$'\t' read -r nadd ndel nfile; do
        [ -n "$nfile" ] || continue
        # A binary file's numstat counts are "-\t-". It contributes no +/- rows
        # to the parse below -- without --binary git prints one "Binary files
        # a/x and b/x differ" line and nothing else, whatever the file weighs
        # -- so it adds nothing to the row total, and its one line is already
        # in the capture like every other byte. This is what keeps a two-line
        # code change beside a rebuilt 5 MB asset reviewable.
        [ "$nadd" = "-" ] && continue
        case "$nadd" in *[!0-9]*) nadd=0 ;; esac
        case "$ndel" in *[!0-9]*) ndel=0 ;; esac
        total=$(( total + nadd + ndel ))
    done <<<"$numstat"
    if [ "$total" -gt "$cap" ]; then
        reason="$total changed lines"
    else
        if [ "$bytes" -gt "$bytecap" ]; then
            reason='> 4 MB'
        else
            # One byte past what is left of the budget: enough to prove the cap
            # is exceeded, never more than the budget itself in memory.
            #
            # The trailing X is what makes the length EXACT. Command
            # substitution strips trailing newlines, so without it a capture
            # that happens to end on one reads a byte short of the budget --
            # and a diff truncated at the budget would then be parsed as a
            # complete one, silently dropping everything past 4 MB and
            # mangling the row it was cut in half on.
            diff=$(tree_diff "$dir" | head -c $(( bytecap - bytes + 1 )); printf X)
            diff=${diff%X}
            if [ "$(bytelen "$diff")" -gt $(( bytecap - bytes )) ]; then
                reason='> 4 MB'
                diff=
            else
                # Back to the shape the old `diff=$(tree_diff ...)` produced,
                # so the parse below sees exactly what it always did.
                diff=${diff%$'\n'}
            fi
        fi
    fi
    if [ -n "$reason" ]; then
        local big="diff too large to anchor line-by-line ($reason) — review it directly"
        # Offset 1 (the preview's first line) so the 5-field split in rows_mode
        # never meets a short row -- this notice has no file to scroll anyway.
        printf '%s\t%s\t%s\t%s\t%s\n' "$CAP_SENTINEL" 0 "$big" "$big" 1
        return 0
    fi

    [ -n "$diff" ] || return 0

    # One pass: track the file a hunk belongs to (from the +++/--- header
    # pair -- a whole-file deletion has "+++ /dev/null", so the path has to
    # come from the "--- a/" side instead), the hunk's starting old/new line
    # from "@@ -o,c +o,c @@" (not a capture-group regex -- portable to
    # non-GNU awk), and a running counter per side. Context lines advance both
    # counters and emit nothing; a +/- line emits a row and advances its own
    # side.
    #
    # The -o,c and +o,c tokens are POSITIONAL -- always fields 2 and 3 of the
    # header -- and have to be taken that way, not found by scanning every
    # token for a leading -/+. git appends a funcname context after the
    # closing "@@" ("@@ -2,7 +2,7 @@ fn compute() -> i32 {"), and a scan
    # keeps clobbering oldtok/newtok on any later token that starts with -
    # or + too -- "-> i32" matched and silently became the anchor.
    # Reproduced: a deletion at old line 5 was anchored to -3 instead.
    #
    # Header lines ("--- a/x", "+++ b/x", "@@ ...") exist only BETWEEN hunks,
    # never inside one -- but a body line whose own text starts "-- " or
    # "++ " becomes, once diff prepends its own -/+ marker, "--- ..." or
    # "+++ ..." and a plain /^--- /-style match can't tell the two apart.
    # "@@" needs no such guard: a body line can only ever start "@@" if diff
    # gave it a bare literal first, which it never does. So --- / +++ are
    # only trusted as headers while the hunk's own line budget (oldrem/newrem,
    # from the "@@ -o,c +o,c @@" counts) is exhausted; while budget remains,
    # every line is content, dispatched on its leading character alone, same
    # as any other +/-/context row. Reproduced: an unstaged "-- a sql
    # comment" deletion vanished and every anchor after it drifted; an added
    # "++ ..." line reset the counters and threw every later anchor off too.
    local raw
    raw=$(printf '%s\n' "$diff" | awk '
        function inhunk() { return (oldrem > 0 || newrem > 0) }
        {
            if (inhunk()) {
                # poff is where the row lands in the PREVIEW, not in the
                # file: --preview-diff prints one stat line and then this same
                # diff from the first @@ of that file. So every line inside a
                # hunk -- context, +, -, and the "\ No newline" note alike --
                # occupies one preview line and is counted before it is
                # dispatched, and the +1 at the emit is that stat line.
                poff++
                c = substr($0, 1, 1)
                if (c == "+") {
                    if (file != "") {
                        printf "%s\t%d\t+\t%d\t%s\n", file, newl, poff + 1, substr($0, 2)
                        newl++
                    }
                    newrem--
                } else if (c == "-") {
                    if (file != "") {
                        printf "%s\t%d\t-\t%d\t%s\n", file, oldl, poff + 1, substr($0, 2)
                        oldl++
                    }
                    oldrem--
                } else if (c == " ") {
                    oldl++; newl++; oldrem--; newrem--
                }
                # anything else ("\ No newline at end of file") stays ignored
                next
            }
            if ($0 ~ /^--- /) {
                # git TERMINATES a header path with a tab when the path holds a
                # space ("--- a/has space.txt<TAB>"), and substr keeps it. That
                # tab then rode into every row the file emitted, where -F"\t"
                # read it as an extra empty field: the line number came out
                # blank, the preview offset was glued to the front of the
                # fragment, and the sign column landed in the offset -- so a
                # DELETION on such a path was emitted as an addition. It was
                # invisible while the rows were built by a tab-IFS `read`,
                # which treats tab as IFS whitespace and collapses the doubled
                # one; awk -F"\t" does not. A header path can never
                # legitimately end in a raw tab (git C-quotes those), so
                # stripping one is unambiguous, and doing it here fixes both
                # sides at the source instead of in every consumer.
                if ($0 ~ /^--- a\//) { oldfile = substr($0, 7); sub(/\t$/, "", oldfile) }
                next
            }
            if ($0 ~ /^\+\+\+ /) {
                if ($0 ~ /^\+\+\+ b\//) { file = substr($0, 7); sub(/\t$/, "", file) } else file = oldfile
                # A new file is a new preview, so its offset restarts too.
                oldl = 0; newl = 0; poff = 0; next
            }
            if ($0 ~ /^@@/) {
                split($0, parts, " ")
                oldtok = parts[2]; newtok = parts[3]
                sub(/^-/, "", oldtok); split(oldtok, oa, ","); oldl = oa[1] + 0
                oldrem = (oa[2] == "" ? 1 : oa[2] + 0)
                sub(/^\+/, "", newtok); split(newtok, na, ","); newl = na[1] + 0
                newrem = (na[2] == "" ? 1 : na[2] + 0)
                # The @@ line is where --preview-diff starts printing, so it is
                # preview line 1 of the diff -- count it like any other.
                poff++
                next
            }
        }
    ')

    [ -n "$raw" ] || return 0

    # Churn, the rows, the test-first partition and the ordering: ONE awk over
    # the two streams this function already has, then `sort | cut`. What stood
    # here was four bash passes over the same data -- a `read` loop building a
    # churn map, a second `read` loop building the rows, a loop partitioning
    # the paths, and two emit loops indexing back into a rows array by each
    # file's recorded [start,end] range -- and bash pays an interpreter step
    # per row for every one of them. Measured on a 4900-row single-file diff
    # (the largest shape that stays under the cap), ten runs each: the whole
    # function cost 195-227ms, of which the git diff and the parsing awk --
    # everything up to `raw` -- are 43-52ms. The bash row build alone was the
    # other ~165ms. The same rows out of awk cost ~19ms, 59-69ms end to end.
    # The row build was never the parse; it was bash.
    #
    # Stream 1 is numstat (add, del, path) -- churn is additions + deletions,
    # the risk proxy that orders everything but the test partition. A binary
    # file's counts are "-\t-", not numbers, so they weigh nothing; a path
    # numstat never mentions weighs nothing either (awk reads an unset element
    # as 0, exactly what `${churn[$path]:-0}` did).
    #
    # Stream 2 is the raw rows. `NR == FNR` is safe as the stream test here
    # only because `printf '%s\n' "$numstat"` always emits at least one line,
    # so FNR restarts at 1 for stream 2 while NR does not -- the empty-first-
    # stream trap the estimate awk above has to sidestep with ARGV[1].
    #
    # The text is taken as "everything past the fourth tab", not as $5: a
    # fragment may itself contain a tab and $5 would drop everything after it,
    # where the bash `read -r ... rest` this replaces kept it. (Both then lose
    # it to the control-char strip -- which is the point: the two agree.)
    #
    # LC_ALL=C on the awk, not just on the sort: the 160 cut is a BYTE cut, and
    # `substr` counts bytes in mawk but CHARACTERS in gawk under a UTF-8
    # locale -- the same diff cut at 160 characters on one box and 160 bytes on
    # the next, and `length($1)`-style field arithmetic drifted with it. C
    # makes every awk here byte-oriented, which is also what the shell it
    # replaces counted once the fragment reached printf.
    #
    # Ordering is done by `sort`, not in awk (no `asorti` in POSIX awk, and an
    # in-awk insertion sort is the O(n^2) this is here to delete). Three
    # prepended key columns and one ascending sort do it: the partition (0 for
    # a test file, 1 otherwise), then `999999999 - churn` so ONE ascending
    # sort reads as churn-DESCENDING, then NR to break ties. NR ascending is
    # first-seen order, and git diff never interleaves two files, so every row
    # of a file shares its file's two leading keys and its NRs are contiguous
    # -- the file's group stays whole and internally line-ascending. LC_ALL=C
    # for a byte order that does not move with the locale; `cut` drops the
    # three keys again.
    LC_ALL=C awk -F'\t' '
        NR == FNR {
            if ($1 ~ /^[0-9]+$/) a = $1; else a = 0
            if ($2 ~ /^[0-9]+$/) d = $2; else d = 0
            churn[$3] = a + d
            next
        }
        {
            p = $1
            # tests/*, *_test.*, *.test.* are all substrings of plain "test",
            # so one test covers the whole family -- the *test* glob the shell
            # partition used, ported exactly.
            if (!(p in part)) part[p] = (index(p, "test") > 0 ? 0 : 1)
            # Control-char strip + 160 cap, the agent-state:82-86 discipline:
            # this text reaches an fzf display column and a comment-store
            # header next.
            frag = substr($0, length($1) + length($2) + length($3) + length($4) + 5)
            gsub(/[\001-\037\177]/, "", frag)
            # 160 BYTES, backed off to a character boundary. A blind byte cut
            # ends a fragment mid-sequence -- 200 "e-acute" after one ASCII
            # byte put a lead byte C3 at 160 and its continuation at 161, so
            # the fzf column and the comment-store quote header got an
            # undecodable trailing byte. The byte AFTER the cut says whether
            # the cut split anything: only a continuation byte there means it
            # landed inside a sequence, and then the whole partial sequence at
            # the end goes. A cut that already fell on a boundary is left
            # alone -- trimming it would drop a whole valid character (200
            # "e-acute" with no prefix is exactly 80 characters at 160 bytes).
            # Invalid input cannot loop or corrupt further: with no lead byte
            # to match, the sub does nothing and the 160-byte cut stands.
            if (length(frag) > 160) {
                tail = substr(frag, 161, 1)
                frag = substr(frag, 1, 160)
                if (tail ~ /^[\200-\277]$/) sub(/[\300-\367][\200-\277]*$/, "", frag)
            }
            # A deletion has no line in the new file, so its row carries the
            # OLD number prefixed "-".
            ml = ($3 == "-" ? "-" $2 : $2)
            printf "%d\t%09d\t%09d\t%s\t%s\t%s\t%s:%s (%s)  %s\t%s\n", \
                   part[p], 999999999 - churn[p], NR, \
                   p, ml, frag, p, $2, $3, frag, $4
        }
    ' <(printf '%s\n' "$numstat") <(printf '%s\n' "$raw") \
        | LC_ALL=C sort -t "$(printf '\t')" -k1,1n -k2,2 -k3,3 \
        | cut -f4-
}

# The snapshot: lines_mode's rows, written ONCE per popup, re-marked after.
#
# And on any tree with something to review, that ONE parse is the only one
# this popup pays: it lands in "<store>.rows" and every rows_mode below --
# fzf's own reload() after each pinned comment, and the two rebuilds on the
# keep-reviewing paths -- reads it back and only re-marks it. (A clean tree
# writes an empty snapshot, which rows_mode declines, so that one case
# still parses twice before the "no uncommitted changes" exit below. It has
# nothing to parse.) The snapshot is deliberately NOT refreshed afterwards:
# the rows a reviewer comments on must stay the rows the reviewer SAW, even
# if the agent writes to the tree while the popup is up. (That is the
# phase-0 mitigation for reviewing a live tree; it is not a diff cache that
# outlives anything -- it dies with the store below.)
#
# Guarded on a non-empty store because "$store.rows" with no store is
# ".rows", a real path in whatever directory this was run from.
#
# `umask 077` + `set -C` in the same subshell that does the writing, the
# discipline deliver() already uses for the oversized-review file -- and
# this file needs it MORE, because its name is DERIVABLE. session_dir()
# builds the store's path from the pane id and the repo root's cksum, and
# "<store>.rows" is one suffix away from that -- inside a 0700 dir under
# $HOME, but O_EXCL still earns its keep against a link planted by anyone
# who can write there. The file holds the entire uncommitted diff. A plain
# `>` was wrong twice over: it created the
# snapshot at the caller's umask (0664 here -- the whole diff
# world-readable, while the store beside it is 0600), and it FOLLOWED a
# symlink already sitting at that name, so the diff could be written into
# a file of someone else's choosing and their file truncated to make room.
# noclobber makes the open O_CREAT|O_EXCL, which refuses an existing path
# -- a symlink included, dangling or not -- and umask makes what it does
# create born 0600, with no create-then-chmod window.
#
# The `rm -f` first is for a resumed session's stale snapshot, which set -C
# would otherwise refuse to replace -- but it is guarded, not unconditional:
# cleared only when "$2.rows" is a plain file, so a planted symlink is left
# standing here and still hits the noclobber refusal below, which sweeps it
# up (unlinked, never followed) the same as always.
#
# A refused write is not an error worth stopping for: the `rm -f` unlinks
# whatever was squatting the name (unlink never follows a symlink, so the
# victim is untouched) and leaves no snapshot, and rows_mode simply
# derives the rows from the tree instead. Slower, correct, no popup lost.
snapshot() {                  # <dir> <store>
    [ -n "${2:-}" ] || return 0
    [ -L "$2.rows" ] || rm -f -- "$2.rows"
    (umask 077; set -C; lines_mode "$1" > "$2.rows") 2>/dev/null || rm -f -- "$2.rows"
}

# Comments whose "## path:line (sign)" header matches no row in the
# snapshot: the agent moved the line since the comment was pinned (dev lens
# §2.2). They still deliver -- the quoted fragment is what the agent anchors
# on -- so this only NAMES them. Streams told apart by FILENAME, as in
# mark_rows: an empty store makes NR == FNR lie.
stale_keys() {                # <store> <rows-file>  -> stale headers, one per line
    # A refused snapshot write means "unknown", not "everything moved".
    [ -s "${2:-}" ] || return 0
    local st=${1:-/dev/null} rows=${2:-/dev/null}
    [ -f "$st" ] || st=/dev/null
    [ -f "$rows" ] || rows=/dev/null
    LC_ALL=C awk -F'\t' '
        FILENAME == ARGV[1] { if (substr($0, 1, 3) == "## ") h[++n] = $0; next }
        NF == 0 { next }
        {
            sign = (substr($2, 1, 1) == "-") ? "-" : "+"
            num = $2; sub(/^-/, "", num)
            k["## " $1 ":" num " (" sign ")"] = 1
        }
        END { for (i = 1; i <= n; i++) if (!(h[i] in k)) print h[i] }
    ' "$st" "$rows"
}

# --- approve -------------------------------------------------------------------
# refs/cockpit/reviewed/<branch> = the tree the human just looked at, untracked
# files included (a real add -A into a temp index, then write-tree; content IS
# hashed here, once per approve). A ref to a tree object is what makes the
# since-review base a plain `git diff <ref>`; git update-ref accepts it.
# It does NOT die with the branch -- `git branch -D` and `worktree remove`
# leave it standing (reproduced), so a deleted-and-recreated branch of the
# same name inherits a stale checkpoint, and a name that collides on the
# refs/ hierarchy (a branch "feat" after a checkpoint at "feat/x") blocks a
# later approve outright. Purge by hand:
#   git for-each-ref --format='%(refname)' refs/cockpit/reviewed | xargs -n1 git update-ref -d
# The pane's state is the caller's to clear -- this function knows the repo,
# not the pane.
approve() {                   # <dir>
    local dir=$1 idx gd br tree
    idx=$(mktemp) || return 1
    gd=$(git -C "$dir" rev-parse --absolute-git-dir 2>/dev/null) || { rm -f -- "$idx"; return 1; }
    cp -p -- "$gd/index" "$idx" 2>/dev/null || rm -f -- "$idx"
    br=$(git -C "$dir" --no-optional-locks rev-parse --abbrev-ref HEAD 2>/dev/null)
    tree=$(GIT_INDEX_FILE=$idx git -C "$dir" add -A 2>/dev/null \
           && GIT_INDEX_FILE=$idx git -C "$dir" write-tree 2>/dev/null)
    rm -f -- "$idx"
    [ -n "$tree" ] && git -C "$dir" update-ref "refs/cockpit/reviewed/${br:-HEAD}" "$tree" 2>/dev/null
}

# After a delivery: the batch joins delivered.md beside the store (the ↺ marks
# of the next round read it), the store and its snapshot go, the dir stays
# while anything is in it -- ^A is what removes it. Public as --done so the
# by-hand re-delivery keep_hint() prints can finish the same way.
done_store() {                # <store>
    local st=$1 d=${1%/*}
    [ "$d" = "$1" ] && d=.
    # The store is removed only once its content is actually IN delivered.md --
    # an append that fails (a full disk, a permissions slip) must not lose the
    # only copy of the review.
    if [ -f "$st" ] && [ ! -L "$st" ] && [ -s "$st" ]; then
        cat -- "$st" >> "$d/delivered.md" || return 1
    fi
    rm -f -- "$st" "$st.rows" "$st.base"
    rmdir -- "$d" 2>/dev/null
    return 0
}

# What ^A ends: the session dir's own files, by name. Not `rm -rf` -- the dir
# may also hold comments.md.deliver, a review already handed to a busy pane
# with @cockpit_review_spool armed at it, and that one belongs to the agent's
# next Stop, not to this approval. rmdir therefore succeeds on an approval with
# nothing in flight and fails (harmlessly) on one with a spool still waiting;
# review-gate rmdirs the leftover after it drains. Two callers, ^A in the
# picker and ^A in --request, and the list must not drift between them.
clear_sess() {                # <sess dir>
    local s=$1
    [ -d "$s" ] && [ ! -L "$s" ] || return 0
    rm -f -- "$s/comments.md" "$s/comments.md.rows" "$s/comments.md.base" \
             "$s/delivered.md" "$s/rc"
    rmdir -- "$s" 2>/dev/null
    return 0
}

# --- --rows / --attach (internal: the picker's own reentry, tmux-open-path's
# --preview/--pick convention) --------------------------------------------
# --lines rows, marked: a leading "●" on any row whose path:line already has
# a comment block in the store, a space on every other row -- same column
# width either way, so nothing shifts. This is the marker-column trick at
# tmux-open-path:176-183, applied to a display FIELD instead of a preview
# line: prepend, never repaint. Its own subcommand (not inline in run_loop)
# because fzf's reload() re-execs a fresh command; there is nothing else to
# call back into.
rows_mode() {
    local dir=$1 store=$2
    [ -n "$dir" ] || return 0

    # The rows the popup shows are a SNAPSHOT, not a live read. run_loop
    # writes lines_mode's output to "<store>.rows" once when the popup opens
    # and every reload re-marks that file instead of asking git again: the
    # picker is modal, so the tree cannot move under it, and pinning a comment
    # changes only which rows carry a marker. Without the snapshot every
    # pinned comment re-ran the whole git diff + row build -- measured on a
    # 4900-row diff with 500 comments pinned, 306ms per reload against 15ms
    # now, and the list visibly stalled between comments.
    #
    # This is also the phase-0 "review the live tree" mitigation: the rows the
    # reviewer comments on stay the rows the reviewer SAW, even if the agent
    # writes to the tree mid-review. It is not a diff cache -- there is no
    # invalidation and no staleness window past the popup, because the file
    # dies with the store that names it.
    #
    # No snapshot (a bare --rows call, or a run whose store was never opened
    # through the loop) still derives the rows from the tree, and the two
    # produce the same bytes for the same tree.
    #
    # `! -L` beside the `-s`: the write above refuses to follow a planted
    # symlink, and the read refuses to trust one independently of it. Without
    # this, someone who wins the sliver of a race between the failed write and
    # its `rm -f` gets to choose the rows the picker shows -- and every comment
    # the human then pins is anchored to a path THEY named.
    local hdr=/dev/null dlv=/dev/null
    [ -n "$store" ] && [ -f "$store" ] && hdr=$store
    [ -n "$store" ] && [ -f "${store%/*}/delivered.md" ] && dlv=${store%/*}/delivered.md
    if [ -n "$store" ] && [ ! -L "$store.rows" ] && [ -s "$store.rows" ]; then
        mark_rows "$hdr" "$dlv" "$store.rows"
    else
        mark_rows "$hdr" "$dlv" <(lines_mode "$dir")
    fi
}

# The marking itself: ONE awk over the store and the rows, no shell per row.
# What stood here read the store's headers into an associative array and then
# ran a bash loop over every row -- a by-hand tab split, an array lookup, two
# ${var/from/to} substitutions and a printf, an interpreter step apiece. On
# the 4900-row/500-comment shape that loop was ~240ms of the 306ms; the same
# work in awk is ~4ms (68ms end to end against lines_mode's own 64ms floor).
# The bash marking was never the store lookup; it was bash, the same finding
# the row build in lines_mode already made.
#
# Streams are told apart by FILENAME == ARGV[1], not by `NR == FNR`: the store
# can be EMPTY (the first time the popup opens) or non-empty (a resumed
# session), and with an empty first file `NR == FNR` is true for the SECOND
# file's first record too
# -- every row would have been read as a store header and the list would have
# come out blank. Same trap, same sidestep, as the estimate awk in lines_mode.
#
# LC_ALL=C for the same reason lines_mode sets it: every substr/length here is
# meant to be bytes, and gawk under a UTF-8 locale counts characters instead.
#
# Two properties the bash loop had to work for, kept here for free. -F"\t"
# does NOT collapse a run of tabs the way `IFS=$'\t' read` does, so an empty
# fragment (a blank added line) stays an empty field instead of shifting the
# display one column left -- reproduced once as 2 of 18 rows rendering blank.
# And a marker key is an exact string, matching what the `grep -qxF` before it
# matched: "## " is the store's own grammar, written by attach() and nothing
# else, so a substr test on the first three bytes cannot pick up a body line.
mark_rows() {                 # <store-or-/dev/null> <delivered-or-/dev/null> <rows-file>
    LC_ALL=C awk -F'\t' -v OFS='\t' '
        FILENAME == ARGV[1] { if (substr($0, 1, 3) == "## ") c[$0]++; next }
        FILENAME == ARGV[2] { if (substr($0, 1, 3) == "## ") d[$0]++; next }
        NF == 0 { next }
        {
            # A deletion carries the OLD line number prefixed "-", so the
            # marker key has to split the sign back off -- a (+) and a (-) row
            # at the same line number are two different anchors.
            sign = (substr($2, 1, 1) == "-") ? "-" : "+"
            num = $2; sub(/^-/, "", num)
            # One column wide whatever the count: ● for one, the digit past
            # that, + for anything more, ↺ for a row commented in an EARLIER
            # round (delivered, nothing pinned on it now) -- "you said this
            # last time, it is still here". A wrong digit lies, "+" does not.
            key = "## " $1 ":" num " (" sign ")"
            n = c[key] + 0
            m = (n == 0) ? ((key in d) ? "↺" : " ") : (n == 1) ? "●" : (n > 9) ? "+" : n ""
            # Prepend, never repaint: "●" and " " are both one column, so a
            # marked row does not shift against an unmarked one.
            disp = $4
            if (sign == "+") sub(/ \(\+\) /, " \033[32m(+)\033[0m ", disp)
            else             sub(/ \(-\) /,  " \033[31m(-)\033[0m ", disp)
            print $1, $2, $3, m disp, $5
        }
    ' "$1" "$2" "$3"
}

# One block, appended -- never rewrite the store, only grow it, so a crash or
# a killed popup mid-review loses at most the comment in flight, not the ones
# already pinned. Grammar is revdiff's, verbatim: "## path:line (+|-)", a
# quoted fragment, the note. A body line starting "## " gets a leading space
# so the parser (compose is a plain cat, but any future reader) can't mistake
# it for a header; "??" needs no handling at all, it passes straight through
# -- the composed header is what tells the agent it is a question.
attach() {
    local store=$1 path=$2 line=$3 fragment=$4 comment=$5 dir=${6:-}
    # No row under the cursor (an empty list, or the query cleared the match)
    # hands {1} an empty string -- without this guard that still writes
    # "## : (+)" to the store and it delivers, a comment with nothing to
    # anchor to.
    [ -n "$path" ] || return 0
    [ -n "$comment" ] || return 0
    # The cap's own "(diff too large)" row (lines_mode's cap branch) has no
    # real file or line behind it -- alt-enter on it used to write "##
    # (diff too large): (+)" to the store anyway, a comment anchored to
    # nothing that delivered as a bogus instruction. Refuse it here, same as
    # the no-row-under-cursor guard above.
    [ "$path" != "$CAP_SENTINEL" ] || return 0
    local sign num bline
    case "$line" in
        -*) sign="-"; num=${line#-} ;;
        *)  sign="+"; num=$line ;;
    esac
    # The display fragment is cut at 160 bytes for the list; the STORE gets the
    # whole line so the `>` quote matches something in the file -- a truncated
    # quote defeats the anchoring it exists for. Read it back from the tree
    # (+) or HEAD (-); fall back to the fragment on any miss.
    local full="" ft gt
    if [ -n "$dir" ]; then
        case "$sign" in
            +) full=$(sed -n "${num}p" -- "$dir/$path" 2>/dev/null) ;;
            -) full=$(git -C "$dir" show "HEAD:$path" 2>/dev/null | sed -n "${num}p") ;;
        esac
        full=${full//[$'\001'-$'\037'$'\177']/}
        full=${full:0:1000}
        # The guard: the line read back from the tree must still START with the
        # fragment fzf had under the cursor, or the file moved under the review
        # and the quote would anchor to the wrong text.
        #
        # Both sides are compared with their LEADING WHITESPACE STRIPPED, because
        # fzf strips it from a {n} field replacement before it ever reaches this
        # script: for `    return 42` the guard used to compare the indented file
        # line against the de-indented fragment, the prefix test failed, full was
        # cleared, and the store fell back to the trimmed 160-byte display
        # fragment. Every line inside a function body is indented, so the whole
        # whole-line quote was inert for real code -- measured: a 224-char
        # indented line stored a 156-char quote with its indentation gone.
        # $full itself stays UNTRIMMED: the indentation is part of the line the
        # agent has to find.
        ft=${full#"${full%%[![:space:]]*}"}
        gt=${fragment#"${fragment%%[![:space:]]*}"}
        [ -n "$full" ] && [ "${ft#"$gt"}" != "$ft" ] || full=""
    fi
    [ -n "$full" ] && fragment=$full
    {
        printf '## %s:%s (%s)\n' "$path" "$num" "$sign"
        printf '> %s\n' "$fragment"
        while IFS= read -r bline; do
            case "$bline" in
                '## '*) printf ' %s\n' "$bline" ;;
                *)      printf '%s\n' "$bline" ;;
            esac
        done <<<"$comment"
        printf '\n'
    } >> "$store"
}

# The inverse of attach() for one anchor: every record at path:line (sign)
# goes, the rest are written back byte-identical (parse is the declared
# inverse of format -- the round-trip test in tests/run.sh pins it). This
# and nothing else in the script rewrites the store; attach() appends.
detach() {                    # <store> <path> <line-with-sign>
    local store=$1 path=$2 line=$3 sign=+ num i j=0 k
    [ -n "$path" ] && [ -n "$line" ] || return 0
    [ -s "$store" ] || { tmux display-message "tmux-review: nothing pinned on this row" 2>/dev/null; return 0; }
    case "$line" in -*) sign=-; num=${line#-} ;; *) num=$line ;; esac
    # shellcheck source=lib/review-store.sh
    . "$LIBDIR/review-store.sh" || { tmux display-message "tmux-review: cannot find $LIBDIR/review-store.sh" 2>/dev/null; return 1; }
    declare -A STORE=() OUT=(); STORE_N=0
    parse_store "$store"
    # A store that fails to parse is moved aside to .bak and STORE_N comes
    # back 0 -- the [ -s "$store" ] guard above already sent a genuinely
    # empty file home, so 0 here can only mean the parse was rejected.
    # Falling through would format_store 0 records over the ORIGINAL path,
    # silently erasing it a second time (past the .bak) under execute-silent.
    [ "$STORE_N" -gt 0 ] || return 0
    for ((i = 0; i < STORE_N; i++)); do
        [ "${STORE[$i.path]}" = "$path" ] && [ "${STORE[$i.line]:-}" = "$num" ] \
            && [ "${STORE[$i.side]}" = "$sign" ] && continue
        for k in path line end side frag body; do
            [ -n "${STORE[$i.$k]+x}" ] && OUT[$j.$k]=${STORE[$i.$k]}
        done
        j=$((j + 1))
    done
    [ "$j" -lt "$STORE_N" ] || { tmux display-message "tmux-review: nothing pinned on this row" 2>/dev/null; return 0; }
    STORE=(); for k in "${!OUT[@]}"; do STORE[$k]=${OUT[$k]}; done; STORE_N=$j
    format_store "$store"
}

# Runs inside fzf's execute(): the terminal is the editor's until it exits.
# The file starts as whatever was typed so far, so ^E continues a comment
# rather than restarting it; an editor that leaves it empty pins nothing
# (attach's own rule). Under $TMPDIR, not beside the store: a killed popup
# leaves the editor's file behind, and a leftover inside the session dir
# would block its rmdir for good.
#
# The one editor chain, shared with ^S's "edit the batch": the path picker's
# @cockpit_editor first, then the environment, then vi.
editor_cmd() {
    local ed
    ed=$(tmux show-options -gqv @cockpit_editor 2>/dev/null)
    printf '%s\n' "${ed:-${VISUAL:-${EDITOR:-vi}}}"
}

# A pane id means nothing to the person reading the confirm; the agent's own
# title (claude sets it) or the window name does, with the id kept for prefix i.
pane_label() {                # <pane-id>
    local t
    t=$(tmux display-message -p -t "$1" "$AGENT_TITLE_FMT" 2>/dev/null)
    printf '%s\n' "${t:+$t }($1)"
}

edit_comment() {              # <store> <path> <line> <fragment> <query> <dir>
    local store=$1 path=$2 line=$3 fragment=$4 query=$5 dir=$6 tmp ed
    [ -n "$path" ] && [ -n "$store" ] || return 0
    # ^E on the cap row would otherwise open the editor and then discard the paragraph.
    [ "$path" != "$CAP_SENTINEL" ] || return 0
    # fzf's execute() lends stdin the tty but leaves stdout on the pipe
    # run_loop captures (resnap's rule); vi refused that pipe and ate keys.
    [ -t 0 ] && [ ! -t 1 ] && exec >/dev/tty 2>&1
    tmp=$(umask 077; mktemp "${TMPDIR:-/tmp}/cockpit-review-edit.XXXXXX") || return 0
    [ -n "$query" ] && printf '%s\n' "$query" > "$tmp"
    ed=$(editor_cmd)
    # Word-splitting on purpose: EDITOR="code --wait".
    # shellcheck disable=SC2086
    $ed "$tmp"
    attach "$store" "$path" "$line" "$fragment" "$(cat -- "$tmp")" "$dir"
    rm -f -- "$tmp"
}

# The store and the row snapshot beside it go together: the snapshot is scratch
# that belongs to ONE popup, and the session dir must not accumulate a
# 4900-row file per review. So the invariant is simply that NO
# snapshot outlives the popup that wrote it: every path that drops the store
# drops both, and the two paths that deliberately KEEP a store -- a refused
# delivery (review_pane, below) and the "could not ask about the pinned
# comments" exit -- still shed the snapshot on its own. A kept store is a
# review someone can re-deliver; a kept snapshot is a diff-sized file nothing
# downstream will ever read again, because --deliver does not know it exists.
#
# Empty store: nothing to remove. `rm -f -- "" ".rows"` would otherwise reach
# for a file actually named ".rows" in the current directory.
drop_rows() {
    [ -n "${1:-}" ] || return 0
    rm -f -- "$1.rows"
}

drop_store() {
    [ -n "${1:-}" ] || return 0
    rm -f -- "$1" "$1.rows" "$1.base"
}

# What another agent needs to discuss a change: the file as it stands, then
# the diff that got it there. Both to stdout; the bind pipes it to the clipboard.
copy_mode() {                 # <dir> [path]
    local dir=$1 path=${2:-}
    [ -n "$dir" ] || return 0
    if [ -z "$path" ]; then tree_diff "$dir"; return 0; fi
    [ "$path" != "$CAP_SENTINEL" ] || return 0
    if [ -f "$dir/$path" ]; then
        printf '### %s\n' "$path"; cat -- "$dir/$path"; printf '\n### diff %s\n' "$path"
    fi
    tree_diff "$dir" -- "$path"
}

# --- --loop ----------------------------------------------------------------
# tmux-branch's --print-query/--expect shape (tmux-branch:213-243) for the
# keys that LEAVE the picker (ctrl-s delivers, esc/^C discard); tm's
# execute-silent(...)+reload(...) (tm:187) for enter, which must NOT leave
# it -- the list mutates in place, in the same fzf session, so commenting
# five rows in a row costs one popup, not five. Enter pins a comment; it
# never approves -- there is still no accept-all, on purpose (a review whose
# only exit is one Enter on everything is the rubber stamp this exists to
# replace). With an empty query attach() itself is the no-op (it returns 0
# without writing), so no separate dead-key binding is needed. alt-enter
# stays bound to the same action, an alias for terminals that eat plain
# enter's alt chord.
run_loop() {
    local dir=$1 store=$2
    [ -n "$dir" ] || { usage; exit 2; }
    command -v fzf >/dev/null 2>&1 || {
        printf 'tmux-review: the review loop needs fzf\n' >&2; exit 1;
    }

    # The base this review diffs against: ^B's choice, remembered beside the
    # store so a resumed review keeps it; exported because --rows and --resnap
    # re-exec through fzf and inherit this environment. COCKPIT_REVIEW_BASE_REV
    # (review_base's field 1 -- the actual rev, not the mode word) rides along
    # so the preview subprocess (a separate tmux-open-path invocation, below)
    # diffs against the same base this review does, instead of always HEAD.
    local base_line label mode
    COCKPIT_REVIEW_BASE=$(cat -- "$store.base" 2>/dev/null); export COCKPIT_REVIEW_BASE
    set_base_line() {
        if git -C "$dir" --no-optional-locks rev-parse -q --verify HEAD >/dev/null 2>&1; then
            base_line=$(review_base "$dir" "${COCKPIT_REVIEW_BASE:-auto}")
            label=$(cut -f2 <<<"$base_line"); mode=$(cut -f3 <<<"$base_line")
            COCKPIT_REVIEW_BASE_REV=${base_line%%$'\t'*}
        else
            label=uncommitted; mode=uncommitted
            COCKPIT_REVIEW_BASE_REV=HEAD
        fi
        export COCKPIT_REVIEW_BASE_REV
    }
    set_base_line

    local rows_cmd attach_cmd preview_cmd resnap_cmd list_cmd detach_cmd edit_cmd copy_cmd copy_all_cmd rows_out nrows
    rows_cmd="$(shq "$SELF") --rows $(shq "$dir") $(shq "$store")"
    attach_cmd="$(shq "$SELF") --attach $(shq "$store") {1} {2} {3} {q} $(shq "$dir")"
    preview_cmd="cd $(shq "$dir") && $(shq "$OPENPATH") --preview-diff {1}"
    resnap_cmd="$(shq "$SELF") --resnap $(shq "$dir") $(shq "$store")"
    list_cmd="$(shq "$SELF") --list $(shq "$store")"
    detach_cmd="$(shq "$SELF") --detach $(shq "$store") {1} {2}"
    edit_cmd="$(shq "$SELF") --edit $(shq "$store") {1} {2} {3} {q} $(shq "$dir")"
    copy_cmd="$(shq "$SELF") --copy $(shq "$dir") {1} | tmux load-buffer -w - && tmux display-message 'tmux-review: file + diff copied'"
    copy_all_cmd="$(shq "$SELF") --copy $(shq "$dir") | tmux load-buffer -w - && tmux display-message 'tmux-review: the whole diff copied'"

    # Build the initial list ONCE and take the row count from it, rather than
    # running lines_mode a second time just to `wc -l` it: the parse (git diff
    # + the whole row build) used to run twice on every popup open. At startup
    # the store is empty, so rows_mode's marks are all blank and its count is
    # exactly what lines_mode would report. The count is only a presence test
    # now -- the split below is a percentage, so nothing here has to measure
    # the terminal.
    snapshot "$dir" "$store"
    # A resumed session (Task 2's dir found comments already pinned) says so,
    # with the count that matters: how many of them the agent has moved.
    if [ -n "$store" ] && [ -s "$store" ]; then
        local nres nstale
        nres=$(grep -c '^## ' -- "$store"); nstale=$(stale_keys "$store" "$store.rows" | grep -c '^## ')
        tmux display-message "tmux-review: resumed $nres pinned comment(s)$([ "$nstale" -gt 0 ] && printf ', %s no longer anchor (^R lists them)' "$nstale")" 2>/dev/null
    fi
    rows_out=$(rows_mode "$dir" "$store")
    nrows=$(printf '%s\n' "$rows_out" | grep -c .)
    if [ "$nrows" -eq 0 ]; then
        tmux display-message "tmux-review: no uncommitted changes" 2>/dev/null
        drop_store "$store"
        exit 0
    fi

    # --disabled: the typed text here is a comment, not a filter. Without it
    # fzf fuzzy-matches whatever you type against the displayed field, and a
    # comment that does not happen to match its own row's text empties the
    # match list -- at which point {1}/{2}/{3} have no row to resolve
    # against and execute-silent gets three empty strings. Found by tracing
    # exactly that: the row under the cursor vanished the moment the typed
    # comment stopped being a substring of the diff line.
    # Not tmux-branch's own ^U/^D for preview scroll here: this list's typed
    # text is a comment, and readline's own ^U/^D already mean something
    # inside it (kill-line, delete-char) -- so scroll moves to alt-u/alt-d
    # instead. ^/ still toggles the preview, same as everywhere else.
    # The picker runs in a LOOP now: a cancel with comments pinned asks first,
    # and "keep reviewing" has to land back in the same list rather than in
    # the caller.
    local out rc key n choice crc ndlv abr
    while :; do
        ndlv=""
        [ -n "$store" ] && [ -f "${store%/*}/delivered.md" ] && ndlv="   ↺ $(grep -c '^## ' "${store%/*}/delivered.md") delivered earlier"
        out=$(printf '%s\n' "$rows_out" \
            | fzf --print-query --expect=ctrl-s,ctrl-b,ctrl-a --disabled --ansi \
                  --delimiter=$'\t' --with-nth=4 \
                  --reverse --info=inline-right --cycle --scroll-off=2 --color=16 \
                  --bind "enter:execute-silent(${attach_cmd})+reload(${rows_cmd})+clear-query" \
                  --bind "alt-enter:execute-silent(${attach_cmd})+reload(${rows_cmd})+clear-query" \
                  --bind "ctrl-r:execute(${resnap_cmd})+reload(${rows_cmd})" \
                  --bind "ctrl-x:execute-silent(${detach_cmd})+reload(${rows_cmd})" \
                  --bind "ctrl-l:execute(${list_cmd})" \
                  --bind "ctrl-e:execute(${edit_cmd})+reload(${rows_cmd})+clear-query" \
                  --bind "ctrl-y:execute-silent(${copy_cmd})" \
                  --bind "alt-y:execute-silent(${copy_all_cmd})" \
                  --bind 'ctrl-/:toggle-preview,alt-u:preview-half-page-up,alt-d:preview-half-page-down' \
                  --preview "$preview_cmd" \
                  --preview-window="down,55%,border-top,+{5}-/2" \
                  --prompt='review> ' \
                  --header-first \
                  --header=$'↵ pin the typed comment   ^S deliver (asks first)   ^A approve   esc leave (asks first)\n^E editor  ^X delete  ^L list  ^R refresh  ^B base  ^/ preview  alt-u/alt-d scroll\n'"base: $label$ndlv")
        rc=$?

        # fzf's own exit codes (tmux-branch:228-231): 0 = an --expect key
        # fired, 1 = no match, 130 = esc/^C. Anything outside {0,1} is a
        # cancel, and a cancel must not leave a stale store some later run
        # reuses -- but it must not silently eat a pinned batch either.
        case "$rc" in
            0|1) ;;
            *)
                # A cancel with pinned comments asks; losing a twenty-comment
                # review to a reflexive esc is the cliff revdiff avoids with a
                # separate discard key. An empty store has nothing to protect,
                # so it still exits straight out.
                if [ -s "$store" ]; then
                    n=$(grep -c '^## ' "$store")
                    choice=$(printf 'leave — %d comment(s) stay pinned\nkeep reviewing\ndiscard %d comment(s)\n' "$n" "$n" \
                        | fzf --reverse --no-info --prompt='esc? ' \
                              --header="$n comment(s) are pinned and not delivered")
                    crc=$?
                    # The confirm picker's OWN exit code decides, not just what
                    # it printed. An fzf that cannot start (no tty -- the popup
                    # torn down under us, a --loop run whose terminal went away)
                    # prints nothing and exits 2, and reading only $choice sent
                    # that through the `*)` arm below, back into `while :`, to
                    # fail again: measured rc=124 under `timeout 5` and 172
                    # "inappropriate ioctl for device" lines in five seconds,
                    # one fork per turn. There is no human here to ask, so the
                    # safe answer is the one every refusal already gives --
                    # keep the store, say where it is, exit 0.
                    case "$crc" in
                        0) ;;              # a row was chosen; $choice decides
                        130) rows_out=$(rows_mode "$dir" "$store"); continue ;;   # same snapshot, re-marked
                        *)  # The popup is over, so its snapshot is scratch --
                            # but the store is a review nobody has seen the
                            # end of, so it stays and gets named.
                            drop_rows "$store"
                            tmux display-message \
                                "tmux-review: could not ask about the pinned comments$(keep_hint "" "$store")" \
                                2>/dev/null
                            exit 0 ;;
                    esac
                    case "$choice" in
                        leave*)   drop_rows "$store"; exit 0 ;;     # the dir keeps the store; prefix r resumes it
                        discard*) drop_store "$store"; exit 0 ;;
                        *)  # Back to the list, store kept. Re-mark the rows:
                            # the marks in $rows_out are from before the
                            # comments were pinned, and fzf's own reload only
                            # ever touched the list inside the session that
                            # just exited. This re-marks the SNAPSHOT taken at
                            # open, not the tree -- "keep reviewing" is the
                            # same review, so it has to be the same rows.
                            rows_out=$(rows_mode "$dir" "$store")
                            continue ;;
                    esac
                fi
                drop_store "$store"; exit 0 ;;
        esac

        # Line 1 is the typed query (--print-query); unused here because
        # --disabled already routed it into the comment via {q} inside the
        # alt-enter bind -- the outer loop only needs which --expect key fired.
        key=$(sed -n 2p <<<"$out")
        if [ "$key" = ctrl-b ]; then
            mode=$(next_base "$dir" "$mode")
            printf '%s\n' "$mode" > "$store.base"
            COCKPIT_REVIEW_BASE=$mode; export COCKPIT_REVIEW_BASE
            set_base_line
            # snapshot(), not resnap(): the base just changed, so EVERY row is
            # a fresh anchor against the new diff, not a re-mark of stale ones
            # -- and resnap()'s `read -n 1` would block here, inside the loop,
            # waiting on a key nothing prompted for. Any pinned comment that
            # no longer anchors still shows as stale the next time this store
            # is opened (run_loop's own "resumed" message), same as any other
            # base switch would leave it.
            snapshot "$dir" "$store"
            rows_out=$(rows_mode "$dir" "$store")
            [ "$(printf '%s\n' "$rows_out" | grep -c .)" -gt 0 ] || \
                tmux display-message "tmux-review: nothing to review against $label" 2>/dev/null
            continue
        fi
        if [ "$key" = ctrl-a ]; then
            if [ -s "$store" ]; then
                # Not dead work: fzf's own reload() (enter/alt-enter, inside
                # THIS session) marks its internal list live but never touches
                # $rows_out -- a comment pinned since the last computation
                # needs this refresh or the next fzf launch shows a stale,
                # unmarked list. The other two exits below genuinely change
                # nothing about the rows, so they skip it.
                tmux display-message "tmux-review: deliver or discard the $(grep -c '^## ' "$store") pinned comment(s) first" 2>/dev/null
                rows_out=$(rows_mode "$dir" "$store"); continue
            fi
            if ! git -C "$dir" --no-optional-locks rev-parse -q --verify HEAD >/dev/null 2>&1; then
                tmux display-message "tmux-review: nothing to approve against before the first commit" 2>/dev/null
                continue
            fi
            if approve "$dir"; then exit 21; fi
            abr=$(git -C "$dir" --no-optional-locks rev-parse --abbrev-ref HEAD 2>/dev/null); abr=${abr:-HEAD}
            tmux display-message "tmux-review: could not write refs/cockpit/reviewed/$abr — a stale ref may block it: git update-ref -d refs/cockpit/reviewed/$abr" 2>/dev/null
            continue
        fi
        if [ "$key" = ctrl-s ]; then
            # Once, in the same picker shape esc uses: the consent gesture
            # shows what it is about to send and to whom, and offers the whole
            # batch to $EDITOR first (a comment edited as text -- the grammar
            # is forgiving, compose is cat).
            n=$(grep -c '^## ' "$store")
            [ "$n" -gt 0 ] || { tmux display-message "tmux-review: nothing pinned" 2>/dev/null; continue; }
            local to ed e
            to="the agent"; [ -n "$REVIEW_PANE_ID" ] && to=$(pane_label "$REVIEW_PANE_ID")
            ed=$(editor_cmd); e=${ed%% *}; e=${e##*/}
            choice=$(printf 'deliver %d comment(s) to %s\nedit the batch in %s first\nkeep reviewing\n' "$n" "$to" "$e" \
                | fzf --reverse --no-info --prompt='^S? ' --header="deliver $n comment(s)?")
            case $? in 0) ;; *) rows_out=$(rows_mode "$dir" "$store"); continue ;; esac
            case "$choice" in
                deliver*) exit 20 ;;
                edit*)    # shellcheck disable=SC2086
                          $ed "$store" </dev/tty >/dev/tty 2>&1
                          rows_out=$(rows_mode "$dir" "$store"); continue ;;
                *)        rows_out=$(rows_mode "$dir" "$store"); continue ;;
            esac
        fi
        # No --expect key matched -- enter/alt-enter stay inside the picker via
        # execute-silent, so this should not happen, but an unmatched exit is a
        # discard, never a silent deliver.
        drop_store "$store"
        exit 0
    done
}

# --- --resnap ----------------------------------------------------------------
# Runs inside fzf's execute(): the terminal is ours until we return, and
# reload() re-marks the new snapshot after. Nothing stale: say nothing and
# hand the terminal straight back. Something stale: name it and wait for a
# key, because reload() will redraw over it the moment we return.
#
# fzf's execute() gives the command the real terminal on stdin (fd0 opens
# /dev/tty) but leaves stdout exactly as fzf's OWN stdout -- and run_loop
# captures fzf's whole stdout into `out=$(... | fzf ...)`, so a plain print
# to stdout here would sit in that capture, invisible until the picker
# exits. `[ -t 0 ]` tells the two calling shapes apart: fzf's execute()
# (stdin is the real tty) prints to /dev/tty instead; a direct CLI call
# (this function's other caller, always with stdin redirected -- a test's
# `</dev/null` included) keeps printing to stdout, which is what pipes it.
resnap() {                    # <dir> <store>
    local dir=$1 store=$2 stale n
    [ -n "$dir" ] && [ -n "$store" ] || { usage; exit 2; }
    snapshot "$dir" "$store"
    stale=$(stale_keys "$store" "$store.rows")
    n=$(printf '%s\n' "$stale" | grep -c '^## ')
    [ "$n" -gt 0 ] || return 0
    if [ -t 0 ]; then
        printf 'refreshed — %d comment(s) no longer anchor to a changed line (they still deliver, quoted):\n%s\n\npress any key\n' "$n" "$stale" > /dev/tty
    else
        printf 'refreshed — %d comment(s) no longer anchor to a changed line (they still deliver, quoted):\n%s\n\npress any key\n' "$n" "$stale"
    fi
    read -r -n 1 -s
    return 0
}

# --- --list ------------------------------------------------------------------
# Every pinned comment, in the terminal, until a key: the store IS the list.
# Not the preview window -- a preview(...) bind needs the window's scroll
# offset reset and put back, and the focus bind that put it back un-hid the
# preview after ^/ (measured on fzf 0.44.1). Same tty rule as resnap().
list_store() {                # <store>
    [ -t 0 ] && exec >/dev/tty
    cat -- "$1" 2>/dev/null
    printf '\n(press any key)\n'
    read -r -n 1 -s
    return 0
}

# --- --compose ---------------------------------------------------------------
# The header (ai lens §7.F: scope fence, questions first, dissent licence,
# trust the fragment, a close-out line the next review can key on), then the
# store verbatim -- cat, nothing clever.
compose() {
    local store=${1:-} root=${2:-}
    printf 'Code review of your changes, from the human, batched on purpose.\n\n'
    printf 'Scope: change only what these comments ask for. Do not refactor, rename,\ntidy or commit anything else — a fix that grows the diff defeats the review.\n'
    printf 'Questions first: a comment containing ?? is a question. Answer every question\nin chat before you edit anything, then make the edits in one pass.\n'
    printf 'Disagree out loud: if a comment is wrong or would break something, say so and\ndo not make the change. Silent compliance with a wrong comment is the worse\nfailure.\n'
    printf 'Anchors: comments are path:line with the original line quoted. The numbers are\nfrom the diff as it was when the review was written and drift after your first\nedit — trust the quoted fragment, not the number.\n'
    # root is the repo root a comment's path is relative to -- optional
    # (omitted, --compose still reads standalone), named here because
    # deliver() has it and the agent otherwise has no way to tell.
    [ -n "$root" ] && printf 'Paths are relative to %s.\n' "$root"
    printf 'When done, end your reply with one line per comment:\n  <path>:<line> — done | skipped: <reason>\n\n'
    [ -n "$store" ] && [ -f "$store" ] && cat -- "$store"
    return 0
}

# --- --deliver -------------------------------------------------------------
# Land the composed review typed-but-unsent in the agent's own pane -- one
# bracketed paste, never an Enter. Live-verified on a private tmux 3.7c
# server (pane running `exec -a claude bash`): load-buffer + `paste-buffer -p
# -r -d` puts the whole multi-line payload into bash's readline buffer,
# UNEXECUTED -- visible across every capture-pane as the same still-open
# prompt line, no "command not found", no fresh prompt underneath. Tested
# with AND without `-r`, with AND without `extended-keys-format csi-u` (the
# #43169 mitigation this flag targets), and with AND without a trailing
# newline on the payload: all five combinations behaved identically and
# safely on this stack. -r ships anyway per the brief -- LF, never CR, is the
# documented-safe shape even where this local stack did not need it.
#
# Guards run in order, each a refusal via display-message (2>/dev/null: no
# attached client is not this call's problem to fail loudly over) rather
# than a paste:
#   1. pane id shape (agent-state:13-16) -- tmux prefix-matches -t against
#      session names too, so a stray non-%N argument could resolve onto
#      someone else's pane entirely.
#   2. pane_current_command against @cockpit_agents_glob (cockpit.tmux's own
#      #{m:*|cmd|*,glob} shape, reused verbatim from tmux-jump/tm) -- a shell
#      pane would EXECUTE review text instead of merely displaying it.
#   3. (no longer a refusal) a pane that is running or on a permission
#      prompt gets the review QUEUED: the composed text is spooled beside
#      the store and @cockpit_review_spool names it; review-gate hands it
#      over at the agent's next Stop. Nothing is ever pasted into a dialog.
#   4. store non-empty -- nothing pinned means nothing to deliver.
#
# Every refusal names the store. review_pane() deletes it only when delivery
# SUCCEEDS, so after a refusal the pinned batch is still on disk -- and it is
# the only copy of the review. A refusal that did not say so was
# indistinguishable from one that ate it.
keep_hint() {
    local pane=$1 store=$2
    [ -n "$store" ] && [ -s "$store" ] || return 0
    # run_loop giving up has no pane in hand -- it was handed a dir and a store
    # and nothing else -- so the id becomes a visible placeholder rather than a
    # silently missing argument in a command the reader would paste as-is.
    [ -n "$pane" ] || pane='<pane>'

    # $SELF, not a bare "tmux-review": the name is only on $PATH after
    # install.sh symlinks it, and from a plugin-only install the suggested
    # command has to be copy-pasteable as printed.
    printf '; comments kept at %s — deliver later with: %s --deliver %s %s && %s --done %s' \
        "$store" "$(shq "$SELF")" "$pane" "$(shq "$store")" "$(shq "$SELF")" "$(shq "$store")"
}

deliver() {
    local pane=$1 store=$2 root=$3

    case "$pane" in
        %[0-9]*) ;;
        *) tmux display-message \
               "tmux-review: not a pane id, refusing to deliver$(keep_hint "$pane" "$store")" \
               2>/dev/null; return 1 ;;
    esac

    local is_agent
    is_agent=$(tmux display-message -p -t "$pane" \
        '#{?#{m:*|#{pane_current_command}|*,#{@cockpit_agents_glob}},1,0}' \
        2>/dev/null)
    [ "$is_agent" = 1 ] || {
        tmux display-message \
            "tmux-review: $pane is not an agent pane, refusing to deliver$(keep_hint "$pane" "$store")" \
            2>/dev/null
        return 1
    }

    [ -n "$store" ] && [ -s "$store" ] || {
        tmux display-message "tmux-review: nothing to deliver" 2>/dev/null
        return 1
    }

    local payload bytes
    payload=$("$SELF" --compose "$store" "$root")

    # The spool: the composed review as a file, born 0600 beside the store. On
    # the paste path it is the Stop hook's copy if the pane turns out busy at
    # paste time; on the hook path it is the whole delivery (review-gate hands the
    # file's text to the agent as Stop hook feedback, and the harness saves any
    # output past 10,000 characters to a file with a preview and the path, so the
    # 2048-byte pointer below is paste-only).
    local spool="$store.deliver"
    if ! (umask 077; [ ! -L "$spool" ] && printf '%s' "$payload" > "$spool"); then
        tmux display-message \
            "tmux-review: could not write the review spool, refusing to deliver$(keep_hint "$pane" "$store")" \
            2>/dev/null
        return 1
    fi

    bytes=$(printf '%s' "$payload" | wc -c)

    # Over 2048 bytes: the review becomes a file the agent reads, not a wall
    # of text typed into its prompt. mktemp, not a predictable
    # tmux-cockpit-review-<pane>.md name -- a fixed name under a shared
    # tmpdir (the COMMON case on macOS, which has no XDG_RUNTIME_DIR) is a
    # symlink-disclosure vector, and mktemp's own randomized suffix makes the
    # name unguessable rather than merely unlinked-and-recreated. `umask 077`
    # in the same subshell that runs mktemp means the file is BORN 0600 --
    # no create-then-chmod window for a racing reader. Template ends in the
    # X run with no trailing .md: BSD/macOS mktemp requires the X's to be
    # the LAST characters of the template and errors ("too few X's") on
    # anything after them, unlike GNU's more permissive "keep a literal
    # suffix after the trailing X run" -- the pointer sentence below already
    # names the exact path, so the extension carried no weight anyway. The
    # agent deletes nothing -- the file outlives the pane on purpose; the OS
    # tmpdir is the only GC.
    if [ "$bytes" -gt 2048 ]; then
        local runtime file
        runtime=${XDG_RUNTIME_DIR:-/tmp}
        file=$(umask 077 && mktemp "$runtime/tmux-cockpit-review-${pane#%}-XXXXXX") || {
            tmux display-message \
                "tmux-review: could not create the review file, refusing to deliver$(keep_hint "$pane" "$store")" \
                2>/dev/null
            return 1
        }
        printf '%s' "$payload" > "$file"
        payload="Read and address every comment in $file — a code review from the human; ?? comments are questions."
    fi

    # A per-invocation buffer name: tmux buffers are SERVER-GLOBAL, so a
    # fixed name races under concurrent deliveries -- a second delivery's
    # load-buffer can overwrite the first's payload before the first's
    # paste-buffer -d has run, landing the wrong review in the wrong pane (or
    # pasting nothing once the buffer was already deleted out from under
    # it). pane + $$ gives every invocation its own buffer.
    local bufname
    bufname="cockpit-review-${pane#%}-$$"
    if ! printf '%s' "$payload" | tmux load-buffer -b "$bufname" -; then
        tmux display-message \
            "tmux-review: could not stage the review, refusing to deliver" \
            2>/dev/null
        return 1
    fi
    # The is-agent test the shell ran up top is a ~50ms-stale snapshot: a
    # compose re-exec, a wc, an mktemp, a spool write and this load-buffer all
    # sit between it and the paste. Kill the agent in that window -- a `claude`
    # foreground child exits and the pane's own shell is back -- and the old
    # unconditional `paste-buffer` landed the review in that shell (the hunt
    # reproduced it 6/6, pasting a live, one-Enter-from-running command line
    # the reviewer never targeted). So the check is redone HERE, by tmux
    # itself, in the same command-queue item as the paste: `if-shell -F -t
    # <pane>` re-evaluates the SAME #{m:...} test -- AND whether @panestate is
    # running or needs-input, which has the identical staleness window: a
    # permission prompt (or a tool starting to run) can come up in it -- against
    # the pane at paste time, and only pastes if it is still an idle agent;
    # otherwise it takes the queued branch below instead of the paste. The
    # window is closed -- there is no shell round-trip left between the test
    # and the paste. The early check up top stays as the cheap fast-fail for a
    # pane that is already not an agent.
    #
    # Both arms consume $bufname themselves -- the idle arm's `paste-buffer -d`,
    # the busy arm's `delete-buffer` -- because if-shell's nested command has
    # already run by the time this CLI call returns (same command-queue item,
    # no -b job behind it), so the buffer's survival is only possible if tmux
    # never ran either arm at all (the pane vanished between load-buffer and
    # if-shell). The post-if-shell check below exists for that gap, not to
    # distinguish paste from queue -- both arms are exit-0 successes and both
    # report themselves via their own display-message.

    # Where the review landed, named the way a human navigates: "work:2 api"
    # beats a bare %7 when the pane is three windows away. Read once, HERE,
    # against the TARGET pane: the notice's own display-message carries no -t
    # (it must not steal focus or fail when the pane is gone by then), so a
    # #{window_name} left in the message would resolve against whatever pane
    # the reader happens to be sitting in -- the wrong window's name.
    #
    # The window name is USER DATA and gets two escapes, because it crosses two
    # parsers on its way into the notice:
    #
    #   1. tmux's command-string parser. $where is interpolated into a
    #      single-quoted argument of the if-shell command string, so a window
    #      named don't closes that quote early and hands tmux the remainder as
    #      commands. Single quotes are stripped; nothing else breaks out.
    #   2. tmux's FORMAT parser. display-message expands its message as a
    #      format, so a window named w#{@some_option} renders that option's
    #      VALUE, not the name -- measured on 3.7c: a window renamed
    #      w##{@cockpit_secret} made the notice read "wLEAKED-SECRETz". ## is
    #      the format literal for #, so doubling every # is the whole fix, and
    #      it works on the 3.3 floor. (3.7c runs no #(shell-command) job from a
    #      display-message -- only status formats do -- but doubling covers
    #      that arm too, whatever a later tmux decides to run.)
    #
    # The READ above is safe on its own: a value substituted by #{window_name}
    # is not re-expanded, so only this second interpolation needs the escape.
    local where
    where=$(tmux display-message -p -t "$pane" \
        '#{session_name}:#{window_index} #{window_name}' 2>/dev/null)
    where=${where//\'/}
    where=${where//#/##}
    [ -n "$where" ] || where="the agent pane"   # display-message failed; still read as a sentence

    # Armed FIRST, disarmed by the idle arm below: the busy/idle choice is made
    # by tmux inside one command-queue item, and arming ahead of it means the
    # spool is never armed on a pane that just took the paste, and never
    # missing on one that did not. A pane that stopped being an agent inside
    # the ~50ms window keeps a harmless armed option that dies with it --
    # review-gate only ever runs from an agent's own hook.
    tmux set-option -p -t "$pane" @cockpit_review_spool "$spool" 2>/dev/null

    tmux if-shell -F -t "$pane" \
        "#{&&:#{m:*|#{pane_current_command}|*,#{@cockpit_agents_glob}},#{&&:#{!=:#{@panestate},running},#{!=:#{@panestate},needs-input}}}" \
        "set-option -pu -t $pane @cockpit_review_spool ; set-option -p -t $pane @cockpit_review sent ; paste-buffer -p -r -d -b $bufname -t $pane ; display-message -d 0 'review pasted into $where ($pane) — press Enter there to send; prefix J walks there'" \
        "delete-buffer -b $bufname ; display-message -d 0 'review queued for $where ($pane) — it lands when the agent next stops'"

    # The idle arm disarms the option as it pastes, so an empty option here
    # means the paste happened and nobody will ever read this spool -- the
    # queued arm is the only one that leaves it armed. Without this every
    # pasted review left a .deliver file behind in the session dir, and
    # done_store's rmdir then found the dir non-empty and left that too.
    [ -n "$(tmux show-option -pqv -t "$pane" @cockpit_review_spool 2>/dev/null)" ] || rm -f -- "$spool"

    if tmux list-buffers -F '#{buffer_name}' 2>/dev/null | grep -qxF "$bufname"; then
        tmux delete-buffer -b "$bufname" 2>/dev/null
        return 1
    fi
    return 0
}

# --- --fleet / entry-point resolution --------------------------------------
# Which of the fleet needs your eyes: every agent pane, every session, that is
# either blocked or dirty -- landscape-gap #1, nothing else answers this. Rows
# are pane\t[◆|↵ ]state\ttitle\trepo⑂branch\t±stat.
#
# The order is the whole point, and it is NOT churn. A pane parked on a
# permission prompt is the one that actually needs a human, and it usually has
# nothing at all to diff -- churn-first ordering listed it last, or (with a
# clean tree) not at all, and answered "who typed most" instead of "who needs
# me". So @panestate ranks first -- needs-input, done, error, running, then
# unset -- and churn only breaks ties inside a rank. A needs-input pane is
# listed even with a clean tree; its ± column reads —, not "+0 -0", because
# there is nothing to review there, only someone to unblock.
#
# The is-agent test is tmux's own #{m:*|cmd|*,glob} conditional (deliver()'s
# guard, cockpit.tmux's window formats) run once per pane inside list-panes,
# not a second shell per pane to re-ask; the title falls back from pane_title
# to the window name the same way @catppuccin_window_text already does
# (examples/tmux.conf:42) -- #{host_short} is what an UNSET pane_title reads
# as, not empty.
fleet_rows() {
    # One -F argument, built in a variable: continuation lines each starting
    # a fresh quoted string are separate WORDS to tmux, not one concatenated
    # format -- list-panes then sees four positional arguments and refuses
    # them ("too many arguments"). Reproduced live before this fix.
    local fmt raw
    fmt='#{?#{m:*|#{pane_current_command}|*,#{@cockpit_agents_glob}},1,0}'$'\t'
    fmt="${fmt}"'#{pane_id}'$'\t'
    # NOT a bare #{@panestate}: tab is an IFS *whitespace* character, so
    # `read` with IFS=$'\t' collapses a RUN of tabs into one delimiter -- an
    # unset @panestate emitted \t\t, the field vanished, and every field after
    # it shifted left (path came out empty and the pane was dropped from the
    # queue entirely). Measured against a pane with no state set. The same
    # trap, with spaces, is why tmux-jump:21 places its own guard. A sentinel
    # keeps the field non-empty on the wire; it is turned back into "unset"
    # the moment it has been read.
    fmt="${fmt}"'#{?#{@panestate},#{@panestate},-}'$'\t'
    # Same sentinel, same reason: @cockpit_review is unset on most panes.
    fmt="${fmt}"'#{?#{@cockpit_review},#{@cockpit_review},-}'$'\t'
    fmt="${fmt}"'#{session_name}:#{window_index} '"$AGENT_TITLE_FMT"$'\t'
    fmt="${fmt}"'#{pane_current_path}'
    raw=$(tmux list-panes -a -F "$fmt" 2>/dev/null)
    [ -n "$raw" ] || return 0

    # Every pane's git status+numstat used to run SERIALLY, one pane fully
    # finished before the next started -- ~2 git calls/pane. On a cold
    # filesystem (150ms/git, the hunt's measured figure) 100 panes blanked the
    # popup for ~32s, on every prefix+r from a non-agent pane. The panes are
    # independent of each other, so run their git work concurrently instead,
    # capped at $cap in flight at once -- unbounded would fork hundreds of git
    # processes at once on a big fleet, trading one kind of slowness for
    # another.
    local tmpdir
    tmpdir=$(mktemp -d) || return 0
    local TREE_DIFF_TMP=$tmpdir      # tree_diff's index copies live here too

    # --- Phase 1: one pane list, one root each -------------------------------
    # Two agent panes cd'd into the same worktree (a subdirectory, or the
    # exact same path) are still two rows, but they have no business costing
    # two status+numstat scans -- so the repo root is resolved for every pane
    # FIRST, in its own background rev-parse (parallel, same cap as the scan
    # below), before any status call runs. rev-parse --show-toplevel takes no
    # lock; it is the status/diff calls after it that do, and those are what
    # phase 2 below dedups.
    local isagent id state review title path n=0 cap=${COCKPIT_FLEET_PARALLEL:-8}
    local -a pids=() pane_id=() pane_state=() pane_review=() pane_title=() pane_root=()
    while IFS=$'\t' read -r isagent id state review title path; do
        [ "$isagent" = 1 ] || continue
        [ -n "$path" ] || continue
        [ "$state" = - ] && state=   # the wire sentinel above, back to unset
        [ "$review" = - ] && review=
        n=$((n + 1))
        pane_id[n]=$id; pane_state[n]=$state; pane_review[n]=$review; pane_title[n]=$title
        git -C "$path" --no-optional-locks rev-parse --show-toplevel \
            > "$tmpdir/root-$n" 2>/dev/null &
        pids+=("$!")
        if [ ${#pids[@]} -ge "$cap" ]; then
            wait "${pids[0]}" 2>/dev/null
            pids=("${pids[@]:1}")
        fi
    done <<<"$raw"
    wait 2>/dev/null
    [ "$n" -gt 0 ] || { rm -rf "$tmpdir"; return 0; }

    # Group panes by their resolved root. A pane whose cwd was not inside a
    # git repo at all resolves to an empty root; every such pane's git calls
    # fail the exact same way regardless of WHICH non-repo path it sits in
    # (nothing to diff against), so they all share one sentinel group instead
    # of each earning its own doomed scan.
    local -A root_idx=()
    local -a uniq_roots=()
    local i root key ri=0
    for ((i = 1; i <= n; i++)); do
        root=$(cat "$tmpdir/root-$i" 2>/dev/null)
        pane_root[i]=$root
        key=${root:-@@none@@}
        if [ -z "${root_idx[$key]+x}" ]; then
            ri=$((ri + 1))
            root_idx[$key]=$ri
            uniq_roots[ri]=$root
        fi
    done

    # --- Phase 2: one status+numstat scan per UNIQUE root --------------------
    pids=()
    for ((i = 1; i <= ri; i++)); do
        fleet_scan_root "${uniq_roots[i]}" > "$tmpdir/scan-$i" &
        pids+=("$!")
        if [ ${#pids[@]} -ge "$cap" ]; then
            wait "${pids[0]}" 2>/dev/null
            pids=("${pids[@]:1}")
        fi
    done
    wait 2>/dev/null

    # --- Phase 3: fan each pane's row back out of its group's scan -----------
    # No git call left here -- just the per-pane state/title/rank the shared
    # scan does not know, joined against the one result its group produced.
    local -a rows=()
    local dirty repo branch stat churn rank line glyph
    for ((i = 1; i <= n; i++)); do
        id=${pane_id[i]}; state=${pane_state[i]}; title=${pane_title[i]}
        key=${pane_root[i]:-@@none@@}
        IFS=$'\t' read -r dirty repo branch stat churn < "$tmpdir/scan-${root_idx[$key]}"
        # A blocked pane earns its row on state alone -- that is the case a
        # dirty-only filter dropped, and it is the most urgent one there is.
        [ "$dirty" = 1 ] || [ "$state" = needs-input ] || continue

        case "$state" in
            needs-input) rank=0 ;;
            done)        rank=1 ;;
            error)       rank=2 ;;
            running)     rank=3 ;;
            *)           rank=4 ;;
        esac
        # The review mark rides the state column: ◆ the gate flagged a finished
        # diff nobody has read, ↵ a review is sitting pasted-but-unsent in the
        # pane. Without it the queue sends you back to a pane you just reviewed.
        case "${pane_review[i]}" in pending) glyph='◆ ' ;; sent) glyph='↵ ' ;; *) glyph='' ;; esac
        rows+=("$(printf '%s\t%s\t%s\t%s\t%s\t%s\t%s' \
            "$rank" "$churn" "$id" "$glyph${state:-—}" "$title" "${repo:-?}⑂${branch:-?}" "$stat")")
    done
    # The OS tmpdir is the only GC here, same call as deliver()'s mktemp --
    # a killed popup takes its children with it, but not necessarily this rm.
    rm -rf "$tmpdir"
    [ ${#rows[@]} -gt 0 ] || return 0

    # Rank ascending, then churn descending inside the rank: who needs me
    # first, and among equals the one with the most to look at.
    for line in "${rows[@]}"; do printf '%s\n' "$line"; done \
        | sort -t "$(printf '\t')" -k1,1n -k2,2nr | cut -f3-
}

# One repo root's git state -- factored out of fleet_rows() so it can run in
# its own background subshell, ONCE per unique root (see the parallel phase-2
# dispatch above), not once per pane. Churn comes from tree_diff, the one base
# --lines reviews from, so a fully staged change still gets a real churn
# number instead of reading as 0. Prints dirty\trepo\tbranch\tstat\tchurn; an
# empty root (no pane in this group sits inside a git repo) short-circuits
# with no git call at all -- the result is path-independent already, so there
# is nothing to look up.
fleet_scan_root() {
    local root=$1
    local numstat add del untracked churn stat dirty=0 repo branch a d gd

    if [ -z "$root" ]; then
        # "?" on the wire, never an empty field: phase 3 joins this row back
        # with `IFS=$'\t' read`, tab is an IFS *whitespace* character, and a
        # RUN of tabs collapses into one delimiter there. Emitting repo and
        # branch empty shifted every field left, so a blocked agent outside a
        # repo rendered "—⑂" + churn with a blank ± column instead of "?⑂?"
        # and "—". Same trap, same sentinel, as the #{@panestate} guard in
        # fleet_rows' pane format above.
        printf '0\t?\t?\t—\t0\n'
        return 0
    fi
    # Two agents on two worktrees of the same repo are indistinguishable from
    # "s:w claude" alone; the row has to say WHICH tree it is. $root IS the
    # rev-parse --show-toplevel result already (fleet_rows resolved it to do
    # the grouping), so naming the repo costs no second call.
    repo=${root##*/}
    # The branch straight off the HEAD ref file, the way `git branch
    # --show-current` reads it, instead of a rev-parse fork per root: "ref:
    # refs/heads/<name>", or a bare sha when detached. A linked worktree's
    # .git is a file naming the dir that holds its own HEAD.
    gd=$root/.git
    if [ ! -d "$gd" ]; then
        read -r gd < "$gd" 2>/dev/null || gd=
        gd=${gd#gitdir: }; case "$gd" in ''|/*) ;; *) gd=$root/$gd ;; esac
    fi
    read -r branch < "$gd/HEAD" 2>/dev/null || branch=
    case "$branch" in 'ref: refs/heads/'*) branch=${branch#ref: refs/heads/} ;; *) branch=HEAD ;; esac

    # One diff per root, and that is every git this row needs beyond the
    # copy: `git status` here was a second walk of the tree for the "?N new"
    # count alone, and its `??` was the wrong count anyway once the base can
    # be a checkpoint -- a file untracked at ^A and untouched since is not
    # new to this review. --summary's "create mode" lines are the files new
    # AGAINST THE BASE, which is what the rest of the stat already measures.
    # tree_diff's --no-optional-locks is why reading a live worktree is safe.
    numstat=$(tree_diff "$root" --numstat --summary)
    if [ -n "$numstat" ]; then
        dirty=1
        add=0; del=0; untracked=0
        while IFS=$'\t' read -r a d _f; do
            case "$a" in ' create mode '*) untracked=$((untracked + 1)); continue ;; esac
            [ -n "$a" ] || continue
            case "$a" in *[!0-9]*) a=0 ;; esac
            case "$d" in *[!0-9]*) d=0 ;; esac
            add=$(( add + a )); del=$(( del + d ))
        done <<<"$numstat"
        stat="+$add -$del"
        [ "$untracked" -gt 0 ] && stat="$stat  ?$untracked new"
        churn=$(( add + del ))
    else
        # Nothing to review, only someone to unblock. "+0 -0" would read as a
        # measurement; — reads as "not applicable", which it is.
        stat='—'; churn=0
    fi

    printf '%s\t%s\t%s\t%s\t%s\n' "$dirty" "${repo:-?}" "${branch:-?}" "$stat" "$churn"
}

# --- entry-point resolution -------------------------------------------------
# review_pane() drives the interactive loop against one pane: a session-dir
# store (session_dir(), below), the interactive --loop re-exec'd (not called
# as a function -- it ends in a script `exit`, and this needs its own exit
# code back rather than the whole process dying), ctrl-s (rc 20) handed to
# --deliver via `tmux run-shell -b` -- a popup kills its own children the
# moment it closes (tmux-open-path:381-386), so delivery has to outlive that
# teardown, not run inside it.

# --- the session dir ---------------------------------------------------------
# One review is one directory the popup does not own. `store=$(mktemp)` kept
# the only copy of a review in a file whose name nothing recorded, and a
# dropped SSH client -- which tears down a client-owned display-popup --
# took it along. Keyed on pane + repo root so reopening the same pane finds
# its own comments; 0700 because it holds the whole uncommitted diff. Removed
# when the review is discarded or delivered; kept, and named, when delivery
# is refused. `rm -rf ~/.local/state/tmux-cockpit/review` is the purge.
session_dir() {               # <pane-id> <root>
    printf '%s/tmux-cockpit/review/%s-%s' "${XDG_STATE_HOME:-$HOME/.local/state}" \
        "${1#%}" "$(printf '%s' "$2" | cksum | cut -d' ' -f1)"
}

review_pane() {
    local pane=$1 dir=$2 store rc
    local sess cleanup
    sess=$(session_dir "$pane" "$dir"); store="$sess/comments.md"
    # umask in the subshell: mkdir -p creates the parents at the caller's
    # umask otherwise, and the store is born 0600 the same way.
    # [ ! -L ]: the same discipline snapshot() uses on "$2.rows" -- a store
    # path is derivable (session_dir() is a pane id and a root's cksum), so a
    # planted symlink must be refused here too, not just followed.
    (umask 077; mkdir -p -- "$sess" && [ ! -L "$store" ] && : >> "$store") || {
        tmux display-message "tmux-review: could not create $sess" 2>/dev/null
        return 1
    }
    REVIEW_PANE_ID=$pane "$SELF" --loop "$dir" "$store"
    rc=$?
    if [ "$rc" -eq 20 ]; then
        # deliver() is a public subcommand the suite re-delivers the same
        # store through, so it must not rm its own store arg -- the cleanup
        # belongs to this caller, chained after delivery so the store still
        # outlives the popup's own teardown (comment above).
        #
        # The STORE is removed only on success: --deliver refuses (needs-input,
        # a non-agent pane, a bogus id) AFTER the popup is gone, and an
        # unconditional rm threw the whole pinned batch away on every one of
        # those -- the store is the only copy of the review, and the human
        # never even saw it happen. A refused store is left on disk on purpose;
        # deliver()'s message names it and the command that re-delivers it.
        #
        # The SNAPSHOT is removed either way -- it served the popup, and the
        # popup is already gone. The DIR follows the store: removed once it is
        # empty (a successful delivery), left standing -- named -- when the
        # store itself is kept.
        #
        # run-shell hands this to `sh -c`, so the exit code is stashed in $rc
        # and tested with a plain `if`; the `\$` keep both out of the reach of
        # the bash expansion that is building the string. Every path is still
        # shq-quoted.
        cleanup="rc=\$?; if [ \$rc -eq 0 ]; then $(shq "$SELF") --done $(shq "$store"); else rm -f -- $(shq "$store.rows"); fi"
        tmux run-shell -b "$(shq "$SELF") --deliver $(shq "$pane") $(shq "$store") $(shq "$dir"); $cleanup"
    elif [ "$rc" -eq 21 ]; then
        # Approved: the ref is written (run_loop did it, in the popup); the
        # pane's attention state and the review dir end here -- by NAME, not
        # rm -rf. A review already delivered to a busy pane is in flight in
        # comments.md.deliver with @cockpit_review_spool armed at it, and ^A is
        # allowed then (the pinned-comments guard sees an empty store), so the
        # recursive remove took the queued review, dangled the option at a path
        # that no longer existed, and took delivered.md with it. An armed spool
        # keeps the dir standing; review-gate's own rmdir finishes it after the
        # drain.
        tmux set-option -pu -t "$pane" @cockpit_review 2>/dev/null
        "$(dirname "$SELF")/agent-state" recount "$pane"
        clear_sess "$sess"
        tmux display-message "review approved — the next one shows only what changes from here" 2>/dev/null
    else
        rmdir -- "$sess" 2>/dev/null   # empty after a discard; a kept store keeps it
    fi
}

# --- --request: the agent asks ----------------------------------------------
# The blocking path (ai lens §7.C, revdiff's contract): run from the agent's
# own Bash tool by the cockpit-review skill, this opens ONE popup on the pane,
# waits for the human, and hands the batch back as stdout + exit 10 -- the
# tool result -- instead of a paste. Nothing else changes: the same session
# dir, the same loop, ^A and esc mean what they always mean.
#
# What comes back is decided by the LOOP's exit code, not by the store: esc
# now offers "leave" (the human said "not now"), which keeps the batch pinned
# and non-empty, and only ^S (rc 20) is a delivery. display-popup does not
# return the command's status -- it returns tmux's own -- so the popup command
# records it in <sess>/rc and this reads it back. A dropped launcher (the tool
# timed out) leaves the popup, the store and the rc file alone; running it
# again resumes the pinned comments, so the recovery is "run it again".
request() {                   # <pane>
    local pane=$1 dir root sess store pw ph rc
    case "$pane" in %[0-9]*) ;; *) usage; exit 2 ;; esac
    if [ "$(tmux display-message -p -t "$pane" '#{session_attached}' 2>/dev/null)" = 0 ]; then
        printf 'tmux-review: no client is attached to %s'"'"'s session — nowhere to open the review\n' "$pane" >&2
        exit 1
    fi
    dir=$(tmux display-message -p -t "$pane" '#{pane_current_path}' 2>/dev/null)
    [ -n "$dir" ] || { printf 'tmux-review: pane %s is gone\n' "$pane" >&2; exit 1; }
    root=$(git_root "$dir"); sess=$(session_dir "$pane" "$root"); store="$sess/comments.md"
    (umask 077; mkdir -p -- "$sess" && [ ! -L "$store" ] && : >> "$store") || {
        printf 'tmux-review: could not create %s\n' "$sess" >&2; exit 1; }
    pw=$(tmux show-option -gqv @cockpit_popup_width);  pw=${pw:-70%}
    ph=$(tmux show-option -gqv @cockpit_popup_height); ph=${ph:-70%}
    # A killed launcher leaves its popup running, and that popup still writes
    # its rc when the human closes it -- so clear the file BEFORE opening this
    # one: an rc read here must belong to the popup this call just waited on.
    rm -f -- "$sess/rc"
    # -E: this returns when the loop exits. display-popup runs the string
    # through sh, so the escaped \$? is the LOOP's code, not tmux's.
    tmux display-popup -E -t "$pane" -w "$pw" -h "$ph" -T ' review · requested ' \
        "REVIEW_PANE_ID=$(shq "$pane") $(shq "$SELF") --loop $(shq "$root") $(shq "$store"); echo \$? > $(shq "$sess/rc")" 2>/dev/null
    rc=$(cat -- "$sess/rc" 2>/dev/null); rm -f -- "$sess/rc"
    case "$rc" in
        20) [ -s "$store" ] || exit 0          # deliver with nothing pinned cannot happen; belt and braces
            # The agent has the review in hand the moment this returns, so the
            # pane carries the same "sent" the paste path sets on delivery.
            tmux set-option -p -t "$pane" @cockpit_review sent 2>/dev/null
            compose "$store" "$root"; done_store "$store"; exit 10 ;;
        21) # ^A: same clean-up review_pane does — the ref is written by the loop,
            # and clear_sess leaves an in-flight comments.md.deliver alone.
            tmux set-option -pu -t "$pane" @cockpit_review 2>/dev/null
            "$(dirname "$SELF")/agent-state" recount "$pane"
            clear_sess "$sess"
            exit 0 ;;
        *)  # leave / discard / a dropped popup: the store stays as the loop
            # left it. The rmdir is review_pane's own -- it takes the dir a
            # discard emptied and is a no-op while `leave` keeps the store.
            rmdir -- "$sess" 2>/dev/null
            exit 0 ;;
    esac
}

# --- --info: one screen for prefix i -------------------------------------------
# What the plugin knows about one pane, in the order you ask it: who, what it
# waits on, the review state, the base, the session, the review dir. Read in
# ONE display-message, split on a US byte (agent-state's idiom -- tab would
# collapse the empty fields that mean "unset").
info_mode() {                 # <pane>
    local pane=$1 sep=$'\037' f id where cmd path state msg review spool sid title root sess b n1 n2
    f=$(tmux display-message -p -t "$pane" \
        '#{pane_id}'"$sep"'#{session_name}:#{window_index} #{window_name}'"$sep"'#{pane_current_command}'"$sep"'#{pane_current_path}'"$sep"'#{@panestate}'"$sep"'#{@panestate_msg}'"$sep"'#{@cockpit_review}'"$sep"'#{@cockpit_review_spool}'"$sep"'#{@cockpit_session}'"$sep"'#{@cockpit_title}' 2>/dev/null)
    id=${f%%"$sep"*};     f=${f#*"$sep"}
    # display-message does NOT fail on a pane id that does not exist -- it
    # expands every format to the empty string and exits 0 (measured on 3.7c),
    # and without this the screen below described the CALLER's own cwd
    # (git_root "" is the caller's repo) as if it were that pane's. The
    # resolved id, not the exit code, is what says the pane was found.
    [ -n "$id" ] || { printf 'tmux-review: no such pane %s\n' "$pane" >&2; return 1; }
    where=${f%%"$sep"*};  f=${f#*"$sep"}
    cmd=${f%%"$sep"*};    f=${f#*"$sep"}
    path=${f%%"$sep"*};   f=${f#*"$sep"}
    state=${f%%"$sep"*};  f=${f#*"$sep"}
    msg=${f%%"$sep"*};    f=${f#*"$sep"}
    review=${f%%"$sep"*}; f=${f#*"$sep"}
    spool=${f%%"$sep"*};  f=${f#*"$sep"}
    sid=${f%%"$sep"*};    title=${f#*"$sep"}
    printf 'pane      %s  %s  (%s)\n' "$id" "$where" "$cmd"
    printf 'cwd       %s\n' "$path"
    printf 'state     %s%s\n' "${state:-—}" "${msg:+  · $msg}"
    printf 'review    %s%s\n' "${review:-—}" "${spool:+  · queued: $spool}"
    root=$(git_root "$path"); sess=$(session_dir "$id" "$root")
    if git -C "$root" --no-optional-locks rev-parse -q --verify HEAD >/dev/null 2>&1; then
        # The mode ^B chose for THIS review, as run_loop reads it -- passed as
        # the argument review_base actually keys on, not exported (nothing this
        # function calls reads COCKPIT_REVIEW_BASE from the environment).
        b=$(review_base "$root" "$(cat -- "$sess/comments.md.base" 2>/dev/null)")
        printf 'base      %s  (%s)\n' "$(cut -f2 <<<"$b")" "$(cut -f1 <<<"$b")"
    fi
    printf 'session   %s\n' "${sid:-—}"
    printf 'title     %s\n' "${title:-—}"
    if [ -d "$sess" ]; then
        n1=$(grep -c '^## ' -- "$sess/comments.md" 2>/dev/null); n2=$(grep -c '^## ' -- "$sess/delivered.md" 2>/dev/null)
        printf 'review dir %s\n           %s pinned · %s delivered · ^A removes it\n' "$sess" "${n1:-0}" "${n2:-0}"
    fi
    printf '\n↵ to close\n'
}

# Pad one field to a fixed COLUMN width. bash's printf pads %-*s by BYTES,
# while ${#s} counts characters -- so a field holding ⑂ or — (3 bytes each)
# came out short and dragged every column to its right with it. Measuring the
# characters first, then widening the printf field by the byte overhead, makes
# printf's own padding land where the eye expects it.
pad_field() {                 # <width> <string>
    local w=$1 c=${#2}
    local LC_ALL=C            # from here ${#2} is bytes, which is what printf counts
    printf '%-*s' "$(( w + ${#2} - c ))" "$2"
}

kill_window() {               # <pane>  the row's window, after a y/N in the popup
    local pane=$1 where nwin npane ans
    case $pane in %[0-9]*) ;; *) return 0 ;; esac
    # #{?pane_id,...}: a pane gone since the list was built reads ": ", not empty.
    where=$(tmux display-message -p -t "$pane" '#{?pane_id,#{session_windows} #{window_panes} #{session_name}:#{window_index} #{window_name},}' 2>/dev/null)
    [ -n "$where" ] || { tmux display-message "tmux-review: pane $pane is gone" 2>/dev/null; return 0; }
    nwin=${where%% *}; where=${where#* }; npane=${where%% *}; where=${where#* }
    if [ "$nwin" = 1 ]; then printf 'kill session %s (last window' "${where%%:*}"
    else printf 'kill window %s' "$where"; fi
    [ "$npane" -gt 1 ] 2>/dev/null && printf ', %s panes' "$npane"
    if [ "$nwin" = 1 ]; then printf ')? [y/N] '; else printf '? [y/N] '; fi
    IFS= read -r -n1 ans || ans=
    printf '\n'
    case "$ans" in y|Y) tmux kill-window -t "$pane" 2>/dev/null ;; esac
}


# The fzf queue over fleet_rows(). Unlike the review loop this filters as you
# type -- it is a pane list, not comment entry, so --disabled has no place
# here. Rows carry pane, state, title, repo⑂branch and stat; the preview
# re-asks tmux for the pane's cwd by id rather than smuggling a sixth hidden
# field, so `--fleet`'s output stays exactly that interface.
#
# The four visible fields are padded to their own column widths before fzf
# sees them: ragged single-space columns made the ± numbers impossible to
# compare down the list, which is most of what this list is FOR.
#
# The queue LOOPS (§8 #3): finishing one review re-lists the fleet with the
# pane you just left under the pointer, so reviewing four agents is four ↵
# instead of four prefix+r. esc on the list is the only way out -- a review's
# own exit code (deliver, approve, discard, leave) says nothing about whether
# you are done with the fleet.
fleet_queue() {               # [preselect-pane]
    command -v fzf >/dev/null 2>&1 || {
        tmux display-message "tmux-review: the fleet queue needs fzf" 2>/dev/null
        return 1
    }
    local pre=${1:-}
    while :; do
        local rows
        rows=$(fleet_rows)
        if [ -z "$rows" ]; then
            tmux display-message "tmux-review: no agent pane is blocked or has uncommitted changes" 2>/dev/null
            return 0
        fi

        # Column widths, capped: one 200-character pane title should not push
        # repo⑂branch and the ± count off the right edge for every other row.
        # A field over its cap simply overflows its column instead of being
        # truncated -- losing the end of a title is worse than one ragged row.
        local f_pane f_state f_title f_loc f_stat
        local w_state=0 w_title=0 w_loc=0
        while IFS=$'\t' read -r f_pane f_state f_title f_loc f_stat; do
            [ -n "$f_pane" ] || continue
            [ "${#f_state}" -gt "$w_state" ] && w_state=${#f_state}
            [ "${#f_title}" -gt "$w_title" ] && w_title=${#f_title}
            [ "${#f_loc}"   -gt "$w_loc"   ] && w_loc=${#f_loc}
        done <<<"$rows"
        [ "$w_state" -gt 12 ] && w_state=12
        [ "$w_title" -gt 40 ] && w_title=40
        [ "$w_loc"   -gt 32 ] && w_loc=32

        local -a disp=()
        while IFS=$'\t' read -r f_pane f_state f_title f_loc f_stat; do
            [ -n "$f_pane" ] || continue
            disp+=("$f_pane"$'\t'"$(pad_field "$w_state" "$f_state")"$'\t'"$(pad_field "$w_title" "$f_title")"$'\t'"$(pad_field "$w_loc" "$f_loc")"$'\t'"$f_stat")
        done <<<"$rows"
        [ ${#disp[@]} -gt 0 ] || return 0

        local nrows avail lrows psz preview_cmd out pane dir
        nrows=${#disp[@]}
        avail=$(tput lines 2>/dev/null || echo 24)
        lrows=$nrows; [ "$lrows" -gt 8 ] && lrows=8
        # 6, not 5: this header is two lines now -- one line of it is 95 columns
        # and the popup is 70% of the terminal, so fzf truncated the key hints off
        # the right edge on anything narrower than 136 columns. Reserve the second
        # row rather than taking it out of the list.
        psz=$(( avail - lrows - 6 ))
        [ "$psz" -lt 5 ] && psz=5

        # The pointer starts on $pre's row -- the pane prefix+r was pressed in,
        # then whichever pane the last review was of. Without it the pointer
        # sits on whatever the SORT put first, and the one pane you actually
        # asked for is one you have to hunt for. --sync is what makes the bind
        # land: without it fzf runs `start` before the list is loaded and the
        # move is silently lost. pos() is 1-based over the input order.
        # A pane that is not in the queue at all (nothing to review there)
        # leaves pos at 0 and the list unmoved.
        local pos=0 i
        local -a presel=()
        for i in "${!disp[@]}"; do [ "${disp[$i]%%$'\t'*}" = "$pre" ] && { pos=$(( i + 1 )); break; }; done
        [ "$pos" -gt 0 ] && presel=(--sync --bind "start:pos($pos)")

        # Same root-vs-cwd seam as review_pane: the row only carries the pane's
        # raw cwd, so resolve it to the repo root here too before handing it to
        # --preview-diff, which expects a real, existing path.
        preview_cmd="pdir=\$(tmux display-message -p -t {1} '#{pane_current_path}' 2>/dev/null); "
        preview_cmd="${preview_cmd}proot=\$(git -C \"\$pdir\" rev-parse --show-toplevel 2>/dev/null); "
        preview_cmd="${preview_cmd}$(shq "$OPENPATH") --preview-diff \"\${proot:-\$pdir}\""

        # @cockpit_fleet_fzf_options is a GLOBAL tmux option -- it can only have
        # been written by the owner's own tmux.conf, so `eval`ing it is eval of
        # their config, not of anything an agent pane can reach. It is confined to
        # this navigation picker on purpose: in the review loop ↵ has a contract
        # (pin a comment, never approve) and ^S is the consent gesture, and one
        # stray --bind from a config would quietly break either of them.
        local -a extra=()
        local opt; opt=$(tmux show-option -gqv @cockpit_fleet_fzf_options 2>/dev/null)
        [ -n "$opt" ] && eval "extra=($opt)"

        out=$(printf '%s\n' "${disp[@]}" \
            | fzf --delimiter=$'\t' --with-nth=2,3,4,5 \
                  --reverse --info=inline-right --cycle --scroll-off=2 --color=16 \
                  --bind 'ctrl-/:toggle-preview,ctrl-u:preview-half-page-up,ctrl-d:preview-half-page-down' \
                  --expect=ctrl-x \
                  --preview "$preview_cmd" \
                  --preview-window="down,$psz,border-top" \
                  --prompt='fleet> ' \
                  --header=$'which agent needs you   [◆ review pending · ↵ pasted, unsent]  state · title · repo⑂branch · ±\n↵ review   ^/ preview   ^X kill window   esc cancel' \
                  ${presel[@]+"${presel[@]}"} \
                  ${extra[@]+"${extra[@]}"})
        [ -n "$out" ] || return 0

        # --expect: the key line first (empty for ↵), then the row -- or no
        # row at all when the key was pressed on an empty filter.
        local key=${out%%$'\n'*} sel=${out#*$'\n'}
        [ "$sel" != "$out" ] || continue
        pane=${sel%%$'\t'*}
        [ -n "$pane" ] || return 0
        if [ "$key" = ctrl-x ]; then
            kill_window "$pane"
            pre=$pane
            continue
        fi
        dir=$(tmux display-message -p -t "$pane" '#{pane_current_path}' 2>/dev/null)
        if [ -z "$dir" ]; then
            tmux display-message "tmux-review: pane $pane is gone" 2>/dev/null
            continue
        fi
        review_pane "$pane" "$(git_root "$dir")"
        pre=$pane
    done
}

# No args, bound to prefix R: ask tmux which pane the CLIENT is actually on --
# not $TMUX_PANE, which inside this popup names the popup's own pseudo-pane,
# not the pane you pressed the key from. Bare `display-message -p` (no -t)
# has no client of its own to resolve from inside a popup -- it falls back to
# whichever attached client was most recently active, which can be a
# DIFFERENT session than the one the popup was opened from (reproduced with
# two real attached clients: the busier one wins, not the opener). REVIEW_PANE_ID
# -- this script's own -p, parsed below, mirroring tmux-branch's -p
# (tmux-branch:38-53) -- pins the query to the actual pane the popup came
# from when the caller has it; without it this falls back to the old
# best-effort client-recency resolution.
main_entry() {
    local pane is_agent
    if [ -n "$REVIEW_PANE_ID" ]; then
        pane=$REVIEW_PANE_ID
    else
        pane=$(tmux display-message -p '#{pane_id}' 2>/dev/null)
    fi
    if [ -z "$pane" ]; then
        printf 'tmux-review: no tmux client to resolve a pane from\n' >&2
        exit 1
    fi
    is_agent=$(tmux display-message -p -t "$pane" \
        '#{?#{m:*|#{pane_current_command}|*,#{@cockpit_agents_glob}},1,0}' 2>/dev/null)
    # Always the queue (§8 #3): the other blocked agents stay visible, and the
    # pane the key was pressed in is preselected so one ↵ reviews it.
    if [ "$is_agent" = 1 ]; then fleet_queue "$pane"; else fleet_queue; fi
}

# -p pane_id, parsed here so the dispatch below sees only the subcommand --
# mirrors tmux-branch's own -c/-p loop (tmux-branch:25-33); tmux-review only
# needs -p (main_entry's click-binding pin), not -c. Default, not reset: an
# unconditional `REVIEW_PANE_ID=""` here would clobber the value review_pane()
# exports around its own `--loop` re-invocation (the ^S picker's label) before
# -p ever gets a chance to override it.
: "${REVIEW_PANE_ID:=}"
while [ $# -gt 0 ]; do
    case "$1" in
        -p) REVIEW_PANE_ID="${2:-}"; shift 2 || break ;;
        *)  break ;;
    esac
done

case "${1:-}" in
    --fleet)
        fleet_rows ;;
    --lines)
        shift; lines_mode "${1:-}" ;;
    --rows)
        shift; rows_mode "${1:-}" "${2:-}" ;;
    --attach)
        shift; attach "${1:-}" "${2:-}" "${3:-}" "${4:-}" "${5:-}" "${6:-}" ;;
    --detach)
        shift; detach "${1:-}" "${2:-}" "${3:-}" ;;
    --copy)
        shift; copy_mode "${1:-}" "${2:-}" ;;
    --edit)
        shift; edit_comment "${1:-}" "${2:-}" "${3:-}" "${4:-}" "${5:-}" "${6:-}" ;;
    --loop)
        shift; run_loop "${1:-}" "${2:-}" ;;
    --resnap)
        shift; resnap "${1:-}" "${2:-}" ;;
    --list)
        shift; list_store "${1:-}" ;;
    --compose)
        shift; compose "${1:-}" "${2:-}" ;;
    --deliver)
        shift; deliver "${1:-}" "${2:-}" "${3:-}" ;;
    --done)
        shift; done_store "${1:-}" ;;
    --delta)
        shift; delta_mode "${1:-}" ;;
    --request)
        shift; request "${1:-}" ;;
    --info)
        info_mode "${REVIEW_PANE_ID:-}" ;;
    -h|--help)
        usage; exit 0 ;;
    "")
        main_entry ;;
    *)
        printf 'unknown option: %s (try: tmux-review -h)\n' "$1" >&2; exit 2 ;;
esac
