#!/usr/bin/env bash
# tmux-review — review an agent's uncommitted diff, one comment at a time, and
# hand the finished review back to the agent's pane.
#   tmux-review [-p pane_id]               no args: review the given pane, or
#                                          (without -p) the CLIENT's active
#                                          pane, if it is an agent, else the
#                                          fleet queue (bound to prefix R)
#   tmux-review --fleet                    the fleet queue's rows, no fzf
#   tmux-review --lines <dir>              the diff rows a review anchors to
#   tmux-review --loop <dir> <store>       the interactive picker (needs fzf);
#                                          ctrl-s exits 20 (deliver), esc/^C
#                                          exit 0 (discard, store deleted --
#                                          asked for first if any are pinned)
#   tmux-review --compose <store>          the composed review, ready to deliver
#   tmux-review --deliver <pane> <store>   one bracketed paste, typed-but-unsent
#
# --lines and --compose touch no tmux.
set -uo pipefail

# bash 4+ (4.4 for `mapfile -d` in tmux-where). Without this the 3.2 failure is
# silent and wrong rather than loud: `declare -A` errors, then the same
# assignment quietly creates an INDEXED array with an arithmetic subscript.
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
    printf '%s needs bash 4 or newer (found %s). On macOS: brew install bash\n' \
           "${BASH_SOURCE[0]##*/}" "${BASH_VERSION:-unknown}" >&2
    exit 1
fi

# Resolved once, not `$0`: a symlink from install.sh (or a PATH lookup) must
# still find its sibling tmux-open-path and re-invoke itself for --rows/--attach
# (fzf's reload/execute-silent binds run in a fresh subshell of their own).
SELF="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
OPENPATH="$(dirname "$SELF")/tmux-open-path"

# tmux runs bind/preview strings through sh, so every path inside one has to be
# shell-quoted -- the same reasoning as tmux-open-path's shq.
shq() { printf '%q' "$1"; }

# lines_mode's own "diff too large" row (below) is not a real anchor -- no
# file, no line -- so it shares this one string with attach(), which refuses
# to comment on it. A row-shaped notice, not a special case in every reader.
CAP_SENTINEL='(diff too large)'

# `git -C <dir> diff` always emits paths relative to the repo ROOT, no matter
# how deep <dir> sits inside the tree -- but <dir> is the pane's own cwd, so
# from an agent working in a subdirectory those root-relative paths do not
# resolve against <dir> itself. Resolve once, at each entry point, and thread
# the root through everywhere a diff-row path gets turned back into a file:
# lines_mode (for consistency, even though git already normalizes this), the
# review-loop's preview `cd`, and the fleet queue's preview. Falls back to
# the caller's own dir when it is not a git worktree at all, so the existing
# "no diff" behavior for a non-repo pane is unchanged.
git_root() {
    local dir=$1 root
    root=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)
    printf '%s\n' "${root:-$dir}"
}

usage() {
    cat >&2 <<'USAGE'
tmux-review — review an agent's uncommitted diff, one comment at a time.
  tmux-review [-p pane_id]                review that pane (or, without -p,
                                          the client's active pane), or the
                                          fleet queue when it is not an agent
  tmux-review --fleet                    the fleet queue's rows, no fzf
  tmux-review --lines <dir>              the diff rows a review anchors to
  tmux-review --loop <dir> <store>       the interactive picker (needs fzf)
  tmux-review --compose <store>          the composed review, ready to deliver
  tmux-review --deliver <pane> <store>   paste it typed-but-unsent into <pane>
In the picker: ↵ pin the typed comment on the row under the cursor   ^S deliver   esc discard
(there is no accept-all: ↵ with nothing typed does nothing)
USAGE
}

# --- the base every uncommitted view diffs against --------------------------
# Everything uncommitted is ONE set: `git diff HEAD` is staged + unstaged in a
# single call. The old "unstaged, else staged" fallback dropped the whole
# index the moment one unstaged edit existed -- reproduced: a staged file was
# invisible to the list while the preview showed it. An unborn HEAD (no
# commits yet) has no HEAD to diff against, so that case keeps the fallback.
tree_diff() {
    local dir=$1; shift
    if git -C "$dir" rev-parse -q --verify HEAD >/dev/null 2>&1; then
        git -C "$dir" -c core.quotePath=false diff --no-color --no-ext-diff HEAD "$@" 2>/dev/null
    else
        local out
        out=$(git -C "$dir" -c core.quotePath=false diff --no-color --no-ext-diff "$@" 2>/dev/null)
        [ -n "$out" ] || out=$(git -C "$dir" -c core.quotePath=false diff --no-color --no-ext-diff --cached "$@" 2>/dev/null)
        printf '%s\n' "$out"
    fi
}

# --- --lines -------------------------------------------------------------
# Every +/- hunk line of the working tree's diff, one tab-separated row per
# line: path, line, fragment, display. `line` anchors a `+` (or context-side)
# row to the NEW file; a deletion has no line in the new file, so its row
# carries the OLD line number instead, prefixed "-" -- the same (+)/(-) split
# the compose grammar uses for its headers.
#
# Everything uncommitted is ONE set -- staged, unstaged and brand-new files --
# because that is what "review what I have not committed" means. See tree_diff
# below for the base, and the untracked synthesis inside for the new files.
lines_mode() {
    local dir=$1
    [ -n "$dir" ] || return 0

    # core.quotePath=false: with git's default (true) a path holding any
    # non-ASCII byte comes out C-quoted and octal-escaped -- `--- "a/caf\303\251.txt"`
    # -- and the header match below (/^--- a\//, /^\+\+\+ b\//) needs a bare
    # `a/`/`b/`, so a quoted header matched neither. The file's every row was
    # then attributed to the PREVIOUS file (or dropped, if it was first): the
    # agent got told to edit café's lines in alpha.txt. Turning quoting off
    # makes the path literal in both the diff headers and numstat, so the two
    # stay keyed on the same name. (A path with a literal tab/quote is still
    # git-quoted even here -- the residual narrow case; non-ASCII is the common
    # one and is fixed.)
    local diff numstat
    diff=$(tree_diff "$dir")
    numstat=$(tree_diff "$dir" --numstat)

    # Untracked files carry no diff at all -- so the newest code, the code most
    # worth reviewing, was invisible. Synthesise their numstat here (every line
    # an addition) so the size cap below counts them too, and their rows after
    # the awk. Binary and unreadable files are skipped (grep -Iq fails on both).
    #
    # core.quotePath=false here for the same reason it is on the diff above, and
    # it bites harder: ls-files C-quotes a non-ASCII name ("caf\303\251-new.txt"),
    # and a quoted name is not a path that exists, so [ -f ] failed and the file
    # was dropped from the list without a word -- while --preview-diff, which
    # asks with the flag set, rendered it. List and preview disagreed again.
    # One call, both loops below read it.
    local untracked u ulines
    untracked=$(git -C "$dir" -c core.quotePath=false ls-files --others --exclude-standard 2>/dev/null)
    while IFS= read -r u; do
        [ -n "$u" ] && [ -f "$dir/$u" ] && grep -Iq . -- "$dir/$u" 2>/dev/null || continue
        ulines=$(wc -l < "$dir/$u")
        numstat="${numstat:+$numstat$'\n'}$ulines"$'\t'"0"$'\t'"$u"
    done <<<"$untracked"
    [ -n "$diff$untracked" ] || return 0

    # A giant single-file diff -- a regenerated lockfile, a vendored bundle, a
    # minified asset -- would feed the per-row parse below tens of thousands of
    # rows. The review popup is MODAL and runs lines_mode at startup and on
    # every reload, so that parse locked the one client for minutes to hours
    # (measured: a 100k-row single-file diff did not finish in 5 minutes, while
    # the git diff and the awk themselves cost ~0.03s -- the shell row-build is
    # the whole cost). numstat's own add+del columns already total the exact
    # number of +/- rows this function emits, at the one cheap git call made
    # just above -- so count first and, past a cap, emit a single notice
    # instead of parsing at all. The popup then always appears at once and esc
    # still cancels it. 5000 is well past any diff a human reads line-by-line
    # yet far below where the parse is felt.
    local cap=5000 total=0 nadd ndel nfile
    while IFS=$'\t' read -r nadd ndel nfile; do
        [ -n "$nfile" ] || continue
        case "$nadd" in *[!0-9]*) nadd=0 ;; esac
        case "$ndel" in *[!0-9]*) ndel=0 ;; esac
        total=$(( total + nadd + ndel ))
    done <<<"$numstat"
    if [ "$total" -gt "$cap" ]; then
        local big="diff too large to anchor line-by-line ($total changed lines) — review it directly"
        printf '%s\t%s\t%s\t%s\n' "$CAP_SENTINEL" 0 "$big" "$big"
        return 0
    fi

    # One pass: track the file a hunk belongs to (from the +++/--- header
    # pair -- a whole-file deletion has "+++ /dev/null", so the path has to
    # come from the "--- a/" side instead), the hunk's starting old/new line
    # from "@@ -o,c +o,c @@" (not a capture-group regex -- portable to
    # non-GNU awk), and a running counter per side. Context lines advance both
    # counters and emit nothing; a +/- line emits a row and advances its own
    # side.
    #
    # The -o,c and +o,c tokens are POSITIONAL -- always fields 2 and 3 of the
    # header -- and have to be taken that way, not found by scanning every
    # token for a leading -/+. git appends a funcname context after the
    # closing "@@" ("@@ -2,7 +2,7 @@ fn compute() -> i32 {"), and a scan
    # keeps clobbering oldtok/newtok on any later token that starts with -
    # or + too -- "-> i32" matched and silently became the anchor.
    # Reproduced: a deletion at old line 5 was anchored to -3 instead.
    #
    # Header lines ("--- a/x", "+++ b/x", "@@ ...") exist only BETWEEN hunks,
    # never inside one -- but a body line whose own text starts "-- " or
    # "++ " becomes, once diff prepends its own -/+ marker, "--- ..." or
    # "+++ ..." and a plain /^--- /-style match can't tell the two apart.
    # "@@" needs no such guard: a body line can only ever start "@@" if diff
    # gave it a bare literal first, which it never does. So --- / +++ are
    # only trusted as headers while the hunk's own line budget (oldrem/newrem,
    # from the "@@ -o,c +o,c @@" counts) is exhausted; while budget remains,
    # every line is content, dispatched on its leading character alone, same
    # as any other +/-/context row. Reproduced: an unstaged "-- a sql
    # comment" deletion vanished and every anchor after it drifted; an added
    # "++ ..." line reset the counters and threw every later anchor off too.
    local raw
    raw=$(printf '%s\n' "$diff" | awk '
        function inhunk() { return (oldrem > 0 || newrem > 0) }
        {
            if (inhunk()) {
                c = substr($0, 1, 1)
                if (c == "+") {
                    if (file != "") {
                        printf "%s\t%d\t+\t%s\n", file, newl, substr($0, 2)
                        newl++
                    }
                    newrem--
                } else if (c == "-") {
                    if (file != "") {
                        printf "%s\t%d\t-\t%s\n", file, oldl, substr($0, 2)
                        oldl++
                    }
                    oldrem--
                } else if (c == " ") {
                    oldl++; newl++; oldrem--; newrem--
                }
                # anything else ("\ No newline at end of file") stays ignored
                next
            }
            if ($0 ~ /^--- /) {
                if ($0 ~ /^--- a\//) oldfile = substr($0, 7)
                next
            }
            if ($0 ~ /^\+\+\+ /) {
                if ($0 ~ /^\+\+\+ b\//) file = substr($0, 7); else file = oldfile
                oldl = 0; newl = 0; next
            }
            if ($0 ~ /^@@/) {
                split($0, parts, " ")
                oldtok = parts[2]; newtok = parts[3]
                sub(/^-/, "", oldtok); split(oldtok, oa, ","); oldl = oa[1] + 0
                oldrem = (oa[2] == "" ? 1 : oa[2] + 0)
                sub(/^\+/, "", newtok); split(newtok, na, ","); newl = na[1] + 0
                newrem = (na[2] == "" ? 1 : na[2] + 0)
                next
            }
        }
    ')

    # The untracked files' rows: no diff to parse, so every line of the file is
    # its own + row at its own number -- the same shape the awk emits.
    while IFS= read -r u; do
        [ -n "$u" ] && [ -f "$dir/$u" ] && grep -Iq . -- "$dir/$u" 2>/dev/null || continue
        # The file arrives on stdin, not as an operand: mawk rejects a `--`
        # before a filename ("cannot open --"), and without one a name holding
        # an `=` would be read as an awk variable assignment instead of a file.
        raw="${raw:+$raw$'\n'}$(awk -v f="$u" '{ printf "%s\t%d\t+\t%s\n", f, NR, $0 }' < "$dir/$u")"
    done <<<"$untracked"
    [ -n "$raw" ] || return 0

    # Churn per file (additions + deletions), the risk proxy that orders
    # everything but the test-file partition. "-" for a binary file's counts
    # under --numstat; not a number, so it does not add any weight.
    local -A churn=()
    local add del fpath
    while IFS=$'\t' read -r add del fpath; do
        [ -n "$fpath" ] || continue
        case "$add" in *[!0-9]*) add=0 ;; esac
        case "$del" in *[!0-9]*) del=0 ;; esac
        churn["$fpath"]=$(( add + del ))
    done <<<"$numstat"

    # tests/*, *_test.*, *.test.* are all substrings of the plain *test*
    # glob, so one pattern covers the whole family (a second, narrower
    # pattern after *test* would just be dead code shellcheck refuses to
    # accept as reachable).
    is_test_file() {
        case "$1" in
            *test*) return 0 ;;
            *) return 1 ;;
        esac
    }

    # Group rows by file, in first-seen order, so a file's own hunks stay in
    # their original (line-ascending) order once the file groups themselves
    # are reordered below. Rows land in ONE indexed array with each file's
    # contiguous [start,end] index range recorded -- git diff never interleaves
    # two files, so a file's rows are always a single run. The earlier shape
    # here was `group[path]+=<row>` into one associative-array element, which
    # bash rebuilds the whole growing string on every append: O(n^2) for a
    # single-file diff (measured 2000 rows 4.77s, 8000 rows 55.9s). The append
    # to an indexed array is amortised O(1). And `disp` is built with `printf
    # -v` rather than `disp=$(printf ...)`, which forked a subshell PER ROW.
    local -A seen=() gstart=() gend=()
    local -a order=() allrows=()
    local path line sign rest frag mline disp ri=0
    while IFS=$'\t' read -r path line sign rest; do
        [ -n "${seen[$path]:-}" ] || { seen[$path]=1; order+=("$path"); gstart["$path"]=$ri; }
        # Control-char strip + cap, the agent-state:82-86 discipline: this
        # text reaches an fzf display column and a comment-store header next.
        frag=${rest//[$'\001'-$'\037'$'\177']/}
        frag=${frag:0:160}
        if [ "$sign" = "-" ]; then mline="-$line"; else mline="$line"; fi
        printf -v disp '%s:%s (%s)  %s' "$path" "$line" "$sign" "$frag"
        allrows[ri]="$path"$'\t'"$mline"$'\t'"$frag"$'\t'"$disp"
        gend["$path"]=$ri
        ri=$((ri + 1))
    done <<<"$raw"

    # Partition into test-first / rest, each ordered by churn descending; ties
    # keep first-seen order via the index tiebreak (sort -k1,1n on ties of -k2).
    local -a tests=() others=()
    local idx=0
    for path in "${order[@]}"; do
        if is_test_file "$path"; then tests+=("$idx"$'\t'"${churn[$path]:-0}"$'\t'"$path")
        else others+=("$idx"$'\t'"${churn[$path]:-0}"$'\t'"$path")
        fi
        idx=$((idx + 1))
    done

    order_group() { sort -t "$(printf '\t')" -k2,2nr -k1,1n | cut -f3; }

    local f j
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        for (( j=${gstart[$f]}; j<=${gend[$f]}; j++ )); do printf '%s\n' "${allrows[j]}"; done
    done < <(printf '%s\n' "${tests[@]}" | order_group)
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        for (( j=${gstart[$f]}; j<=${gend[$f]}; j++ )); do printf '%s\n' "${allrows[j]}"; done
    done < <(printf '%s\n' "${others[@]}" | order_group)
}

# --- --rows / --attach (internal: the picker's own reentry, tmux-open-path's
# --preview/--pick convention) --------------------------------------------
# --lines rows, marked: a leading "●" on any row whose path:line already has
# a comment block in the store, a space on every other row -- same column
# width either way, so nothing shifts. This is the marker-column trick at
# tmux-open-path:176-183, applied to a display FIELD instead of a preview
# line: prepend, never repaint. Its own subcommand (not inline in run_loop)
# because fzf's reload() re-execs a fresh command; there is nothing else to
# call back into.
rows_mode() {
    local dir=$1 store=$2
    [ -n "$dir" ] || return 0

    # The store's "## path:line (sign)" headers, read ONCE into a set, so the
    # per-row marker test is an associative-array lookup instead of a fresh
    # `grep -qxF` over the whole store PER ROW. On a 2000-row diff that grep
    # fired 2000 times per reload, and the picker reloads after every pinned
    # comment -- the whole list re-marked from scratch each time. A header line
    # is the store's own grammar (attach() writes exactly "## ..."), so an
    # exact-string key matches what grep -qxF matched.
    local -A commented=()
    if [ -n "$store" ] && [ -f "$store" ]; then
        local hdr
        while IFS= read -r hdr; do
            case "$hdr" in '## '*) commented["$hdr"]=1 ;; esac
        done < "$store"
    fi

    # Tab is IFS whitespace, so `IFS=$'\t' read` COLLAPSES a run of tabs -- an
    # empty fragment (a blank added line) shifted the display into field 3 and
    # the marker became the whole row. Reproduced: 2 of 18 rows rendered blank.
    # Split by hand instead; an empty field stays an empty field.
    local row rest path line fragment display sign num marker
    while IFS= read -r row; do
        [ -n "$row" ] || continue
        path=${row%%$'\t'*};     rest=${row#*$'\t'}
        line=${rest%%$'\t'*};    rest=${rest#*$'\t'}
        fragment=${rest%%$'\t'*}; display=${rest#*$'\t'}
        case "$line" in
            -*) sign="-"; num=${line#-} ;;
            *)  sign="+"; num=$line ;;
        esac
        marker=" "
        [ -n "${commented["## ${path}:${num} (${sign})"]:-}" ] && marker="●"
        case "$sign" in
            +) display=${display/ (+) / $'\e[32m'(+)$'\e[0m' } ;;
            -) display=${display/ (-) / $'\e[31m'(-)$'\e[0m' } ;;
        esac
        printf '%s\t%s\t%s\t%s%s\n' "$path" "$line" "$fragment" "$marker" "$display"
    done < <(lines_mode "$dir")
}

# One block, appended -- never rewrite the store, only grow it, so a crash or
# a killed popup mid-review loses at most the comment in flight, not the ones
# already pinned. Grammar is revdiff's, verbatim: "## path:line (+|-)", a
# quoted fragment, the note. A body line starting "## " gets a leading space
# so the parser (compose is a plain cat, but any future reader) can't mistake
# it for a header; "??" needs no handling at all, it passes straight through
# -- the composed header is what tells the agent it is a question.
attach() {
    local store=$1 path=$2 line=$3 fragment=$4 comment=$5 dir=${6:-}
    # No row under the cursor (an empty list, or the query cleared the match)
    # hands {1} an empty string -- without this guard that still writes
    # "## : (+)" to the store and it delivers, a comment with nothing to
    # anchor to.
    [ -n "$path" ] || return 0
    [ -n "$comment" ] || return 0
    # The cap's own "(diff too large)" row (lines_mode's cap branch) has no
    # real file or line behind it -- alt-enter on it used to write "##
    # (diff too large): (+)" to the store anyway, a comment anchored to
    # nothing that delivered as a bogus instruction. Refuse it here, same as
    # the no-row-under-cursor guard above.
    [ "$path" != "$CAP_SENTINEL" ] || return 0
    local sign num bline
    case "$line" in
        -*) sign="-"; num=${line#-} ;;
        *)  sign="+"; num=$line ;;
    esac
    # The display fragment is cut at 160 bytes for the list; the STORE gets the
    # whole line so the `>` quote matches something in the file -- a truncated
    # quote defeats the anchoring it exists for. Read it back from the tree
    # (+) or HEAD (-); fall back to the fragment on any miss.
    local full=""
    if [ -n "$dir" ]; then
        case "$sign" in
            +) full=$(sed -n "${num}p" -- "$dir/$path" 2>/dev/null) ;;
            -) full=$(git -C "$dir" show "HEAD:$path" 2>/dev/null | sed -n "${num}p") ;;
        esac
        full=${full//[$'\001'-$'\037'$'\177']/}
        full=${full:0:1000}
        [ -n "$full" ] && [ "${full#"$fragment"}" != "$full" ] || full=""
    fi
    [ -n "$full" ] && fragment=$full
    {
        printf '## %s:%s (%s)\n' "$path" "$num" "$sign"
        printf '> %s\n' "$fragment"
        while IFS= read -r bline; do
            case "$bline" in
                '## '*) printf ' %s\n' "$bline" ;;
                *)      printf '%s\n' "$bline" ;;
            esac
        done <<<"$comment"
        printf '\n'
    } >> "$store"
}

# --- --loop ----------------------------------------------------------------
# tmux-branch's --print-query/--expect shape (tmux-branch:213-243) for the
# keys that LEAVE the picker (ctrl-s delivers, esc/^C discard); tm's
# execute-silent(...)+reload(...) (tm:187) for enter, which must NOT leave
# it -- the list mutates in place, in the same fzf session, so commenting
# five rows in a row costs one popup, not five. Enter pins a comment; it
# never approves -- there is still no accept-all, on purpose (a review whose
# only exit is one Enter on everything is the rubber stamp this exists to
# replace). With an empty query attach() itself is the no-op (it returns 0
# without writing), so no separate dead-key binding is needed. alt-enter
# stays bound to the same action, an alias for terminals that eat plain
# enter's alt chord.
run_loop() {
    local dir=$1 store=$2
    [ -n "$dir" ] || { usage; exit 2; }
    command -v fzf >/dev/null 2>&1 || {
        printf 'tmux-review: the review loop needs fzf\n' >&2; exit 1;
    }

    local rows_cmd attach_cmd preview_cmd rows_out nrows avail lrows psz
    rows_cmd="$(shq "$SELF") --rows $(shq "$dir") $(shq "$store")"
    attach_cmd="$(shq "$SELF") --attach $(shq "$store") {1} {2} {3} {q} $(shq "$dir")"
    preview_cmd="cd $(shq "$dir") && $(shq "$OPENPATH") --preview-diff {1}"

    # Build the initial list ONCE and take the row count from it, rather than
    # running lines_mode a second time just to `wc -l` it: the parse (git diff
    # + the whole row build) used to run twice on every popup open. At startup
    # the store is empty, so rows_mode's marks are all blank and its count is
    # exactly what lines_mode would report. Preview sizing then follows
    # tmux-branch:202-205 -- a fixed split either hid rows in a short popup or
    # starved the preview in a tall one.
    rows_out=$(rows_mode "$dir" "$store")
    nrows=$(printf '%s\n' "$rows_out" | grep -c .)
    if [ "$nrows" -eq 0 ]; then
        tmux display-message "tmux-review: no uncommitted changes" 2>/dev/null
        rm -f -- "$store"
        exit 0
    fi
    avail=$(tput lines 2>/dev/null || echo 24)
    lrows=$nrows; [ "$lrows" -gt 8 ] && lrows=8
    psz=$(( avail - lrows - 5 ))
    [ "$psz" -lt 5 ] && psz=5

    # --disabled: the typed text here is a comment, not a filter. Without it
    # fzf fuzzy-matches whatever you type against the displayed field, and a
    # comment that does not happen to match its own row's text empties the
    # match list -- at which point {1}/{2}/{3} have no row to resolve
    # against and execute-silent gets three empty strings. Found by tracing
    # exactly that: the row under the cursor vanished the moment the typed
    # comment stopped being a substring of the diff line.
    # Not tmux-branch's own ^U/^D for preview scroll here: this list's typed
    # text is a comment, and readline's own ^U/^D already mean something
    # inside it (kill-line, delete-char) -- so scroll moves to alt-u/alt-d
    # instead. ^/ still toggles the preview, same as everywhere else.
    # The picker runs in a LOOP now: a cancel with comments pinned asks first,
    # and "keep reviewing" has to land back in the same list rather than in
    # the caller.
    local out rc key n choice
    while :; do
        out=$(printf '%s\n' "$rows_out" \
            | fzf --print-query --expect=ctrl-s --disabled --ansi \
                  --delimiter=$'\t' --with-nth=4 \
                  --reverse --info=inline-right --cycle --scroll-off=2 --color=16 \
                  --bind "enter:execute-silent(${attach_cmd})+reload(${rows_cmd})+clear-query" \
                  --bind "alt-enter:execute-silent(${attach_cmd})+reload(${rows_cmd})+clear-query" \
                  --bind 'ctrl-/:toggle-preview,alt-u:preview-half-page-up,alt-d:preview-half-page-down' \
                  --preview "$preview_cmd" \
                  --preview-window="down,$psz,border-top" \
                  --prompt='review> ' \
                  --header-first \
                  --header=$'↵ pin the typed comment   ^S deliver   esc discard (asks first)\n^/ preview   alt-u/alt-d scroll   ↵ with nothing typed does nothing')
        rc=$?

        # fzf's own exit codes (tmux-branch:228-231): 0 = an --expect key
        # fired, 1 = no match, 130 = esc/^C. Anything outside {0,1} is a
        # cancel, and a cancel must not leave a stale store some later run
        # reuses -- but it must not silently eat a pinned batch either.
        case "$rc" in
            0|1) ;;
            *)
                # A cancel with pinned comments asks; losing a twenty-comment
                # review to a reflexive esc is the cliff revdiff avoids with a
                # separate discard key. An empty store has nothing to protect,
                # so it still exits straight out.
                if [ -s "$store" ]; then
                    n=$(grep -c '^## ' "$store")
                    choice=$(printf 'keep reviewing\ndiscard %d comment(s)\n' "$n" \
                        | fzf --reverse --no-info --prompt='discard? ' \
                              --header="$n comment(s) are pinned and not delivered")
                    case "$choice" in
                        discard*) rm -f -- "$store"; exit 0 ;;
                        *)  # Back to the list, store kept. Rebuild the rows:
                            # the marks in $rows_out are from before the
                            # comments were pinned, and fzf's own reload only
                            # ever touched the list inside the session that
                            # just exited.
                            rows_out=$(rows_mode "$dir" "$store")
                            continue ;;
                    esac
                fi
                rm -f -- "$store"; exit 0 ;;
        esac

        # Line 1 is the typed query (--print-query); unused here because
        # --disabled already routed it into the comment via {q} inside the
        # alt-enter bind -- the outer loop only needs which --expect key fired.
        key=$(sed -n 2p <<<"$out")
        if [ "$key" = ctrl-s ]; then
            exit 20
        fi
        # No --expect key matched -- enter/alt-enter stay inside the picker via
        # execute-silent, so this should not happen, but an unmatched exit is a
        # discard, never a silent deliver.
        rm -f -- "$store"
        exit 0
    done
}

# --- --compose ---------------------------------------------------------------
# The fixed header, then the store verbatim -- cat, nothing clever. The header
# is what tells the agent "??" means a question; the store itself needs no
# reformatting because attach() already wrote it in the delivered shape.
compose() {
    local store=${1:-} root=${2:-}
    printf 'Code review of your uncommitted changes. Address each comment; a comment\ncontaining ?? is a question — answer it in chat, do not edit for it.\nComments are anchored as path:line with the original line quoted.\n'
    # root is the repo root a comment's path is relative to -- optional
    # (omitted, --compose still reads standalone), named here because
    # deliver() has it and the agent otherwise has no way to tell.
    [ -n "$root" ] && printf 'Paths are relative to %s.\n' "$root"
    printf '\n'
    [ -n "$store" ] && [ -f "$store" ] && cat -- "$store"
    return 0
}

# --- --deliver -------------------------------------------------------------
# Land the composed review typed-but-unsent in the agent's own pane -- one
# bracketed paste, never an Enter. Live-verified on a private tmux 3.7c
# server (pane running `exec -a claude bash`): load-buffer + `paste-buffer -p
# -r -d` puts the whole multi-line payload into bash's readline buffer,
# UNEXECUTED -- visible across every capture-pane as the same still-open
# prompt line, no "command not found", no fresh prompt underneath. Tested
# with AND without `-r`, with AND without `extended-keys-format csi-u` (the
# #43169 mitigation this flag targets), and with AND without a trailing
# newline on the payload: all five combinations behaved identically and
# safely on this stack. -r ships anyway per the brief -- LF, never CR, is the
# documented-safe shape even where this local stack did not need it.
#
# Guards run in order, each a refusal via display-message (2>/dev/null: no
# attached client is not this call's problem to fail loudly over) rather
# than a paste:
#   1. pane id shape (agent-state:13-16) -- tmux prefix-matches -t against
#      session names too, so a stray non-%N argument could resolve onto
#      someone else's pane entirely.
#   2. pane_current_command against @cockpit_agents_glob (cockpit.tmux's own
#      #{m:*|cmd|*,glob} shape, reused verbatim from tmux-jump/tm) -- a shell
#      pane would EXECUTE review text instead of merely displaying it.
#   3. @panestate is not needs-input -- a pane sitting on a permission
#      prompt would take the paste into the dialog, where the Enter this
#      script tells the human to press becomes a blind approval.
#   4. store non-empty -- nothing pinned means nothing to deliver.
#
# Every refusal names the store. review_pane() deletes it only when delivery
# SUCCEEDS, so after a refusal the pinned batch is still on disk -- and it is
# the only copy of the review. A refusal that did not say so was
# indistinguishable from one that ate it.
keep_hint() {
    local pane=$1 store=$2
    [ -n "$store" ] && [ -s "$store" ] || return 0
    # $SELF, not a bare "tmux-review": the name is only on $PATH after
    # install.sh symlinks it, and from a plugin-only install the suggested
    # command has to be copy-pasteable as printed.
    printf '; comments kept at %s — deliver later with: %s --deliver %s %s' \
        "$store" "$(shq "$SELF")" "$pane" "$(shq "$store")"
}

deliver() {
    local pane=$1 store=$2 root=$3

    case "$pane" in
        %[0-9]*) ;;
        *) tmux display-message \
               "tmux-review: not a pane id, refusing to deliver$(keep_hint "$pane" "$store")" \
               2>/dev/null; return 1 ;;
    esac

    local is_agent
    is_agent=$(tmux display-message -p -t "$pane" \
        '#{?#{m:*|#{pane_current_command}|*,#{@cockpit_agents_glob}},1,0}' \
        2>/dev/null)
    [ "$is_agent" = 1 ] || {
        tmux display-message \
            "tmux-review: $pane is not an agent pane, refusing to deliver$(keep_hint "$pane" "$store")" \
            2>/dev/null
        return 1
    }

    # Guard 3: a pane sitting on a permission prompt. The paste would land in
    # the dialog and the human's Enter -- the one this script tells them to
    # press -- becomes a blind approval of whatever tool was being asked about.
    # @panestate is written only by agent-state, so this is the cheap read.
    local pstate
    pstate=$(tmux show-option -pqv -t "$pane" @panestate 2>/dev/null)
    if [ "$pstate" = needs-input ]; then
        tmux display-message \
            "tmux-review: $pane is waiting on a permission prompt — answer it first$(keep_hint "$pane" "$store")" \
            2>/dev/null
        return 1
    fi

    [ -n "$store" ] && [ -s "$store" ] || {
        tmux display-message "tmux-review: nothing to deliver" 2>/dev/null
        return 1
    }

    local payload bytes
    payload=$("$SELF" --compose "$store" "$root")
    bytes=$(printf '%s' "$payload" | wc -c)

    # Over 2048 bytes: the review becomes a file the agent reads, not a wall
    # of text typed into its prompt. mktemp, not a predictable
    # tmux-cockpit-review-<pane>.md name -- a fixed name under a shared
    # tmpdir (the COMMON case on macOS, which has no XDG_RUNTIME_DIR) is a
    # symlink-disclosure vector, and mktemp's own randomized suffix makes the
    # name unguessable rather than merely unlinked-and-recreated. `umask 077`
    # in the same subshell that runs mktemp means the file is BORN 0600 --
    # no create-then-chmod window for a racing reader. Template ends in the
    # X run with no trailing .md: BSD/macOS mktemp requires the X's to be
    # the LAST characters of the template and errors ("too few X's") on
    # anything after them, unlike GNU's more permissive "keep a literal
    # suffix after the trailing X run" -- the pointer sentence below already
    # names the exact path, so the extension carried no weight anyway. The
    # agent deletes nothing -- the file outlives the pane on purpose; the OS
    # tmpdir is the only GC.
    if [ "$bytes" -gt 2048 ]; then
        local runtime file
        runtime=${XDG_RUNTIME_DIR:-/tmp}
        file=$(umask 077 && mktemp "$runtime/tmux-cockpit-review-${pane#%}-XXXXXX") || {
            tmux display-message \
                "tmux-review: could not create the review file, refusing to deliver$(keep_hint "$pane" "$store")" \
                2>/dev/null
            return 1
        }
        printf '%s' "$payload" > "$file"
        payload="Read and address every comment in $file — review of your uncommitted changes; ?? comments are questions."
    fi

    # A per-invocation buffer name: tmux buffers are SERVER-GLOBAL, so a
    # fixed name races under concurrent deliveries -- a second delivery's
    # load-buffer can overwrite the first's payload before the first's
    # paste-buffer -d has run, landing the wrong review in the wrong pane (or
    # pasting nothing once the buffer was already deleted out from under
    # it). pane + $$ gives every invocation its own buffer.
    local bufname
    bufname="cockpit-review-${pane#%}-$$"
    if ! printf '%s' "$payload" | tmux load-buffer -b "$bufname" -; then
        tmux display-message \
            "tmux-review: could not stage the review, refusing to deliver" \
            2>/dev/null
        return 1
    fi
    # The is-agent test the shell ran up top is a ~50ms-stale snapshot: a
    # compose re-exec, a wc, an mktemp and this load-buffer all sit between it
    # and the paste. Kill the agent in that window -- a `claude` foreground
    # child exits and the pane's own shell is back -- and the old unconditional
    # `paste-buffer` landed the review in that shell (the hunt reproduced it
    # 6/6, pasting a live, one-Enter-from-running command line the reviewer
    # never targeted). So the check is redone HERE, by tmux itself, in the same
    # command-queue item as the paste: `if-shell -F -t <pane>` re-evaluates the
    # SAME #{m:...} test -- AND guard 3's #{!=:#{@panestate},needs-input}, which
    # has the identical staleness window: a permission prompt can come up in it
    # -- against the pane at paste time and only pastes if it is still an idle
    # agent. The window is closed -- there is no shell round-trip left
    # between the test and the paste. The early check up top stays as the
    # cheap fast-fail for a pane that is already not an agent, or already
    # sitting on a permission prompt.
    #
    # The refused branch deliberately does NOT delete $bufname (only the
    # delivered branch's `paste-buffer -d` does) -- if-shell's nested command
    # has already run by the time this CLI call returns (same command-queue
    # item, no -b job behind it), so the buffer's survival IS the atomic
    # gate's own true/false outcome, readable here without a second stale
    # re-test of the pane. Before this, a race-refusal here fell through with
    # whatever `tmux if-shell` itself returns ("the queue accepted it", always
    # 0) even though nothing was delivered -- silently breaking the exit-1
    # refusal contract every early guard above already honors. Checking (and
    # then clearing) the buffer closes that gap: both refusal paths now share
    # one contract, and the buffer is gone either way before this function
    # returns, same as before.

    # Where the review landed, named the way a human navigates: "work:2 api"
    # beats a bare %7 when the pane is three windows away. Read once, HERE,
    # against the TARGET pane: the notice's own display-message carries no -t
    # (it must not steal focus or fail when the pane is gone by then), so a
    # #{window_name} left in the message would resolve against whatever pane
    # the reader happens to be sitting in -- the wrong window's name.
    #
    # The window name is USER DATA and gets two escapes, because it crosses two
    # parsers on its way into the notice:
    #
    #   1. tmux's command-string parser. $where is interpolated into a
    #      single-quoted argument of the if-shell command string, so a window
    #      named don't closes that quote early and hands tmux the remainder as
    #      commands. Single quotes are stripped; nothing else breaks out.
    #   2. tmux's FORMAT parser. display-message expands its message as a
    #      format, so a window named w#{@some_option} renders that option's
    #      VALUE, not the name -- measured on 3.7c: a window renamed
    #      w##{@cockpit_secret} made the notice read "wLEAKED-SECRETz". ## is
    #      the format literal for #, so doubling every # is the whole fix, and
    #      it works on the 3.3 floor. (3.7c runs no #(shell-command) job from a
    #      display-message -- only status formats do -- but doubling covers
    #      that arm too, whatever a later tmux decides to run.)
    #
    # The READ above is safe on its own: a value substituted by #{window_name}
    # is not re-expanded, so only this second interpolation needs the escape.
    local where
    where=$(tmux display-message -p -t "$pane" \
        '#{session_name}:#{window_index} #{window_name}' 2>/dev/null)
    where=${where//\'/}
    where=${where//#/##}
    [ -n "$where" ] || where="the agent pane"   # display-message failed; still read as a sentence
    tmux if-shell -F -t "$pane" \
        "#{&&:#{m:*|#{pane_current_command}|*,#{@cockpit_agents_glob}},#{!=:#{@panestate},needs-input}}" \
        "set-option -p -t $pane @cockpit_review sent ; paste-buffer -p -r -d -b $bufname -t $pane ; display-message -d 0 'review pasted into $where ($pane) — press Enter there to send; prefix J walks there'" \
        "display-message 'tmux-review: $pane is not an idle agent — not delivered'"

    if tmux list-buffers -F '#{buffer_name}' 2>/dev/null | grep -qxF "$bufname"; then
        tmux delete-buffer -b "$bufname" 2>/dev/null
        return 1
    fi
    return 0
}

# --- --fleet / entry-point resolution --------------------------------------
# Which of the fleet needs your eyes: every agent pane, every session, whose
# tree is dirty -- landscape-gap #1, nothing else answers this. Rows are
# pane\ttitle\t±stat, dirtiest (most churn) first. The is-agent test is
# tmux's own #{m:*|cmd|*,glob} conditional (deliver()'s guard, cockpit.tmux's
# window formats) run once per pane inside list-panes, not a second shell per
# pane to re-ask; the title falls back from pane_title to the window name the
# same way @catppuccin_window_text already does (examples/tmux.conf:42) --
# #{host_short} is what an UNSET pane_title reads as, not empty.
fleet_rows() {
    # One -F argument, built in a variable: continuation lines each starting
    # a fresh quoted string are separate WORDS to tmux, not one concatenated
    # format -- list-panes then sees four positional arguments and refuses
    # them ("too many arguments"). Reproduced live before this fix.
    local fmt raw
    fmt='#{?#{m:*|#{pane_current_command}|*,#{@cockpit_agents_glob}},1,0}'$'\t'
    fmt="${fmt}"'#{pane_id}'$'\t'
    fmt="${fmt}"'#{session_name}:#{window_index} #{?#{==:#{pane_title},#{host_short}},#{window_name},#{s/^✳ //:#{pane_title}}}'$'\t'
    fmt="${fmt}"'#{pane_current_path}'
    raw=$(tmux list-panes -a -F "$fmt" 2>/dev/null)
    [ -n "$raw" ] || return 0

    # Every pane's git status+numstat used to run SERIALLY, one pane fully
    # finished before the next started -- ~2 git calls/pane. On a cold
    # filesystem (150ms/git, the hunt's measured figure) 100 panes blanked the
    # popup for ~32s, on every prefix+r from a non-agent pane. The panes are
    # independent of each other, so run their git work concurrently instead,
    # each pane's row computed in its own background subshell and written to
    # its own file (rows are re-sorted by churn below anyway, so completion
    # order never matters). Capped at $cap in flight at once -- unbounded
    # would fork hundreds of git processes at once on a big fleet, trading one
    # kind of slowness for another.
    local tmpdir
    tmpdir=$(mktemp -d) || return 0

    local isagent id title path n=0 cap=${COCKPIT_FLEET_PARALLEL:-8}
    local -a pids=()
    while IFS=$'\t' read -r isagent id title path; do
        [ "$isagent" = 1 ] || continue
        [ -n "$path" ] || continue
        n=$((n + 1))
        fleet_row_one "$id" "$title" "$path" > "$tmpdir/$n" &
        pids+=("$!")
        if [ ${#pids[@]} -ge "$cap" ]; then
            wait "${pids[0]}" 2>/dev/null
            pids=("${pids[@]:1}")
        fi
    done <<<"$raw"
    wait 2>/dev/null

    local -a rows=()
    local f
    for f in "$tmpdir"/*; do
        [ -s "$f" ] || continue
        rows+=("$(cat "$f")")
    done
    # The OS tmpdir is the only GC here, same call as deliver()'s mktemp --
    # a killed popup takes its children with it, but not necessarily this rm.
    rm -rf "$tmpdir"
    [ ${#rows[@]} -gt 0 ] || return 0

    for line in "${rows[@]}"; do printf '%s\n' "$line"; done \
        | sort -t "$(printf '\t')" -k1,1nr | cut -f2-4
}

# One pane's fleet row -- factored out of fleet_rows() so it can run in its
# own background subshell (see the parallel dispatch above). Churn comes from
# tree_diff, the one base --lines reviews from, so a fully staged change still
# gets a real churn number instead of reading as 0. Prints nothing (and the
# caller's file stays empty) for a pane git status calls clean, so an empty
# output file is indistinguishable from "not dirty" on the reading side.
fleet_row_one() {
    local id=$1 title=$2 path=$3
    local st numstat add del untracked churn stat a d

    st=$(git -C "$path" status --porcelain 2>/dev/null)
    [ -n "$st" ] || return 0

    # The same one base --lines reviews from: staged + unstaged together, so a
    # fully staged change gets its real churn instead of reading as 0.
    numstat=$(tree_diff "$path" --numstat)
    add=0; del=0
    while IFS=$'\t' read -r a d _f; do
        [ -n "$a" ] || continue
        case "$a" in *[!0-9]*) a=0 ;; esac
        case "$d" in *[!0-9]*) d=0 ;; esac
        add=$(( add + a )); del=$(( del + d ))
    done <<<"$numstat"

    # Untracked files carry no numstat line at all -- without counting them a
    # pane holding only new files reads as 0 churn and sorts last, even
    # though `git status` already called it dirty.
    untracked=$(printf '%s\n' "$st" | grep -c '^??' || true)
    stat="+$add -$del"
    [ "$untracked" -gt 0 ] && stat="$stat  ?$untracked new"
    churn=$(( add + del + untracked ))

    printf '%s\t%s\t%s\t%s\t%s\n' "$churn" "$id" "$title" "$stat" "$path"
}

# --- entry-point resolution -------------------------------------------------
# Enter Task 2's loop against one pane: a fresh mktemp store, the interactive
# --loop re-exec'd (not called as a function -- it ends in a script `exit`,
# and this needs its own exit code back rather than the whole process dying),
# ctrl-s (rc 20) handed to --deliver via `tmux run-shell -b` -- a popup kills
# its own children the moment it closes (tmux-open-path:381-386), so delivery
# has to outlive that teardown, not run inside it.
review_pane() {
    local pane=$1 dir=$2 store rc
    store=$(mktemp) || {
        tmux display-message "tmux-review: could not create a comment store" 2>/dev/null
        return 1
    }
    "$SELF" --loop "$dir" "$store"
    rc=$?
    if [ "$rc" -eq 20 ]; then
        # deliver() is a public subcommand the suite re-delivers the same
        # store through, so it must not rm its own store arg -- the cleanup
        # belongs to this caller, chained after delivery so the store still
        # outlives the popup's own teardown (comment above).
        #
        # `&&`, not `;`: --deliver refuses (needs-input, a non-agent pane, a
        # bogus id) AFTER the popup is gone, and an unconditional rm threw the
        # whole pinned batch away on every one of those -- the store is the
        # only copy of the review, and the human never even saw it happen. A
        # refused store is left on disk on purpose; deliver()'s message names
        # it and the command that re-delivers it.
        tmux run-shell -b "$(shq "$SELF") --deliver $(shq "$pane") $(shq "$store") $(shq "$dir") && rm -f -- $(shq "$store")"
    fi
}

# The fzf queue over fleet_rows(). Unlike the review loop this filters as you
# type -- it is a pane list, not comment entry, so --disabled has no place
# here. Rows carry only the three fields the brief names (pane, title, stat);
# the preview re-asks tmux for the pane's cwd by id rather than smuggling a
# fourth hidden field, so `--fleet`'s output stays exactly that interface.
fleet_queue() {
    command -v fzf >/dev/null 2>&1 || {
        tmux display-message "tmux-review: the fleet queue needs fzf" 2>/dev/null
        return 1
    }
    local rows
    rows=$(fleet_rows)
    if [ -z "$rows" ]; then
        tmux display-message "tmux-review: no agent pane has uncommitted changes" 2>/dev/null
        return 0
    fi

    local nrows avail lrows psz preview_cmd out pane dir
    nrows=$(printf '%s\n' "$rows" | wc -l)
    avail=$(tput lines 2>/dev/null || echo 24)
    lrows=$nrows; [ "$lrows" -gt 8 ] && lrows=8
    psz=$(( avail - lrows - 5 ))
    [ "$psz" -lt 5 ] && psz=5

    # Same root-vs-cwd seam as review_pane: the row only carries the pane's
    # raw cwd, so resolve it to the repo root here too before handing it to
    # --preview-diff, which expects a real, existing path.
    preview_cmd="pdir=\$(tmux display-message -p -t {1} '#{pane_current_path}' 2>/dev/null); "
    preview_cmd="${preview_cmd}proot=\$(git -C \"\$pdir\" rev-parse --show-toplevel 2>/dev/null); "
    preview_cmd="${preview_cmd}$(shq "$OPENPATH") --preview-diff \"\${proot:-\$pdir}\""

    out=$(printf '%s\n' "$rows" \
        | fzf --delimiter=$'\t' --with-nth=2,3 \
              --reverse --info=inline-right --cycle --scroll-off=2 --color=16 \
              --bind 'ctrl-/:toggle-preview,ctrl-u:preview-half-page-up,ctrl-d:preview-half-page-down' \
              --preview "$preview_cmd" \
              --preview-window="down,$psz,border-top" \
              --prompt='fleet> ' \
              --header='which agent needs you   ↵ review it   ^/ preview   esc cancel')
    [ -n "$out" ] || return 0

    pane=$(cut -f1 <<<"$out")
    [ -n "$pane" ] || return 0
    dir=$(tmux display-message -p -t "$pane" '#{pane_current_path}' 2>/dev/null)
    [ -n "$dir" ] || {
        tmux display-message "tmux-review: pane $pane is gone" 2>/dev/null
        return 0
    }
    review_pane "$pane" "$(git_root "$dir")"
}

# No args, bound to prefix R: ask tmux which pane the CLIENT is actually on --
# not $TMUX_PANE, which inside this popup names the popup's own pseudo-pane,
# not the pane you pressed the key from. Bare `display-message -p` (no -t)
# has no client of its own to resolve from inside a popup -- it falls back to
# whichever attached client was most recently active, which can be a
# DIFFERENT session than the one the popup was opened from (reproduced with
# two real attached clients: the busier one wins, not the opener). REVIEW_PANE_ID
# -- this script's own -p, parsed below, mirroring tmux-branch's -p
# (tmux-branch:38-53) -- pins the query to the actual pane the popup came
# from when the caller has it; without it this falls back to the old
# best-effort client-recency resolution.
main_entry() {
    local pane is_agent dir
    if [ -n "$REVIEW_PANE_ID" ]; then
        pane=$REVIEW_PANE_ID
    else
        pane=$(tmux display-message -p '#{pane_id}' 2>/dev/null)
    fi
    if [ -z "$pane" ]; then
        printf 'tmux-review: no tmux client to resolve a pane from\n' >&2
        exit 1
    fi
    is_agent=$(tmux display-message -p -t "$pane" \
        '#{?#{m:*|#{pane_current_command}|*,#{@cockpit_agents_glob}},1,0}' 2>/dev/null)
    if [ "$is_agent" = 1 ]; then
        dir=$(tmux display-message -p -t "$pane" '#{pane_current_path}' 2>/dev/null)
        review_pane "$pane" "$(git_root "$dir")"
    else
        fleet_queue
    fi
}

# -p pane_id, parsed here so the dispatch below sees only the subcommand --
# mirrors tmux-branch's own -c/-p loop (tmux-branch:25-33); tmux-review only
# needs -p (main_entry's click-binding pin), not -c.
REVIEW_PANE_ID=""
while [ $# -gt 0 ]; do
    case "$1" in
        -p) REVIEW_PANE_ID="${2:-}"; shift 2 || break ;;
        *)  break ;;
    esac
done

case "${1:-}" in
    --fleet)
        fleet_rows ;;
    --lines)
        shift; lines_mode "${1:-}" ;;
    --rows)
        shift; rows_mode "${1:-}" "${2:-}" ;;
    --attach)
        shift; attach "${1:-}" "${2:-}" "${3:-}" "${4:-}" "${5:-}" "${6:-}" ;;
    --loop)
        shift; run_loop "${1:-}" "${2:-}" ;;
    --compose)
        shift; compose "${1:-}" "${2:-}" ;;
    --deliver)
        shift; deliver "${1:-}" "${2:-}" "${3:-}" ;;
    -h|--help)
        usage; exit 0 ;;
    "")
        main_entry ;;
    *)
        printf 'unknown option: %s (try: tmux-review -h)\n' "$1" >&2; exit 2 ;;
esac
