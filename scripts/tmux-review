#!/usr/bin/env bash
# tmux-review — review an agent's uncommitted diff, one comment at a time, and
# hand the finished review back to the agent's pane.
#   tmux-review [-p pane_id]               no args: review that pane -- or,
#                                          without -p, the CLIENT's active
#                                          pane (what r on a board row runs)
#   tmux-review --loop <dir> <store>       the review: revdiff, then a one-key
#                                          prompt; exits 20 (deliver), 21
#                                          (approved), 127 (no revdiff), else
#                                          leaves the batch pinned
#   tmux-review --compose <store>          the composed review, ready to deliver
#   tmux-review --deliver <pane> <store>   one bracketed paste, typed-but-unsent
#
# --compose touches no tmux.
set -uo pipefail

# bash 4+: on 3.2 `declare -A` fails and the assignment quietly makes an
# indexed array, so fail loudly instead.
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
    printf '%s needs bash 4 or newer (found %s). On macOS: brew install bash\n' \
           "${BASH_SOURCE[0]##*/}" "${BASH_VERSION:-unknown}" >&2
    exit 1
fi

# Not `$0`: through install.sh's symlink or a PATH lookup this must still
# find its siblings and re-invoke itself.
# shellcheck disable=SC2034  # read by the libs
SELF="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
# lib/ sits beside the REAL script; install.sh links it by absolute path.
d=${BASH_SOURCE[0]}; [ -L "$d" ] && d=$(readlink "$d")
LIBDIR=${d%/*}/lib
# Every git call, revdiff's too, is about the pane's own repo: a popup inherits
# tmux's environment, where a dotfiles setup's GIT_DIR would point all of them
# at another, and a pathspec mode would change what this script's pathspecs
# match (#673). Here, before any mode runs, so a new mode cannot miss it.
# shellcheck source=lib/git-env.sh
. "$LIBDIR/git-env.sh" || exit 1
# shellcheck source=lib/git.sh
. "$LIBDIR/git.sh" || exit 1

# tmux runs run-shell and popup strings through sh: every path in one is quoted.
shq() { printf '%q' "$1"; }

# shellcheck source=lib/pane.sh
. "$LIBDIR/pane.sh" || exit 1
# shellcheck source=lib/fmt.sh
. "$LIBDIR/fmt.sh" || exit 1
# shellcheck source=lib/workdir.sh
. "$LIBDIR/workdir.sh" || exit 1

# How a pane names itself in the prompt. An unset pane_title reads as
# #{host_short}, not empty, so the window name stands in.
# shellcheck disable=SC2034  # read by the libs
AGENT_TITLE_FMT='#{?#{==:#{pane_title},#{host_short}},#{window_name},#{s/^✳ //:#{pane_title}}}'

# git diff paths are relative to the repo root, not to a pane's subdirectory
# cwd: every entry point resolves the root once. Not a repo: the dir itself.
git_root() {
    local dir=$1 root
    root=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)
    printf '%s\n' "${root:-$dir}"
}

usage() {
    cat >&2 <<'USAGE'
tmux-review — review an agent's uncommitted diff, one comment at a time.
  tmux-review [-p pane_id]                review that pane (or, without -p, the
                                          client's active pane); prefix r opens
                                          the board, where r on a row runs this
  tmux-review --loop <dir> <store>       the review: revdiff, then a one-key prompt
                                          (deliver, approve, review again, base,
                                          discard, leave); needs revdiff
  tmux-review --compose <store>          the composed review, ready to deliver
  tmux-review --deliver <pane> <store>   paste it typed-but-unsent into <pane>; a busy pane gets it queued for its next Stop
  tmux-review --done <store>            after a by-hand --deliver: archive the batch, drop the scratch
  tmux-review --delta <pane>            exit 0 when <pane>'s tree differs from its review base
  tmux-review --request <pane>          the agent asks: one popup on <pane>; the batch on stdout, exit 10
  tmux-review --dir <pane>              the tree <pane> works in, as the board shows it
In revdiff: its own keys (? lists them); q saves the comments, Q discards.
After it: d deliver   a approve (no comments)   r review again   b base   x discard   l leave
USAGE
}

# --- the session dir ---------------------------------------------------------
# One review is one directory the popup does not own, so a dropped SSH client
# cannot take it along. Keyed on pane + repo root; 0700, as it holds the diff.
# `rm -rf ~/.local/state/tmux-cockpit/review` is the purge.
session_dir() {               # <pane-id> <root>
    printf '%s/tmux-cockpit/review/%s-%s' "${XDG_STATE_HOME:-$HOME/.local/state}" \
        "${1#%}" "$(printf '%s' "$2" | cksum | cut -d' ' -f1)"
}

# -p pane_id. Defaulted, not reset: review_pane exports it around its --loop
# re-invocation for the prompt's label.
: "${REVIEW_PANE_ID:=}"
while [ $# -gt 0 ]; do
    case "$1" in
        -p) REVIEW_PANE_ID="${2:-}"; shift 2 || break ;;
        *)  break ;;
    esac
done
[ -z "$REVIEW_PANE_ID" ] || is_pane "$REVIEW_PANE_ID" || { usage; exit 2; }

# Each mode sources only the libs it calls.
need() {
    local l
    for l; do . "$LIBDIR/$l" || exit 1; done
}
case "${1:-}" in
    --delta)                    need review-diff.sh ;;
    --loop)                     need review-diff.sh review-revdiff.sh review-deliver.sh ;;
    --compose|--deliver|--done) need review-deliver.sh ;;
    --request)                  need review-deliver.sh review-fleet.sh ;;
    "")                         need review-diff.sh review-deliver.sh review-fleet.sh ;;
esac

case "${1:-}" in
    --loop)
        shift; review_loop "${1:-}" "${2:-}" ;;
    --compose)
        shift; compose "${1:-}" "${2:-}" ;;
    --deliver)
        shift; deliver "${1:-}" "${2:-}" "${3:-}" ;;
    --done)
        shift; done_store "${1:-}" ;;
    --delta)
        shift; delta_mode "${1:-}" ;;
    --request)
        shift; request "${1:-}" ;;
    --dir)
        shift; pane_workdir "${1:-}" ;;
    -h|--help)
        usage; exit 0 ;;
    "")
        main_entry ;;
    *)
        printf 'unknown option: %s (try: tmux-review -h)\n' "$1" >&2; exit 2 ;;
esac
