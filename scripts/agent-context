#!/usr/bin/env bash
# Claude Code statusLine shim: records the pane's context fill in @panestate_ctx and its
# 5-hour and weekly allowance in @panestate_rl (#1600), then prints a minimal statusline.
# Bad input is a silent no-op, never an error.
set -u
pane="${TMUX_PANE:-}"
# An agent-view background worker has no pane; its front end relays what matters (#174).
[ -z "$pane" ] && [ "${CLAUDE_CODE_SESSION_KIND:-}" = bg ] && exit 0
case "$pane" in %[0-9]*) ;; *) exit 0 ;; esac   # same guard as agent-state

d=${BASH_SOURCE[0]}; case $d in (*/*) ;; (*) d=./$d ;; esac
[ -L "$d" ] && d=$(n=0
    while [ -L "$d" ] && [ $((n += 1)) -le 40 ] && t=$(readlink "$d"); do
        case $t in (/*) d=$t ;; (*) d=${d%/*}/$t ;; esac; done; printf %s "$d")
# shellcheck source=lib/hook.sh
. "${d%/*}/lib/hook.sh" 2>/dev/null || exit 0
read_payload false

command -v jq >/dev/null 2>&1 || exit 0
# The fallback recomputes used_percentage from input tokens, should a version drop it.
# Output: line 1 the percentage, line 2 the allowance, then the model, which is free text,
# then a last line `.`, so an empty value at the end is not cut with the newlines after it.
# The allowance is the minute read, then each window's used share, whole and rounded up,
# and its resets_at: `<minute>_<used 5h>_<reset 5h>_<used 7d>_<reset 7d>`, `-_-` for a
# window the payload lacks, and empty with neither. It starts with a digit, so tmux never
# reads it as a flag. A share is clamped to 0 to 100, with "<= 0" since jq's ceil of -0.5 is
# -0, which prints as "-0". Claude Code sends rate_limits to subscribers only, after the
# session's first answer.
out=$(jq -r '
    ([(.context_window.used_percentage
     // (if (.context_window.context_window_size? and .context_window.current_usage?)
         then ((.context_window.current_usage.input_tokens
                + (.context_window.current_usage.cache_creation_input_tokens // 0)
                + (.context_window.current_usage.cache_read_input_tokens // 0))
               / .context_window.context_window_size * 100)
         else empty end)
     // empty) | floor
     # Cache tokens can overshoot the window; nothing downstream expects > 100.
     | if . > 100 then 100 else . end][0] // ""),
    (.rate_limits as $r
     | if ($r | type) == "object" then
         [($r.five_hour, $r.seven_day)
          | if type == "object" and (.used_percentage | type) == "number"
               and (.resets_at | type) == "number"
            then (.used_percentage | ceil | if . <= 0 then 0 elif . > 100 then 100 else . end
                  | tostring) + "_" + (.resets_at | floor | tostring)
            else "-_-" end]
         | if . == ["-_-", "-_-"] then "" else "\(now / 60 | floor * 60)_\(join("_"))" end
       else "" end),
    (.model.display_name // ""), "."' 2>/dev/null <<<"$payload") || exit 0
out=${out%$'\n.'}
pct=${out%%$'\n'*}
out=${out#*$'\n'}
rl=${out%%$'\n'*}
model=${out#*$'\n'}
case $rl in *[!0-9_-]*) rl="" ;; esac

case "$pct" in
    ''|*[!0-9]*) exit 0 ;;
    *)
        # Called every render, and an unchanged set-option still redraws: compare first.
        # $pane and $pct are validated, safe in a command string. The session's
        # gauge cells (the bar's tab budget counts them) are summed here, once per
        # change, so no redraw walks the windows; written only when the sum moves.
        # Each test reads 1 only for an equal compare read whole (#713): tmux 3.7+ cuts a
        # format past 100 ms to "", which must write, not skip. The cells are tested again
        # after a write, as agent-state's put does; the gauge is a literal, never cut.
        # The allowance has its own test, second in the call, so a minute's new stamp
        # rewrites only it.
        cells='#{n:#{W:#{?#{E:@cockpit_ctx_on},xx#{@panestate_ctx}x,}}}'
        ct="#{?#{e|==:$cells,#{@cockpit_ctx_all}},1,0}"
        cs="set-option -F -t $pane @cockpit_ctx_all '$cells'"
        cs="if -F -t $pane '$ct' {} { $cs ; if -F -t $pane '$ct' {} { $cs } }"
        rs="set-option -pqu -t $pane @panestate_rl"
        [ -z "$rl" ] || rs="set-option -pq -t $pane @panestate_rl $rl"
        tmux if-shell -F -t "$pane" "#{?#{==:#{@panestate_ctx},$pct},1,0}" "" \
            "set-option -p -t $pane @panestate_ctx $pct ; $cs" \; \
            if-shell -F -t "$pane" "#{?#{==:#{@panestate_rl},$rl},1,0}" "" "$rs" 2>/dev/null
        ;;
esac
printf '%s · ctx %s%%\n' "${model:-claude}" "$pct"
exit 0
