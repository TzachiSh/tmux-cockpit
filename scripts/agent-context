#!/usr/bin/env bash
# Claude Code statusLine shim: records the pane's context fill in @panestate_ctx,
# then prints a minimal statusline. Bad input is a silent no-op, never an error.
set -u
pane="${TMUX_PANE:-}"
# An agent-view background worker has no pane; its front end relays what matters (#174).
[ -z "$pane" ] && [ "${CLAUDE_CODE_SESSION_KIND:-}" = bg ] && exit 0
case "$pane" in %[0-9]*) ;; *) exit 0 ;; esac   # same guard as agent-state

d=${BASH_SOURCE[0]}; [ -L "$d" ] && d=$(readlink "$d")
# shellcheck source=lib/hook.sh
. "${d%/*}/lib/hook.sh" 2>/dev/null || exit 0
read_payload false

command -v jq >/dev/null 2>&1 || exit 0
# The fallback recomputes used_percentage from input tokens, should a version drop it.
# Output: line 1 the percentage, line 2 the model.
out=$(jq -r '
    ([(.context_window.used_percentage
     // (if (.context_window.context_window_size? and .context_window.current_usage?)
         then ((.context_window.current_usage.input_tokens
                + (.context_window.current_usage.cache_creation_input_tokens // 0)
                + (.context_window.current_usage.cache_read_input_tokens // 0))
               / .context_window.context_window_size * 100)
         else empty end)
     // empty) | floor
     # Cache tokens can overshoot the window; nothing downstream expects > 100.
     | if . > 100 then 100 else . end][0] // ""),
    (.model.display_name // "")' 2>/dev/null <<<"$payload") || exit 0
pct=${out%%$'\n'*}
model=${out#*$'\n'}

case "$pct" in
    ''|*[!0-9]*) exit 0 ;;
    *)
        # Called every render, and an unchanged set-option still redraws: compare first.
        # $pane and $pct are validated, safe in a command string.
        tmux if-shell -F -t "$pane" "#{!=:#{@panestate_ctx},$pct}" \
            "set-option -p -t $pane @panestate_ctx $pct" 2>/dev/null
        ;;
esac
printf '%s · ctx %s%%\n' "${model:-claude}" "$pct"
exit 0
