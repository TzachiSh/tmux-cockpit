#!/usr/bin/env bash
# cockpit-msg: messages between agent sessions, in a private store (#1575, epic #1573).
#   cockpit-msg send --session <id> <to> <summary-file> <body-file>
#                                  the calling session sends one message; prints its msg_id
#   cockpit-msg read --session <id> <msg_id>
#                                  the calling session reads one of its messages: prints the
#                                  body and marks that message read
#   cockpit-msg who                the sessions that can receive, one a line:
#                                  <id> TAB <branch, or -> TAB <work folder>
# Every session id here is the hex form a contract id takes (sid_hex). Each command runs in a
# pane of the tmux server $TMUX names. The caller of send and read is the pane $TMUX_PANE
# names, and --session must name the session that pane publishes in @cockpit_session (epic
# #1573, D9).
# Exit: 0 done; 1 refused, the last line on stderr says why (a tool that failed may print its
# own line before it); 2 usage; 3 cannot load; 129, 130 and 143 ended by HUP, INT and TERM.
#
# The store, under the state folder (state_root), 0700 folders, 0600 files:
#   tmux-cockpit/refs/<msg_id>.md          the body           (contracts/README.md, Refs)
#   tmux-cockpit/refs/<msg_id>.txt         the summary line
#   tmux-cockpit/msg/<to>/<msg_id>.json    the envelope       (contracts/agent-message.schema.json)
#   tmux-cockpit/msg/<to>/read/<msg_id>    empty: the receiver read that message
# Each file is written beside its name and linked into place, so a reader sees all of it or
# none, and no name already stored is replaced. One read marker per message, not a cursor: a
# newer message read first leaves an older one unread.
set -u

# bash 4+: ${x,,} below. 3, as for a lib that fails to load.
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
    printf '%s needs bash 4 or newer (found %s). On macOS: brew install bash\n' \
           "${BASH_SOURCE[0]##*/}" "${BASH_VERSION:-unknown}" >&2
    exit 3
fi

# lib/ sits beside the REAL script, at the end of any chain of links (#1283).
d=${BASH_SOURCE[0]}; case $d in (*/*) ;; (*) d=./$d ;; esac
[ -L "$d" ] && d=$(n=0
    while [ -L "$d" ] && [ $((n += 1)) -le 40 ] && t=$(readlink "$d"); do
        case $t in (/*) d=$t ;; (*) d=${d%/*}/$t ;; esac; done; printf %s "$d")
LIBDIR=${d%/*}/lib
# who's git reads the pane's own repo, never one an inherited GIT_DIR names (#673).
# shellcheck source=lib/git-env.sh
. "$LIBDIR/git-env.sh" || exit 3
# shellcheck source=lib/git.sh
. "$LIBDIR/git.sh" || exit 3
# is_pane, and workdir_row and workdir_resolve: the one rule for a pane's work folder (#470,
# #1342).
# shellcheck source=lib/workdir.sh
. "$LIBDIR/workdir.sh" || exit 3
# shellcheck source=lib/tmpdir.sh
. "$LIBDIR/tmpdir.sh" || exit 3

SUMMARY_MAX=200               # bytes
HEX='[0123456789abcdef]{16,64}'
umask 077

# The usage through the printf builtin: no tool, and no here-document, whose temp file could
# fail unread (#1575).
usage() {
    printf '%s\n' 'usage: cockpit-msg send --session <id> <to> <summary-file> <body-file>' \
        '       cockpit-msg read --session <id> <msg_id>' '       cockpit-msg who' >&2
    exit 2
}

# A temp file in flight, and the names a send puts in place: taken back if the send stops
# before its envelope, so no ref is left with no envelope naming it. A signal ends the run
# through leave too, and none cuts leave short (#1107).
TMPF='' PUT=()
leave() {
    trap '' HUP INT TERM
    [ -z "$TMPF" ] || rm -f -- "$TMPF"
    [ "${#PUT[@]}" -eq 0 ] || rm -f -- "${PUT[@]}"
}
trap leave EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

die() { printf 'cockpit-msg: %s\n' "$1" >&2; exit 1; }

# A session id as every contract id is written (#1575): the UUID Claude Code names a session
# by, its dashes dropped, in lower case: 32 hex digits (contracts/README.md wants 16 to 64
# lowercase hex). REPLY empty and 1 for a value that is no UUID. The UUID shape is tested in
# two more places, each its own copy: save_session in scripts/lib/hook.sh (either case) and
# the resume in scripts/cockpit-board (lower case only). One helper for the three is a
# refactor PR of its own.
sid_hex() {                   # <UUID> -> REPLY
    local h='[0123456789abcdefABCDEF]'
    REPLY=''
    [[ ${1-} =~ ^$h{8}-$h{4}-$h{4}-$h{4}-$h{12}$ ]] || return 1
    REPLY=${1//-/}; REPLY=${REPLY,,}
}

# The server and the pane a run is on: $TMUX names the server, $TMUX_PANE the pane.
in_pane() {
    [ -n "${TMUX:-}" ] && is_pane "${TMUX_PANE:-}" ||
        die "not in a tmux pane: TMUX must be set and TMUX_PANE must be %N"
}

# The panes of this server that publish a session, one word each in PUBLISHED: the hex id, a
# space, and the pane's WORKDIR_FMT row, which who resolves to its work folder. A pane whose
# @cockpit_session is no UUID publishes none. The list is one tmux call, read whole before it
# is searched, and a tmux that fails is a refusal with its reason. Its lines are cut out by
# expansion: a here-string into the loop is a redirect whose failure goes unread (#1575).
published() {
    local us=$'\037' out rest p
    out=$(tmux list-panes -a -F "#{@cockpit_session}$us$WORKDIR_FMT" 2>&1) ||
        die "cannot list the panes of this tmux server: ${out%%$'\n'*}"
    PUBLISHED=()
    rest=$out$'\n'
    while [ -n "$rest" ]; do
        p=${rest%%$'\n'*} rest=${rest#*$'\n'}
        sid_hex "${p%%"$us"*}" && PUBLISHED+=("$REPLY ${p#*"$us"}")
    done
}

# The calling session (epic #1573, D9): the pane's @cockpit_session, and the id given with
# --session must be its hex form. ME is it. A tmux that fails is a refusal with its reason.
check_caller() {              # <id given>
    local pane out
    in_pane; pane=$TMUX_PANE
    out=$(tmux display-message -p -t "$pane" '#{@cockpit_session}' 2>&1) ||
        die "cannot read pane $pane: ${out%%$'\n'*}"
    sid_hex "$out" || die "pane $pane publishes no session in @cockpit_session"
    ME=$REPLY
    [ "$1" = "$ME" ] || die "session $1 is not the session of pane $pane"
}

# The state folder, by the rule tui/src/store.rs xdg_dir holds (#1508): XDG_STATE_HOME when it
# is an absolute path, else $HOME/.local/state when HOME is one. A relative value is ignored,
# as the XDG spec says, and with neither there is no store.
state_root() {
    local base
    case ${XDG_STATE_HOME:-} in
        /*) base=$XDG_STATE_HOME ;;
        *) case ${HOME:-} in
               /*) base=$HOME/.local/state ;;
               *) die "no state folder: neither XDG_STATE_HOME nor HOME is an absolute path" ;;
           esac ;;
    esac
    ROOT=$base/tmux-cockpit
}

# A folder of the store, made 0700 (the umask) where it is missing, or mkdir's reason.
own_dir() {                   # <dir>
    local err
    err=$(mkdir -p -- "$1" 2>&1) || die "cannot make $1: ${err%%$'\n'*}"
}

# <tmp> in place as <name>, beside it, only when nothing is at <name>: ln makes the name or
# fails, where mv would replace a file stored there. 1 when the name is taken; any other
# failure of ln is a refusal with ln's reason. The temp file goes here, or in leave on a
# refusal, and an rm that fails is a refusal: the temp would be a second name of the file.
put_new() {                   # <tmp> <name>
    local err rc=0
    if [ -e "$2" ] || [ -L "$2" ]; then rc=1
    elif ! err=$(ln -- "$1" "$2" 2>&1); then
        die "cannot link ${2##*/} into place: ${err%%$'\n'*}"
    fi
    rm -f -- "$1" || die "cannot remove $1"
    TMPF=''
    return "$rc"
}

# A new file <dir>/<name> holding what <command> prints, written to a temp file beside it and
# put in place by put_new. 1 when a file of that name is stored already.
write_new() {                 # <dir> <name> <command...>
    own_tmpfile TMPF "$1/.new.XXXXXX" ||
        die "cannot make a temp file in $1 (own_tmpfile: $own_tmpfile_why)"
    "${@:3}" > "$TMPF" || die "cannot write in $1"
    put_new "$TMPF" "$1/$2"
}

# One of this send's files. Its name joins PUT before the link, so a signal at any point takes
# it back. A name that is taken is no file of this send's: it leaves PUT, and the send is
# refused. A signal that lands before put_new finds such a name would take it too: only a
# msg_id drawn twice from /dev/urandom can bring that about.
send_file() {                 # <dir> <name> <command...>
    PUT+=("$1/$2")
    write_new "$@" && return 0
    PUT=("${PUT[@]:0:${#PUT[@]}-1}")
    die "msg_id ${2%.*} is already stored"
}

# The summary: one line, a final newline allowed, no other control byte, not empty and at
# most SUMMARY_MAX bytes. Only SUMMARY_MAX + 2 bytes are read: past that it is too long. A NUL
# is read as \001, a control byte: $( ) would drop it, and the line kept would not be the file's.
# pipefail: a head that fails is a refusal, not an empty summary.
summary_line() {              # <file> -> REPLY
    local LC_ALL=C s
    s=$(set -o pipefail; head -c $((SUMMARY_MAX + 2)) -- "$1" | tr '\000' '\001' && printf x) ||
        die "cannot read $1"
    s=${s%x}; s=${s%$'\n'}
    [ -n "$s" ] || die "the summary is empty"
    [[ $s != *[[:cntrl:]]* ]] || die "the summary is not one line of text"
    [ "${#s}" -le "$SUMMARY_MAX" ] || die "the summary is over $SUMMARY_MAX bytes"
    REPLY=$s
}

# A new msg_id: 16 bytes from /dev/urandom as 32 lowercase hex.
new_id() {
    REPLY=$(od -A n -t x1 -N 16 -v /dev/urandom) && REPLY=${REPLY//[!0123456789abcdef]/} &&
        [ "${#REPLY}" -eq 32 ] || die "cannot read 16 bytes from /dev/urandom"
}

cmd_send() {                  # --session <id> <to> <summary-file> <body-file>
    [ $# -eq 5 ] && [ "$1" = --session ] || usage
    local to=$3 sum=$4 body=$5 line id box now json pe known=''
    check_caller "$2"
    published
    for pe in ${PUBLISHED[@]+"${PUBLISHED[@]}"}; do [ "${pe%% *}" != "$to" ] || known=1; done
    [ -n "$known" ] || die "no pane of this tmux server publishes session $to"
    # A relative path under ./, so "-" names the file the checks below test: head and cat read
    # stdin for a bare "-", after "--" too.
    case $sum in /*) ;; *) sum=./$sum ;; esac
    case $body in /*) ;; *) body=./$body ;; esac
    [ -f "$sum" ] && [ -r "$sum" ] || die "no readable summary file: $sum"
    [ -f "$body" ] && [ -r "$body" ] || die "no readable body file: $body"
    summary_line "$sum"; line=$REPLY
    new_id; id=$REPLY
    now=$(date -u +%Y-%m-%dT%H:%M:%SZ) || die "cannot read the clock"
    # Each check that needs no folder runs first: a send refused before here makes none.
    state_root; own_dir "$ROOT/refs"; box=$ROOT/msg/$to; own_dir "$box"
    json="{\"schema_version\":2,\"msg_id\":\"$id\",\"from\":\"$ME\",\"to\":\"$to\""
    json+=",\"subject\":\"msg.$ME.$to\",\"timestamp\":\"$now\",\"correlation_id\":\"$id\""
    json+=",\"payload\":{\"body_ref\":\"$id.md\",\"summary_ref\":\"$id.txt\"}}"
    # The refs first and the envelope last: an envelope names only refs already in place.
    send_file "$ROOT/refs" "$id.txt" printf '%s\n' "$line"
    send_file "$ROOT/refs" "$id.md" cat -- "$body"
    send_file "$box" "$id.json" printf '%s\n' "$json"
    # Stored: a msg_id that cannot be printed leaves the message in place, and the line names it.
    PUT=()
    printf '%s\n' "$id" || die "message $id is stored, but its msg_id could not be printed"
}

# One "key":"value" of an envelope, the value of the shape <re>.
env_field() {                 # <text> <key> <re> -> REPLY; 1 when not there
    local re="\"$2\": ?\"($3)\""
    REPLY=''
    [[ $1 =~ $re ]] || return 1
    REPLY=${BASH_REMATCH[1]}
}

cmd_read() {                  # --session <id> <msg_id>
    [ $# -eq 3 ] && [ "$1" = --session ] || usage
    local id=$3 box f text ref
    check_caller "$2"
    [[ $id =~ ^$HEX$ ]] || die "$id is not a msg_id"
    state_root; box=$ROOT/msg/$ME; f=$box/$id.json
    # The writer makes no link, so a link in the store is none of its files: an envelope or a
    # ref that is one is refused, one that leads out of its folder with the rest
    # (contracts/README.md, Refs).
    [ ! -L "$f" ] || die "message $id is a symbolic link; envelopes are read only as files"
    [ -f "$f" ] || die "no message $id for session $ME"
    text=$(head -c 4096 -- "$f") || die "cannot read message $id"
    [[ $text =~ \"schema_version\":\ ?2[,}] ]] || die "message $id is no agent-message v2"
    # A msg_id is delivered once: an envelope copied under a new name is no new message.
    env_field "$text" msg_id "$HEX" && [ "$REPLY" = "$id" ] ||
        die "message $id holds the envelope of message ${REPLY:-none}; a copy is no new message"
    env_field "$text" to "$HEX" && [ "$REPLY" = "$ME" ] ||
        die "message $id is not addressed to session $ME"
    env_field "$text" body_ref "$HEX\\.md" || die "message $id names no body"
    ref=$ROOT/refs/$REPLY
    [ ! -L "$ref" ] || die "ref ${ref##*/} is a symbolic link; refs are read only as files"
    [ -f "$ref" ] || die "message $id has no body in refs/"
    cat -- "$ref" || die "cannot read the body of message $id"
    own_dir "$box/read"
    # 1: an earlier read left the marker.
    write_new "$box/read" "$id" true || :
}

# The branch <dir> is on, in REPLY, or - for none: a detached HEAD (symbolic-ref --quiet exits
# 1 and says nothing) or a folder in no repo. Any other failure of git is a refusal with git's
# reason. git speaks C here, so the words matched are its own.
branch_of() {                 # <dir> -> REPLY
    local out rc
    out=$(LC_ALL=C git -C "$1" symbolic-ref --quiet --short HEAD 2>&1); rc=$?
    case $rc:$out in
        0:?*) REPLY=$out ;;
        1:) REPLY=- ;;
        128:*'not a git repository'*) REPLY=- ;;
        *) die "cannot read the branch of $1: ${out%%$'\n'*}" ;;
    esac
}

# Each folder from the fields the one checked list read (workdir_row), by the rule in
# lib/workdir.sh (workdir_resolve): no second tmux call per pane, whose failure could pass
# for a pane gone. A folder that is not a directory is a refusal: git -C would read another.
cmd_who() {
    [ $# -eq 0 ] || usage
    local pe
    in_pane
    published
    for pe in ${PUBLISHED[@]+"${PUBLISHED[@]}"}; do
        workdir_row "${pe#* }"
        workdir_resolve
        workdir_ok "$WORKDIR" || die "no work folder for pane $WD_ID: '$WORKDIR' is not a directory"
        branch_of "$WORKDIR"
        printf '%s\t%s\t%s\n' "${pe%% *}" "$REPLY" "$WORKDIR" || die "cannot print the list"
    done
}

case "${1:-}" in
    send) shift; cmd_send "$@" ;;
    read) shift; cmd_read "$@" ;;
    who) shift; cmd_who "$@" ;;
    *) usage ;;
esac
