root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Shell throughout, four spaces, except tm which was written with two.
[*.{sh,tmux}]
indent_style = space
indent_size = 4

[scripts/*]
indent_style = space
indent_size = 4

[scripts/tm]
indent_size = 2

[Makefile]
indent_style = tab

[*.{md,json}]
indent_style = space
indent_size = 2
