{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tmux-cockpit:contracts:agent-state",
  "title": "agent-state",
  "description": "One agent's state, in today's hook words. Ids, a state and timestamps only: no title, no prompt.",
  "type": "object",
  "properties": {
    "schema_version": { "const": 1 },
    "agent_id": { "$ref": "#/$defs/id" },
    "pane_id": { "type": "string", "pattern": "^%[0-9]{1,10}$" },
    "state": { "enum": ["running", "needs-input", "error", "done", "idle"] },
    "updated_at": { "$ref": "#/$defs/utc" },
    "revision": {
      "description": "The store revision the writer read before this write; 0 for a create.",
      "type": "integer",
      "minimum": 0
    }
  },
  "required": ["schema_version", "agent_id", "pane_id", "state", "updated_at", "revision"],
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[0-9a-f]{16,64}$" },
    "utc": {
      "description": "ISO-8601 in UTC, Z only, optional fraction.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
    }
  }
}
